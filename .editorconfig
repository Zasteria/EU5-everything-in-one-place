# Взято у Community Mod Toolkit (их ветка `dev`, 2026-08-31) — но только та
# половина, которая описывает это дерево.
#
# **Перенос конца строки НЕ взят.** У них `end_of_line = crlf` на всё, а здесь
# LF — и в генерируемых файлах, и в самих файлах игры, распакованных в
# `reference/`. Поставить crlf значило бы, что редактор правит одно, а
# `refresh.py` переписывает обратно, и так на каждом файле. Единственный файл,
# которому CRLF правда нужен, — `mods.bat`, и он уже назван в `.gitattributes`.
#
# Остальное — те самые правила, за которые здесь платят руками:
# `docs/pitfalls/localization.md` (BOM, один пробел отступа в локализации) и
# `docs/CONVENTIONS.md`.
root = true

[*]
insert_final_newline = true
trim_trailing_whitespace = true

# Скрипт, локализация и интерфейс игры читаются с меткой порядка байтов; без
# неё ключ показывается сырым, и увидеть это можно только в игре.
[*.{txt,yml,gui}]
charset = utf-8-bom

[*.{txt,gui}]
indent_style = tab

# Локализация — один ведущий пробел на ключ, и это не стиль, а синтаксис.
[*.yml]
indent_style = space
indent_size = 1

[*.py]
indent_style = space
indent_size = 4

[*.bat]
end_of_line = crlf
