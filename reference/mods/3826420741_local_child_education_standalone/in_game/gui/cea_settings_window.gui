window = {
    name = "cea_settings_window"
    parentanchor = center
    size = { 780 620 }
    using = bg_window_default_alt
    visible = "[GetPlayer.IsValid]"
    background = { using = color_dark_blue_texture alpha = 0.98 }
    window_header_alt = {
        position = { 0 0 } size = { 780 40 }
        blockoverride "header_text" { text = "cea_name" }
        blockoverride "window_header_alt_color_texture" { using = color_advances_texture }
    }
    text_single = { position = { 20 47 } size = { 736 28 }
        align = left|nobaseline fontsize = 14 text = "CEA_UI_SUBTITLE" default_format = ""
         }
    header_secondary_tabs = {
        position = { 18 82 } size = { 744 40 }
        blockoverride "content" {
            button_secondary_tab_alt = { size = { 369 40 }
                text = "cea__settings_name"
                down = "[Not(GetVariableSystem.Exists('cea_paid_tab'))]"
                onclick = "[GetVariableSystem.Clear('cea_paid_tab')]" }
            button_secondary_tab_alt = { size = { 369 40 }
                text = "cea__paid_name"
                down = "[GetVariableSystem.Exists('cea_paid_tab')]"
                onclick = "[GetVariableSystem.Set('cea_paid_tab', 'yes')]" }
        }
    }
