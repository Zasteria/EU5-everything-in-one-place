widget = {
 name = "cea_standalone_widget"
 size = { 100% 100% }
 alwaystransparent = yes
 button_wax = {
  parentanchor = top|right position = { -280 115 } size = { 260 35 }
  visible = "[And3(GetPlayer.IsValid, GetPlayer.MakeScope.GetVariable('cea_alert_enabled').IsSet, GetPlayer.MakeScope.GetVariable('cea_found').IsSet)]"
  text = "cea_child_education_name"
  tooltip = "cea_child_education_tooltip"
  onclick = "[GetScriptedGui('cea_open_settings').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
  onclick = "[ExecuteConsoleCommand(Select_CString(GetVariableSystem.Exists('cea_settings_open'), 'gui.ClearWidgets cea_settings_window', 'gui.createwidget gui/cea_settings_window.gui cea_settings_window'))]"
  onclick = "[GetVariableSystem.Toggle('cea_settings_open')]"
 }
}
