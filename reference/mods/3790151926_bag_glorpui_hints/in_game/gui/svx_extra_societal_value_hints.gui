template SocietalValueCountryRight_tooltip {
	using = SocietalValueRight_tooltip
	blockoverride "societal_value_right_tooltip_extra" {
		# GlorpUI: C++ GetRightHint blob kept behind a setting, per-axis lists filtered to takeable suggestions otherwise.
		TooltipScrolledStringPairList = {
			visible = "[Player.MakeScope.GetVariable('showUnavailableSocietalValueSuggestions').IsSet]"
			blockoverride "block_scrollarea" {
				maximumsize = { -1 160 }
			}

			blockoverride "block_title" {
				text = "TO_MOVE_FURTHER_TO_RIGHT"
				default_format = "#help"
			}

			textcontext = "[SocietalValue.GetRightHint(Player.Self)]"
		}

		TooltipScrolledStringPairList = {
			visible = "[GreaterThan_CFixedPoint(GuiScope.AddScope('glorpui_sv', SocietalValue.MakeScope).AddScope('glorpui_country', Player.MakeScope).ScriptValue('glorpui_svh_visible_decentralization'), '(CFixedPoint)0')]"
