					layoutpolicy_vertical = preferred
					layoutstretchfactor_horizontal = 1
					using = bg_square_wood_tile
					using = bg_cabinet_card_frame
					max_width = 860
					margin = { 10 6 }
					spacing = 5

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6
						icon = {
							size = { 28 28 }
							texture = "gfx/interface/icons/flat_icons/building_panel/productionfiltered_button.dds"
							texture_density = 2
						}
						text_single = {
							layoutpolicy_horizontal = expanding
							size = { -1 28 }
							default_format = "#yellow_titles"
							fontsize = 16
							fontsize_min = 12
							align = left|vcenter
							text = "eu5ab_template_editor_sections_title"
						}

					}

					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = preferred
						spacing = 5
						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 8
							button_regular = {
						size = { 180 40 }
						tooltip = "eu5ab_open_buildings_editor_button"
						text_single = {
							size = { 172 36 }
							parentanchor = center
							autoresize = no
							maximumsize = { 172 36 }
							fontsize = 14
							fontsize_min = 10
							align = center|nobaseline
							elide = right
							text = "eu5ab_open_buildings_editor_button"
						}
						onclick = "[GetScriptedGui('eu5ab_gui_open_template_buildings_slot_2').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

						onclick = "[GetScriptedGui('eu5ab_gui_clear_cmf_window_request').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

						onclick = "[GetVariableSystem.Clear('eu5ab_window_open')]"

						onclick = "[GetVariableSystem.Set('eu5ab_template_buildings_visible', '1')]"
					}
							button_regular = {
						size = { 180 40 }
						tooltip = "eu5ab_open_rules_editor_button"
						text_single = {
							size = { 172 36 }
							parentanchor = center
							autoresize = no
							maximumsize = { 172 36 }
							fontsize = 14
							fontsize_min = 10
							align = center|nobaseline
							elide = right
							text = "eu5ab_open_rules_editor_button"
						}
						onclick = "[GetScriptedGui('eu5ab_gui_open_template_rules_slot_2').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

						onclick = "[GetScriptedGui('eu5ab_gui_clear_cmf_window_request').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

						onclick = "[GetVariableSystem.Clear('eu5ab_window_open')]"

						onclick = "[GetVariableSystem.Set('eu5ab_template_rules_visible', '1')]"
					}
						}
						text_multi = { layoutpolicy_horizontal = expanding autoresize = yes text = "eu5ab_template_editor_sections_desc" }
					}
				}
