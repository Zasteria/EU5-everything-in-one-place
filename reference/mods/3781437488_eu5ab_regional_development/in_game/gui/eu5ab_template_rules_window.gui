template EU5ABRulesHelp_eu5ab_ranking_mode_section_title {
	ConceptTooltipType = {
		blockoverride "title_icon" { icon = { texture = "gfx/interface/icons/sort/development.dds" using = tooltip_concept_title_icon_size } }
		blockoverride "title_text" { text = "eu5ab_ranking_mode_section_title" }
		blockoverride "tooltip_content" { TooltipTextBlock = { blockoverride "text" { text = "eu5ab_ranking_mode_help" } } }
	}
}

