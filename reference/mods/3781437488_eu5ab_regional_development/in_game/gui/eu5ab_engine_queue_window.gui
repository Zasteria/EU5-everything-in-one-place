widget = {
    datamodel = "[GetPlayer.MakeScope.GetList('eu5ab_bridge_fire_1')]"
    item = { widget = { datacontext = "[GetPlayer.MakeScope.GetVariableFromVariableMap('eu5ab_bridge_request_locations', MakeScopeValue(Scope.GetValue)).GetLocation]"
        visible_at_creation = no visible = "[GetPlayer.Exists]"
        state = { name = _hide alpha = 0 }
        state = { name = _show alpha = 1 duration = 0.01 next = eu5ab_bridge_fire_1_setup }
        state = { name = eu5ab_bridge_fire_1_setup alpha = 0 duration = 0.01
             next = eu5ab_bridge_fire_1_read }
        state = { name = eu5ab_bridge_fire_1_read alpha = 1 duration = 0.01 on_finish = "[PdxGuiTriggerAllAnimations('eu5ab_bridge_fire_1_read_sample')]" }

            widget = { datacontext = "[GetPlayer.MakeScope.GetVariableFromVariableMap('eu5ab_bridge_request_types', MakeScopeValue(Scope.GetValue)).GetBuildingType]"
            visible_at_creation = no visible = "[GetPlayer.Exists]"
            state = { name = _hide alpha = 0 } state = { name = _show alpha = 1 }
            state = { name = eu5ab_bridge_fire_1_read_sample on_finish = "[GetScriptedGui('eu5ab_gui_queue_request_fire').Execute(GuiScope.SetRoot(Location.MakeScope).AddScope('eu5ab_engine_country', GetPlayer.MakeScope).AddScope('eu5ab_bridge_ticket', MakeScopeValue(Scope.GetValue)).AddScope('eu5ab_candidate_building', BuildingType.MakeScope).AddScope('eu5ab_engine_cost', MakeScopeValue(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self))).AddScope('eu5ab_engine_replaced_building', BuildingType.GetObsoleteBuildingInLocation(Location.Self, GetPlayer.Self).MakeScope).End)]" }

            widget = {
                visible_at_creation = no
                visible = "[GetScriptedGui('eu5ab_gui_queue_fire_permitted').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('eu5ab_candidate_location', Location.MakeScope).AddScope('eu5ab_candidate_building', BuildingType.MakeScope).AddScope('eu5ab_engine_country', GetPlayer.MakeScope).AddScope('eu5ab_bridge_ticket', MakeScopeValue(Scope.GetValue)).End)]"
                state = { name = _hide alpha = 0 }
                state = {
                    name = _show
                    alpha = 1
                    on_finish = "[GetScriptedGui('eu5ab_gui_queue_record_fire').Execute(GuiScope.SetRoot(Location.MakeScope).AddScope('eu5ab_engine_country', GetPlayer.MakeScope).AddScope('eu5ab_candidate_building', BuildingType.MakeScope).AddScope('eu5ab_bridge_ticket', MakeScopeValue(Scope.GetValue)).End)]"
                    on_finish = "[BuildOrExpandBuildingDefault(BuildingType.Self, Location.Self)]"
                }
            }

        }
    } }
}
