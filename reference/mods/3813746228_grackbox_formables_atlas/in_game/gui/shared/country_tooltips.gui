				vbox = { 
					TooltipScrolledStringPairList = {
						blockoverride "block_title" {
							text = "TAX_BASE_SOURCES"
						}
						blockoverride "block_scrollarea" { maximumsize = { -1 300 } }
	
						textcontext =  "[Country.GetTaxBaseLocationInfo]"
					}
					TooltipScrolledStringPairList = {
						blockoverride "block_title" {
							text = "TAX_BASE_GOODS_HEADER"
						}
						blockoverride "block_scrollarea" { maximumsize = { -1 300 } }
						textcontext =  "[Country.GetTaxBaseGoodsInfo]"
					}
				}
			}
		}
	}
}

