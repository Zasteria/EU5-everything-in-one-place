template EconomicalBaseTimelineTooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[GetConceptTexture('economical_base')]"
			}
		}

		blockoverride "title_text" {
			text = "TIMELINE_ECONOMICALBASE_TOOLTIP_TITLE"
		}

		blockoverride "concept_link" {
			text = [economical_base|E]
		}

		blockoverride "tooltip_content" {
			TooltipDebugStringPairList = {
				textcontext = "[TimelineCountry.GetTimelineDebugText]"
			}

			caesar_plotline = {
				size = { 400 360 }

				blockoverride "header" {
					text = "TIMELINE_ECONOMICALBASE_TOOLTIP_HEADER"
					background = {
						using = bg_round_corners_up

						modify_texture = {
							using = bg_fade_vertical_up_mask_texture
							blend_mode = alphamultiply
							alpha = 0.2
						}
					}
				}
				blockoverride "line_color" {
					color = { .9 .9 .9 1.0 }
				}
				blockoverride "line_plotpoints" {
					plotpoints = "[TimelineCountry.GetHistoricalEconomicalBasePlotPoints]"
				}
				blockoverride "maxvalue" {
					raw_text = "[TimelineCountry.GetHistoricalMaxEconomicalBase|2]@gold!"
				}
				blockoverride "minvalue" {
					raw_text = "[TimelineCountry.GetHistoricalMinEconomicalBase|2]@gold!"
				}
				blockoverride "startdate" {
					text = "[TimelineCountry.GetHistoricalEconomicalBaseStartYear]"
				}
				blockoverride "enddate" {
					text = "[TimelineCountry.GetHistoricalEconomicalBaseEndYear]"
				}
				blockoverride "tooltip" {
					marker = {
						text_single = {
							position = { 0 -20 }
							autoresize = yes

							margin_right = 4
							margin_top = 4
							align = left|nobaseline
							using = bg_number_container_bckg
							default_format = "#t"

							text = "[TimelineCountry.GetHistoricalEconomicalBaseValueAt(PlotLine.GetSnappedIndexNearMouse)]"
						}
					}
				}
				blockoverride "multiitem" {}

				blockoverride "extra_plotlines" {}
				blockoverride "empty_state_visibility" {}
				blockoverride "empty_state_text" {}
			}
		}
	}
}

template EconomicalBaseTooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[GetConceptTexture('economical_base')]"
			}
		}

		blockoverride "title_text" {
			datacontext = "[Country]"
			text = "ECONOMICALBASE_TOOLTIP_TITLE"
		}

		blockoverride "concept_link" {
			text = [economical_base|E]
		}

		blockoverride "tooltip_content" {
			hbox = {
				TooltipStringPairList = {
					textcontext =  "[Country.GetEconomicalBaseInfo]"
				}
				widget = { size = { 16 16 } }

				caesar_plotline = {
					size = { 400 360 }

					blockoverride "header" {
						datacontext = "[Country]"
						text = "ECONOMICALBASE_TOOLTIP_HEADER"
						background = {
							using = bg_round_corners_up

							modify_texture = {
								using = bg_fade_vertical_up_mask_texture
								blend_mode = alphamultiply
								alpha = 0.2
							}
						}
					}
					blockoverride "line_color" {
						color = { .9 .9 .9 1.0 }
					}
					blockoverride "line_plotpoints" {
						plotpoints = "[Country.GetHistoricalEconomicalBase]"
					}
					blockoverride "maxvalue" {
						raw_text = "[Country.GetHistoricalMaxEconomicalBase|2]@gold!"
					}
					blockoverride "minvalue" {
						raw_text = "[Country.GetHistoricalMinEconomicalBase|2]@gold!"
					}
					blockoverride "startdate" {
						text = "[Country.GetStartDataDate]"
					}
					blockoverride "enddate" {
						text = "[Country.GetEndDataDate]"
					}
					blockoverride "tooltip" {
						marker = {
							text_single = {
								position = { 0 -20 }
								autoresize = yes

								margin_right = 4
								margin_top = 4
								align = left|nobaseline
								#using = Font_Size_Small
								using = bg_number_container_bckg
								default_format = "#t"

								text = "[Country.GetYearlyDataPointValueEconomicalBase(PlotLine.GetSnappedIndexNearMouse)]"
							}
						}
					}
					blockoverride "multiitem" {}

					blockoverride "extra_plotlines" {}
					blockoverride "empty_state_visibility" {}
					blockoverride "empty_state_text" {}
				}
			}
		}
	}
}




