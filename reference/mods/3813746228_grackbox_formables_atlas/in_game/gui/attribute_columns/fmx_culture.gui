types FmxCultureColumns
{
	type fmx_culture_name = select_cell_default {
		size = { 170 32 }
		blockoverride "interaction_target_action_provider_tooltip" {
			tooltipwidget = {
				using = action_tooltip_pop_out
			}
		}
		tagtooltip_enabled = yes
		tooltip = "[InteractionTarget.GetCulture.GetName]"
		sort_by_highlight = {
			size = { 100% 100% }
			name = "fmx_culture_name"
		}
		hbox = {
			margin = { 10 0 }
			spacing = 5
			layoutpolicy_horizontal = expanding
			text_single = {
				layoutpolicy_horizontal = expanding
				align = nobaseline
				default_format = "#yellow_titles"
				text = "[InteractionTarget.GetCulture.GetNameWithNoTooltip]"
			}
		}
	}

	type fmx_cul_group = select_cell_default {
		size = { 130 32 }
		sort_by_highlight = {
			size = { 100% 100% }
			name = "fmx_cul_group"
		}
		hbox = {
			margin = { 10 0 }
			layoutpolicy_horizontal = expanding
			text_single = {
				layoutpolicy_horizontal = expanding
				align = nobaseline
				text = "[Localize(Concatenate('FMX_CGN_', InteractionTarget.GetCulture.GetKey))]"
			}
		}
	}

	type fmx_cul_lang = select_cell_default {
		size = { 100 32 }
		sort_by_highlight = {
			size = { 100% 100% }
			name = "fmx_cul_lang"
		}
		hbox = {
			margin = { 10 0 }
			layoutpolicy_horizontal = expanding
			text_single = {
				layoutpolicy_horizontal = expanding
				align = nobaseline
				text = "[InteractionTarget.GetCulture.GetLanguage.GetName]"
			}
		}
	}

	type fmx_cul_adv = select_cell_default {
		size = { 50 32 }
		sort_by_highlight = {
			size = { 100% 100% }
			name = "fmx_cul_adv"
		}
		hbox = {
			margin = { 10 0 }
			layoutpolicy_horizontal = expanding
			text_single = {
				layoutpolicy_horizontal = expanding
				align = center|nobaseline
				text = "[InteractionTarget.GetCulture.MakeScope.ScriptValue('fmx_cul_adv_value')|0]"
			}
		}
	}

	type fmx_cul_forms = select_cell_default {
		size = { 50 32 }
		sort_by_highlight = {
			size = { 100% 100% }
			name = "fmx_cul_forms"
		}
		hbox = {
			margin = { 10 0 }
			layoutpolicy_horizontal = expanding
			text_single = {
				layoutpolicy_horizontal = expanding
				align = center|nobaseline
				text = "[InteractionTarget.GetCulture.MakeScope.ScriptValue('fmx_cul_forms_value')|0]"
			}
		}
	}

	type fmx_cul_st = select_cell_default {
		size = { 50 32 }
		sort_by_highlight = {
			size = { 100% 100% }
			name = "fmx_cul_st"
		}
		hbox = {
			margin = { 10 0 }
			layoutpolicy_horizontal = expanding
			text_single = {
				layoutpolicy_horizontal = expanding
				align = center|nobaseline
				text = "[InteractionTarget.GetCulture.MakeScope.ScriptValue('fmx_cul_st_value')|0]"
			}
		}
	}

}
