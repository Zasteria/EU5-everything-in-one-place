types FmxCountryColumns
{
	type fmx_country_name = select_cell_default {
		size = { 190 32 }
		blockoverride "interaction_target_action_provider_tooltip" {
			tooltipwidget = {
				using = action_tooltip_pop_out
			}
		}
		tagtooltip_enabled = yes
		tooltip = "[Localize(Concatenate('FMX_XL_', ToString_int32(FixedPointToInt(InteractionTarget.GetCountry.MakeScope.ScriptValue('fmx_x_index_value')))))]"
		sort_by_highlight = {
			size = { 100% 100% }
			name = "fmx_country_name"
		}
		hbox = {
			margin = { 10 0 }
			spacing = 5
			layoutpolicy_horizontal = expanding
			country_flag_small = {
				size = { 40 27 }
				datacontext = "[InteractionTarget.GetCountry]"
			}
			text_single = {
				layoutpolicy_horizontal = expanding
				align = nobaseline
				default_format = "#yellow_titles"
				text = "[InteractionTarget.GetCountry.GetNameWithNoTooltip]"
			}
		}
	}

	type fmx_x_cul = select_cell_default {
		size = { 130 32 }
		sort_by_highlight = {
			size = { 100% 100% }
			name = "fmx_x_cul"
		}
		hbox = {
			margin = { 10 0 }
			layoutpolicy_horizontal = expanding
			text_single = {
				layoutpolicy_horizontal = expanding
				align = nobaseline
				text = "[InteractionTarget.GetCountry.GetCulture.GetName]"
			}
		}
	}

	type fmx_x_rel = select_cell_default {
		size = { 130 32 }
		sort_by_highlight = {
			size = { 100% 100% }
			name = "fmx_x_rel"
		}
		hbox = {
			margin = { 10 0 }
			layoutpolicy_horizontal = expanding
			text_single = {
				layoutpolicy_horizontal = expanding
				align = nobaseline
				text = "[InteractionTarget.GetCountry.GetReligion.GetName]"
			}
		}
	}

	type fmx_x_adv = select_cell_default {
		size = { 70 32 }
		sort_by_highlight = {
			size = { 100% 100% }
			name = "fmx_x_adv"
		}
		hbox = {
			margin = { 10 0 }
			layoutpolicy_horizontal = expanding
			text_single = {
				layoutpolicy_horizontal = expanding
				align = center|nobaseline
				text = "[InteractionTarget.GetCountry.MakeScope.ScriptValue('fmx_x_adv_value')|0]"
			}
		}
	}

	type fmx_x_ref = select_cell_default {
		size = { 70 32 }
		sort_by_highlight = {
			size = { 100% 100% }
			name = "fmx_x_ref"
		}
		hbox = {
			margin = { 10 0 }
			layoutpolicy_horizontal = expanding
			text_single = {
				layoutpolicy_horizontal = expanding
				align = center|nobaseline
				text = "[InteractionTarget.GetCountry.MakeScope.ScriptValue('fmx_x_ref_value')|0]"
			}
		}
	}

}
