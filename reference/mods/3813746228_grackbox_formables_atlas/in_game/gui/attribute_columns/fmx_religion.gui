types FmxReligionColumns
{
	type fmx_religion_name = select_cell_default {
		size = { 190 32 }
		blockoverride "interaction_target_action_provider_tooltip" {
			tooltipwidget = {
				using = action_tooltip_pop_out
			}
		}
		tagtooltip_enabled = yes
		tooltip = "[InteractionTarget.GetReligion.GetName]"
		sort_by_highlight = {
			size = { 100% 100% }
			name = "fmx_religion_name"
		}
		hbox = {
			margin = { 10 0 }
			spacing = 5
			layoutpolicy_horizontal = expanding
			icon = {
				size = { 28 28 }
				texture = "[GetReligionIcon(InteractionTarget.GetReligion)]"
			}
			text_single = {
				layoutpolicy_horizontal = expanding
				align = nobaseline
				default_format = "#yellow_titles"
				text = "[InteractionTarget.GetReligion.GetNameWithNoTooltip]"
			}
		}
	}

	type fmx_rel_group = select_cell_default {
		size = { 150 32 }
		sort_by_highlight = {
			size = { 100% 100% }
			name = "fmx_rel_group"
		}
		hbox = {
			margin = { 10 0 }
			layoutpolicy_horizontal = expanding
			text_single = {
				layoutpolicy_horizontal = expanding
				align = nobaseline
				text = "[InteractionTarget.GetReligion.GetGroup.GetName]"
			}
		}
	}

	type fmx_rel_adv = select_cell_default {
		size = { 60 32 }
		sort_by_highlight = {
			size = { 100% 100% }
			name = "fmx_rel_adv"
		}
		hbox = {
			margin = { 10 0 }
			layoutpolicy_horizontal = expanding
			text_single = {
				layoutpolicy_horizontal = expanding
				align = center|nobaseline
				text = "[InteractionTarget.GetReligion.MakeScope.ScriptValue('fmx_rel_adv_value')|0]"
			}
		}
	}

	type fmx_rel_forms = select_cell_default {
		size = { 60 32 }
		sort_by_highlight = {
			size = { 100% 100% }
			name = "fmx_rel_forms"
		}
		hbox = {
			margin = { 10 0 }
			layoutpolicy_horizontal = expanding
			text_single = {
				layoutpolicy_horizontal = expanding
				align = center|nobaseline
				text = "[InteractionTarget.GetReligion.MakeScope.ScriptValue('fmx_rel_forms_value')|0]"
			}
		}
	}

	type fmx_rel_st = select_cell_default {
		size = { 60 32 }
		sort_by_highlight = {
			size = { 100% 100% }
			name = "fmx_rel_st"
		}
		hbox = {
			margin = { 10 0 }
			layoutpolicy_horizontal = expanding
			text_single = {
				layoutpolicy_horizontal = expanding
				align = center|nobaseline
				text = "[InteractionTarget.GetReligion.MakeScope.ScriptValue('fmx_rel_st_value')|0]"
			}
		}
	}

}
