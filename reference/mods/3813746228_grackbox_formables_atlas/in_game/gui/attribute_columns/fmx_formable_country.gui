types FmxFormable_CountryColumns
{
	type fmx_formable_country_name = select_cell_default {
		size = { 190 32 }
		blockoverride "interaction_target_action_provider_tooltip" {
			tooltipwidget = {
				using = action_tooltip_pop_out
			}
		}
		tagtooltip_enabled = yes
		tooltip = "[InteractionTarget.GetFormableCountry.GetName]"
		sort_by_highlight = {
			size = { 100% 100% }
			name = "fmx_formable_country_name"
		}
		hbox = {
			margin = { 10 0 }
			spacing = 5
			layoutpolicy_horizontal = expanding
			country_flag = {
				size = { 40 27 }
				blockoverride "tooltip" { tooltip_enabled = no tagtooltip_enabled = no }
				blockoverride "contextmenu" { contextmenu_enabled = no }
				blockoverride "flag" {
					datacontext = "[InteractionTarget.GetFormableCountry.GetOrCreateCoatOfArms(Player.Self)]"
					texture = "[CoatOfArmsWrapper.GetTexture('(int32)144','(int32)96')]"
					frame = "[CoatOfArmsWrapper.GetFrame('(int32)144','(int32)96')]"
					framesize = "[CoatOfArmsWrapper.GetFrameSizeOrFallback('(int32)144','(int32)96','(float)0.5')]"
					texture_density = 2
				}
				blockoverride "click" {}
				blockoverride "double_click" {}
				blockoverride "hover" {}
			}
			text_single = {
				layoutpolicy_horizontal = expanding
				align = nobaseline
				default_format = "#yellow_titles"
				text = "[InteractionTarget.GetFormableCountry.GetNameWithNoTooltip]"
			}
		}
	}

	type fmx_f_tier = select_cell_default {
		size = { 70 32 }
		sort_by_highlight = {
			size = { 100% 100% }
			name = "fmx_f_tier"
		}
		hbox = {
			margin = { 10 0 }
			layoutpolicy_horizontal = expanding
			text_single = {
				layoutpolicy_horizontal = expanding
				align = center|nobaseline
				text = "[InteractionTarget.GetFormableCountry.MakeScope.ScriptValue('fmx_f_tier_value')|0]"
			}
		}
	}

	type fmx_f_need = select_cell_default {
		size = { 90 32 }
		sort_by_highlight = {
			size = { 100% 100% }
			name = "fmx_f_need"
		}
		hbox = {
			margin = { 10 0 }
			layoutpolicy_horizontal = expanding
			text_single = {
				layoutpolicy_horizontal = expanding
				align = center|nobaseline
				text = "[InteractionTarget.GetFormableCountry.MakeScope.ScriptValue('fmx_f_need_value')|0]"
			}
		}
	}

	type fmx_f_adv = select_cell_default {
		size = { 80 32 }
		sort_by_highlight = {
			size = { 100% 100% }
			name = "fmx_f_adv"
		}
		hbox = {
			margin = { 10 0 }
			layoutpolicy_horizontal = expanding
			text_single = {
				layoutpolicy_horizontal = expanding
				align = center|nobaseline
				text = "[InteractionTarget.GetFormableCountry.MakeScope.ScriptValue('fmx_f_adv_value')|0]"
			}
		}
	}

	type fmx_f_ref = select_cell_default {
		size = { 80 32 }
		sort_by_highlight = {
			size = { 100% 100% }
			name = "fmx_f_ref"
		}
		hbox = {
			margin = { 10 0 }
			layoutpolicy_horizontal = expanding
			text_single = {
				layoutpolicy_horizontal = expanding
				align = center|nobaseline
				text = "[InteractionTarget.GetFormableCountry.MakeScope.ScriptValue('fmx_f_ref_value')|0]"
			}
		}
	}

}
