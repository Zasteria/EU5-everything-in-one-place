	type GoldenCenturyColumnRight = widget {
		datacontext = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('gc_winner_country').GetCountry]"
		allow_outside = yes

		vbox = {
			visible = "[Or(ObjectsEqual(Country.Self, GetCountry('SPA').Self), ObjectsEqual(Country.Self, GetCountry('CAS').Self))]"
			parentanchor = top|hcenter
			widgetanchor = top|hcenter
			layoutpolicy_vertical = expanding
			allow_outside = yes

			icon = {
				block "spa_column_texture_top" {
					texture = "gfx/interface/icons/situations/golden_century/golden_century_castile_tower_top_right.dds"
				}
				texture_density = 2
			}
			icon = {
				using = golden_century_castile_middle_block_texture
				size = { 48 60 }
			}
			icon = {
				using = golden_century_castile_middle_block_texture
				size = { 48 60 }
			}
			icon = {
				using = golden_century_castile_middle_block_texture
				size = { 48 60 }
			}
			icon = {
				using = golden_century_castile_middle_block_texture
				size = { 48 60 }
			}
			icon = {
				layoutpolicy_vertical = expanding
				texture = "gfx/interface/icons/situations/golden_century/golden_century_castile_tower_base.dds"
				texture_density = 2
				spriteType = corneredtiled
				spriteborder = { 0 33 }
			}
		}

		vbox = {
