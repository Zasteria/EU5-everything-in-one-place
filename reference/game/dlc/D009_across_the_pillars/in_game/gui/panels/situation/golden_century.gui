	type GoldenCenturyDominanceBar = widget {
		allow_outside = yes

		widget = {
			size = { 22 100% }
			parentanchor = center
			tooltipwidget = {
				ContextualTooltipType = {
					blockoverride "title_icon_texture" { texture = "[SituationView.GetActiveSituation.GetIcon]" }
					blockoverride "title_text" { text = "[MonthlySavedVariable.GetName]" }
					blockoverride "concept_link" { text = "[situation|e]" }
					blockoverride "tooltip_content" {
						TooltipTextBlock = { blockoverride "text" { text = "GC_THRESHOLD_CURRENT" } }
					}
				}
			}
			background = {
				using = bg_progress_bar_silver_rotated_texture
				spriteType = corneredstretched
				spriteborder = { 0 12 }
			}

			progressbar = {
				size = { 100% 100% }
				direction = vertical
				texture_density = 2
				spriteType = corneredstretched
				spriteborder = { 0 12 }
				min = 0
				max = 100
				value = "[FixedPointToFloat(SituationView.GetActiveSituation.GetVariable(MonthlySavedVariable.GetTag))]"
				progresstexture = "gfx/interface/progressbars/progress_bar_goldish_rotated.dds"
				noprogresstexture = "gfx/interface/icons/unit_view/moral_bar_transparent.dds"
			}
		}

		vbox = {
			size = { 100% 100% }
			allow_outside = yes

			widget = {
				layoutpolicy_vertical = expanding
				allow_outside = yes
				GoldenCenturyThresholdMarker100 = { parentanchor = top|hcenter widgetanchor = center }
			}
			widget = {
				layoutpolicy_vertical = expanding
				allow_outside = yes
				GoldenCenturyThresholdMarker75 = { parentanchor = top|hcenter widgetanchor = center }
			}
			widget = {
				layoutpolicy_vertical = expanding
				allow_outside = yes
				GoldenCenturyThresholdMarker50 = { parentanchor = top|hcenter widgetanchor = center }
			}
			widget = {
				layoutpolicy_vertical = expanding
				allow_outside = yes
				GoldenCenturyThresholdMarker25 = { parentanchor = top|hcenter widgetanchor = center }
			}
		}
	}

	type GoldenCenturyActionBanner = widget {
		size = { 240 50 }
		
		button = {
			size = { 100% 100% }
			parentanchor = center
			texture = "gfx/interface/icons/situations/golden_century/castile_golden_century_button.dds"
			using = gc_action_banner_button_properties
			visible = yes
			block "gc_banner_button_mirror" { mirror = horizontal }

			block "gc_banner_action_overlay" {
				scripted_action_tooltip = {
					click_type = left
					click_mode = confirm
					action_name = "gc_action_default"
					actor = "[SituationView.GetPlayer]"
					parameter = {
						parameter_name = "recipient"
						parameter_value = "[SituationView.GetActiveSituation.GetSituation]"
					}
				}
				enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
			}
			block "gc_banner_tooltip" {
				tooltipwidget = {
					ContextualTooltipType = {
						blockoverride "title_icon_texture" { texture = "[SituationView.GetActiveSituation.GetIcon]" }
						blockoverride "title_text" { text = "gc_action_default" }
						blockoverride "concept_link" { text = "[action|E]" }
						blockoverride "tooltip_content" {
							using = gc_action_effects_list
						}
					}
				}
			}
		}

		hbox = {
			parentanchor = center
			spacing = 2
			alwaystransparent = yes
			block "gc_banner_icon_leading" {
				margin_left = 28
				margin_right = 12
				using = gc_banner_action_icon
			}
			text_single = {
				layoutpolicy_horizontal = expanding
				maximumsize = { 173 -1 }
				autoresize = yes
				block "gc_banner_text_align" {
					align = left
				}
				fontsize = 13
				alwaystransparent = yes
				default_format = "#header_titles"
				block "gc_banner_text" {}
			}
			block "gc_banner_icon_trailing" {}
		}
	}

	type GoldenCenturyActionBannerRight = GoldenCenturyActionBanner {
		blockoverride "gc_banner_button_mirror" {}
		blockoverride "gc_banner_icon_leading" {}
		blockoverride "gc_banner_text_align" {
			align = right
		}
		blockoverride "gc_banner_icon_trailing" {
			using = gc_banner_action_icon
