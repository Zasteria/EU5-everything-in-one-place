template gc_banner_action_icon {
	icon = {
		size = { 22 22 }
		alwaystransparent = yes
		texture = "[GenericAction.GetIcon]"
	}
}

template ga_threshold_bonus_list {
	TooltipListBase = {
		blockoverride "block_title" {
			text = "ga_threshold_bonus_title"
		}
		text_multi = {
			margin = { 6 0 }
			block "ga_threshold_bonus_list_eu_visible" { 
				visible = "[EqualTo_string(MonthlySavedVariable.GetTag, 'gc_european_dominance')]"
			}
			layoutpolicy_horizontal = expanding
			minimumsize = { 420 -1 }
			autoresize = yes
			fontsize_min = 13
			align = left|nobaseline
			block "ga_threshold_bonus_list_eu_text" {}
		}
		text_multi = {
			margin = { 6 0 }
			block "ga_threshold_bonus_list_col_visible" { 
				visible = "[EqualTo_string(MonthlySavedVariable.GetTag, 'gc_colonial_dominance')]"
			}
			layoutpolicy_horizontal = expanding
			minimumsize = { 420 -1 }
			autoresize = yes
			fontsize_min = 13
			align = left|nobaseline
			block "ga_threshold_bonus_list_col_text" {}
		}
	}
}

template ga_threshold_modifier_reward {
	TooltipListBase = {
		blockoverride "block_title" {
			text = "GC_THRESHOLD_MODIFIER"
		}
		text_multi = {
			margin = { 6 0 }
			block "ga_threshold_modifier_eu_spa_visible" {
				visible = "[And(EqualTo_string(MonthlySavedVariable.GetTag, 'gc_european_dominance'), Or(ObjectsEqual(GetGlobalVariable('battle_for_the_strait_winner_country').GetCountry.Self, GetCountry('SPA').Self), ObjectsEqual(GetGlobalVariable('battle_for_the_strait_winner_country').GetCountry.Self, GetCountry('CAS').Self)))]"
			}
			layoutpolicy_horizontal = expanding
			minimumsize = { 420 -1 }
			autoresize = yes
			fontsize_min = 13
			align = left|nobaseline
			block "ga_threshold_modifier_eu_spa_text" {}
		}
		text_multi = {
			margin = { 6 0 }
			block "ga_threshold_modifier_eu_adu_visible" {
				visible = "[And(EqualTo_string(MonthlySavedVariable.GetTag, 'gc_european_dominance'), Not(Or(ObjectsEqual(GetGlobalVariable('battle_for_the_strait_winner_country').GetCountry.Self, GetCountry('SPA').Self), ObjectsEqual(GetGlobalVariable('battle_for_the_strait_winner_country').GetCountry.Self, GetCountry('CAS').Self))))]"
			}
			layoutpolicy_horizontal = expanding
			minimumsize = { 420 -1 }
			autoresize = yes
			fontsize_min = 13
			align = left|nobaseline
			block "ga_threshold_modifier_eu_adu_text" {}
		}
		text_multi = {
			margin = { 6 0 }
			block "ga_threshold_modifier_col_spa_visible" {
				visible = "[And(EqualTo_string(MonthlySavedVariable.GetTag, 'gc_colonial_dominance'), Or(ObjectsEqual(GetGlobalVariable('battle_for_the_strait_winner_country').GetCountry.Self, GetCountry('SPA').Self), ObjectsEqual(GetGlobalVariable('battle_for_the_strait_winner_country').GetCountry.Self, GetCountry('CAS').Self)))]"
			}
			layoutpolicy_horizontal = expanding
			minimumsize = { 420 -1 }
			autoresize = yes
			fontsize_min = 13
			align = left|nobaseline
			block "ga_threshold_modifier_col_spa_text" {}
		}
		text_multi = {
			margin = { 6 0 }
			block "ga_threshold_modifier_col_adu_visible" {
				visible = "[And(EqualTo_string(MonthlySavedVariable.GetTag, 'gc_colonial_dominance'), Not(Or(ObjectsEqual(GetGlobalVariable('battle_for_the_strait_winner_country').GetCountry.Self, GetCountry('SPA').Self), ObjectsEqual(GetGlobalVariable('battle_for_the_strait_winner_country').GetCountry.Self, GetCountry('CAS').Self))))]"
			}
			layoutpolicy_horizontal = expanding
			minimumsize = { 420 -1 }
			autoresize = yes
			fontsize_min = 13
			align = left|nobaseline
			block "ga_threshold_modifier_col_adu_text" {}
		}
	}
}

template gc_action_effects_list {
	TooltipConditionList = {
		visible = "[ConditionList.HasItems]"
		blockoverride "block_title" { text = "game_concept_effects" }
		datacontext = "[StringToConditionListOnlyPassedAndNeutral(UIAction.GetEffects)]"
	}
}

template GoldenCenturyDominance_Tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "[MonthlySavedVariable.GetName]"
		}
		blockoverride "concept_link" {
			text = "[situation|e]"
		}
		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				blockoverride "text" {
					text = "GC_CURRENT_DOMINANCE"
				}
			}
			TooltipScrolledStringPairList = {
				visible = "[And(Not(MonthlySavedVariable.IsMonthlyChangeHidden), Not(StringIsEmpty(MonthlySavedVariable.GetMonthlyChangeBreakdown(SituationView.GetActiveSituation.GetBaseClass))))]"
				blockoverride "block_scrollarea" { maximumsize = { -1 450 } }
				blockoverride "block_title" {
					text = "GC_DOMINANCE_MONTHLY_CHANGE_TITLE"
				}
				textcontext = "[MonthlySavedVariable.GetMonthlyChangeBreakdown(SituationView.GetActiveSituation.GetBaseClass)]"
			}
			TooltipScrolledStringPairList = {
				visible = "[EqualTo_string(MonthlySavedVariable.GetTag, 'gc_european_dominance')]"
				blockoverride "block_scrollarea" { maximumsize = { -1 450 } }
				textcontext = "[Localize('GC_EUROPEAN_DOMINANCE_SOURCES')]"
			}
			TooltipScrolledStringPairList = {
				visible = "[EqualTo_string(MonthlySavedVariable.GetTag, 'gc_colonial_dominance')]"
				blockoverride "block_scrollarea" { maximumsize = { -1 450 } }
				textcontext = "[Localize('GC_COLONIAL_DOMINANCE_SOURCES')]"
			}
			TooltipTextBlock = {
				blockoverride "text" {
					text = "[MonthlySavedVariable.GetDesc]"
				}
			}
			block "gc_dominance_tooltip_extra" {}
		}
	}
}

types GoldenCenturyTypes {
	type GoldenCenturyThresholdMarker = widget {
		block "gc_threshold_marker_size" {
			size = { 34 34 }
		}

		icon = {
			size = { 100% 100% }
			parentanchor = center
			texture = "gfx/interface/progressbars/empty_circle_bg.dds"
			texture_density = 2
			alpha = 0.6
		}
		icon = {
			size = { 100% 100% }
			parentanchor = center
			texture = "gfx/interface/progressbars/yellow_circle_bg.dds"
			texture_density = 2
			block "gc_marker_lit" {}
		}
		hbox = {
			parentanchor = center

			expand = {}
			text_single = {
				align = center|nobaseline
				fontsize = 11
				default_format = "#header_titles"
				block "gc_marker_pct" {}
			}
			text_single = {
				align = center|nobaseline
				fontsize = 9
				default_format = "#header_titles"
				raw_text = "%"
			}
			expand = {}
		}
	}

	type GoldenCenturyUnlockRow = hbox {
		layoutpolicy_horizontal = expanding
		spacing = 6
		margin = { 4 2 }
		icon = {
			size = { 24 24 }
			texture = "[GenericAction.GetIcon]"
		}
		text_single = {
			autoresize = yes
			align = left|nobaseline
			text = "[GenericAction.GetNameWithNoTooltip]"
		}
		expand = {}
	}

	type GoldenCenturyThresholdMarker25 = GoldenCenturyThresholdMarker {
		blockoverride "gc_marker_pct" { raw_text = "25" }
		blockoverride "gc_marker_lit" {
			visible = "[GreaterThanOrEqualTo_CFixedPoint(SituationView.GetActiveSituation.GetVariable(MonthlySavedVariable.GetTag), '(CFixedPoint)25')]"
		}
		tooltipwidget = {
			ContextualTooltipType = {
				blockoverride "title_icon_texture" { texture = "[SituationView.GetActiveSituation.GetIcon]" }
				blockoverride "title_text" { text = "[MonthlySavedVariable.GetName]" }
				blockoverride "concept_link" { text = "[situation|e]" }
				blockoverride "tooltip_content" {
					TooltipTextBlock = { blockoverride "text" { text = "GC_THRESHOLD_CURRENT" } }
					TooltipListBase = {
						blockoverride "block_title" {
							text = "GC_THRESHOLD_UNLOCKS"
						}
						vbox = {
							layoutpolicy_horizontal = expanding
							visible = "[EqualTo_string(MonthlySavedVariable.GetTag, 'gc_european_dominance')]"
							GoldenCenturyUnlockRow = {
								visible = "[Not(Or(ObjectsEqual(GetGlobalVariable('battle_for_the_strait_winner_country').GetCountry.Self, GetCountry('SPA').Self), ObjectsEqual(GetGlobalVariable('battle_for_the_strait_winner_country').GetCountry.Self, GetCountry('CAS').Self)))]"
								datacontext = "[GetGenericAction('invoke_ummayad_legacy')]"
							}
							GoldenCenturyUnlockRow = {
								visible = "[Or(ObjectsEqual(GetGlobalVariable('battle_for_the_strait_winner_country').GetCountry.Self, GetCountry('SPA').Self), ObjectsEqual(GetGlobalVariable('battle_for_the_strait_winner_country').GetCountry.Self, GetCountry('CAS').Self))]"
								datacontext = "[GetGenericAction('spa_edict_expulsion')]"
							}
						}
						vbox = {
							layoutpolicy_horizontal = expanding
							visible = "[EqualTo_string(MonthlySavedVariable.GetTag, 'gc_colonial_dominance')]"
							GoldenCenturyUnlockRow = {
								visible = "[Not(Or(ObjectsEqual(GetGlobalVariable('battle_for_the_strait_winner_country').GetCountry.Self, GetCountry('SPA').Self), ObjectsEqual(GetGlobalVariable('battle_for_the_strait_winner_country').GetCountry.Self, GetCountry('CAS').Self)))]"
								datacontext = "[GetGenericAction('adu_charter_saharan_trade_house')]"
							}
							GoldenCenturyUnlockRow = {
								visible = "[Or(ObjectsEqual(GetGlobalVariable('battle_for_the_strait_winner_country').GetCountry.Self, GetCountry('SPA').Self), ObjectsEqual(GetGlobalVariable('battle_for_the_strait_winner_country').GetCountry.Self, GetCountry('CAS').Self))]"
								datacontext = "[GetGenericAction('spa_increase_capital_market_demands')]"
							}
						}
					}
					using = ga_threshold_modifier_reward
					blockoverride "ga_threshold_modifier_eu_spa_text" { text = "as_long_as_we_remain_at_25_european_dominance_rising_iberian_power_modifier_tt" }
					blockoverride "ga_threshold_modifier_eu_adu_text" { text = "as_long_as_we_remain_at_25_european_dominance_restoration_of_al_andalus_modifier_tt" }
					blockoverride "ga_threshold_modifier_col_spa_text" { text = "as_long_as_we_remain_at_25_colonial_dominance_market_dominance_modifier_tt" }
					blockoverride "ga_threshold_modifier_col_adu_text" { text = "as_long_as_we_remain_at_25_colonial_dominance_wealth_sahel_modifier_tt" }
					using = ga_threshold_bonus_list
					blockoverride "ga_threshold_bonus_list_eu_text" {
						text = "ga_eu_25_bonus_tt" 
					}
					blockoverride "ga_threshold_bonus_list_col_text" {
						text = "ga_col_25_bonus_tt" 
					}
				}
			}
		}
	}

