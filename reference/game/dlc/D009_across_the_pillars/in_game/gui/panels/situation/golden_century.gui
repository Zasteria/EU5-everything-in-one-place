	type GoldenCenturyMemberCard = widget {
		layoutpolicy_horizontal = expanding
		size = { -1 30 }
		using = bg_paper_card
		using = bg_cabinet_card_frame

		hbox = {
			layoutpolicy_horizontal = expanding
			margin = { 2 4 }
			margin_right = 4
			spacing = 3

			country_flag_very_small = {
				tooltipwidget = { using = CountryTooltip }
			}

			expand = {}

			hbox = {
				tooltipwidget = { using = ArmyOverview_tooltip }
				text_single = {
					autoresize = yes
					maximumsize = { 100 -1 }
					align = right
					fontsize = 13
					raw_text = "[Country.GetRaisedAndPotentialLevyStrength] @levy! / [Country.GetRegularArmySize|0L] @regular!"
				}
			}

			hbox = {
				spacing = 3
				tooltipwidget = {
					SimpleContextualStringPairTooltipType = {
						blockoverride "title_icon_texture" { texture = "gfx/interface/icons/flat_icons/military.dds" }
						blockoverride "tooltip_title_text" { text = "[military_strength]" }
						blockoverride "concept_link" { text = "[military_strength|e]" }
						lowpriotextcontext = "[Country.GetMilitaryStrengthForRelativePowerTooltip]"
					}
				}
				text_single = {
					autoresize = yes
					maximumsize = { 24 -1 }
					fontsize = 13
					default_format = "#yellow_titles"
					text = "[Country.GetMilitaryStrength|1]"
				}
				icon = {
					size = { 16 16 }
					using = military_texture
				}
			}
		}
	}
}

situation_panel = {

	blockoverride "situation_start_date" {
		icon = {
			parentanchor = top|hcenter
			texture = "gfx/interface/component_tiles/regular_banner.dds"
			size = { 175 48 }
			texture_density = 2
			spriteType = corneredstretched
            spriteborder = { 20 0 }
			vbox = {
				layoutpolicy_horizontal = expanding
				maximumsize = {170 38}
				parentanchor = top|hcenter
				text_single = {
					layoutpolicy_horizontal = expanding
					align = center
					raw_text = "[Localize('SITUATION_LATERAL_VIEW_START_DATE_HEADER')] - [Localize('SITUATION_LATERAL_VIEW_END_DATE_HEADER')]"
					default_format = "#subtle_name"
				}
	
				text_single = {
					layoutpolicy_horizontal = expanding
					align = center
					fontsize = 13
					raw_text = "[SituationView.GetActiveSituation.GetStartDate] - [SituationView.GetActiveSituation.GetStartDatePlusYears('(int32)100')]"
				}
			}
		}
	}

	##################################### MAIN IMAGE #####################################
	blockoverride "situation_panel_image" {
		datacontext = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('gc_winner_country').GetCountry]"
		using = one_country_header_template
		blockoverride "one_country_header_background" {
			background = {
				visible = "[And(Country.IsValid, Not(Or(ObjectsEqual(Country.Self, GetCountry('MOR').Self), Or(ObjectsEqual(Country.Self, GetCountry('GRA').Self), ObjectsEqual(Country.Self, GetCountry('ADU').Self)))))]"
				texture = "gfx/interface/illustrations/situation/golden_century_castile.dds"
				modify_texture = {
					using = bg_mask_fade_horizontal_middle_texture
					texture_density = 2
					spriteType = stretched
					spriteborder = { 250 250 }
					blend_mode = alphamultiply
					alpha = 0.4
				}
			}
			background = {
				visible = "[And(Country.IsValid, ObjectsEqual(Country.Self, GetCountry('MOR').Self))]"
				texture = "gfx/interface/illustrations/situation/golden_century_morocco.dds"
				modify_texture = {
					using = bg_mask_fade_horizontal_middle_texture
					texture_density = 2
					spriteType = stretched
					spriteborder = { 250 250 }
					blend_mode = alphamultiply
					alpha = 0.4
				}
			}
			background = {
				visible = "[And(Country.IsValid, Or(ObjectsEqual(Country.Self, GetCountry('GRA').Self), ObjectsEqual(Country.Self, GetCountry('ADU').Self)))]"
				texture = "gfx/interface/illustrations/situation/golden_century_granada.dds"
				modify_texture = {
					using = bg_mask_fade_horizontal_middle_texture
					texture_density = 2
					spriteType = stretched
					spriteborder = { 250 250 }
					blend_mode = alphamultiply
					alpha = 0.4
				}
			}
		}


		blockoverride "character_portrait_anchor" {
			parentanchor = bottom|left
		}
		blockoverride "character_religion_visibility" {
			visible = no
		}
		blockoverride "character_name_maximumsize" {
			maximumsize = { 270 -1 }
		}
		blockoverride "country_header_extra" {
			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				margin = { 10 10 }
				spacing = 8
				expand = {}
			}
		}
	}

	##################################### TOP SUBHEADER #####################################
	blockoverride "situation_panel_main_actions" {}
	blockoverride "situation_top_subheader_content" {
		hbox = {
			visible = no
			layoutpolicy_horizontal = expanding
			margin = { 36 0 }
			spacing = 10

			# ===================== COLONIAL DOMINANCE =====================
			hbox = {
				layoutpolicy_horizontal = expanding
				maximumsize = { 190 -1 }
				spacing = 6
				visible = "[SituationView.GetActiveSituation.HasVariable('gc_colonial_dominance')]"
				datacontext = "[SituationView.GetActiveSituation.GetVariableSpec('gc_colonial_dominance')]"

				widget = {
					size = { 38 38 }

					tooltipwidget = {
						using = GoldenCenturyDominance_Tooltip
						blockoverride "title_icon_texture" { texture = "gfx/interface/icons/situations/gc_colonial_dominance.dds" }
					}

					piechart = {
						size = { 100% 100% }
						parentanchor = center
						using = piechart_angles
						using = bg_circle_piechart

						pieslice_no_highlight = {
							using = bg_pie_chart_alpha_80_texture
							value = "[FixedPointToFloat(SituationView.GetActiveSituation.GetVariable('gc_colonial_dominance'))]"
							using = color_value_progress_blue
						}
						pieslice_no_highlight = {
							using = bg_pie_chart_alpha_80_texture
							value = "[Subtract_float('(float)100.0', FixedPointToFloat(SituationView.GetActiveSituation.GetVariable('gc_colonial_dominance')))]"
							using = color_value_progress_gray
						}

						icon = {
							size = { 60% 60% }
							parentanchor = center
							using = gc_colonial_dominance_texture
						}
					}
				}

				vbox = {
					spacing = 2

					text_single = {
						autoresize = yes
						fontsize = 15
						text = "[MonthlySavedVariable.GetName]"
					}
					text_single = {
						layoutpolicy_horizontal = expanding
						autoresize = yes
						align = left
						fontsize = 15
						default_format = "#yellow_titles"
						text = "[SituationView.GetActiveSituation.GetVariableText(MonthlySavedVariable.Self)]"
					}
				}
			}

			expand = {}

			# ===================== NEXT FLASHPOINT =====================
			widget = {
				size = { 40 40 }
				visible = "[SituationView.GetActiveSituation.HasVariable('gc_flashpoint_meter')]"
				datacontext = "[SituationView.GetActiveSituation.GetVariableSpec('gc_flashpoint_meter')]"

				tooltipwidget = {
					using = GoldenCenturyDominance_Tooltip
					blockoverride "title_icon_texture" { texture = "gfx/interface/icons/situations/flashpoint.dds" }
					blockoverride "gc_dominance_tooltip_extra" {
						TooltipTextBlock = {
							blockoverride "text" {
								text = "gc_flashpoint_meter_at_max_tt"
							}
						}
					}
				}

				piechart = {
					size = { 100% 100% }
					parentanchor = center
					using = piechart_angles
					using = bg_circle_piechart

					pieslice_no_highlight = {
						using = bg_pie_chart_alpha_80_texture
						value = "[FixedPointToFloat(SituationView.GetActiveSituation.GetVariable('gc_flashpoint_meter'))]"
						color = { 0.94 0.8 0.36 1 }
					}
					pieslice_no_highlight = {
						using = bg_pie_chart_alpha_80_texture
						value = "[Subtract_float('(float)100.0', FixedPointToFloat(SituationView.GetActiveSituation.GetVariable('gc_flashpoint_meter')))]"
						using = color_value_progress_gray
					}

					icon = {
						size = { 55% 55% }
						parentanchor = center
						using = flashpoint_texture
					}
				}
			}

			expand = {}

			# ===================== EUROPEAN DOMINANCE =====================
			hbox = {
				layoutpolicy_horizontal = expanding
				maximumsize = { 190 -1 }
				spacing = 6
				visible = "[SituationView.GetActiveSituation.HasVariable('gc_european_dominance')]"
				datacontext = "[SituationView.GetActiveSituation.GetVariableSpec('gc_european_dominance')]"

				vbox = {
					spacing = 2

					text_single = {
						autoresize = yes
						fontsize = 15
						align = right
						text = "[MonthlySavedVariable.GetName]"
					}
					text_single = {
						layoutpolicy_horizontal = expanding
						autoresize = yes
						fontsize = 15
						align = right
						default_format = "#yellow_titles"
						text = "[SituationView.GetActiveSituation.GetVariableText(MonthlySavedVariable.Self)]"
					}
				}

				widget = {
					size = { 38 38 }

					tooltipwidget = {
						using = GoldenCenturyDominance_Tooltip
						blockoverride "title_icon_texture" { texture = "gfx/interface/icons/situations/gc_european_dominance.dds" }
					}

					piechart = {
						size = { 100% 100% }
						parentanchor = center
						using = piechart_angles
						using = bg_circle_piechart

						pieslice_no_highlight = {
							using = bg_pie_chart_alpha_80_texture
							value = "[FixedPointToFloat(SituationView.GetActiveSituation.GetVariable('gc_european_dominance'))]"
							using = color_value_progress_red
						}
						pieslice_no_highlight = {
							using = bg_pie_chart_alpha_80_texture
							value = "[Subtract_float('(float)100.0', FixedPointToFloat(SituationView.GetActiveSituation.GetVariable('gc_european_dominance')))]"
							using = color_value_progress_gray
						}

						icon = {
							size = { 60% 60% }
							parentanchor = center
							using = gc_european_dominance_texture
						}
					}
				}
			}
		}
	}

