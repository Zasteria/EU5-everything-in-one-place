	#End Requirements
	blockoverride "situation_panel_outcome_list_spacing" {
		spacing = 5
	}
	blockoverride "situation_panel_outcomes_card_size" {
		minimumsize = { 410 -1 }
		maximumsize = { 410 -1 }
	}
	blockoverride "situation_panel_outcome_item_size" {
		minimumsize = { 360 -1 }
		maximumsize = { 360 -1 }
	}
	blockoverride "situation_panel_outcome_hint" {
		action_tooltip = {
			title = "OPEN_HINT"
			on_action = "[OpenLateralViewWithParams('hints', 'selected_hint = hint_golden_century')]"
		}
	}
	
	blockoverride "situation_panel_main_content" {
		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 5
			margin = { 50 0 }
			margin_top = 12
			ignoreinvisible = yes


			vbox = {
				layoutpolicy_horizontal = expanding

				minimumsize = { -1 220 }
				maximumsize = { -1 220 }
				visible = "[GetUniqueInternationalOrganization('grand_alliance').Exists]"
				using = bg_paper_card
				using = bg_cabinet_card_frame
				datacontext = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('gc_winner_country').GetCountry]"

				widget = {
					layoutpolicy_horizontal = expanding
					size = { -1 41 }

					hbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						spacing = 20
						margin = { 5 0 }
						margin_top = 5

						header_button_left = {
							layoutpolicy_horizontal = expanding
							size = { -1 36 }
							datacontext = "[GetUniqueInternationalOrganization('grand_alliance').GetTarget]"
							enabled = "[GetUniqueInternationalOrganization('grand_alliance').Exists]"

							action_tooltip = {
								click_type = left
								title = "GC_OPEN_COUNTRY_DIPLOMACY"
								using = snd_UI_alert_openAndCycle
								on_action = "[OpenDiplomacy(Country.Self)]"
							}

							tooltipwidget = { BasicFunctionalTooltip = {} }

							blockoverride "header_button_icon_size" {}
							blockoverride "header_button_icon_obj" {}
							blockoverride "header_button_frame_inner" { visible = no }

							blockoverride "header_button_text_layout" {
								background = {
									using = color_dark_green_texture
									margin = { -2 -2 }
								}
								
								hbox = {
									layoutpolicy_horizontal = expanding
									margin = { 10 0 }
									margin_right = 15
									spacing = 5
									country_flag_very_small = {}

									text_single = {
										layoutpolicy_horizontal = expanding
										fontsize = 15
										minimumsize = { -1 20 }
										autoresize = no
										align = left
										text = "gc_our_coalition"
									}

									expand = {}

									text_single = {
										fontsize = 15
										autoresize = yes
										align = left
										raw_text = "[GetDataModelSize(SituationView.GetSubjectsAndAllies(Country.Self))]"
									}
								}
							}
						}

						header_button_left = {
							layoutpolicy_horizontal = expanding
							size = { -1 36 }
							datacontext = "[GetUniqueInternationalOrganization('grand_alliance')]"
							enabled = "[GetUniqueInternationalOrganization('grand_alliance').Exists]"

							action_tooltip = {
								click_type = left
								title = "OPEN_IO"
								using = snd_UI_alert_openAndCycle
								on_action = "[OpenInternationalOrganizationView(InternationalOrganization.Self)]"
							}

							tooltipwidget = { BasicFunctionalTooltip = {} }

							blockoverride "header_button_icon_size" {}
							blockoverride "header_button_icon_obj" {}
							blockoverride "header_button_frame_inner" { visible = no }

							blockoverride "header_button_text_layout" {
								background = {
									using = bg_red_bckg_texture
									margin = { -2 -2 }
								}

								hbox = {
									layoutpolicy_horizontal = expanding
									margin = { 10 0 }
									margin_left = 15
									spacing = 5

									icon = {
										size = { 20 20 }
										texture = "[InternationalOrganization.GetIcon]"
										texture_density = 2
									}

									text_single = {
										layoutpolicy_horizontal = expanding
										fontsize = 15
										minimumsize = { -1 20 }
										autoresize = no
										align = left
										text = "[InternationalOrganization.GetNameWithNoTooltip]"
									}

									text_single = {
										fontsize = 15
										autoresize = yes
										align = left
										raw_text = "[GetDataModelSize(InternationalOrganization.GetMembers)]"
									}
								}
							}
						}
					}

					widget = {
						parentanchor = center
						size = { 34 34 }
						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "title_icon_texture" { texture = "gfx/interface/icons/flat_icons/military.dds" }
								blockoverride "title_text" { text = "[military_strength]" }
								blockoverride "concept_link" { text = "[military_strength|e]" }
								blockoverride "tooltip_content" {
									TooltipManualTableField = {
										blockoverride "field_content" {
											margin = { 10 0 }
											spacing = 10
											widget = {
												size = { 12 12 }
												background = { using = color_dark_green_texture }
											}
											text_single = {
												autoresize = yes
												align = nobaseline
												text = "gc_our_coalition"
											}
											expand = {}
											text_single = {
												autoresize = yes
												align = nobaseline
												default_format = "#yellow_titles"
												raw_text = "[Country.GetDiplomacy.GetCoalitionArmyStrength|1]"
											}
										}
									}
									TooltipManualTableField = {
										blockoverride "field_content" {
											margin = { 10 0 }
											spacing = 10
											widget = {
												size = { 12 12 }
												background = { using = color_dark_red_texture }
											}
											text_single = {
												autoresize = yes
												align = nobaseline
												text = "[GetUniqueInternationalOrganization('grand_alliance').GetNameWithNoTooltip]"
											}
											expand = {}
											text_single = {
												autoresize = yes
												align = nobaseline
												default_format = "#yellow_titles"
												raw_text = "[GetUniqueInternationalOrganization('grand_alliance').GetTotalMilitaryStrength|1]"
											}
										}
									}
								}
							}
						}
						piechart = {
							size = { 100% 100% }
							parentanchor = center
							using = piechart_angles
							using = bg_circle_piechart
							
							pieslice_no_highlight = {
								using = bg_pie_chart_alpha_80_texture
								value = "[FixedPointToFloat(GetUniqueInternationalOrganization('grand_alliance').GetTotalMilitaryStrength)]"
								color = { 0.70 0.13 0.13 1 }
							}
							pieslice_no_highlight = {
								using = bg_pie_chart_alpha_80_texture
								value = "[FixedPointToFloat(Country.GetDiplomacy.GetCoalitionArmyStrength)]"
								color = { 0.25 0.55 0.28 1 }
							}

							icon = {
								size = { 70% 70% }
								parentanchor = center
								using = military_texture
							}
						}
					}
				}

				widget = {
					layoutpolicy_horizontal = expanding
					size = { -1 172 }

					hbox = {
						layoutpolicy_horizontal = expanding
