				margin_top = 20
				text = "gc_main_actions"
				fontsize = 20

			}

			##################################### FRAMING COLUMNS #####################################
			##Actions
			hbox = {
				using = layoutpolicy_expanding
				spacing = 10
				vbox = {
					using = layoutpolicy_expanding
					spacing = 8
					margin_top = 35
					datacontext = "[SituationView.GetActiveSituation.GetVariableSpec('gc_colonial_dominance')]"
					datacontext = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('gc_winner_country').GetCountry]"
					GoldenCenturyActionBanner = {
						datacontext = "[GetGenericAction('spa_seize_colony')]"
						visible = "[Or(ObjectsEqual(Country.Self, GetCountry('SPA').Self), ObjectsEqual(Country.Self, GetCountry('CAS').Self))]"
						blockoverride "gc_banner_text" { text = "[GetGenericAction('spa_seize_colony').GetNameWithNoTooltip]" }
						blockoverride "gc_banner_tooltip" {
							tooltipwidget = {
								ContextualTooltipType = {
									blockoverride "title_icon_texture" { texture = "[GenericAction.GetIcon]" }
									blockoverride "title_text" { text = "[GetGenericAction('spa_seize_colony').GetNameWithNoTooltip]" }
									blockoverride "concept_link" { text = "[action|E]" }
									blockoverride "tooltip_content" {
										TooltipTextBlock = { blockoverride "text" { text = "spa_seize_colony_desc" } }
										using = gc_action_effects_list
									}
								}
							}
						}
						blockoverride "gc_banner_action_overlay" {
							scripted_action_tooltip = {
								click_type = left
								click_mode = confirm
								action_name = "spa_seize_colony"
								actor = "[SituationView.GetPlayer]"
								parameter = {
									parameter_name = "recipient"
