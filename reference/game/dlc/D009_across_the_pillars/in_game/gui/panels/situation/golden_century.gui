						datacontext = "[GetGenericAction('spa_demand_tribute_fleets')]"
						visible = "[Or(ObjectsEqual(Country.Self, GetCountry('SPA').Self), ObjectsEqual(Country.Self, GetCountry('CAS').Self))]"
						blockoverride "gc_banner_text" { text = "[GetGenericAction('spa_demand_tribute_fleets').GetNameWithNoTooltip]" }
						blockoverride "gc_banner_tooltip" {
							tooltipwidget = {
								ContextualTooltipType = {
									blockoverride "title_icon_texture" { texture = "[GenericAction.GetIcon]" }
									blockoverride "title_text" { text = "[GetGenericAction('spa_demand_tribute_fleets').GetNameWithNoTooltip]" }
									blockoverride "concept_link" { text = "[action|E]" }
									blockoverride "tooltip_content" {
										TooltipTextBlock = { blockoverride "text" { text = "spa_demand_tribute_fleets_desc" } }
										using = gc_action_effects_list
									}
								}
							}
						}
						blockoverride "gc_banner_action_overlay" {
							scripted_action_tooltip = {
								click_type = left
								click_mode = confirm
								action_name = "spa_demand_tribute_fleets"
