									visible = "[Not(GetCountry('GRA').HasVariable('duration_of_enforcing_variable'))]"
								}
								blockoverride "bfts_action_button_icon_active" {
									visible = "[GetCountry('GRA').HasVariable('duration_of_enforcing_variable')]"
								}
								blockoverride "bfts_action_button_action" {
									scripted_action_tooltip = {
										click_type = left
										click_mode = confirm
										actor = "[SituationView.GetPlayer]"
										parameter = {
											parameter_name = "recipient"
											parameter_value = "[SituationView.GetActiveSituation.GetSituation]"
										}
										action_name = "gra_enforce_sovereignty"
									}
								}
							}
							bfts_action_button_granada = {
								datacontext = "[GetGenericAction('attract_andalusi_refugees')]"
								blockoverride "bfts_action_button_action" {
									scripted_action_tooltip = {
										click_type = left
										click_mode = confirm
										actor = "[SituationView.GetPlayer]"
										parameter = {
											parameter_name = "recipient"
											parameter_value = "[SituationView.GetActiveSituation.GetSituation]"
										}
