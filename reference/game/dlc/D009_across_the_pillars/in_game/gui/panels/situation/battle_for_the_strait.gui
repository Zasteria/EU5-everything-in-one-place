	# End Requirements
	blockoverride "situation_panel_main_content_top" {}
	blockoverride "situation_panel_main_content_bottom" {
		using = situation_outcomes
		blockoverride "situation_panel_outcomes_card_size" {
			minimumsize = { 520 -1 }
			maximumsize = { 520 -1 }
		}
		blockoverride "situation_panel_outcomes_header_text" {
			text = "BFTS_NEUTRAL_OUTCOMES_HEADER"
		}
		blockoverride "situation_panel_outcome_list_spacing" {
			spacing = 5
		}
		blockoverride "situation_panel_outcome_list_datamodel" {
			datamodel = "[DataModelSubSpan(SituationView.GetActiveSituation.GetSituation.GetOutcomes, '(int32)3', '(int32)1')]"
		}
		blockoverride "situation_panel_outcome_item_content" {
			TooltipRequirementsList = {
				textcontext = "[ScriptedOutcome.GetSituationConditions(SituationView.GetActiveSituation.GetSituation.Self)]"
			}
		}
	}

    blockoverride "situation_panel_image" {
		background = {
			texture = "[GetSituationIllustration(SituationView.GetActiveSituation.GetSituation)]"
			texture_density = 2
			spriteType = stretched
			spriteborder = { 0 0 }
		}
	}

    blockoverride "situation_subheader_content" {}
