	##################################### MAIN CONTENT #####################################
	blockoverride "situation_panel_autoresize_scroll_area" {
		autoresizeviewport = no

		viewportwidget = {
			widget = {
				size = { 100% 100% }
				scissor = no
			}
		}
	}

	blockoverride "situation_tab_buttons" {}

	blockoverride "situation_panel_main_content_margin" {
		margin = { 2 6 }
	}

	blockoverride "situation_panel_main_content" {
		vbox = {
			layoutpolicy_horizontal = expanding
			allow_outside = yes
			minimumsize = { 536 -1 }
			background = {
				texture = "gfx/interface/component_decoration/situation/battle_for_the_strait_dds/granadian_sovereignity_background.dds"
				spriteType = stretched
			}
			using = bg_cabinet_card_frame
			margin = { 10 8 }
			margin_bottom = 22
			spacing = -130

			widget = {
				ignore_layout = yes
				layoutpolicy_horizontal = expanding
				parentanchor = top|hcenter
				position = { 2 26 }
				size = { 460 190 }
				datacontext = "[SituationView.GetActiveSituation.GetVariableSpec('granadan_sovereignty')]"

				icon = {
					size = { 100% 100% }
					texture = "gfx/interface/component_decoration/situation/battle_for_the_strait_dds/castilla_morocco_frame.dds"
