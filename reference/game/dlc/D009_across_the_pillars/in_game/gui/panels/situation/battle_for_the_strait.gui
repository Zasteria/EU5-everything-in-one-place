						datacontext = "[GetGenericAction('mor_vassalize_granada')]"
						blockoverride "bfts_action_button_action" {
							scripted_action_tooltip = {
								click_type = left
								click_mode = confirm
								actor = "[SituationView.GetPlayer]"
								parameter = {
