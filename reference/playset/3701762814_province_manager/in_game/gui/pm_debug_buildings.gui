window = {
	name = "pm_debug_buildings_window"
	size = { 1380 650 }
	parentanchor = center
	movable = yes
	visible = "[GetVariableSystem.Exists('pm_debug_open')]"
	layer = windows_layer

	datacontext = "[GetPlayer.MakeScope.Var('pm_debug_location').GetLocation]"

	using = bg_main_inner_alt

	vbox = {
		margin = { 10 10 }
		spacing = 5

		# Title bar
		hbox = {
			layoutpolicy_horizontal = expanding
			minimumsize = { -1 30 }

			background = {
				using = tile_background_squared_texture
				modify_texture = {
					using = color_dark_brown_texture
				}
			}

			margin = { 10 0 }

			text_single = {
				text = "PM_DBG_TITLE"
			}

			expand = {}

			text_single = {
				text = "PM_DBG_SELECTED"
				fontsize = 13
				margin_right = 10
			}

			button_close_alt = {
				size = { 30 30 }
				blockoverride "close_properties" {}
				onclick = "[GetVariableSystem.Clear('pm_debug_open')]"
				blockoverride "close_inputaction" {
					input_action = "close_window"
					use_global_input_instance = yes
				}
			}
		}

		# Two panels side by side
		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			spacing = 5

			### LEFT PANEL — Existing buildings ###
			vbox = {
				layoutpolicy_vertical = expanding
				layoutpolicy_horizontal = expanding

				# Section header
				hbox = {
					layoutpolicy_horizontal = expanding
					minimumsize = { -1 24 }

					background = {
						using = tile_background_squared_texture
						modify_texture = {
							using = color_dark_brown_texture
							alpha = 0.6
						}
					}

					margin = { 5 0 }
					text_single = {
						text = "PM_DBG_BUILT"
						fontsize = 12
					}
				}

				# Column headers
				hbox = {
					layoutpolicy_horizontal = expanding
					minimumsize = { -1 22 }

					widget = {
						size = { 30 22 }
						text_single = {
							parentanchor = vcenter
							size = { 30 -1 }
							raw_text = "#L ##!#!"
							fontsize = 10
							align = right|nobaseline
						}
					}
					widget = { size = { 26 22 } }
					widget = {
						size = { 160 22 }
						text_single = {
							parentanchor = vcenter
							text = "PM_DBG_COL_BUILDING"
							fontsize = 10
						}
					}
					widget = {
						size = { 55 22 }
						text_single = {
							parentanchor = vcenter
							size = { 55 -1 }
							text = "PM_DBG_COL_PROFIT"
							fontsize = 10
							align = right|nobaseline
						}
					}
					widget = {
						size = { 55 22 }
						text_single = {
							parentanchor = vcenter
							size = { 55 -1 }
							text = "PM_DBG_COL_INCOME"
							fontsize = 10
							align = right|nobaseline
						}
					}
					widget = {
						size = { 80 22 }
						text_single = {
							parentanchor = vcenter
							size = { 80 -1 }
							text = "PM_DBG_COL_LEVEL"
							fontsize = 10
							align = center|nobaseline
						}
					}
					widget = {
						size = { 55 22 }
					}
				}

				# Scrollable list
				scrollarea = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					scrollbarpolicy_horizontal = always_off
					autoresizeviewport = yes

					viewportwidget = {
						widget = { scissor = yes }
					}

					scrollbar_vertical = {
						using = Scrollbar_Vertical
					}

					scrollwidget = {
						fixedgridbox = {
							addcolumn = 580
							addrow = 26
							setitemsizefromcell = yes
							datamodel = "[Location.MakeScope.GetList('pm_valid_buildings')]"

							item = {
								widget = {
									size = { 580 26 }
									using = bg_scroll_card

									hbox = {
										widget = {
											size = { 30 26 }
											text_single = {
												parentanchor = vcenter
												size = { 30 -1 }
												align = right|nobaseline
												raw_text = "#L [Add_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)1')]#!"
												fontsize = 11
											}
										}

										widget = {
											size = { 26 26 }
											icon = {
												parentanchor = center
												size = { 22 22 }
												texture = "[GetBuildingIcon(Scope.Building.GetType)]"
											}
										}

										widget = {
											size = { 160 26 }
											text_single = {
												parentanchor = vcenter
												size = { 160 -1 }
												autoresize = no
												raw_text = "[Scope.Building.GetName]"
												fontsize = 11
											}
										}

										widget = {
											size = { 55 26 }
											text_single = {
												parentanchor = vcenter
												size = { 55 -1 }
												align = right|nobaseline
												raw_text = "#G +[Scope.Building.GetProfitPerLevel|2]#!"
												fontsize = 11
											}
										}

										widget = {
											size = { 55 26 }
											text_single = {
												parentanchor = vcenter
												size = { 55 -1 }
												align = right|nobaseline
												raw_text = "#Y +[Scope.Building.GetIncomeToOwnerPerLevel|2]#!"
												fontsize = 11
											}
										}

										widget = {
											size = { 80 26 }
											text_single = {
												visible = "[Not(Scope.Building.IsUnderConstruction)]"
												parentanchor = vcenter
												size = { 80 -1 }
												align = center|nobaseline
												raw_text = "[Scope.Building.GetLevel] / [Scope.Building.GetMaxLevel]"
												fontsize = 11
											}
											text_single = {
												visible = "[Scope.Building.IsUnderConstruction]"
												parentanchor = vcenter
												size = { 80 -1 }
												align = center|nobaseline
												raw_text = "#Y [Scope.Building.GetLevel](+[Scope.Building.GetLevelsUnderConstruction|0])#! / [Scope.Building.GetMaxLevel]"
												fontsize = 11
											}
										}

										widget = {
											size = { 55 26 }
											text_single = {
												visible = "[CanBuildOrExpandBuilding(Scope.Building.GetType, Location.Self)]"
												parentanchor = vcenter
												size = { 55 -1 }
												align = center|nobaseline
												text = "PM_DBG_CAN_BUILD"
												fontsize = 10
											}
											text_single = {
												visible = "[Not(CanBuildOrExpandBuilding(Scope.Building.GetType, Location.Self))]"
												parentanchor = vcenter
												size = { 55 -1 }
												align = center|nobaseline
												text = "PM_DBG_CANNOT_BUILD"
												fontsize = 10
											}
										}
									}
								}
							}
						}
					}
				}
			}

			# Vertical divider
			widget = {
				size = { 2 -1 }
				layoutpolicy_vertical = expanding
				background = {
					using = tile_background_squared_texture
					modify_texture = {
						using = color_dark_brown_texture
						alpha = 0.4
					}
				}
			}

			### RIGHT PANEL — New buildings ###
			vbox = {
				layoutpolicy_vertical = expanding
				layoutpolicy_horizontal = expanding

				# Section header
				hbox = {
					layoutpolicy_horizontal = expanding
					minimumsize = { -1 24 }

					background = {
						using = tile_background_squared_texture
						modify_texture = {
							using = color_dark_brown_texture
							alpha = 0.6
						}
					}

					margin = { 5 0 }
					text_single = {
						text = "PM_DBG_NEW_BUILDINGS"
						fontsize = 12
					}
				}

				# Column headers
				hbox = {
					layoutpolicy_horizontal = expanding
					minimumsize = { -1 22 }

					widget = {
						size = { 30 22 }
						text_single = {
							parentanchor = vcenter
							size = { 30 -1 }
							raw_text = "#L ##!#!"
							fontsize = 10
							align = right|nobaseline
						}
					}
					widget = { size = { 26 22 } }
					widget = {
						size = { 160 22 }
						text_single = {
							parentanchor = vcenter
							text = "PM_DBG_COL_BUILDING"
							fontsize = 10
						}
					}
					widget = {
						size = { 60 22 }
						text_single = {
							parentanchor = vcenter
							size = { 60 -1 }
							text = "PM_DBG_COL_PROFIT"
							fontsize = 10
							align = right|nobaseline
						}
					}
					widget = {
						size = { 60 22 }
						text_single = {
							parentanchor = vcenter
							size = { 60 -1 }
							text = "PM_DBG_COL_INCOME"
							fontsize = 10
							align = right|nobaseline
						}
					}
					widget = {
						size = { 75 22 }
						text_single = {
							parentanchor = vcenter
							size = { 75 -1 }
							text = "PM_DBG_COL_COST"
							fontsize = 10
							align = right|nobaseline
						}
					}
					widget = {
						size = { 120 22 }
						text_single = {
							parentanchor = vcenter
							size = { 120 -1 }
							raw_text = "#L Labor debug#!"
							fontsize = 10
							align = center|nobaseline
						}
					}
				}

				# Scrollable list
				scrollarea = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					scrollbarpolicy_horizontal = always_off
					autoresizeviewport = yes

					viewportwidget = {
						widget = { scissor = yes }
					}

					scrollbar_vertical = {
						using = Scrollbar_Vertical
					}

					scrollwidget = {
						fixedgridbox = {
							addcolumn = 710
							addrow = 26
							setitemsizefromcell = yes
							datamodel = "[Location.MakeScope.GetList('pm_new_buildings')]"

							item = {
								widget = {
									size = { 710 26 }
									using = bg_scroll_card

									hbox = {
										widget = {
											size = { 30 26 }
											text_single = {
												parentanchor = vcenter
												size = { 30 -1 }
												align = right|nobaseline
												raw_text = "#L [Add_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)1')]#!"
												fontsize = 11
											}
										}

										widget = {
											size = { 26 26 }
											icon = {
												parentanchor = center
												size = { 22 22 }
												texture = "[GetBuildingIcon(Scope.BuildingType)]"
											}
										}

										widget = {
											size = { 160 26 }
											text_single = {
												parentanchor = vcenter
												size = { 160 -1 }
												autoresize = no
												raw_text = "[Scope.BuildingType.GetNameWithNoTooltip]"
												fontsize = 11
											}
										}

										widget = {
											size = { 60 26 }
											# Positive profit
											text_single = {
												visible = "[GreaterThan_CFixedPoint(GetBuildingTypePotentialProfitInLocation(Scope.BuildingType, Location.Self), '(CFixedPoint)0')]"
												parentanchor = vcenter
												size = { 60 -1 }
												align = right|nobaseline
												raw_text = "#G +[GetBuildingTypePotentialProfitInLocation(Scope.BuildingType, Location.Self)|2]#!"
												fontsize = 11
											}
											# Zero or negative profit
											text_single = {
												visible = "[Not(GreaterThan_CFixedPoint(GetBuildingTypePotentialProfitInLocation(Scope.BuildingType, Location.Self), '(CFixedPoint)0'))]"
												parentanchor = vcenter
												size = { 60 -1 }
												align = right|nobaseline
												raw_text = "#R [GetBuildingTypePotentialProfitInLocation(Scope.BuildingType, Location.Self)|2]#!"
												fontsize = 11
											}
										}

										widget = {
											size = { 60 26 }
											# Positive income
											text_single = {
												visible = "[GreaterThan_CFixedPoint(GetBuildingTypeIncomeToOwnerInLocation(Scope.BuildingType, Location.Self), '(CFixedPoint)0')]"
												parentanchor = vcenter
												size = { 60 -1 }
												align = right|nobaseline
												raw_text = "#Y +[GetBuildingTypeIncomeToOwnerInLocation(Scope.BuildingType, Location.Self)|3]#!"
												fontsize = 11
											}
											# Zero or negative income
											text_single = {
												visible = "[Not(GreaterThan_CFixedPoint(GetBuildingTypeIncomeToOwnerInLocation(Scope.BuildingType, Location.Self), '(CFixedPoint)0'))]"
												parentanchor = vcenter
												size = { 60 -1 }
												align = right|nobaseline
												raw_text = "#R [GetBuildingTypeIncomeToOwnerInLocation(Scope.BuildingType, Location.Self)|3]#!"
												fontsize = 11
											}
										}

										widget = {
											size = { 75 26 }
											text_single = {
												parentanchor = vcenter
												size = { 75 -1 }
												align = right|nobaseline
												raw_text = "[GetBuildOrExpandBuildingCostValue(Scope.BuildingType, Location.Self)]"
												fontsize = 11
											}
										}

										widget = {
											size = { 120 26 }
											# HasLacking = false → green OK
											text_single = {
												visible = "[Not(HasLackingPopsFromBuildingType(Scope.BuildingType, Location.Self))]"
												parentanchor = vcenter
												size = { 120 -1 }
												align = center|nobaseline
												raw_text = "#G OK#! [GetUnEmployedFromBuildingType(Scope.BuildingType, Location.Self)]"
												fontsize = 10
											}
											# HasLacking = true → red LACK
											text_single = {
												visible = "[HasLackingPopsFromBuildingType(Scope.BuildingType, Location.Self)]"
												parentanchor = vcenter
												size = { 120 -1 }
												align = center|nobaseline
												raw_text = "#R LACK#! -[GetLackingPopsFromBuildingType(Scope.BuildingType, Location.Self)]"
												fontsize = 10
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
