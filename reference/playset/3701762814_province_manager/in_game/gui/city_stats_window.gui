window = {
	name = "city_stats_window"
	size = { 100% 100% }
	parentanchor = center
	layer = confirmation
	movable = no
	alwaystransparent = yes
	visible = "[GetVariableSystem.Exists('pm_city_stats_open')]"

	state = {
		name = _show
		trigger_on_create = yes
		on_finish = "[GetVariableSystem.Set('pm_city_stats_open', 'yes')]"
	}

	widget = {
		size = { 100% 100% }
		parentanchor = center
		alwaystransparent = no

		using = bg_main_inner_alt

		vbox = {
			using = layoutpolicy_expanding
			margin = { 40 20 }

			# Header
			hbox = {
				layoutpolicy_horizontal = expanding
				margin = { 10 5 }

				window_header_alt = {
					blockoverride "header_text" {
						text = "PM_CITY_STATS"
					}
					blockoverride "window_header_alt_color_texture" {
						using = color_default_brown_texture
					}
				}

				button_close_alt = {
					size = { 30 30 }
					blockoverride "close_properties" {}
					onclick = "[GetVariableSystem.Clear('pm_city_stats_open')]"
				}
			}

			# Column headers
			hbox = {
				layoutpolicy_horizontal = expanding
				margin = { 10 3 }
				using = bg_paper_card

				text_single = { size = { 200 25 } text = "PM_COL_PROVINCE" align = left|nobaseline margin_left = 5 }
				text_single = { size = { 100 25 } text = "PM_COL_POPULATION" align = center|nobaseline }
				text_single = { size = { 60 25 } text = "PM_COL_LOCS" align = center|nobaseline }
				text_single = { size = { 80 25 } text = "PM_COL_AVG_DEV" align = center|nobaseline }
				text_single = { size = { 80 25 } text = "PM_COL_AVG_CTRL" align = center|nobaseline }
				text_single = { size = { 80 25 } text = "PM_COL_FOOD" align = center|nobaseline }
				text_single = { size = { 100 25 } text = "PM_COL_INTEGRATION" align = center|nobaseline }
				text_single = { size = { 100 25 } text = "PM_COL_SATISFACTION" align = center|nobaseline }
			}

			# Province list
			scrollarea = {
				using = layoutpolicy_expanding
				scrollbarpolicy_horizontal = always_off
				scrollbar_vertical = {
					using = Scrollbar_Vertical
				}

				scrollwidget = {
					dynamicgridbox = {
						layoutpolicy_horizontal = expanding
						datamodel = "[GetPlayer.GetProvinces]"
						item = {
							widget = {
								layoutpolicy_horizontal = expanding
								size = { -1 32 }

								background = {
									visible = "[IsOdd_int32(PdxGuiWidget.GetIndexInDataModel)]"
									using = color_whiteish_texture
									alpha = 0.06
								}

								hbox = {
									using = layoutpolicy_expanding
									margin = { 10 0 }

									text_single = {
										size = { 200 -1 }
										autoresize = no
										align = left|nobaseline
										margin_left = 5
										text = "[Province.GetNameWithNoTooltip]"
										default_format = "#yellow_titles"
										datacontext = "[Province.Self]"
										tooltipwidget = {
											using = province_tooltip
										}
									}
									text_single = {
										size = { 100 -1 }
										autoresize = no
										align = center|nobaseline
										raw_text = "[Province.GetTotalPopulation]"
									}
									text_single = {
										size = { 60 -1 }
										autoresize = no
										align = center|nobaseline
										raw_text = "[GetDataModelSize(Province.GetLocations)]"
									}
									text_single = {
										size = { 80 -1 }
										autoresize = no
										align = center|nobaseline
										text = "[Province.GetAverageDevelopment|2/%]"
									}
									text_single = {
										size = { 80 -1 }
										autoresize = no
										align = center|nobaseline
										text = "[Province.GetAverageControl|2%]"
									}
									text_single = {
										size = { 80 -1 }
										autoresize = no
										align = center|nobaseline
										text = "[Province.GetFood]"
									}
									text_single = {
										size = { 100 -1 }
										autoresize = no
										align = center|nobaseline
										text = "[Province.GetAverageIntegration|2/%]"
									}
									text_single = {
										size = { 100 -1 }
										autoresize = no
										align = center|nobaseline
										text = "[Province.GetAverageSatisfaction|2/%]"
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
