### Confirmation dialog for Cancel All Constructions

basic_dialog = {
	name = "pm_cancel_all_dialog"
	layer = top
	visible = "[GetVariableSystem.HasValue('pm_cancel_all_popup', 'yes')]"
	filter_mouse = all

	blockoverride "header_text" {
		text = "PM_CANCEL_ALL_DIALOG_TITLE"
	}

	blockoverride "content" {
		text_multi = {
			layoutpolicy_horizontal = expanding
			autoresize = yes
			max_width = 520
			text = "PM_CANCEL_ALL_DIALOG_TEXT"
			align = center
		}
	}

	blockoverride "bottom_buttons" {
		expand = {}
		button_regular_icon = {
			size = { 120 36 }
			onclick = "[GetVariableSystem.Clear('pm_cancel_all_popup')]"

			blockoverride "button_text" {
				text = "PM_CANCEL_ALL_DIALOG_NO"
			}
		}

		button_regular_icon = {
			size = { 200 36 }
			onclick = "[PdxGuiTriggerAllAnimations('pm_cancel_all_constructions')]"
			onclick = "[GetVariableSystem.Clear('pm_cancel_all_popup')]"

			blockoverride "button_text" {
				text = "PM_CANCEL_ALL_DIALOG_YES"
			}
		}
		expand = {}
	}
}
