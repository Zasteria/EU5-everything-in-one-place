					blockoverride "scroll_list_content" {
						addcolumn = 100%
						addrow = 45
						setitemsizefromcell = yes

						datamodel = "[LocationsListView.GetLocationsListView]"
						item = {
							widget = {
								size = { 100% 45 }
								using = bg_scroll_card

								hbox = {

										# Name (clickable - opens location window)
										button = {
											size = { 130 35 }
											datacontext = "[LocationsListViewItem.GetLocation]"
											onclick = "[ShowLocation(Location.Self)]"
											tooltipwidget = { using = location_simple_tooltip }
											sort_by_highlight = {
												name = "name"
											}

											hbox = {
												parentanchor = vcenter
												margin_left = 0
												spacing = 0

												# Integration icon (shield)
												icon = {
													visible = "[Location.IsIntegrated]"
													size = { 24 24 }
													texture = "[GetIntegrationLevelIcon(Location.GetIntegrationLevel)]"
													tooltipwidget = { using = location_core_tooltip }
												}
												widget = {
													visible = "[And(Not(Location.IsIntegrated), Location.IsCurrentlyBeingIntegrated)]"
													size = { 24 24 }
													tooltipwidget = { using = location_core_tooltip }
													piechart = {
														size = { 24 24 }
														using = piechart_angles
														alwaystransparent = yes
														pieslice = {
															texture = "gfx/interface/pie_charts/pie_chart_alpha_80_green.dds"
															value = "[Location.GetIntegrationProgressFloat]"
														}
														pieslice = {
															texture = "gfx/interface/pie_charts/pie_chart_alpha_80_red.dds"
															value = "[Subtract_float('(float)100.0', Location.GetIntegrationProgressFloat)]"
														}
														icon = {
															size = { 60% 60% }
															parentanchor = center
															texture = "[GetIntegrationLevelIcon(Location.GetIntegrationLevel)]"
															alwaystransparent = yes
														}
													}
												}
												icon = {
													visible = "[And(Not(Location.IsIntegrated), Not(Location.IsCurrentlyBeingIntegrated))]"
													size = { 24 24 }
													texture = "[GetIntegrationLevelIcon(Location.GetIntegrationLevel)]"
													alpha = 0.4
													tooltipwidget = { using = location_core_tooltip }
												}

												text_single = {
													autoresize = no
													size = { 100 -1 }
													text = "[Location.GetNameWithNoTooltip]"
													default_format = "#yellow_titles"
													align = left|nobaseline
												}
											}
										}

										# Rank - vanilla style upgrade button
										button_regular = {
											visible = "[Not(GetVariableSystem.Exists('pm_hide_rank'))]"
											size = { 108 28 }
											datacontext = "[LocationsListViewItem.GetLocation]"

											enabled = "[Or(Location.CanUpgradeRank, Location.CanDowngradeRank)]"

											action_tooltip = {
												click_type = left
												click_mode = confirm
												enabled = "[Location.CanUpgradeRank]"
												title = "[Location.GetUpgradeRankName]"
												cost = "[Location.GetUpgradeRankPrice]"
												description = "[Location.GetUpgradeRankDescription]"
												effects = "[Location.GetUpgradeRankEffects]"
												conditions = "[Location.GetUpgradeRankConditions]"
												on_action = "[UpgradeLocationRank(Location.Self)]"
											}

											action_tooltip = {
												click_type = right
												click_mode = confirm
												enabled = "[Location.CanDowngradeRank]"
												title = "[Location.GetDowngradeRankName]"
												description = "[Location.GetDowngradeRankDescription]"
												effects = "[Location.GetDowngradeRankEffects]"
												conditions = "[Location.GetDowngradeRankConditions]"
												on_action = "[DowngradeLocationRank(Location.Self)]"
											}

											tooltipwidget = {
												using = location_rank_tooltip
												blockoverride "location_rank_tooltip_button" {
													TooltipBlockList = {
														visible = "[Not(StringIsEmpty(Location.GetUpgradeRankPriceBreakdown))]"
														textcontext = "[Location.GetUpgradeRankPriceBreakdown]"
													}
												}
											}
											sort_by_highlight = {
												name = "type"
											}

											hbox = {
												spacing = 3
												margin = { 4 0 }

												icon = {
													size = { 22 22 }
													texture = "[Location.GetRankIcon]"
												}

												text_single = {
													align = left|nobaseline
													layoutpolicy_horizontal = expanding
													autoresize = no
													fontsize = 14
													text = "[Location.GetRank.GetNameWithNoTooltip]"
												}
											}
										}

										# Population + capacity bar + satisfaction
										widget = {
											visible = "[Not(GetVariableSystem.Exists('pm_hide_pop'))]"
											size = { 130 40 }
											datacontext = "[LocationsListViewItem.GetLocation]"
											sort_by_highlight = {
												name = "pop"
											}

											hbox = {
												size = { 130 40 }
												spacing = 0

												# Satisfaction piechart (vanilla style)
												widget = {
												size = { 40 40 }
												parentanchor = vcenter
												tooltipwidget = { using = AverageSatisfaction_tooltip }
												piechart = {
													parentanchor = center
													size = { 40 40 }
													alwaystransparent = yes
													using = piechart_angles
													pieslice_no_highlight = {
														texture = "gfx/interface/pie_charts/pie_chart_alpha_80_green.dds"
														value = "[FixedPointToFloat(Location.GetAverageSatisfaction)]"
														color = { 1 1 1 1 }
														alwaystransparent = yes
													}
													pieslice_no_highlight = {
														texture = "gfx/interface/pie_charts/pie_chart_alpha_80_red.dds"
														value = "[Subtract_float('(float)1.0', FixedPointToFloat(Location.GetAverageSatisfaction))]"
														color = { 1 1 1 1 }
														alwaystransparent = yes
													}
													hbox = {
														widget = {
															using = layoutpolicy_expanding
															icon = { size = { 61% 61% } parentanchor = center visible = "[LessThanOrEqualTo_CFixedPoint(Location.GetAverageSatisfaction,'(CFixedPoint)0.25')]" texture = "gfx/interface/icons/flat_icons/sad.dds" texture_density = 2 }
															icon = { size = { 61% 61% } parentanchor = center visible = "[BetweenInclusiveOfMax_CFixedPoint(Location.GetAverageSatisfaction,'(CFixedPoint)0.25', '(CFixedPoint)0.5')]" texture = "gfx/interface/icons/flat_icons/neutral.dds" texture_density = 2 }
															icon = { size = { 61% 61% } parentanchor = center visible = "[GreaterThan_CFixedPoint(Location.GetAverageSatisfaction,'(CFixedPoint)0.5')]" texture = "gfx/interface/icons/flat_icons/happy.dds" texture_density = 2 }
														}
													}
													using = bg_circle_piechart
												}
											}

											# Population + capacity
											vbox = {
												layoutpolicy_horizontal = expanding
												parentanchor = left
												margin_top = 3
												tooltipwidget = { using = population_location_tooltip }

												hbox = {
													layoutpolicy_horizontal = expanding
													spacing = 2
													text_single = {
														autoresize = yes
														align = center|nobaseline
														size = { -1 16 }
														text = "[Location.GetTotalPopulationWithBreakDown]"
													}
													text_single = {
														autoresize = yes
														fontsize = 10
														align = left|nobaseline
														raw_text = "[Location.GetPopGrowth|+=2%]"
														default_format = "#color_green"
														tooltipwidget = {
														ContextualTooltipType = {
															blockoverride "title_icon" {
																icon = {
																	using = tooltip_title_icon_size
																	texture = "gfx/interface/icons/location_icons/monthly_growth.dds"
																	glow = {
																		name = "drop_shadow"
																		glow_radius = 3
																		color = {0.0 0.0 0.0 1.0}
																		alpha = 0.6
																	}
																}
															}
															blockoverride "title_text" {
																text = "POP_GROWTH_TT_HEADER_TEXT"
															}
															blockoverride "concept_link" {
																text = [population_growth|E]
															}
															blockoverride "tooltip_content" {
																vbox = {
																	layoutpolicy_horizontal = expanding
																	spacing = 5
																	text_multi = {
																		layoutpolicy_horizontal = expanding
																		autoresize = yes
																		max_width = 350
																		raw_text = "Yearly [population_growth|E] of #G [Location.GetPopGrowth|+=2%]#! is due to:"
																	}
																	TooltipStringPairList = {
																		textcontext = "[Location.GetPopGrowthInfo]"
																	}
																}
															}
														}
													}
													}
												}
												progressbar = {
													size = { 65 6 }
													using = progress_bar_green_alt
													value = "[Location.GetCapacityPercentage]"
													direction = horizontal
												}
											}
										}
										}

										# Literacy
										widget = {
											visible = "[Not(GetVariableSystem.Exists('pm_hide_literacy'))]"
											size = { 50 42 }
											datacontext = "[LocationsListViewItem.GetLocation]"
											tooltipwidget = { using = LocationLiteracy_tooltip }

											text_single = {
												parentanchor = center
												autoresize = yes
												fontsize = 14
												align = center|nobaseline
												raw_text = "[Location.GetAverageLiteracy|2]%"
											}
										}

										# Wealth + Income (vanilla style)
										widget = {
											visible = "[Not(GetVariableSystem.Exists('pm_hide_tax'))]"
											size = { 90 40 }
											datacontext = "[LocationsListViewItem.GetLocation]"
											tooltipwidget = { using = location_tax_base_tooltip }
											sort_by_highlight = {
												name = "tax"
											}

											hbox = {
												margin = { 2 0 }
												spacing = 2

												widget = {
													size = { 30 30 }
													using = bg_circle_piechart

													icon_pie_left = {
														parentanchor = center
														blockoverride "PieSize_bckg" {}
														blockoverride "PieSize" { size = { 30 30 } }
														blockoverride "pie_datamodel" { datamodel = "[DataModelSkipFirst(Location.GetOwner.GetGovernment.GetEstates, '(int32)1')]" }
														blockoverride "pieslice_item" {
															pieslice_no_highlight = {
																texture = "gfx/interface/pie_charts/piechart_alpha.dds"
																texture_density = 2
																tooltip_enabled = no
																value = "[Location.GetEstateTaxBasePercent(Estate.Self)]"
																color = "[Estate.GetType.GetMapColor]"
																alpha = 0.99
																alwaystransparent = yes
															}
														}
														blockoverride "SliceTooltip" {}
														blockoverride "SliceValue" {}
														blockoverride "SliceColor" {}
														blockoverride "Icon" { texture = "gfx/interface/icons/location_icons/tax_base.dds" }
														blockoverride "Icon_Size" { size = { 60% 60% } }
														blockoverride "datamodel" { visible = no }
													}
												}

												vbox = {
													layoutpolicy_horizontal = expanding
													spacing = -1
													text_single = {
														layoutpolicy_horizontal = expanding
														size = { -1 16 }
														autoresize = no
														fontsize = 13
														align = left|nobaseline
														raw_text = "[Location.GetTotalPossibleTaxBase|W2]"
													}
													text_single = {
														layoutpolicy_horizontal = expanding
														size = { -1 13 }
														autoresize = no
														fontsize = 11
														align = left|nobaseline
														raw_text = "[Location.GetTotalIncome|g2]@income!"
														default_format = "#bold"
													}
												}
											}
										}

										# Net Balance
										widget = {
											visible = "[Not(GetVariableSystem.Exists('pm_hide_balance'))]"
											size = { 60 42 }
											datacontext = "[LocationsListViewItem.GetLocation]"
											tooltipwidget = { using = location_tax_base_tooltip }

											vbox = {
												parentanchor = center

												text_single = {
													visible = "[GreaterThanOrEqualTo_CFixedPoint(Location.GetNetBalance, '(CFixedPoint)0')]"
