lateralview_full = {
	name = "locations_list_view"

	blockoverride "panel_header" {
		window_header_alt = {
			blockoverride "header_text" {
				text = "LEDGER_TAB"
			}
			blockoverride "window_header_alt_color_texture"{
				using = color_default_brown_texture
			}
		}
	}

	blockoverride "panel_content" {
		vbox = {
			header_main_tabs = {
				blockoverride "content" {
					using = ledger_tabs_template
				}
			}

			# Set default sub-tab on open
			state = {
				name = pm_init_tab
				trigger_on_create = yes
				on_finish = "[GetVariableSystem.Set('pm_tab', 'locations')]"
				on_finish = "[GetVariableSystem.Set('pm_filter_constructions', 'yes')]"
			}

			# === Sub-tab buttons ===
			hbox = {
				margin = { 5 2 }
				spacing = 3

				button_main_tab_alt = {
					size = { 120 30 }
					blockoverride "tab_text" {
						text = "PM_TAB_LOCATIONS"
					}
					down = "[GetVariableSystem.HasValue('pm_tab', 'locations')]"
					onclick = "[GetVariableSystem.Set('pm_tab', 'locations')]"
				}
				button_main_tab_alt = {
					size = { 140 30 }
					blockoverride "tab_text" {
						text = "PM_TAB_CONSTRUCTIONS"
					}
					down = "[GetVariableSystem.HasValue('pm_tab', 'constructions')]"
					onclick = "[GetVariableSystem.Set('pm_tab', 'constructions')]"
				}

				expand = {}
			}

			# ============================================================
			# === LOCATIONS TAB ==========================================
			# ============================================================
			vbox = {
				visible = "[GetVariableSystem.HasValue('pm_tab', 'locations')]"
				using = layoutpolicy_expanding
				using = bg_main_inner_alt
				using = window_main_tabs_margin_alt

				# Auto-precompute best buildings on panel open
				state = {
					name = pm_precompute_on_open
					trigger_on_create = yes
					on_finish = "[GetScriptedGui('pm_sgui_precompute_all').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
				state = {
					name = pm_compare_on_open
					trigger_on_create = yes
					duration = 0.1
					on_finish = "[PdxGuiTriggerAllAnimations('pm_compare_new_profit_state')]"
				}

				scrollarea = {
					using = layoutpolicy_expanding
					scrollbarpolicy_horizontal = as_needed
					scrollbarpolicy_vertical = always_off

					scrollbar_horizontal = {
						using = editor_horizontal_scrollbar
					}

					scrollwidget = {
						vbox = {
						# Dynamic width spacer: sum of visible column widths
						hbox = {
							widget = { size = { 130 0 } }
							widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_rank'))]" size = { 108 0 } }
							widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_pop'))]" size = { 130 0 } }
							widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_literacy'))]" size = { 50 0 } }
							widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_tax'))]" size = { 90 0 } }
							widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_balance'))]" size = { 60 0 } }
							widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_religion'))]" size = { 30 0 } }
							widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_culture'))]" size = { 65 0 } }
							widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_dev'))]" size = { 70 0 } }
							widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_prosperity'))]" size = { 70 0 } }
							widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_control'))]" size = { 70 0 } }
							widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_market'))]" size = { 60 0 } }
							widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_manpower'))]" size = { 60 0 } }
							widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_food'))]" size = { 60 0 } }
							widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_rgo'))]" size = { 140 0 } }
							widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_town_rights'))]" size = { 50 0 } }
							widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_enfranchisement'))]" size = { 60 0 } }
							widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_migration'))]" size = { 60 0 } }
							widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_sailors'))]" size = { 60 0 } }
							widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_cores'))]" size = { 155 0 } }
							widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_nobles'))]" size = { 84 0 } }
							widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_clergy'))]" size = { 84 0 } }
							widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_burghers'))]" size = { 84 0 } }
							widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_laborers'))]" size = { 84 0 } }
							widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_soldiers'))]" size = { 84 0 } }
							widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_peasants'))]" size = { 84 0 } }
							widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_tribesmen'))]" size = { 84 0 } }
							widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_slaves'))]" size = { 84 0 } }
							widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_build'))]" size = { 214 0 } }
							widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_buildings'))]" size = { 85 0 } }
							widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_active'))]" size = { 90 0 } }
						}
						filtered_sorted_list = {
							margin_top = 10
							datacontext = "[LocationsListView.GetLocationsListSortSearch]"

							blockoverride "searchbar_visible" {
								visible = "[Or(SearchBar.HasSearchFilterCategories, SearchBar.HasTextSearchFilters)]"
								maximumsize = { 250 -1 }
					}

					blockoverride "extra_searchbar_content" {

							# === Card: Profit Threshold ===
							adjustable_budget_card = {
								size = { 215 55 }

								blockoverride "top_widget" {
									hbox = {
										margin = { 5 0 }
										spacing = 5
										tooltip = "PM_THRESHOLD_TT"
										icon = {
											size = { 24 24 }
											texture = "gfx/interface/icons/resources/gold.dds"
										}
										text_single = {
											layoutpolicy_horizontal = expanding
											autoresize = no
											align = left|nobaseline
											text = "PM_THRESHOLD_TITLE"
										}
										text_single = {
											autoresize = yes
											align = right|nobaseline
											raw_text = "[GetPlayer.MakeScope.Var('pm_profit_threshold').GetValue|2]"
										}
									}
								}

								blockoverride "bottom_widget" {
									hbox = {
										margin = { 5 0 }
										spacing = 3

										button_minus = {
											size = { 22 22 }
											tooltip = "PM_THRESHOLD_DEC_TT"
											click_modifiers = {
												ondefault = "[GetScriptedGui('pm_sgui_threshold_dec').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
												onctrl = "[GetScriptedGui('pm_sgui_threshold_dec_big').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
												onshift = "[GetScriptedGui('pm_sgui_threshold_reset').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
											}
											onrightclick = "[GetScriptedGui('pm_sgui_threshold_dec_mid').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										}

										button_plus = {
											size = { 22 22 }
											tooltip = "PM_THRESHOLD_INC_TT"
											click_modifiers = {
												ondefault = "[GetScriptedGui('pm_sgui_threshold_inc').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
												onctrl = "[GetScriptedGui('pm_sgui_threshold_inc_big').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
												onshift = "[GetScriptedGui('pm_sgui_threshold_max').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
											}
											onrightclick = "[GetScriptedGui('pm_sgui_threshold_inc_mid').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										}

										expand = {}

										button_regular = {
											size = { 90 22 }
											onclick = "[GetScriptedGui('pm_sgui_precompute_all').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
											onclick = "[PdxGuiTriggerAllAnimations('pm_compare_new_profit_state')]"
											tooltip = "PM_RECALC_TT"
											hbox = {
												spacing = 3
												margin = { 3 0 }
												icon = {
													size = { 14 14 }
													texture = "gfx/interface/icons/resources/gold.dds"
												}
												text_single = {
													text = "PM_RECALC"
													fontsize = 12
												}
											}
										}
									}
								}
							}

							# === Card: Gold Reserve Limit ===
							adjustable_budget_card = {
								size = { 215 55 }

								blockoverride "top_widget" {
									hbox = {
										margin = { 5 0 }
										spacing = 5
										tooltip = "PM_GOLD_LIMIT_TT"
										icon = {
											size = { 24 24 }
											texture = "gfx/interface/icons/resources/gold.dds"
										}
										text_single = {
											layoutpolicy_horizontal = expanding
											autoresize = no
											align = left|nobaseline
											text = "PM_GOLD_LIMIT_TITLE"
										}
										text_single = {
											autoresize = yes
											align = right|nobaseline
											raw_text = "[GetPlayer.MakeScope.Var('pm_gold_limit').GetValue|0]"
										}
									}
								}

								blockoverride "bottom_widget" {
									hbox = {
										margin = { 5 0 }
										spacing = 3

										button_minus = {
											size = { 22 22 }
											tooltip = "PM_GOLD_LIMIT_DEC_TT"
											click_modifiers = {
												ondefault = "[GetScriptedGui('pm_sgui_gold_limit_dec').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
												onctrl = "[GetScriptedGui('pm_sgui_gold_limit_dec_ctrl').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
												onshift = "[GetScriptedGui('pm_sgui_gold_limit_dec_shift').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
											}
											onrightclick = "[GetScriptedGui('pm_sgui_gold_limit_dec_big').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										}

										button_plus = {
											size = { 22 22 }
											tooltip = "PM_GOLD_LIMIT_INC_TT"
											click_modifiers = {
												ondefault = "[GetScriptedGui('pm_sgui_gold_limit_inc').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
												onctrl = "[GetScriptedGui('pm_sgui_gold_limit_inc_ctrl').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
												onshift = "[GetScriptedGui('pm_sgui_gold_limit_inc_shift').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
											}
											onrightclick = "[GetScriptedGui('pm_sgui_gold_limit_inc_big').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										}

										expand = {}
									}
								}
							}

							# === Card: Actions ===
							adjustable_budget_card = {
								size = { 215 55 }

								blockoverride "top_widget" {
									hbox = {
										margin = { 5 0 }
										spacing = 5
										icon = {
											size = { 24 24 }
											texture = "gfx/interface/icons/flat_icons/building_panel/build.dds"
										}
										text_single = {
											layoutpolicy_horizontal = expanding
											autoresize = no
											align = left|nobaseline
											text = "PM_ACTIONS_TITLE"
										}
										button_regular = {
											size = { 65 22 }
											onclick = "[GetVariableSystem.Toggle('pm_ab_settings')]"
											tooltip = "PM_AB_SETTINGS_TT"
											hbox = {
												spacing = 3
												margin = { 3 0 }
												icon = {
													size = { 14 14 }
													texture = "gfx/interface/icons/flat_icons/settings.dds"
												}
												text_single = {
													text = "PM_AB_SETTINGS_BTN"
													fontsize = 11
												}
											}
										}
									}
								}

								blockoverride "bottom_widget" {
									hbox = {
										margin = { 5 0 }
										spacing = 3

										button_regular = {
											size = { 100 22 }
											onclick = "[GetScriptedGui('pm_sgui_toggle_all_auto_build').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
											onrightclick = "[GetScriptedGui('pm_sgui_toggle_core_auto_build').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
											tooltip = "PM_TOGGLE_ALL_AUTO_BUILD_TT"
											hbox = {
												spacing = 3
												margin = { 3 0 }
												icon = {
													size = { 14 14 }
													texture = "gfx/interface/buttons/checkbox_auto.dds"
													texture_density = 2
													frame_grid = { 2 1 }
													frame = 2
												}
												text_single = {
													text = "PM_TOGGLE_ALL_AB"
													fontsize = 12
												}
											}
										}

										button_regular = {
											size = { 90 22 }
											onclick = "[GetVariableSystem.Set('pm_cancel_all_popup', 'yes')]"
											tooltip = "PM_CANCEL_ALL_TT"
											hbox = {
												spacing = 3
												margin = { 3 0 }
												text_single = {
													text = "PM_CANCEL_ALL"
													fontsize = 12
												}
											}

											# Hidden: iterate ALL locations → constructions for cancel
											widget = {
												size = { 0 0 }
												fixedgridbox = {
													addcolumn = 1
													addrow = 1
													datamodel = "[LocationsListView.GetLocationsListView]"
													item = {
														widget = {
															size = { 0 0 }
															dynamicgridbox = {
																datamodel = "[LocationsListViewItem.GetLocation.GetCivilConstructions]"
																item = {
																	widget = {
																		size = { 0 0 }
																		state = {
																			name = pm_cancel_all_constructions
																			on_finish = "[CancelConstruction(Construction.Self)]"
																		}
																	}
																}
															}
														}
													}
												}
											}
										}

										expand = {}

									}
								}
							}

						# === Card: Columns ===
						adjustable_budget_card = {
							size = { 215 55 }

							blockoverride "top_widget" {
								hbox = {
									margin = { 5 0 }
									spacing = 5
									tooltip = "PM_COL_SETTINGS_TT"
									icon = {
										size = { 24 24 }
										texture = "gfx/interface/icons/flat_icons/settings.dds"
									}
									text_single = {
										layoutpolicy_horizontal = expanding
										autoresize = no
										align = left|nobaseline
										text = "PM_COL_SETTINGS_TITLE"
									}
								}
							}

							blockoverride "bottom_widget" {
								hbox = {
									margin = { 5 0 }
									spacing = 3

									button_regular = {
										size = { 190 22 }
										onclick = "[GetVariableSystem.Toggle('pm_col_settings')]"
										tooltip = "PM_COL_SETTINGS_TT"
										hbox = {
											spacing = 3
											margin = { 3 0 }
											text_single = {
												text = "PM_COL_SETTINGS_BTN"
												fontsize = 12
											}
										}
									}

									expand = {}
								}
							}
						}

							expand = {}
					}

					blockoverride "sort_buttons_filtered_list" {
						sort_by_key_button = {
							name = "name"
							size = { 130 -1 }
							layoutpolicy_vertical = expanding
						}
						sort_by_key_button = {
							name = "type"
							visible = "[Not(GetVariableSystem.Exists('pm_hide_rank'))]"
							size = { 108 -1 }
							layoutpolicy_vertical = expanding
						}
						sort_by_key_button = {
							name = "pop"
							visible = "[Not(GetVariableSystem.Exists('pm_hide_pop'))]"
							size = { 130 -1 }
							layoutpolicy_vertical = expanding
						}
						# Literacy header
						widget = {
							visible = "[Not(GetVariableSystem.Exists('pm_hide_literacy'))]"
							size = { 50 -1 }
							layoutpolicy_vertical = expanding
							hbox = {
								parentanchor = center
								text_single = {
									fontsize = 13
									text = "PM_COL_SET_LITERACY"
								}
							}
						}
						sort_by_key_button = {
							name = "tax"
							visible = "[Not(GetVariableSystem.Exists('pm_hide_tax'))]"
							size = { 90 -1 }
							layoutpolicy_vertical = expanding
						}
						# Net Balance header
						widget = {
							visible = "[Not(GetVariableSystem.Exists('pm_hide_balance'))]"
							size = { 60 -1 }
							layoutpolicy_vertical = expanding
							hbox = {
								parentanchor = center
								text_single = {
									fontsize = 13
									text = "PM_COL_SET_BALANCE"
								}
							}
						}
						sort_by_key_button = {
							name = "religion"
							visible = "[Not(GetVariableSystem.Exists('pm_hide_religion'))]"
							size = { 30 -1 }
							layoutpolicy_vertical = expanding
						}
						sort_by_key_button = {
							name = "culture"
							visible = "[Not(GetVariableSystem.Exists('pm_hide_culture'))]"
							size = { 65 -1 }
							layoutpolicy_vertical = expanding
						}
						sort_by_key_button = {
							name = "development"
							visible = "[Not(GetVariableSystem.Exists('pm_hide_dev'))]"
							size = { 70 -1 }
							layoutpolicy_vertical = expanding
						}
						# Prosperity column header
						widget = {
							visible = "[Not(GetVariableSystem.Exists('pm_hide_prosperity'))]"
							size = { 70 -1 }
							layoutpolicy_vertical = expanding
							hbox = {
								parentanchor = center
								spacing = 3
								text_single = {
									fontsize = 13
									text = "PM_COL_SET_PROSPERITY"
								}
							}
						}
						sort_by_key_button = {
							name = "control"
							visible = "[Not(GetVariableSystem.Exists('pm_hide_control'))]"
							size = { 70 -1 }
							layoutpolicy_vertical = expanding
						}
						# Market access header
						widget = {
							visible = "[Not(GetVariableSystem.Exists('pm_hide_market'))]"
							size = { 60 -1 }
							layoutpolicy_vertical = expanding
							icon = {
								parentanchor = center
								size = { 28 28 }
								texture = "gfx/interface/icons/location_icons/market.dds"
								tooltip = "[market_access|E]"
							}
						}
						sort_by_key_button = {
							name = "manpower"
							visible = "[Not(GetVariableSystem.Exists('pm_hide_manpower'))]"
							size = { 60 -1 }
							layoutpolicy_vertical = expanding
						}
						sort_by_key_button = {
							name = "food"
							visible = "[Not(GetVariableSystem.Exists('pm_hide_food'))]"
							size = { 60 -1 }
							layoutpolicy_vertical = expanding
						}
						sort_by_key_button = {
							name = "raw_material"
							visible = "[Not(GetVariableSystem.Exists('pm_hide_rgo'))]"
							size = { 140 -1 }
							layoutpolicy_vertical = expanding
						}
						sort_by_key_button = {
							name = "town_rights"
							visible = "[Not(GetVariableSystem.Exists('pm_hide_town_rights'))]"
							layoutpolicy_vertical = expanding
							size = { 50 -1 }
						}
						sort_by_key_button = {
							name = "enfranchisement"
							visible = "[Not(GetVariableSystem.Exists('pm_hide_enfranchisement'))]"
							using = layoutpolicy_expanding
						}
						sort_by_key_button = {
							name = "migration"
							visible = "[Not(GetVariableSystem.Exists('pm_hide_migration'))]"
							using = layoutpolicy_expanding
						}
						sort_by_key_button = {
							name = "sailors"
							visible = "[Not(GetVariableSystem.Exists('pm_hide_sailors'))]"
							using = layoutpolicy_expanding
						}
						sort_by_key_button = {
							name = "cores"
							visible = "[Not(GetVariableSystem.Exists('pm_hide_cores'))]"
							layoutpolicy_vertical = expanding
							size = { 155 -1 }
						}
						# Nobles column header
						widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_nobles'))]" size = { 84 -1 } layoutpolicy_vertical = expanding
							background = {
								using = paper_card_texture
								margin = { -3 -3 }
								modify_texture = { using = color_paper_texture }
								modify_texture = { using = overlay_paper_03 }
							}
							background = {
								using = color_grey_texture
								margin = { -3 -3 }
								modify_texture = {
									texture = "[GetGraphicalCultureTexture('header_pattern')]"
									texture_density = 2
									spriteType = corneredtiled
									blend_mode = overlay
									alpha = 0.2
								}
								modify_texture = {
									color = "[GetPopTypeByName('nobles').GetColor]"
									alpha = 0.7
									blend_mode = overlay
								}
							}
							widget = {
								parentanchor = center
								size = { 28 28 }
								using = bg_circle_piechart
								icon = {
									size = { 92% 92% }
									parentanchor = center
									texture = "[GetGraphicalCultureTextureForPopType(GetPopTypeByName('nobles'))]"
									tooltip = "[GetPopTypeByName('nobles').GetName]"
								}
							}
						}
						# Clergy column header
						widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_clergy'))]" size = { 84 -1 } layoutpolicy_vertical = expanding
							background = {
								using = paper_card_texture
								margin = { -3 -3 }
								modify_texture = { using = color_paper_texture }
								modify_texture = { using = overlay_paper_03 }
							}
							background = {
								using = color_grey_texture
								margin = { -3 -3 }
								modify_texture = {
									texture = "[GetGraphicalCultureTexture('header_pattern')]"
									texture_density = 2
									spriteType = corneredtiled
									blend_mode = overlay
									alpha = 0.2
								}
								modify_texture = {
									color = "[GetPopTypeByName('clergy').GetColor]"
									alpha = 0.7
									blend_mode = overlay
								}
							}
							widget = {
								parentanchor = center
								size = { 28 28 }
								using = bg_circle_piechart
								icon = {
									size = { 92% 92% }
									parentanchor = center
									texture = "[GetGraphicalCultureTextureForPopType(GetPopTypeByName('clergy'))]"
									tooltip = "[GetPopTypeByName('clergy').GetName]"
								}
							}
						}
						# Burghers column header
						widget = { visible = "[Not(GetVariableSystem.Exists('pm_hide_burghers'))]" size = { 84 -1 } layoutpolicy_vertical = expanding
							background = {
								using = paper_card_texture
								margin = { -3 -3 }
								modify_texture = { using = color_paper_texture }
								modify_texture = { using = overlay_paper_03 }
							}
							background = {
								using = color_grey_texture
								margin = { -3 -3 }
								modify_texture = {
									texture = "[GetGraphicalCultureTexture('header_pattern')]"
									texture_density = 2
									spriteType = corneredtiled
									blend_mode = overlay
									alpha = 0.2
								}
								modify_texture = {
