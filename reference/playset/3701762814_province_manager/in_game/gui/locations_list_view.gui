										# === HIDDEN: iterate new buildings for profit comparison via GUI bridge ===
										widget = {
											size = { 0 0 }
											datacontext = "[LocationsListViewItem.GetLocation]"
											fixedgridbox = {
												addcolumn = 1
												addrow = 1
												datamodel = "[Location.MakeScope.GetList('pm_new_buildings')]"
												item = {
													widget = {
														size = { 1 1 }
														state = {
															name = pm_compare_new_profit_state
															trigger_on_create = yes
															on_finish = "[GetScriptedGui('pm_sgui_compare_new_profit').Execute(GuiScope.SetRoot(Location.MakeScope).AddScope('bt', Scope.BuildingType.MakeScope).AddScope('profit', MakeScopeValue(GetBuildingTypeIncomeToOwnerInLocation(Scope.BuildingType, Location.Self))).End)]"
														}
													}
												}
											}
										}


										# === BUILD BUTTON (auto-build for this city) ===
										widget = {
											visible = "[Not(GetVariableSystem.Exists('pm_hide_build'))]"
											size = { 214 28 }
											datacontext = "[LocationsListViewItem.GetLocation]"

											# Button area (base + constructions variants)
											widget = {
												size = { 190 28 }

												# Base button: left click build + tooltip when no constructions
												card_header_button_04 = {
													size = { 100% 100% }
												onclick = "[BuildOrExpandBuildingDefault(Location.MakeScope.Var('pm_best_bt').BuildingType, Location.Self)]"
												onclick = "[GetScriptedGui('pm_sgui_precompute_single').Execute(GuiScope.SetRoot(Location.MakeScope).End)]"
												onclick = "[PdxGuiTriggerAllAnimations('pm_compare_new_profit_state')]"
												tooltip = "[SelectLocalization(And(Location.MakeScope.Var('pm_best_bt').IsSet, CanBuildOrExpandBuilding(Location.MakeScope.Var('pm_best_bt').BuildingType, Location.Self)), 'PM_BUILD_BEST_TT', 'PM_NOTHING_TO_BUILD_TT')]"
												visible = "[IsDataModelEmpty(Location.GetCivilConstructions)]"
												enabled = "[And(Location.MakeScope.Var('pm_best_bt').IsSet, CanBuildOrExpandBuilding(Location.MakeScope.Var('pm_best_bt').BuildingType, Location.Self))]"

												background = {
													using = color_society_texture
													alpha = 0.8
												}

												hbox = {
													spacing = 2
													margin = { 3 0 }
													# Building icon — with building tooltip
													icon = {
														visible = "[And(Location.MakeScope.Var('pm_best_bt').IsSet, CanBuildOrExpandBuilding(Location.MakeScope.Var('pm_best_bt').BuildingType, Location.Self))]"
														size = { 20 20 }
														texture = "[GetBuildingIcon(Location.MakeScope.Var('pm_best_bt').BuildingType)]"
														datacontext = "[Location.MakeScope.Var('pm_best_bt').BuildingType]"
														tooltipwidget = {
															using = BuildingType_tooltip
														}
													}
													# Profit value
													text_single = {
														visible = "[And(Location.MakeScope.Var('pm_best_bt').IsSet, CanBuildOrExpandBuilding(Location.MakeScope.Var('pm_best_bt').BuildingType, Location.Self))]"
														autoresize = yes
														fontsize = 12
														align = left|nobaseline
														raw_text = "#G +[Location.MakeScope.Var('pm_best_profit').GetValue|2]#! "
														alwaystransparent = yes
													}
													# Building name
													text_single = {
														visible = "[And(Location.MakeScope.Var('pm_best_bt').IsSet, CanBuildOrExpandBuilding(Location.MakeScope.Var('pm_best_bt').BuildingType, Location.Self))]"
														layoutpolicy_horizontal = expanding
														autoresize = no
														fontsize = 12
														align = left|nobaseline
														raw_text = "[Location.MakeScope.Var('pm_best_bt').BuildingType.GetNameWithNoTooltip]"
														alwaystransparent = yes
													}
													# Fallback if not precomputed or can't build
													text_single = {
														visible = "[Or(Not(Location.MakeScope.Var('pm_best_bt').IsSet), Not(CanBuildOrExpandBuilding(Location.MakeScope.Var('pm_best_bt').BuildingType, Location.Self)))]"
														layoutpolicy_horizontal = expanding
														autoresize = no
														fontsize = 12
														align = center|nobaseline
														default_format = "#L"
														text = "PM_NOTHING_TO_BUILD"
														alwaystransparent = yes
													}
												}
											}

											# When constructions active: left click build + right click cancel + construction tooltip
											dynamicgridbox = {
												visible = "[Not(IsDataModelEmpty(Location.GetCivilConstructions))]"
												datamodel = "[DataModelLast(Location.GetCivilConstructions,'(int32)1')]"
												item = {
													card_header_button_04 = {
														size = { 190 28 }
														onclick = "[BuildOrExpandBuildingDefault(Location.MakeScope.Var('pm_best_bt').BuildingType, Location.Self)]"
														onclick = "[GetScriptedGui('pm_sgui_precompute_single').Execute(GuiScope.SetRoot(Location.MakeScope).End)]"
														onclick = "[PdxGuiTriggerAllAnimations('pm_compare_new_profit_state')]"
														enabled = "[And(Location.MakeScope.Var('pm_best_bt').IsSet, CanBuildOrExpandBuilding(Location.MakeScope.Var('pm_best_bt').BuildingType, Location.Self))]"
														tooltip = "[SelectLocalization(And(Location.MakeScope.Var('pm_best_bt').IsSet, CanBuildOrExpandBuilding(Location.MakeScope.Var('pm_best_bt').BuildingType, Location.Self)), '', 'PM_NOTHING_TO_BUILD_TT')]"

														background = {
															using = color_society_texture
															alpha = 0.8
														}

														action_tooltip = {
															click_type = right
															click_mode = single
															title = "CANCEL_CONSTRUCTION"
															on_action = "[ShowConstructionCancellationDialog(Construction.Self, '(bool)no')]"
														}
														action_tooltip = {
															click_type = right
															click_mode = single
															click_modifier = shift
															title = "CANCEL_CONSTRUCTION_FORCED"
															on_action = "[ShowConstructionCancellationDialog(Construction.Self, '(bool)yes')]"
														}

														tooltipwidget = {
															using = Construction_tooltip
														}

														hbox = {
															spacing = 2
															margin = { 3 0 }
															# Building icon — with building tooltip
															icon = {
																visible = "[And(Location.MakeScope.Var('pm_best_bt').IsSet, CanBuildOrExpandBuilding(Location.MakeScope.Var('pm_best_bt').BuildingType, Location.Self))]"
																size = { 20 20 }
																texture = "[GetBuildingIcon(Location.MakeScope.Var('pm_best_bt').BuildingType)]"
																datacontext = "[Location.MakeScope.Var('pm_best_bt').BuildingType]"
																tooltipwidget = {
																	using = BuildingType_tooltip
																}
															}
															# Profit value
															text_single = {
																visible = "[And(Location.MakeScope.Var('pm_best_bt').IsSet, CanBuildOrExpandBuilding(Location.MakeScope.Var('pm_best_bt').BuildingType, Location.Self))]"
																autoresize = yes
																fontsize = 12
																align = left|nobaseline
																raw_text = "#G +[Location.MakeScope.Var('pm_best_profit').GetValue|2]#! "
																alwaystransparent = yes
															}
															# Building name
															text_single = {
																visible = "[And(Location.MakeScope.Var('pm_best_bt').IsSet, CanBuildOrExpandBuilding(Location.MakeScope.Var('pm_best_bt').BuildingType, Location.Self))]"
																layoutpolicy_horizontal = expanding
																autoresize = no
																fontsize = 12
																align = left|nobaseline
																raw_text = "[Location.MakeScope.Var('pm_best_bt').BuildingType.GetNameWithNoTooltip]"
																alwaystransparent = yes
															}
															# Fallback
															text_single = {
																visible = "[Or(Not(Location.MakeScope.Var('pm_best_bt').IsSet), Not(CanBuildOrExpandBuilding(Location.MakeScope.Var('pm_best_bt').BuildingType, Location.Self)))]"
																layoutpolicy_horizontal = expanding
																autoresize = no
																fontsize = 12
																align = center|nobaseline
																default_format = "#L"
																text = "PM_NOTHING_TO_BUILD"
																alwaystransparent = yes
															}
														}
													}
												}
											}
											}

											# Auto-build checkbox
											button_checkbox_auto = {
												parentanchor = vcenter
												position = { 191 0 }
												size = { 22 22 }
												down = "[Location.MakeScope.Var('pm_auto_build').IsSet]"
												onclick = "[GetScriptedGui('pm_sgui_toggle_auto_build').Execute(GuiScope.SetRoot(Location.MakeScope).End)]"
												tooltip = "PM_AUTO_BUILD_TT"
											}
										}

# === Buildings (clickable - opens debug window) ===
										button = {
											visible = "[Not(GetVariableSystem.Exists('pm_hide_buildings'))]"
											size = { 85 38 }
											datacontext = "[LocationsListViewItem.GetLocation]"
											onclick = "[GetScriptedGui('pm_sgui_open_debug_buildings').Execute(GuiScope.SetRoot(Location.MakeScope).End)]"
											onclick = "[GetVariableSystem.Set('pm_debug_open', 'true')]"
											tooltipwidget = { using = LocationBuildingLevels_tooltip }

											widget = {
												size = { 55 24 }
												parentanchor = center
												alwaystransparent = yes

												piechart = {
													visible = "[Not(Location.HasTooManyBuildingLevel)]"
													size = { 24 24 }
													using = bg_circle
													using = bg_circle_piechart
													using = piechart_angles
													alwaystransparent = yes
													pieslice_no_highlight = {
														texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
														value = "[Location.GetBuildingLevelsPercentage]"
														color = { 1 1 1 1 }
													}
													pieslice_no_highlight = {
														texture = "gfx/interface/pie_charts/pie_chart_alpha_80_green.dds"
														value = "[Subtract_float('(float)100.0', Location.GetBuildingLevelsPercentage)]"
														color = { 1 1 1 1 }
													}
													icon = {
														size = { 59% 59% }
														parentanchor = center
														texture = "[GetConceptTexture('supported_building_levels')]"
													}
												}
												piechart = {
													visible = "[Location.HasTooManyBuildingLevel]"
													size = { 24 24 }
													using = bg_circle
													using = bg_circle_piechart
													using = piechart_angles
													alwaystransparent = yes
													pieslice_no_highlight = {
														texture = "gfx/interface/pie_charts/pie_chart_alpha_80_red.dds"
														value = 100
														color = { 1 1 1 1 }
													}
													icon = {
														size = { 59% 59% }
														parentanchor = center
														texture = "[GetConceptTexture('supported_building_levels')]"
													}
												}

												text_single = {
													visible = "[Not(Location.HasTooManyBuildingLevel)]"
													position = { 29 0 }
													parentanchor = vcenter
													size = { 29 24 }
													autoresize = no
													align = left|nobaseline
													raw_text = "#G [Location.GetBuildingLevelsPercentage|0]%#!"
													alwaystransparent = yes
												}
												text_single = {
													visible = "[Location.HasTooManyBuildingLevel]"
													position = { 29 0 }
													parentanchor = vcenter
													size = { 29 24 }
													autoresize = no
													align = left|nobaseline
													raw_text = "#R [Location.GetBuildingLevelsPercentage|0]%#!"
													alwaystransparent = yes
												}
											}
										}

# === Active constructions column ===
										widget = {
											visible = "[Not(GetVariableSystem.Exists('pm_hide_active'))]"
											size = { 90 42 }
											datacontext = "[LocationsListViewItem.GetLocation]"

											vbox = {
												parentanchor = center
												spacing = -2

												# Count
												text_single = {
													visible = "[Not(IsDataModelEmpty(Location.GetCivilConstructions))]"
													autoresize = yes
													fontsize = 14
													align = center|nobaseline
													raw_text = "#Y [GetDataModelSize(Location.GetCivilConstructions)]#!"
													tooltipwidget = {
														widget = {
															size = { 300 -1 }
															dynamicgridbox = {
																set_parent_size_to_minimum = yes
																datamodel = "[Location.GetCivilConstructions]"
																item = {
																	widget = {
																		size = { 300 -1 }
																		using = Construction_tooltip
																	}
																}
															}
														}
													}
												}
												text_single = {
													visible = "[IsDataModelEmpty(Location.GetCivilConstructions)]"
													autoresize = yes
													fontsize = 14
													align = center|nobaseline
													raw_text = "#L —#!"
												}

												# Icons row: up to 4 icons, or 3 + "..."
												hbox = {
													visible = "[Not(IsDataModelEmpty(Location.GetCivilConstructions))]"
													spacing = 1

													# When 4 or fewer: show all
													dynamicgridbox = {
														visible = "[Not(GreaterThan_int32(GetDataModelSize(Location.GetCivilConstructions), '(int32)4'))]"
														flipdirection = yes
														datamodel = "[Location.GetCivilConstructions]"
														item = {
															icon = {
																size = { 18 18 }
																texture = "[GetConstructionIcon(Construction.Self)]"
																tooltip = "[Construction.GetNameWithNoTooltip]"
															}
														}
													}

													# When more than 4: show first 3 + "..."
													dynamicgridbox = {
														visible = "[GreaterThan_int32(GetDataModelSize(Location.GetCivilConstructions), '(int32)4')]"
														flipdirection = yes
														datamodel = "[DataModelFirst(Location.GetCivilConstructions, '(int32)3')]"
														item = {
															icon = {
																size = { 18 18 }
																texture = "[GetConstructionIcon(Construction.Self)]"
																tooltip = "[Construction.GetNameWithNoTooltip]"
															}
														}
													}
													text_single = {
														visible = "[GreaterThan_int32(GetDataModelSize(Location.GetCivilConstructions), '(int32)4')]"
														autoresize = yes
														fontsize = 12
														raw_text = "#L ...#!"
													}
												}
											}
										}
								}
							}
						}
					}
				}
			}
			} # vbox
			} # scrollwidget
			} # scrollarea

			# ============================================================
			# === CONSTRUCTIONS TAB ======================================
			# ============================================================
			vbox = {
				visible = "[GetVariableSystem.HasValue('pm_tab', 'constructions')]"
				using = layoutpolicy_expanding
				using = bg_main_inner_alt
				using = window_main_tabs_margin_alt
				margin_top = 10

				# Hidden: scan all locations' constructions for estate builds
				widget = {
					size = { 0 0 }
					fixedgridbox = {
						addcolumn = 1
						addrow = 1
					datamodel = "[LocationsListView.GetLocationsListView]"
					item = {
						widget = {
							size = { 0 0 }
							datacontext = "[LocationsListViewItem.GetLocation]"
							dynamicgridbox = {
								datamodel = "[Location.GetCivilConstructions]"
								item = {
									widget = {
										size = { 0 0 }
										state = {
											name = pm_scan_estate_constructions
											on_finish = "[GetScriptedGui('pm_sgui_mark_estate_loc').Execute(GuiScope.SetRoot(Location.MakeScope).AddScope('is_estate', MakeScopeValue(Select_CFixedPoint(Construction.IsBuiltByEstate, '(CFixedPoint)1', '(CFixedPoint)0'))).End)]"
										}
									}
								}
							}
						}
					}
				}
				}

				filtered_sorted_list = {
					margin_top = 10
					datacontext = "[LocationsListView.GetLocationsListSortSearch]"

					blockoverride "searchbar_visible" {
						visible = no
					}

					blockoverride "extra_searchbar_content" {
						hbox = {
							layoutpolicy_horizontal = expanding
							margin = { 5 0 }
							spacing = 8

							# Tab title
							text_single = {
								parentanchor = vcenter
								autoresize = yes
								fontsize = 13
								text = "PM_CONSTRUCTIONS_SUMMARY"
							}

							expand = {}

							# Filter: active only
							button_checkbox_auto = {
								parentanchor = vcenter
								size = { 22 22 }
								down = "[GetVariableSystem.Exists('pm_filter_constructions')]"
								onclick = "[GetVariableSystem.Toggle('pm_filter_constructions')]"
								tooltip = "PM_FILTER_CONSTRUCTIONS_TT"
							}
							text_single = {
								parentanchor = vcenter
								fontsize = 12
								text = "PM_FILTER_CONSTRUCTIONS"
							}

							# Filter: stalled only
							button_checkbox_auto = {
								parentanchor = vcenter
								size = { 22 22 }
								down = "[GetVariableSystem.Exists('pm_filter_stalled')]"
								onclick = "[GetVariableSystem.Toggle('pm_filter_stalled')]"
								tooltip = "PM_FILTER_STALLED_TT"
							}
							text_single = {
								parentanchor = vcenter
								fontsize = 12
								text = "PM_FILTER_STALLED"
							}

							# Filter: estate builds
							button_checkbox_auto = {
								parentanchor = vcenter
								size = { 22 22 }
								down = "[GetVariableSystem.Exists('pm_filter_estate')]"
								onclick = "[GetVariableSystem.Toggle('pm_filter_estate')]"
								onclick = "[GetScriptedGui('pm_sgui_clear_estate_flags').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[PdxGuiTriggerAllAnimations('pm_scan_estate_constructions')]"
								tooltip = "PM_FILTER_ESTATE_TT"
							}
							text_single = {
								parentanchor = vcenter
								margin_right = 5
								fontsize = 12
								text = "PM_FILTER_ESTATE"
							}
						}

						expand = {}
					}

					blockoverride "sort_buttons_filtered_list" {
						sort_by_key_button = {
							name = "name"
							size = { 140 -1 }
							using = layoutpolicy_expanding
						}
						widget = { size = { 0 -1 } using = layoutpolicy_expanding
							hbox = { parentanchor = vcenter spacing = 3
								icon = { size = { 16 16 } texture = "gfx/interface/icons/flat_icons/building_panel/build.dds" }
								text_single = { fontsize = 13 text = "PM_TAB_CONSTRUCTIONS" }
							}
						}
					}

					blockoverride "scroll_list_content" {
						addcolumn = 100%
						addrow = 80
						setitemsizefromcell = yes
							datamodel = "[LocationsListView.GetLocationsListView]"
							item = {
								widget = {
									datacontext = "[LocationsListViewItem.GetLocation]"
									visible = "[And(And(Or(Not(GetVariableSystem.Exists('pm_filter_constructions')), Not(IsDataModelEmpty(Location.GetCivilConstructions))), Or(Not(GetVariableSystem.Exists('pm_filter_stalled')), Location.HasStalledConstruction)), Or(Not(GetVariableSystem.Exists('pm_filter_estate')), Location.MakeScope.Var('pm_has_estate_build').IsSet))]"
									size = { 1870 80 }
									using = bg_scroll_card

									hbox = {
										size = { 100% 80 }
										margin = { 10 2 }
										spacing = 3

										# Location name (clickable)
										button = {
											size = { 140 76 }
											onclick = "[ShowLocation(Location.Self)]"
											tooltipwidget = { using = location_simple_tooltip }

											hbox = {
												margin_left = 5
												spacing = 3
												icon = {
													size = { 24 24 }
													texture = "[Location.GetRankIcon]"
												}
												text_single = {
													autoresize = no
													size = { 110 -1 }
													text = "[Location.GetNameWithNoTooltip]"
													default_format = "#yellow_titles"
													align = left|nobaseline
													fontsize = 14
												}
											}
										}

										# Construction cards (horizontal)
										hbox = {
											layoutpolicy_horizontal = expanding
											spacing = 3

											dynamicgridbox = {
												datamodel = "[Location.GetCivilConstructions]"
												flipdirection = yes
												item = {
													button = {
														size = { 58 76 }
														visible = "[Or(Not(GetVariableSystem.Exists('pm_filter_estate')), Construction.IsBuiltByEstate)]"

														tooltipwidget = {
															using = Construction_tooltip
														}

														# Right-click: cancel this construction
														action_tooltip = {
															click_type = right
															click_mode = single
															title = "CANCEL_CONSTRUCTION"
															enabled = "[CanCancelConstruction(Construction.Self)]"
															on_action = "[ShowConstructionCancellationDialog(Construction.Self, '(bool)no')]"
														}

														# Card frame (production goods style)
														widget = {
															parentanchor = hcenter
															position = { 0 2 }
															size = { 50 72 }
															alwaystransparent = yes

															# Icon with frame
															widget = {
																parentanchor = hcenter
																position = { 0 2 }
																size = { 44 44 }
																alwaystransparent = yes

																background = {
																	texture = "gfx/interface/component_tiles/balance_card_bg.dds"
																	margin = { -2 -2 }
																	modify_texture = {
																		using = color_production_texture
																		alpha = 0.5
																	}
																}
																background = {
																	using = default_border_03
																	margin = { -4 -4 }
																}

																# Building icon
																icon = {
																	parentanchor = center
																	size = { 30 30 }
																	texture = "[GetConstructionIcon(Construction.Self)]"
																	alwaystransparent = yes
																}
																# Estate badge overlay
																icon = {
																	visible = "[Construction.IsBuiltByEstate]"
																	parentanchor = top|right
																	position = { 6 -6 }
																	size = { 24 24 }
																	texture = "[GetEstateIcon(Construction.GetEstateType)]"
																	alwaystransparent = yes
																}
															}

															# Progress bar
															progressbar = {
																parentanchor = hcenter
																position = { 0 48 }
																size = { 44 5 }
																using = progress_bar_green_alt
																value = "[Construction.GetProgress]"
																alwaystransparent = yes
															}

															# Days below progress bar
															text_single = {
																visible = "[Not(Construction.IsStalled)]"
																parentanchor = hcenter|bottom
																position = { 0 -2 }
																autoresize = yes
																fontsize = 11
																align = center|nobaseline
																raw_text = "[Construction.GetDurationInDays] #L d#!"
																alwaystransparent = yes
															}
															# Stalled: show missing goods
															text_single = {
																visible = "[Construction.IsStalled]"
																parentanchor = hcenter|bottom
																position = { 0 -2 }
																autoresize = yes
																fontsize = 10
																align = center|nobaseline
																raw_text = "#R STALL#!"
																tooltip = "[Construction.GetMissingGoodsInfo]"
																alwaystransparent = yes
															}

															# Stalled overlay
															icon = {
																visible = "[Construction.IsStalled]"
																parentanchor = top|right
																position = { 2 2 }
																size = { 16 16 }
																using = warning_icon_texture
																alwaystransparent = yes
															}
														}
													}
												}
											}

											widget = {
												layoutpolicy_horizontal = expanding
												alwaystransparent = yes
											}
										}
									}
								}
							}
					}
				}
			}
		}
	}
}
