											tooltipwidget = { using = location_prosperity_tooltip }

											vbox = {
												parentanchor = center
												spacing = -2

												text_single = {
													autoresize = yes
													fontsize = 14
													align = center|nobaseline
													raw_text = "[Location.GetProsperity|0%]"
												}

