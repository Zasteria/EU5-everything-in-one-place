													fontsize = 14
													align = center|nobaseline
													raw_text = "[Location.GetNetBalance|+2]"
													default_format = "#color_green"
												}
												text_single = {
													visible = "[Not(GreaterThanOrEqualTo_CFixedPoint(Location.GetNetBalance, '(CFixedPoint)0'))]"
													autoresize = yes
													fontsize = 14
													align = center|nobaseline
													raw_text = "[Location.GetNetBalance|+2]"
													default_format = "#color_red"
												}
											}
