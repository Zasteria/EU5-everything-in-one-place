						button_checkbox_auto = { size = { 22 22 } down = "[Not(GetVariableSystem.Exists('pm_hide_laborers'))]" onclick = "[GetVariableSystem.Toggle('pm_hide_laborers')]" }
						text_single = { fontsize = 13 text = "PM_COL_SET_LABORERS" }
