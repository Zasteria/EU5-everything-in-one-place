							onclick = "[GetVariableSystem.Set('pm_hide_peasants', 'yes')]"
							onclick = "[GetVariableSystem.Set('pm_hide_tribesmen', 'yes')]"
							onclick = "[GetVariableSystem.Set('pm_hide_slaves', 'yes')]"
