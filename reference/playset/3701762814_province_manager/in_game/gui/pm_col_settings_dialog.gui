	}

	blockoverride "bottom_buttons" {
		expand = {}
		button_regular_icon = {
			size = { 120 36 }
			onclick = "[GetVariableSystem.Clear('pm_col_settings')]"
			input_action = "close_window"

			blockoverride "button_text" {
				text = "PM_COL_SETTINGS_CLOSE"
			}
		}
		expand = {}
	}
}
