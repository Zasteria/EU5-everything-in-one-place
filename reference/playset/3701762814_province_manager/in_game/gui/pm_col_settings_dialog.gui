						text_single = { fontsize = 13 text = "PM_COL_SET_ACTIVE" }
						expand = {}
					}
				}

				# --- Estates ---
				widget = {
					layoutpolicy_horizontal = expanding
					size = { -1 28 }
					using = bg_card_header_01
					using = bg_cabinet_card_frame
					hbox = {
						margin = { 4 0 }
