### Column visibility settings dialog

basic_dialog = {
	name = "pm_col_settings_dialog"
	layer = top
	visible = "[GetVariableSystem.Exists('pm_col_settings')]"
	filter_mouse = all

	blockoverride "header_text" {
		text = "PM_COL_SETTINGS_TITLE"
	}

	blockoverride "dialog_size" {
		minimumsize = { 900 200 }
		maximumsize = { 900 800 }
	}

	blockoverride "block_scrollarea" {
		maximumsize = { -1 550 }
	}

	blockoverride "content" {
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 8
			margin = { 15 10 }

			# ==================== COLUMN A ====================
			vbox = {
				layoutpolicy_horizontal = expanding
				spacing = 4

				# --- General ---
				widget = {
					layoutpolicy_horizontal = expanding
					size = { -1 28 }
					using = bg_card_header_01
					using = bg_cabinet_card_frame
					hbox = {
						margin = { 4 0 }
						spacing = 4
						# ON → toggle off + hide all
						button = {
							visible = "[Not(GetVariableSystem.Exists('pm_hide_grp_general'))]"
							size = { 20 20 }
							onclick = "[GetVariableSystem.Set('pm_hide_grp_general', 'yes')]"
							onclick = "[GetVariableSystem.Set('pm_hide_rank', 'yes')]"
							onclick = "[GetVariableSystem.Set('pm_hide_religion', 'yes')]"
							onclick = "[GetVariableSystem.Set('pm_hide_culture', 'yes')]"
							onclick = "[GetVariableSystem.Set('pm_hide_town_rights', 'yes')]"
							onclick = "[GetVariableSystem.Set('pm_hide_cores', 'yes')]"
							icon = { size = { 100% 100% } texture = "gfx/interface/buttons/checkbox_auto.dds" texture_density = 2 frame_grid = { 2 1 } frame = 2 }
						}
						# OFF → toggle on + show all
						button = {
							visible = "[GetVariableSystem.Exists('pm_hide_grp_general')]"
							size = { 20 20 }
							onclick = "[GetVariableSystem.Clear('pm_hide_grp_general')]"
							onclick = "[GetVariableSystem.Clear('pm_hide_rank')]"
							onclick = "[GetVariableSystem.Clear('pm_hide_religion')]"
							onclick = "[GetVariableSystem.Clear('pm_hide_culture')]"
							onclick = "[GetVariableSystem.Clear('pm_hide_town_rights')]"
							onclick = "[GetVariableSystem.Clear('pm_hide_cores')]"
							icon = { size = { 100% 100% } texture = "gfx/interface/buttons/checkbox_auto.dds" texture_density = 2 frame_grid = { 2 1 } frame = 1 }
						}
						text_single = { fontsize = 14 text = "PM_COL_GROUP_GENERAL" }
						expand = {}
					}
				}
				vbox = {
					layoutpolicy_horizontal = expanding
					using = bg_paper_card
					margin = { 5 4 }
					spacing = 3

					hbox = { spacing = 4 layoutpolicy_horizontal = expanding
						button_checkbox_auto = { size = { 22 22 } down = "[Not(GetVariableSystem.Exists('pm_hide_rank'))]" onclick = "[GetVariableSystem.Toggle('pm_hide_rank')]" }
						text_single = { fontsize = 13 text = "PM_COL_SET_RANK" }
						expand = {}
					}
					hbox = { spacing = 4 layoutpolicy_horizontal = expanding
						button_checkbox_auto = { size = { 22 22 } down = "[Not(GetVariableSystem.Exists('pm_hide_religion'))]" onclick = "[GetVariableSystem.Toggle('pm_hide_religion')]" }
						text_single = { fontsize = 13 text = "PM_COL_SET_RELIGION" }
						expand = {}
					}
					hbox = { spacing = 4 layoutpolicy_horizontal = expanding
						button_checkbox_auto = { size = { 22 22 } down = "[Not(GetVariableSystem.Exists('pm_hide_culture'))]" onclick = "[GetVariableSystem.Toggle('pm_hide_culture')]" }
						text_single = { fontsize = 13 text = "PM_COL_SET_CULTURE" }
						expand = {}
					}
					hbox = { spacing = 4 layoutpolicy_horizontal = expanding
						button_checkbox_auto = { size = { 22 22 } down = "[Not(GetVariableSystem.Exists('pm_hide_town_rights'))]" onclick = "[GetVariableSystem.Toggle('pm_hide_town_rights')]" }
						text_single = { fontsize = 13 text = "PM_COL_SET_TOWNRIGHTS" }
						expand = {}
					}
					hbox = { spacing = 4 layoutpolicy_horizontal = expanding
						button_checkbox_auto = { size = { 22 22 } down = "[Not(GetVariableSystem.Exists('pm_hide_cores'))]" onclick = "[GetVariableSystem.Toggle('pm_hide_cores')]" }
						text_single = { fontsize = 13 text = "PM_COL_SET_CORES" }
						expand = {}
					}
				}

				# --- Demographics ---
				widget = {
					layoutpolicy_horizontal = expanding
					size = { -1 28 }
					using = bg_card_header_01
					using = bg_cabinet_card_frame
					hbox = {
						margin = { 4 0 }
						spacing = 4
						button = {
							visible = "[Not(GetVariableSystem.Exists('pm_hide_grp_demo'))]"
							size = { 20 20 }
							onclick = "[GetVariableSystem.Set('pm_hide_grp_demo', 'yes')]"
							onclick = "[GetVariableSystem.Set('pm_hide_pop', 'yes')]"
							onclick = "[GetVariableSystem.Set('pm_hide_literacy', 'yes')]"
							onclick = "[GetVariableSystem.Set('pm_hide_manpower', 'yes')]"
							onclick = "[GetVariableSystem.Set('pm_hide_food', 'yes')]"
							onclick = "[GetVariableSystem.Set('pm_hide_migration', 'yes')]"
							onclick = "[GetVariableSystem.Set('pm_hide_sailors', 'yes')]"
							icon = { size = { 100% 100% } texture = "gfx/interface/buttons/checkbox_auto.dds" texture_density = 2 frame_grid = { 2 1 } frame = 2 }
						}
						button = {
							visible = "[GetVariableSystem.Exists('pm_hide_grp_demo')]"
							size = { 20 20 }
							onclick = "[GetVariableSystem.Clear('pm_hide_grp_demo')]"
							onclick = "[GetVariableSystem.Clear('pm_hide_pop')]"
							onclick = "[GetVariableSystem.Clear('pm_hide_literacy')]"
							onclick = "[GetVariableSystem.Clear('pm_hide_manpower')]"
							onclick = "[GetVariableSystem.Clear('pm_hide_food')]"
							onclick = "[GetVariableSystem.Clear('pm_hide_migration')]"
							onclick = "[GetVariableSystem.Clear('pm_hide_sailors')]"
							icon = { size = { 100% 100% } texture = "gfx/interface/buttons/checkbox_auto.dds" texture_density = 2 frame_grid = { 2 1 } frame = 1 }
						}
						text_single = { fontsize = 14 text = "PM_COL_GROUP_DEMO" }
						expand = {}
					}
				}
				vbox = {
					layoutpolicy_horizontal = expanding
					using = bg_paper_card
					margin = { 5 4 }
					spacing = 3

					hbox = { spacing = 4 layoutpolicy_horizontal = expanding
						button_checkbox_auto = { size = { 22 22 } down = "[Not(GetVariableSystem.Exists('pm_hide_pop'))]" onclick = "[GetVariableSystem.Toggle('pm_hide_pop')]" }
						text_single = { fontsize = 13 text = "PM_COL_SET_POP" }
						expand = {}
					}
					hbox = { spacing = 4 layoutpolicy_horizontal = expanding
						button_checkbox_auto = { size = { 22 22 } down = "[Not(GetVariableSystem.Exists('pm_hide_literacy'))]" onclick = "[GetVariableSystem.Toggle('pm_hide_literacy')]" }
						text_single = { fontsize = 13 text = "PM_COL_SET_LITERACY" }
						expand = {}
					}
					hbox = { spacing = 4 layoutpolicy_horizontal = expanding
						button_checkbox_auto = { size = { 22 22 } down = "[Not(GetVariableSystem.Exists('pm_hide_manpower'))]" onclick = "[GetVariableSystem.Toggle('pm_hide_manpower')]" }
						text_single = { fontsize = 13 text = "PM_COL_SET_MANPOWER" }
						expand = {}
					}
					hbox = { spacing = 4 layoutpolicy_horizontal = expanding
						button_checkbox_auto = { size = { 22 22 } down = "[Not(GetVariableSystem.Exists('pm_hide_food'))]" onclick = "[GetVariableSystem.Toggle('pm_hide_food')]" }
						text_single = { fontsize = 13 text = "PM_COL_SET_FOOD" }
						expand = {}
					}
					hbox = { spacing = 4 layoutpolicy_horizontal = expanding
						button_checkbox_auto = { size = { 22 22 } down = "[Not(GetVariableSystem.Exists('pm_hide_migration'))]" onclick = "[GetVariableSystem.Toggle('pm_hide_migration')]" }
						text_single = { fontsize = 13 text = "PM_COL_SET_MIGRATION" }
						expand = {}
					}
					hbox = { spacing = 4 layoutpolicy_horizontal = expanding
						button_checkbox_auto = { size = { 22 22 } down = "[Not(GetVariableSystem.Exists('pm_hide_sailors'))]" onclick = "[GetVariableSystem.Toggle('pm_hide_sailors')]" }
						text_single = { fontsize = 13 text = "PM_COL_SET_SAILORS" }
						expand = {}
					}
				}

				# --- Economy ---
				widget = {
					layoutpolicy_horizontal = expanding
					size = { -1 28 }
					using = bg_card_header_01
					using = bg_cabinet_card_frame
					hbox = {
						margin = { 4 0 }
						spacing = 4
						button = {
							visible = "[Not(GetVariableSystem.Exists('pm_hide_grp_economy'))]"
							size = { 20 20 }
							onclick = "[GetVariableSystem.Set('pm_hide_grp_economy', 'yes')]"
							onclick = "[GetVariableSystem.Set('pm_hide_tax', 'yes')]"
							onclick = "[GetVariableSystem.Set('pm_hide_balance', 'yes')]"
							onclick = "[GetVariableSystem.Set('pm_hide_rgo', 'yes')]"
							onclick = "[GetVariableSystem.Set('pm_hide_market', 'yes')]"
							icon = { size = { 100% 100% } texture = "gfx/interface/buttons/checkbox_auto.dds" texture_density = 2 frame_grid = { 2 1 } frame = 2 }
						}
						button = {
							visible = "[GetVariableSystem.Exists('pm_hide_grp_economy')]"
							size = { 20 20 }
							onclick = "[GetVariableSystem.Clear('pm_hide_grp_economy')]"
							onclick = "[GetVariableSystem.Clear('pm_hide_tax')]"
							onclick = "[GetVariableSystem.Clear('pm_hide_balance')]"
							onclick = "[GetVariableSystem.Clear('pm_hide_rgo')]"
							onclick = "[GetVariableSystem.Clear('pm_hide_market')]"
							icon = { size = { 100% 100% } texture = "gfx/interface/buttons/checkbox_auto.dds" texture_density = 2 frame_grid = { 2 1 } frame = 1 }
						}
						text_single = { fontsize = 14 text = "PM_COL_GROUP_ECONOMY" }
						expand = {}
					}
				}
				vbox = {
					layoutpolicy_horizontal = expanding
					using = bg_paper_card
					margin = { 5 4 }
					spacing = 3

					hbox = { spacing = 4 layoutpolicy_horizontal = expanding
						button_checkbox_auto = { size = { 22 22 } down = "[Not(GetVariableSystem.Exists('pm_hide_tax'))]" onclick = "[GetVariableSystem.Toggle('pm_hide_tax')]" }
						text_single = { fontsize = 13 text = "PM_COL_SET_TAX" }
						expand = {}
					}
					hbox = { spacing = 4 layoutpolicy_horizontal = expanding
						button_checkbox_auto = { size = { 22 22 } down = "[Not(GetVariableSystem.Exists('pm_hide_balance'))]" onclick = "[GetVariableSystem.Toggle('pm_hide_balance')]" }
						text_single = { fontsize = 13 text = "PM_COL_SET_BALANCE" }
						expand = {}
					}
					hbox = { spacing = 4 layoutpolicy_horizontal = expanding
						button_checkbox_auto = { size = { 22 22 } down = "[Not(GetVariableSystem.Exists('pm_hide_rgo'))]" onclick = "[GetVariableSystem.Toggle('pm_hide_rgo')]" }
						text_single = { fontsize = 13 text = "PM_COL_SET_RGO" }
						expand = {}
					}
					hbox = { spacing = 4 layoutpolicy_horizontal = expanding
						button_checkbox_auto = { size = { 22 22 } down = "[Not(GetVariableSystem.Exists('pm_hide_market'))]" onclick = "[GetVariableSystem.Toggle('pm_hide_market')]" }
						text_single = { fontsize = 13 text = "PM_COL_SET_MARKET" }
						expand = {}
					}
				}
			}

			# ==================== COLUMN B ====================
			vbox = {
				layoutpolicy_horizontal = expanding
				spacing = 4

				# --- Development ---
				widget = {
					layoutpolicy_horizontal = expanding
					size = { -1 28 }
					using = bg_card_header_01
					using = bg_cabinet_card_frame
					hbox = {
						margin = { 4 0 }
						spacing = 4
						button = {
							visible = "[Not(GetVariableSystem.Exists('pm_hide_grp_dev'))]"
							size = { 20 20 }
							onclick = "[GetVariableSystem.Set('pm_hide_grp_dev', 'yes')]"
							onclick = "[GetVariableSystem.Set('pm_hide_dev', 'yes')]"
							onclick = "[GetVariableSystem.Set('pm_hide_prosperity', 'yes')]"
							onclick = "[GetVariableSystem.Set('pm_hide_control', 'yes')]"
							onclick = "[GetVariableSystem.Set('pm_hide_enfranchisement', 'yes')]"
							icon = { size = { 100% 100% } texture = "gfx/interface/buttons/checkbox_auto.dds" texture_density = 2 frame_grid = { 2 1 } frame = 2 }
						}
						button = {
							visible = "[GetVariableSystem.Exists('pm_hide_grp_dev')]"
							size = { 20 20 }
							onclick = "[GetVariableSystem.Clear('pm_hide_grp_dev')]"
							onclick = "[GetVariableSystem.Clear('pm_hide_dev')]"
							onclick = "[GetVariableSystem.Clear('pm_hide_prosperity')]"
							onclick = "[GetVariableSystem.Clear('pm_hide_control')]"
							onclick = "[GetVariableSystem.Clear('pm_hide_enfranchisement')]"
							icon = { size = { 100% 100% } texture = "gfx/interface/buttons/checkbox_auto.dds" texture_density = 2 frame_grid = { 2 1 } frame = 1 }
						}
						text_single = { fontsize = 14 text = "PM_COL_GROUP_DEV" }
						expand = {}
					}
				}
				vbox = {
					layoutpolicy_horizontal = expanding
					using = bg_paper_card
					margin = { 5 4 }
					spacing = 3

					hbox = { spacing = 4 layoutpolicy_horizontal = expanding
						button_checkbox_auto = { size = { 22 22 } down = "[Not(GetVariableSystem.Exists('pm_hide_dev'))]" onclick = "[GetVariableSystem.Toggle('pm_hide_dev')]" }
						text_single = { fontsize = 13 text = "PM_COL_SET_DEV" }
						expand = {}
					}
					hbox = { spacing = 4 layoutpolicy_horizontal = expanding
						button_checkbox_auto = { size = { 22 22 } down = "[Not(GetVariableSystem.Exists('pm_hide_prosperity'))]" onclick = "[GetVariableSystem.Toggle('pm_hide_prosperity')]" }
						text_single = { fontsize = 13 text = "PM_COL_SET_PROSPERITY" }
						expand = {}
					}
					hbox = { spacing = 4 layoutpolicy_horizontal = expanding
						button_checkbox_auto = { size = { 22 22 } down = "[Not(GetVariableSystem.Exists('pm_hide_control'))]" onclick = "[GetVariableSystem.Toggle('pm_hide_control')]" }
						text_single = { fontsize = 13 text = "PM_COL_SET_CONTROL" }
						expand = {}
					}
					hbox = { spacing = 4 layoutpolicy_horizontal = expanding
						button_checkbox_auto = { size = { 22 22 } down = "[Not(GetVariableSystem.Exists('pm_hide_enfranchisement'))]" onclick = "[GetVariableSystem.Toggle('pm_hide_enfranchisement')]" }
						text_single = { fontsize = 13 text = "PM_COL_SET_ENFRANCHISEMENT" }
						expand = {}
					}
				}

				# --- Construction ---
				widget = {
					layoutpolicy_horizontal = expanding
					size = { -1 28 }
					using = bg_card_header_01
					using = bg_cabinet_card_frame
					hbox = {
						margin = { 4 0 }
						spacing = 4
						button = {
							visible = "[Not(GetVariableSystem.Exists('pm_hide_grp_build'))]"
							size = { 20 20 }
							onclick = "[GetVariableSystem.Set('pm_hide_grp_build', 'yes')]"
							onclick = "[GetVariableSystem.Set('pm_hide_build', 'yes')]"
							onclick = "[GetVariableSystem.Set('pm_hide_buildings', 'yes')]"
							onclick = "[GetVariableSystem.Set('pm_hide_active', 'yes')]"
							icon = { size = { 100% 100% } texture = "gfx/interface/buttons/checkbox_auto.dds" texture_density = 2 frame_grid = { 2 1 } frame = 2 }
						}
						button = {
							visible = "[GetVariableSystem.Exists('pm_hide_grp_build')]"
							size = { 20 20 }
							onclick = "[GetVariableSystem.Clear('pm_hide_grp_build')]"
							onclick = "[GetVariableSystem.Clear('pm_hide_build')]"
							onclick = "[GetVariableSystem.Clear('pm_hide_buildings')]"
							onclick = "[GetVariableSystem.Clear('pm_hide_active')]"
							icon = { size = { 100% 100% } texture = "gfx/interface/buttons/checkbox_auto.dds" texture_density = 2 frame_grid = { 2 1 } frame = 1 }
						}
						text_single = { fontsize = 14 text = "PM_COL_GROUP_BUILD" }
						expand = {}
					}
				}
				vbox = {
					layoutpolicy_horizontal = expanding
					using = bg_paper_card
					margin = { 5 4 }
					spacing = 3

					hbox = { spacing = 4 layoutpolicy_horizontal = expanding
						button_checkbox_auto = { size = { 22 22 } down = "[Not(GetVariableSystem.Exists('pm_hide_build'))]" onclick = "[GetVariableSystem.Toggle('pm_hide_build')]" }
						text_single = { fontsize = 13 text = "PM_COL_SET_BUILD" }
						expand = {}
					}
					hbox = { spacing = 4 layoutpolicy_horizontal = expanding
						button_checkbox_auto = { size = { 22 22 } down = "[Not(GetVariableSystem.Exists('pm_hide_buildings'))]" onclick = "[GetVariableSystem.Toggle('pm_hide_buildings')]" }
