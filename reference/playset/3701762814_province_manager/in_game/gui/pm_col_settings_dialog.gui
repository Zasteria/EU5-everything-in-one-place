							onclick = "[GetVariableSystem.Clear('pm_hide_laborers')]"
							onclick = "[GetVariableSystem.Clear('pm_hide_soldiers')]"
							onclick = "[GetVariableSystem.Clear('pm_hide_peasants')]"
							onclick = "[GetVariableSystem.Clear('pm_hide_tribesmen')]"
