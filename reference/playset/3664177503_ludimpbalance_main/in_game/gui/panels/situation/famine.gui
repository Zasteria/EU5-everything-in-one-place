situation_panel = {

	##################################### TOP HEADER #####################################

	blockoverride "situation_header_center" {
		vbox = {
			layoutpolicy_horizontal = expanding
			text_single = {
				layoutpolicy_horizontal = expanding
				align = center
				text = "ludi_great_asian_famine_years_header"
				default_format = "#subtle_name"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				align = center
				fontsize = 13
				text = "ludi_great_asian_famine_years_value"
			}
		}
	}

	blockoverride "situation_header_right" {
		expand = {}

		vbox = {
			layoutpolicy_horizontal = expanding
			text_single = {
				layoutpolicy_horizontal = expanding
				align = right|nobaseline
				text = "ludi_great_asian_famine_deaths_header"
				default_format = "#subtle_name"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				align = right|nobaseline
				fontsize = 13
				raw_text = "[Multiply_CFixedPoint(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('ludi_famine_total_deaths').GetValue, '(CFixedPoint)1000')|0L]@population!"
			}
		}

		icon = {
			size = { 32 32 }
			texture = "gfx/interface/icons/location_icons/population.dds"
		}

		tooltipwidget = {
			SimpleContextualTooltipType = {
				blockoverride "title_icon" {
					icon = {
						using = tooltip_title_icon_size
						texture = "gfx/interface/icons/location_icons/population.dds"
					}
				}

				blockoverride "concept_link" {
					text = "[population|e]"
				}

				lowpriotextcontext = "ludi_great_asian_famine_deaths_tt"
			}
		}
	}

	##################################### MAIN IMAGE #####################################

	# Default situation illustration from common.gui.

	##################################### SUBHEADER #####################################

	blockoverride "situation_subheader_content" {}

	##################################### MAIN CONTENT #####################################

	blockoverride "situation_panel_main_content" {
		situation_card_expandable = {
			blockoverride "header_button_onclick" {
				onclick = "[LateralView.Vars.Toggle( 'requirements_toggled' )]"
			}
			blockoverride "header_text" {
				text = "END_REQUIREMENTS"
			}
			blockoverride "header_icon" {
				texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
			}
			blockoverride "bottom_content" {
				TooltipRequirementsList = {
					textcontext = "[SituationView.GetActiveSituation.GetSituation.GetEndConditions]"
				}
			}
			blockoverride "visible_hint" {
				visible = no
			}
			blockoverride "bottom_content_onclick" {
				visible = "[LateralView.Vars.Exists( 'requirements_toggled' )]"
			}
			blockoverride "icon_replace_visible_yes" {
				visible = "[LateralView.Vars.Exists( 'requirements_toggled' )]"
			}
			blockoverride "icon_replace_visible_not" {
				visible = "[Not(LateralView.Vars.Exists( 'requirements_toggled' ))]"
			}
		}

		situation_card_expandable = {
			blockoverride "header_button_onclick" {
				onclick = "[LateralView.Vars.Toggle( 'famine_overview_toggled' )]"
			}
			blockoverride "header_text" {
				text = "ludi_great_asian_famine_overview_header"
			}
			blockoverride "header_icon" {
				texture = "[SituationView.GetActiveSituation.GetIcon]"
			}
			blockoverride "bottom_content" {
				text_multi = {
					layoutpolicy_horizontal = expanding
					autoresize = yes
					multiline = yes
					text = "ludi_great_asian_famine_panel_overview"
				}
			}
			blockoverride "visible_hint" {
				visible = no
			}
			blockoverride "bottom_content_onclick" {
				visible = "[LateralView.Vars.Exists( 'famine_overview_toggled' )]"
			}
			blockoverride "icon_replace_visible_yes" {
				visible = "[LateralView.Vars.Exists( 'famine_overview_toggled' )]"
			}
			blockoverride "icon_replace_visible_not" {
				visible = "[Not(LateralView.Vars.Exists( 'famine_overview_toggled' ))]"
			}
		}
	}
}
