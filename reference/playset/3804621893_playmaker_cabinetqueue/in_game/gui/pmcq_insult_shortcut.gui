# Expire failed opens even if the Declare War window closes while the game is paused.
template pmcq_insult_shortcut_controller {
    using = pmcq_native_shortcut_timeout
    # Let the insult confirmation finish closing before reopening war preparation.
    widget = {
        size = { 1 1 }
        ignore_layout = yes
        alwaystransparent = yes
        dynamicgridbox = {
            datamodel = "[DataModelRepeatedItem(Select_int32(GetVariableSystem.HasValue('pmcq_insult_return_war', 'yes'), '(int32)1', '(int32)0'))]"
            item = { widget = { size = { 1 1 }
                state = {
                    name = pmcq_return_to_war_after_insult
                    trigger_on_create = yes
                    alpha = 0.99
                    duration = 0.15
                    on_finish = "[GetVariableSystem.Set('pmcq_insult_return_war', 'no')]"
                    on_finish = "[GetVariableSystem.Set('pmcq_shortcut_target', GetVariableSystem.Get('pmcq_insult_war_target'))]"
                    on_finish = "[GetVariableSystem.Set('pmcq_shortcut_key', 'return_declare_war')]"
                    on_finish = "[GetVariableSystem.Set('pmcq_shortcut_category', 'CATEGORY_HOSTILE_ACTIONS')]"
                    on_finish = "[GetVariableSystem.Set('pmcq_shortcut_pending', 'yes')]"
                }
            } }
        }
    }
    widget = {
        size = { 1 1 }
        ignore_layout = yes
        alwaystransparent = yes
        dynamicgridbox = {
            datamodel = "[DataModelRepeatedItem(Select_int32(GetVariableSystem.HasValue('pmcq_insult_quick_accept', 'yes'), '(int32)1', '(int32)0'))]"
            item = {
                widget = {
                    size = { 1 1 }
                    state = {
                        name = pmcq_expire_insult_request
                        trigger_on_create = yes
                        alpha = 0.99
                        duration = 3
                        on_finish = "[GetVariableSystem.Set('pmcq_insult_quick_accept', 'no')]"
                    }
                }
            }
        }
    }
}

# Shared shortcut expiry. This runs while paused and survives closing the source panel.
template pmcq_native_shortcut_timeout {
    widget = {
        size = { 1 1 }
        ignore_layout = yes
        alwaystransparent = yes
        dynamicgridbox = {
            datamodel = "[DataModelRepeatedItem(Select_int32(Or(GetVariableSystem.HasValue('pmcq_shortcut_pending', 'yes'), GetVariableSystem.HasValue('pmcq_shortcut_pending', 'inspect')), '(int32)1', '(int32)0'))]"
            item = { widget = { size = { 1 1 }
                state = {
                    name = pmcq_expire_native_shortcut
                    trigger_on_create = yes
                    alpha = 0.99
                    duration = 1.5
                    on_finish = "[GetVariableSystem.Set('pmcq_shortcut_pending', 'no')]"
                }
            } }
        }
    }
}
