                visible = "[GetScriptedGui('pmcqpriv_unowned_trade_monopolies').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                onclick = "[GetScriptedGui('pmcqpriv_toggle_trade_monopolies').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
