                icon = { size = { 100% 3 } parentanchor = bottom|left widgetanchor = bottom|left using = color_yellow_texture alwaystransparent = yes visible = "[GetScriptedGui('pmcqpriv_selected_trade_monopolies').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
