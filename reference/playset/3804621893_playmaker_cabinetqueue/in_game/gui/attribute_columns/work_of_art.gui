types WorkOfArtColumns
{
	type art_quality = select_cell_default {
		size = { 100 32 }

		sort_by_highlight = {
			size = { 100% 100% }
			name = "quality"
		}

		icon = {
			size = { 24 24 }
			parentanchor = center
			texture = "[GetWorkOfArtQualityIcon(WorkOfArt.GetQuality)]"
		}

		datacontext = "[InteractionTarget.GetWorkOfArt]"
		tooltipwidget = {
			using = QualityOfArt_tooltip
		}
	}

	type art_location = select_cell_default {
		size = { 100 32 }

		sort_by_highlight = {
			size = { 100% 100% }
			name = "location"
		}

		hbox = {
			text_single = {
				using = layoutpolicy_expanding
				autoresize = yes
				text = "[InteractionTarget.GetWorkOfArt.GetLocation.GetNameWithNoTooltip|L]"
			}
		}

		tagtooltip_enabled = yes
		tooltip = "[InteractionTarget.GetWorkOfArt.GetLocation.GetName]"
	}

 type pmcq_art_gold_sale = select_cell_default {
  size = { 100 32 }
  sort_by_highlight = { size = { 100% 100% } name = "pmcq_art_gold_sale" }
  text_single = {
   size = { 100% 100% }
   align = center|vcenter
   text = "[GuiScope.SetRoot(InteractionTarget.GetWorkOfArt.MakeScope).ScriptValue('pmcq_art_gold_sale')|2]@gold!"
  }
  tooltip = "pmcq_art_gold_sale_desc"
 }

 type pmcq_art_gold_estates = select_cell_default {
  size = { 100 32 }
  sort_by_highlight = { size = { 100% 100% } name = "pmcq_art_gold_estates" }
  text_single = {
   size = { 100% 100% }
   align = center|vcenter
   text = "[GuiScope.SetRoot(InteractionTarget.GetWorkOfArt.MakeScope).ScriptValue('pmcq_art_gold_estates')|2]@gold!"
  }
  tooltip = "pmcq_art_gold_estates_desc"
 }
}
