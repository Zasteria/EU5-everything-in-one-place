types SelectionCardsTypes
{
	type card_list = vbox {
		layoutpolicy_horizontal = expanding
		background = {
			block "bg_color" { using = color_intense_bg_blue_texture }
			alpha = 0.2
		}

		using = bg_header_golden_frame

		block "row_size" {
			minimumsize = { 520 -1 }
			maximumsize = { 520 -1 }
		}

		text_multi = {
			block "row_size" {
				minimumsize = { 520 -1 }
				maximumsize = { 520 -1 }
			}
			
			autoresize = yes
			margin = { 10 5 }
			using = Font_Type_Headers
			align = nobaseline

			block "block_title" {
				visible = no
			}

			background = {
				block "bg_color" { using = color_intense_bg_blue_texture }
				alpha = 0.2
			}
		}
	}

	type card_field = hbox {
		layoutpolicy_horizontal = expanding

		background = {
			visible = "[IsOdd_int32(PdxGuiWidget.GetIndexInDataModel)]"
			block "bg_color" { using = color_intense_bg_blue_texture }
			alpha = 0.2
		}

		block "field_content" {}
	}

	type card_column = vbox {
		layoutpolicy_horizontal = expanding

		block "column_datamodel" {}

		item = {
			card_field = {
				blockoverride "field_content" {
					block "field_left" {}

					text_single = {
						margin = { 10 5 }
						fontsize = 14
						align = nobaseline
						block "field_text" {}

						block "field_highlight" {
							sort_by_highlight = {
								size = { 100% 100% }
								name = "effect"
							}
						}
					}
					
					block "field_right" {}
				}
			}
		}
	}

	type card_row_list = card_list {
		ontextcontextchanged = "[SetRowListFromTextContext(PdxGuiWidget.AccessSelf)]"
		vbox = {
			layoutpolicy_horizontal = expanding
			margin = { 0 2 }

			datamodel = "[RowList.GetRows]"
			item = {
				text_multi = {
					visible = "[CPdxStringView.IsStringViewNotEmptyOrNull]"
					layoutpolicy_horizontal = expanding
					margin = { 10 5 }
					align = nobaseline
					fontsize = 14
					autoresize = yes

					block "row_size" {
						minimumsize = { 520 -1 }
						maximumsize = { 520 -1 }
					}
					
					text = "[CPdxStringView.GetStringView]"

					background = {
						visible = "[IsOdd_int32(PdxGuiWidget.GetIndexInDataModel)]"
						block "bg_color" { using = color_intense_bg_blue_texture }
						alpha = 0.4
					}
				}
			}
		}
	}

	type card_block_list = card_list {
		ontextcontextchanged = "[SetBlockListFromTextContext(PdxGuiWidget.AccessSelf)]"

		vbox = {
			layoutpolicy_horizontal = expanding
			datamodel = "[BlockList.GetBlocks]"
			item = {
				vbox = {
					layoutpolicy_horizontal = expanding

					card_column = {
						visible = "[BlockListBlock.IsSingle]"
						layoutpolicy_horizontal = expanding
						blockoverride "column_datamodel" { datamodel = "[BlockListBlock.GetSingleRows]" }
						blockoverride "field_text" {
							layoutpolicy_horizontal = expanding
							minimumsize = { -1 30 }
							autoresize = yes
							align = left|nobaseline
							multiline = yes
							text = "[ConditionLine.GetText]"
						}

						blockoverride "field_left" {}
						blockoverride "field_right" { expand = {} }
					}

					hbox = {
						visible = "[BlockListBlock.IsPair]"
						layoutpolicy_horizontal = expanding

						card_column = {
							layoutpolicy_horizontal = expanding
							blockoverride "column_datamodel" { datamodel = "[BlockListBlock.GetPairRows]" }
							blockoverride "field_text" {
								maximumsize = { -1 30 }
								minimumsize = { -1 30 }
								autoresize = yes
								align = left|nobaseline
								text = "[StringViewPair.GetLeft.GetStringView]"
							}

							blockoverride "field_left" {}
							blockoverride "field_right" { expand = {} }
						}

						card_column = {
							layoutpolicy_horizontal = fixed
							blockoverride "column_datamodel" { datamodel = "[BlockListBlock.GetPairRows]" }
							blockoverride "field_text" {
								maximumsize = { -1 30 }
								minimumsize = { -1 30 }
								autoresize = yes
								align = right|nobaseline
								text = "[StringViewPair.GetRight.GetStringView]"
							}

							blockoverride "field_left" { expand = {} }
							blockoverride "field_right" {}
						}
					}

					hbox = {
						visible = "[BlockListBlock.IsColumns]"
						layoutpolicy_horizontal = expanding

						block "columnlist_datamodel" {
							datamodel = "[TableColumnList.GetColumns]"
							ignoreinvisible = yes
						}
				
						item = {
							card_column = {
								layoutpolicy_horizontal = "[TableColumn.GetHorizontalLayoutPolicy]"
				
								blockoverride "column_datamodel" {
									datamodel = "[TableColumn.GetRows]"
									ignoreinvisible = yes
								}
				
								blockoverride "column_title" {
									visible = "[TableColumn.GetTitle.IsStringViewNotEmptyOrNull]"
								}
				
								blockoverride "column_title_text" {
									maximumsize = { 70 30 }
									minimumsize = { -1 30 }
									autoresize = yes
									text = "[TableColumn.GetTitle.GetStringView]"
									align = "[TableColumn.GetTextAlignment]"
								}
				
								blockoverride "column_title_left" {
									expand = {
										visible = "[TableColumn.IsTextRight]"
									}
								}
				
								blockoverride "column_title_right" {
									expand = {
										visible = "[TableColumn.IsTextLeft]"
									}
								}
				
								blockoverride "field_text" {
									maximumsize = { 70 30 }
									minimumsize = { -1 30 }
									autoresize = yes
									text = "[CPdxStringView.GetStringView]"
									align = "[TableColumn.GetTextAlignment]"
								}
				
								blockoverride "field_left" {
									expand = {
										visible = "[TableColumn.IsTextRight]"
									}
								}
				
								blockoverride "field_right" {
									expand = {
										visible = "[TableColumn.IsTextLeft]"
									}
								}
							}
						}
					}
				}
			}
		}
	}

	type card_stringpair_list = card_list {
		ontextcontextchanged = "[SetStringPairListFromTextContext(PdxGuiWidget.AccessSelf)]"

		hbox = {
			layoutpolicy_horizontal = expanding
			margin = { 0 2 }

			card_column = {
				layoutpolicy_horizontal = expanding
				blockoverride "column_datamodel" { datamodel = "[StringPairList.GetRows]" }
				blockoverride "field_text" {
					maximumsize = { -1 30 }
					minimumsize = { -1 30 }
					autoresize = yes
					
					align = left|nobaseline
					text = "[StringViewPair.GetLeft.GetStringView][AddTextIf(Not(StringViewPair.GetLeft.IsStringViewNotEmptyOrNull), ' ')]"
				}

				blockoverride "field_left" {}	
				blockoverride "field_right" { expand = {} }
			}

			card_column = {
				layoutpolicy_horizontal = fixed
				blockoverride "column_datamodel" { datamodel = "[StringPairList.GetRows]" }
				blockoverride "field_text" {
					maximumsize = { -1 30 }
					minimumsize = { -1 30 }
					autoresize = yes
					align = right|nobaseline
					text = "[StringViewPair.GetRight.GetStringView][AddTextIf(Not(StringViewPair.GetRight.IsStringViewNotEmptyOrNull), ' ')]"
				}

				blockoverride "field_left" { expand = {} }
				blockoverride "field_right" {}
			}
		}
	}

	type card_2row_stringpair_list = card_list {
		ontextcontextchanged = "[SetStringPairListFromTextContext(PdxGuiWidget.AccessSelf)]"

		datamodel = "[StringPairList.GetRows]"
		item = {
			hbox = {
				layoutpolicy_horizontal = expanding
				margin = { 5 0 }
				spacing = 5
				background = {
					visible = "[IsOdd_int32(PdxGuiWidget.GetIndexInDataModel)]"
					block "bg_color" { using = color_intense_bg_blue_texture }
					alpha = 0.2
				}

				datacontext = "[StringToIconAndText(StringViewPair.GetLeft.GetString)]"
				text_single = {
					autoresize = yes
					using = Font_Size_Medium
					visible = "[StringViewPair.GetRight.IsStringViewNotEmptyOrNull]"
					text = "[IconAndText.GetIcon]"

					tagtooltip_enabled = yes
					tooltip = "[IconAndText.GetText]"
				}

				vbox = {
					visible = "[StringViewPair.GetRight.IsStringViewNotEmptyOrNull]"
					layoutpolicy_horizontal = expanding
					text_single = {
						layoutpolicy_horizontal = expanding
						text = "[IconAndText.GetText]"
					}
					text_single = {
						layoutpolicy_horizontal = expanding
						text = "[StringViewPair.GetRight.GetStringView]"
					}
				}

				text_multi = {
					margin = { 5 5 }
					visible = "[Not(StringViewPair.GetRight.IsStringViewNotEmptyOrNull)]"
					layoutpolicy_horizontal = expanding
					autoresize = yes
					text = "[IconAndText.GetText]"
				}
			}	
		}
	}
}

types CabinetActionColumns
{
	type cabinet_action_name = clickable_header_card {
widget = { size = { 1 1 } ignore_layout = yes alwaystransparent = yes
 dynamicgridbox = {
  datamodel = "[DataModelRepeatedItem(Select_int32(And(And(GetVariableSystem.HasValue('pmcqcs_request', 'change_societal_values'), SelectInteractionTargetView.IsCabinetAction), And(And(GetVariableSystem.HasValue('pmcqcs_slot_index', ToString_int32(SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('cabinet').GetCabinet.GetIndex)), Or(SelectInteractionTargetGlue.IsLeftClickEnabled, SelectInteractionTargetGlue.IsLeftClickAndConfirmEnabled)), EqualTo_string(InteractionTarget.GetCabinetAction.GetNameWithNoTooltip, ShowCabinetActionNameWithNoTooltip('change_societal_values')))), '(int32)1', '(int32)0'))]"
  item = {
button = { name = "pmcqcs_dispatch_change_societal_values" size = { 1 1 } ignore_layout = yes alwaystransparent = yes
 action_tooltip = {
  click_type = left click_mode = single
  visible = "[SelectInteractionTargetGlue.IsLeftClickVisible]"
  enabled = "[SelectInteractionTargetGlue.IsLeftClickEnabled]"
  title = "[SelectInteractionTargetGlue.GetLeftClickTitle]"
  on_action_with_params = "[SelectInteractionTargetGlue.OnLeftClick]"
 }
 action_tooltip = {
  click_type = left click_mode = confirm
  visible = "[SelectInteractionTargetGlue.IsLeftClickAndConfirmVisible]"
  enabled = "[SelectInteractionTargetGlue.IsLeftClickAndConfirmEnabled]"
  title = "[SelectInteractionTargetGlue.GetLeftClickAndConfirmTitle]"
  on_action_with_params = "[SelectInteractionTargetGlue.OnLeftClickAndConfirm]"
 }
 state = { name = pmcqcs_run_requested_action trigger_on_create = yes alpha = 0.99 duration = 0.2
  on_finish = "[SelectInteractionTargetGlue.OnMouseEnter(PdxGuiWidget.AccessSelf, SelectInteractionTargetGlue.GetObject)]"
  on_finish = "[GetVariableSystem.Set('pmcqcs_cleanup', 'yes')]"
  on_finish = "[GetVariableSystem.Set('pmcqcs_close_government', 'yes')]"
  on_finish = "[UIAction.OnLeftClick]"
  on_finish = "[GetVariableSystem.Clear('pmcqcs_request')]"
 }
}
  }
 }
}
