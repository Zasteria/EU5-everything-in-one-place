template pmcqsg_tools {
 # A completed native map pick reopens the picker without resetting the batch.
 dynamicgridbox = { size = { 1 1 } ignore_layout = yes alwaystransparent = yes
  datacontext = "[GetGenericAction('pmcqsg_add')]"
  datamodel = "[DataModelRepeatedItem(Select_int32(GetPlayer.MakeScope.GetVariable('pmcqsg_reopen_picker').IsSet, '(int32)1', '(int32)0'))]"
  item = { widget = { size = { 1 1 } alwaystransparent = yes
   state = { name = pmcqsg_resume_picker trigger_on_create = yes duration = 0.01
    on_finish = "[PerformGenericAction(GenericAction.Self)]"
    on_finish = "[GetScriptedGui('pmcqsg_reopen_consumed').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
   }
  } }
 }
 dynamicgridbox = { size = { 1 1 } ignore_layout = yes alwaystransparent = yes
  datamodel = "[DataModelRepeatedItem(Select_int32(GetPlayer.MakeScope.GetVariable('pmcqsg_open_requested').IsSet, '(int32)1', '(int32)0'))]"
  item = { widget = { size = { 1 1 }
   state = { name = pmcqsg_open_window trigger_on_create = yes
    on_start = "[GetVariableSystem.Clear('cmm_window_open')]"
    on_start = "[GetVariableSystem.Clear('pmcqr_window')]"
    on_start = "[GetVariableSystem.Set('pmcqsg_window', 'yes')]"
    on_start = "[GetScriptedGui('pmcqsg_open').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
   }
  } }
 }
 window = { name = "pmcqsg_window" layer = top movable = yes
  parentanchor = center widgetanchor = center size = { 700 570 } using = bg_main_inner_alt
  visible = "[GetVariableSystem.HasValue('pmcqsg_window', 'yes')]"
  text_single = { position = { 16 12 } size = { 624 30 } fontsize = 20 text = "pmcqsg_title" }
  button = { position = { 658 12 } size = { 26 26 } using = button_regular_texture raw_text = "X"
   onclick = "[GetVariableSystem.Clear('pmcqsg_window')]"
  }
  text_multi = { position = { 16 53 } size = { 668 64 } fontsize = 12 autoresize = no text = "pmcqsg_help" }
  button = { position = { 16 126 } size = { 196 32 } using = button_regular_texture
   text = "[SelectLocalization(GetPlayer.MakeScope.GetVariable('pmcqsg_enabled').IsSet, 'pmcqsg_on', 'pmcqsg_off')]"
   tooltip = "pmcqsg_toggle_tip"
   onclick = "[GetScriptedGui('pmcqsg_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
  }
  button = { position = { 224 126 } size = { 174 32 } using = button_regular_texture
   datacontext = "[GetGenericAction('pmcqsg_add')]" text = "pmcqsg_add"
   onclick = "[GetScriptedGui('pmcqsg_begin_selection').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
   onclick = "[PerformGenericAction(GenericAction.Self)]"
   onclick = "[GetVariableSystem.Clear('pmcqsg_window')]"
  }
  text_single = { position = { 414 129 } size = { 270 28 } fontsize = 13
   raw_text = "Gifts sent: [GetPlayer.MakeScope.GetVariable('pmcqsg_sent').GetValueWithDefault('(CFixedPoint)0')|0]"
  }
  text_single = { position = { 16 174 } size = { 360 28 } text = "pmcqsg_reserve" fontsize = 13 tooltip = "pmcqsg_reserve_tip" }
  button = { position = { 422 174 } size = { 30 28 } using = button_regular_texture raw_text = "-"
   onclick = "[GetScriptedGui('pmcqsg_less').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
  }
  text_single = { position = { 464 174 } size = { 180 28 } fontsize = 14
   raw_text = "[GetPlayer.MakeScope.GetVariable('pmcqsg_reserve').GetValueWithDefault('(CFixedPoint)100')|0] [gold_i]"
  }
  button = { position = { 654 174 } size = { 30 28 } using = button_regular_texture raw_text = "+"
   onclick = "[GetScriptedGui('pmcqsg_more').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
  }
  text_single = { position = { 20 216 } size = { 658 24 } fontsize = 12 text = "pmcqsg_columns" }
  scrollarea = { name = "pmcqsg_target_list" position = { 16 244 } size = { 668 221 }
   minimumsize = { 668 221 } maximumsize = { 668 221 }
   autoresizescrollarea = no autoresizeviewport = yes
   scrollbarpolicy_horizontal = always_off scrollbarpolicy_vertical = as_needed
   viewportwidget = { widget = { scissor = yes } }
   scrollbar_vertical = { using = Scrollbar_Vertical }
   scrollwidget = { vbox = {
    layoutpolicy_horizontal = expanding layoutpolicy_vertical = fixed parentanchor = top spacing = 5
    datamodel = "[GetPlayer.MakeScope.GetList('pmcqsg_targets')]"
    item = { widget = { size = { 644 36 } datacontext = "[Scope.GetCountry]"
     text_single = { position = { 4 4 } size = { 240 26 } text = "[Country.GetName]" fontsize = 12 }
     text_single = { position = { 250 4 } size = { 105 26 } fontsize = 12
      raw_text = "[GetPlayer.MakeScope.GetVariableFromVariableMap('pmcqsg_prices', Country.MakeScope).GetValue|2] [gold_i]"
      tooltip = "pmcqsg_price_tip"
     }
     text_single = { position = { 364 4 } size = { 182 26 } fontsize = 11
      text = "[Localize(Select_CString(EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariableFromVariableMap('pmcqsg_statuses', Country.MakeScope).GetValue, '(CFixedPoint)1'), 'pmcqsg_cooldown', Select_CString(EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariableFromVariableMap('pmcqsg_statuses', Country.MakeScope).GetValue, '(CFixedPoint)2'), 'pmcqsg_war', Select_CString(EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariableFromVariableMap('pmcqsg_statuses', Country.MakeScope).GetValue, '(CFixedPoint)3'), 'pmcqsg_range', Select_CString(EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariableFromVariableMap('pmcqsg_statuses', Country.MakeScope).GetValue, '(CFixedPoint)4'), 'pmcqsg_funds', Select_CString(EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariableFromVariableMap('pmcqsg_statuses', Country.MakeScope).GetValue, '(CFixedPoint)5'), 'pmcqsg_cap', Select_CString(EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariableFromVariableMap('pmcqsg_statuses', Country.MakeScope).GetValue, '(CFixedPoint)6'), 'pmcqsg_invalid', 'pmcqsg_ready')))))))]"
     }
     button = { position = { 552 2 } size = { 88 30 } using = button_regular_texture text = "pmcqsg_remove" fontsize = 12
      onclick = "[GetScriptedGui('pmcqsg_remove').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqsg_target', Country.MakeScope).End)]"
     }
    } }
   } }
  }
  text_single = { position = { 24 257 } size = { 620 32 } text = "pmcqsg_empty" fontsize = 13
   visible = "[IsDataModelEmpty(GetPlayer.MakeScope.GetList('pmcqsg_targets'))]"
  }
  text_multi = { position = { 16 474 } size = { 668 40 } text = "pmcqsg_note" fontsize = 11 autoresize = no }
  button = { position = { 16 526 } size = { 322 30 } using = button_regular_texture text = "pmcqsg_back"
   onclick = "[GetVariableSystem.Clear('pmcqsg_window')]"
   onclick = "[GetVariableSystem.Clear('cmm_mod_search_text')]"
   onclick = "[GetVariableSystem.Set('cmm_selected_mod', 'pmcq')]"
   onclick = "[GetVariableSystem.Set('cmm_selected_tab', 'pmcq__diplomacy')]"
   onclick = "[GetVariableSystem.Set('cmm_window_open', 'yes')]"
  }
  button = { position = { 350 526 } size = { 334 30 } using = button_regular_texture text = "pmcqsg_run"
   enabled = "[GetPlayer.MakeScope.GetVariable('pmcqsg_enabled').IsSet]"
   tooltip = "pmcqsg_run_tip"
   onclick = "[GetScriptedGui('pmcqsg_run').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
  }
 }
}
