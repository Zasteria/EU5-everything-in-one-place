		tagtooltip_enabled = yes
		tooltip = "[loan|e]"

		sort_by_small_highlight = {
			name = "loan_amount"
		}
	}
}

template offer_loan_extra {
	divider_flavor_01 = {
		size = {9 -1}
		visible = "[SelectCountryDiplomacyLateralView.IsOfferLoan]"
	}

	text_single = { # Creditworthiness
		visible = "[SelectCountryDiplomacyLateralView.IsOfferLoan]"
		using = layoutpolicy_expanding
		align = center|nobaseline
		raw_text = "[Country.GetCreditworthinessEffectiveRating|0]@creditworthiness!"
