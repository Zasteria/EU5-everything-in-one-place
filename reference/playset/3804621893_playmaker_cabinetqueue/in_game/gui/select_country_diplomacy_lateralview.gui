}

lateralview = {
	name = "select_country_diplomacy_lateralview"

 widget = { size = { 1 1 } ignore_layout = yes alwaystransparent = yes
  dynamicgridbox = { datamodel = "[DataModelRepeatedItem(Select_int32(And(GetVariableSystem.Exists('pmcqcb_close_completed'), EqualTo_string(SelectCountryDiplomacyLateralView.GetActionName, Localize('CREATE_CB'))), '(int32)1', '(int32)0'))]"
   item = { widget = { size = { 1 1 }
    state = { name = pmcqcb_close_country_list trigger_on_create = yes
     on_start = "[SelectCountryDiplomacyLateralView.Manager.Close]"
    }
   } }
  }
 }


	# SOUND - Diplomacy Macrobuilder (Left Panel)
	blockoverride "snd_panel_identifier" { soundeffect = "UI_panelAux_diplomacy_selectCountry_show" }
	blockoverride "panel_header" {
		window_header_alt = {
			blockoverride "header_text" {
				text = "[SelectCountryDiplomacyLateralView.GetActionName]"
				autoresize = no
				margin_left = 25
				margin_right = 25
			}
			blockoverride "window_header_alt_color_texture"{
				using = color_diplomacy_texture
			}
		}
	}

	blockoverride "panel_content" {
		vbox = {
			using = layoutpolicy_expanding
			using = bg_main_inner_notabs_alt
			using = window_main_tabs_margin_alt

			vbox = {
				using = layoutpolicy_expanding


 hbox = {
  visible = "[EqualTo_string(SelectCountryDiplomacyLateralView.GetActionName, Localize('request_military_sponsorship'))]"
  spacing = 6
  margin = { 5 5 }
  button_regular = {
   size = { 180 30 }
   text = "pmcq_sponsorship_sort"
   tooltip = "pmcq_sponsorship_rank_desc"
   onclick = "[GetScriptedGui('pmcq_sponsorship_rank').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
   onclick = "[GetVariableSystem.Set('pmcq_sponsorship_view', 'gold')]"
  }
  button_regular = {
   size = { 150 30 }
   text = "pmcq_sponsorship_standard"
   onclick = "[GetVariableSystem.Set('pmcq_sponsorship_view', 'standard')]"
  }
 }
 scrollbox = {
  using = layoutpolicy_expanding
  datacontext = "[SelectCountryDiplomacyLateralView.GetCountriesSortSearch]"
  visible = "[And(EqualTo_string(SelectCountryDiplomacyLateralView.GetActionName, Localize('request_military_sponsorship')), GetVariableSystem.HasValue('pmcq_sponsorship_view', 'gold'))]"
  blockoverride "scrollbox_empty" {
   visible = "[IsDataModelEmpty(GetPlayer.MakeScope.GetList('pmcq_sponsorship_ranked'))]"
   text = "pmcq_sponsorship_empty"
  }
  blockoverride "scrollbox_content" {
   dynamicgridbox = {
    layoutpolicy_horizontal = expanding
    datamodel = "[GetPlayer.MakeScope.GetList('pmcq_sponsorship_ranked')]"
    item = {
     widget = {
      size = { 100% 70 }
      datacontext = "[Scope.GetCountry]"
      visible = "[SelectCountryDiplomacy_HasDiplomaticActionItem(Country.Self)]"
      widget = {
       size = { 100% 70 }
       datacontext = "[SelectCountryDiplomacy_GetDiplomaticActionItem(Country.Self)]"
       using = pmcq_sponsorship_diplomatic_card
      }
     }
    }
   }
  }
 }
				filtered_sorted_list = {
 visible = "[Not(And(EqualTo_string(SelectCountryDiplomacyLateralView.GetActionName, Localize('request_military_sponsorship')), GetVariableSystem.HasValue('pmcq_sponsorship_view', 'gold')))]"
					datacontext = "[SelectCountryDiplomacyLateralView.GetCountriesSortSearch]"

					blockoverride "scroll_list_is_empty" {
						visible = "[IsDataModelEmpty(SelectCountryDiplomacyLateralView.GetCountryItems)]"
					}

					blockoverride "scroll_list_is_empty_text" {
						text = "SELECT_COUNTRY_DIPLOMACY_LIST_EMPTY"
					}

					blockoverride "sort_buttons_filtered_list" {
						sort_by_key_button = {
							name = "name"
							using = layoutpolicy_expanding
						}

						sort_by_key_button = {
							name = "opinion"
							using = layoutpolicy_expanding
						}

						sort_by_key_button = {
							name = "trust"
							using = layoutpolicy_expanding
						}

						sort_by_key_button = {
							name = "antagonism"
							using = layoutpolicy_expanding
						}

						sort_by_key_button = {
							name = "favors"
							using = layoutpolicy_expanding
						}

						sort_by_key_button = {
							name = "spy_network"
							visible = "[SelectCountryDiplomacyLateralView.ShouldShowSpySort]"
							using = layoutpolicy_expanding
						}

						sort_by_key_button = {
							name = "relations"
							using = layoutpolicy_expanding
						}

						sort_by_key_button = {
							name = "will"
							visible = "[SelectCountryDiplomacyLateralView.RequiresAcceptance]"
							using = layoutpolicy_expanding
						}

						sort_by_key_button = {
							name = "possible_options"
							visible = "[SelectCountryDiplomacyLateralView.HasInnerRequirements]"
							using = layoutpolicy_expanding
						}

						sort_by_key_button = {
							name = "loan_amount"
							visible = "[SelectCountryDiplomacyLateralView.IsTakeOverLoan]"
							using = layoutpolicy_expanding
						}

						sort_by_key_button = {
							name = "creditworthiness"
							visible = "[SelectCountryDiplomacyLateralView.IsOfferLoan]"
							using = layoutpolicy_expanding
						}

						sort_by_key_button = {
							name = "loyalty"
							visible = "[SelectCountryDiplomacyLateralView.IsSubjectAction]"
							using = layoutpolicy_expanding
						}

						sort_by_key_button = {
							name = "liberty_desire"
							visible = "[SelectCountryDiplomacyLateralView.IsSubjectAction]"
							using = layoutpolicy_expanding
						}

						sort_by_key_button = {
							name = "relative_power"
							using = layoutpolicy_expanding
						}
					}

					blockoverride "scroll_list_layout" {
                        dynamicgridbox = {
                            position = { 0 2 }
                            parentanchor = top|left
                            widgetanchor = top|left
                            layoutpolicy_horizontal = expanding
                            datamodel_wrap = 1
                            flipdirection = yes
                            ignoreinvisible = yes
                            datamodel = "[SelectCountryDiplomacyLateralView.GetCountryItems]"
                            item = {
                                widget = {
                                    size = { 530 70 }
                                    minimumsize = { 530 70 }
                                    maximumsize = { 530 70 }
                                    visible = "[Or(Not(DiplomaticActionItem.IsType('create_casus_belli')), GetScriptedGui('pmcqcb_target_eligible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', DiplomaticActionItem.GetRecipient.MakeScope).End))]"
                                    using = pmcq_sponsorship_diplomatic_card
                                }
                            }
                        }
                    }
				}
			}
		}
	}
}

template subject_parameters {
	divider_flavor_01 = { 
		size = {9 -1}
		visible = "[SelectCountryDiplomacyLateralView.IsSubjectAction]"
	}
	
	text_single = { # Loyalty
		visible = "[SelectCountryDiplomacyLateralView.IsSubjectAction]"
		using = layoutpolicy_expanding
		align = center|nobaseline
		raw_text = "[Country.GetDiplomacy.GetSubjectLoyalty|2%/]"
		tooltipwidget = {
			using = SubjectLoyalty_tooltip
		}

		sort_by_small_highlight = {
			name = "loyalty"
		}
	}

	divider_flavor_01 = { 
		size = {9 -1}
		visible = "[SelectCountryDiplomacyLateralView.IsSubjectAction]"
	}

	text_single = { # Liberty Desire
		visible = "[SelectCountryDiplomacyLateralView.IsSubjectAction]"
		using = layoutpolicy_expanding
		align = center|nobaseline
		text = "[Country.GetDiplomacy.GetLibertyDesire|2]"
		tagtooltip_enabled = yes
		tooltip = "[liberty_desire|e]"

		sort_by_small_highlight = {
			name = "liberty_desire"
		}
	}

}

