# Expand native diplomacy categories once for the currently viewed country.
# Only closed categories with actions are toggled. After initialization the
# player can collapse them freely; no diplomacy action is executed here.
template pmcq_expand_diplomacy_on_first_open {
    widget = {
        size = { 1 1 }
        ignore_layout = yes
        alwaystransparent = yes
        dynamicgridbox = {
            datamodel = "[DataModelRepeatedItem(Select_int32(And4(PdxGuiWidget.FindParent('foreign_country_lateralview').IsVisible, ForeignCountryView.Vars.NotExistOrHasValue('foreign', 'diplomacy'), And(Not(ForeignCountryView.IsViewingPlayerCountry), DataModelHasItems(ForeignCountryView.GetCategoryItems)), Not(ForeignCountryView.Vars.HasValue('pmcq_categories_initialized', ForeignCountryView.GetCountry.GetTag))), '(int32)1', '(int32)0'))]"
            item = {
                widget = {
                    size = { 1 1 }
                    state = {
                        name = pmcq_finish_category_initialization
                        trigger_on_create = yes
                        alpha = 0.99
                        duration = 0.2
                        on_finish = "[ForeignCountryView.Vars.Set('pmcq_categories_initialized', ForeignCountryView.GetCountry.GetTag)]"
                    }
                    vbox = {
                        datamodel = "[ForeignCountryView.GetCategoryItems]"
                        item = {
                            widget = {
                                size = { 1 1 }
                                dynamicgridbox = {
                                    datamodel = "[DataModelRepeatedItem(Select_int32(And(DiplomaticActionCategory.HasActions, Not(DiplomaticActionCategory.IsExpanded)), '(int32)1', '(int32)0'))]"
                                    item = { widget = { size = { 1 1 }
                                        state = {
                                            name = pmcq_expand_initial_diplomacy_category
                                            trigger_on_create = yes
                                            alpha = 0.99
                                            duration = 0.01
                                            on_finish = "[DiplomaticActionCategory.OnClick]"
                                        }
                                    } }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
