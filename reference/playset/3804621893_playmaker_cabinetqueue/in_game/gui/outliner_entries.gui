				}

				OutlinerTextBase = {
					autoresize = yes
					raw_text = "[Privateer.GetPowerChange|+=%]"
				}
			}
		}
	}

	blockoverride "expanded_small_content" {
		OutlinerButtonBase = {
			size = { 95% 100% }

			OutlinerTextBase = {
				size = { 100% 100% }
				using = outliner_entry_margin
				autoresize = no
				align = left
				raw_text = "[Privateer.GetPowerChange|+=%]"
			}
		}
	}

	blockoverride "icon_content" {
		OutlinerIconBg = {
			piechart = {
				using = bg_circle
				size = { 30 30 }
				minimumsize = { 30 30 }
