template pmcq_cabinet_row_right_click {
 action_tooltip = {
  click_type = right click_mode = single
  title = "CABINET_ACTION_SIDEMENU_RMB"
  visible = "[IsChangeCabinetActionTargetVisible(Cabinet.Self)]"
  enabled = "[IsChangeCabinetActionTargetEnabled(Cabinet.Self)]"
  on_action = "[ChangeCabinetActionTarget(Cabinet.Self)]"
 }
 action_tooltip = {
  click_type = right click_mode = single
  title = "CABINET_ACTION_SIDEMENU"
  visible = "[Not(IsChangeCabinetActionTargetVisible(Cabinet.Self))]"
  on_action = "[SelectCabinetAction(Cabinet.Self, '(bool)no')]"
 }
}


template pmcq_cabinet_icon_row {
 OutlinerButtonBase = {
  size = { 95% 100% }
  using = pmcq_cabinet_row_right_click
  widget = {
   name = "pmcqcs_left_half"
   size = { 44% 28 }
   parentanchor = left|vcenter widgetanchor = left|vcenter
   position = { 8 0 }
   using = pmcq_cabinet_shortcuts
  }
  widget = {
   size = { 44% 28 }
   parentanchor = right|vcenter
   widgetanchor = right|vcenter
   position = { -36 0 }
   scissor = yes
   OutlinerTextBase = {
    visible = "[And(Not(GetScriptedGui('pmcq_manual_setup_visible').IsShown(GuiScope.SetRoot(Cabinet.MakeScope).End)), Not(And(Cabinet.IsActive, EqualTo_string(Cabinet.GetAction.GetNameWithNoTooltip, ShowCabinetActionNameWithNoTooltip('change_societal_values')))))]"
    size = { 100% 14 } parentanchor = top|left widgetanchor = top|left
    autoresize = no align = left|nobaseline fontsize = 12
    text = "[Select_CString(GetScriptedGui('pmcq_assimilation_waiting').IsShown(GuiScope.SetRoot(Cabinet.MakeScope).End), SelectLocalization(Cabinet.IsCharacterSet, 'pmcq_assimilation_waiting', 'pmcq_assimilation_no_member'), Select_CString(Cabinet.MakeScope.GetVariable('pmcqi_slot_target').IsSet, Localize('pmcq_outliner_integrating'), Select_CString(Cabinet.MakeScope.GetVariable('pmcqa_slot_target').IsSet, Localize('pmcq_outliner_converting'), Select_CString(Cabinet.MakeScope.GetVariable('pmcqie_area').IsSet, Localize('pmcq_outliner_integrating_area'), Select_CString(Cabinet.MakeScope.GetVariable('pmcqae_area').IsSet, Localize('pmcq_outliner_converting_area'), SelectLocalization(Cabinet.IsActive, 'pmcqcs_action_name', 'EMPTY_CABINET_SLOT'))))))]"
    tooltip = "[Select_CString(GetScriptedGui('pmcq_assimilation_waiting').IsShown(GuiScope.SetRoot(Cabinet.MakeScope).End), SelectLocalization(Cabinet.IsCharacterSet, 'pmcq_assimilation_waiting', 'pmcq_assimilation_no_member'), Select_CString(Cabinet.MakeScope.GetVariable('pmcqi_slot_target').IsSet, Localize('pmcq_outliner_integrating'), Select_CString(Cabinet.MakeScope.GetVariable('pmcqa_slot_target').IsSet, Localize('pmcq_outliner_converting'), Select_CString(Cabinet.MakeScope.GetVariable('pmcqie_area').IsSet, Localize('pmcq_outliner_integrating_area'), Select_CString(Cabinet.MakeScope.GetVariable('pmcqae_area').IsSet, Localize('pmcq_outliner_converting_area'), SelectLocalization(Cabinet.IsActive, 'pmcqcs_action_name', 'EMPTY_CABINET_SLOT'))))))]"
   }
   OutlinerTextBase = {
    size = { 100% 12 } position = { 0 15 }
    parentanchor = top|left widgetanchor = top|left
    visible = "[And(Not(GetScriptedGui('pmcq_manual_setup_visible').IsShown(GuiScope.SetRoot(Cabinet.MakeScope).End)), And(Cabinet.IsActive, Not(And(Cabinet.IsActive, EqualTo_string(Cabinet.GetAction.GetNameWithNoTooltip, ShowCabinetActionNameWithNoTooltip('change_societal_values'))))))]"
    autoresize = no align = left|nobaseline fontsize = 10
    text = "[Select_CString(Cabinet.MakeScope.GetVariable('pmcqi_slot_target').IsSet, Localize('pmcq_integration_province_progress'), Select_CString(Cabinet.MakeScope.GetVariable('pmcqie_area').IsSet, Localize('pmcq_integration_area_progress'), Cabinet.GetActionProgress))]"
   }
    button = {
     name = "pmcqcs_control_setup"
     size = { 32% 22 } parentanchor = right|vcenter widgetanchor = right|vcenter using = button_regular_texture
     text = "pmcq_manual_setup" fontsize = 11
     tooltip = "pmcq_manual_setup_desc"
     visible = "[GetScriptedGui('pmcq_manual_setup_visible').IsShown(GuiScope.SetRoot(Cabinet.MakeScope).End)]"
     onclick = "[GetVariableSystem.SetOrToggle('pmcq_manual_window', 'open')]"
    }
   widget = {
    name = "pmcqcs_control_province"
    size = { 64% 28 } parentanchor = left|vcenter widgetanchor = left|vcenter
    visible = "[GetScriptedGui('pmcq_manual_setup_visible').IsShown(GuiScope.SetRoot(Cabinet.MakeScope).End)]"
    OutlinerTextBase = {
     size = { 100% 24 } parentanchor = left|vcenter widgetanchor = left|vcenter
     autoresize = no align = left|vcenter fontsize = 11
     visible = "[GetPlayer.MakeScope.GetVariable('pmcq2_target').IsSet]"
     text = "[GetPlayer.MakeScope.GetVariable('pmcq2_target').GetProvince.GetNameWithNoTooltip]"
     tooltip = "[GetPlayer.MakeScope.GetVariable('pmcq2_target').GetProvince.GetNameWithNoTooltip]"
    }
    OutlinerTextBase = {
     size = { 100% 24 } parentanchor = left|vcenter widgetanchor = left|vcenter
     autoresize = no align = left|vcenter fontsize = 11
     visible = "[Not(GetPlayer.MakeScope.GetVariable('pmcq2_target').IsSet)]"
     text = "pmcq_outliner_control_waiting"
    }
    button = {
     name = "pmcqcs_control_province_link"
     using = pmcq_cabinet_row_right_click
     size = { 100% 24 } parentanchor = left|vcenter widgetanchor = left|vcenter
     visible = "[GetPlayer.MakeScope.GetVariable('pmcq2_target').IsSet]"
     tooltip = "[GetPlayer.MakeScope.GetVariable('pmcq2_target').GetProvince.GetNameWithNoTooltip]"
     onclick = "[ShowLocation(GetPlayer.MakeScope.GetVariable('pmcq2_target').GetProvince.GetCapital)]"
    }
   }
   widget = {
    name = "pmcqcs_societal_value_details"
    size = { 100% 100% }
    visible = "[And(Cabinet.IsActive, EqualTo_string(Cabinet.GetAction.GetNameWithNoTooltip, ShowCabinetActionNameWithNoTooltip('change_societal_values')))]"
    datacontext = "[Cabinet.GetSocietalValue]"
    OutlinerTextBase = {
     size = { 100% 14 } parentanchor = top|left widgetanchor = top|left
     autoresize = no align = left|nobaseline fontsize = 12
     text = "[Cabinet.GetSocietalValueName]"
     default_format = "#yellow_titles"
     tooltip = "change_societal_values_action_title"
    }
    OutlinerTextBase = {
     size = { 100% 12 } position = { 0 15 } parentanchor = top|left widgetanchor = top|left
     autoresize = no align = left|nobaseline fontsize = 11
     raw_text = "[Cabinet.GetSocietalValueTotal|+=2] ([OutlinerCabinetEntry.GetSocietalValueMonthlyProgress|G+=2])"
    }
   }
  }
 }
}
template pmcq_cabinet_member_right {
 portrait_standard_head_button = {
  datacontext = "[Cabinet.GetCharacter]"
  parentanchor = center
  size = { 90% 96% }
  action_tooltip = {
   click_type = left click_mode = single
   title = "SELECT_CABINET_CHARACTER"
   cost = "[Cabinet.GetPriceForAssigningCabinetMemberToSlot]"
   enabled = "[Cabinet.ArePossibleCabinetCharactersAvailable]"
   description = "[Cabinet.GetDescriptionForReplacingCabinetMemberToSlot]"
   on_action_with_params = "[Cabinet.AssigningCabinetMemberToSlot]"
  }
  blockoverride "character_contextmenu" {}
  blockoverride "button_setup" {}
  blockoverride "rightclick" {}
 }
}
template pmcqfav_action_change_societal_values {
 tooltip_enabled = yes tooltip = "pmcqfav_action_change_societal_values_desc"
 button = {
  name = "pmcqfav_action_button_change_societal_values"
  size = { 24 24 } using = button_regular_texture
  down = "[And(Cabinet.IsActive, EqualTo_string(Cabinet.GetAction.GetNameWithNoTooltip, ShowCabinetActionNameWithNoTooltip('change_societal_values')))]"
  tooltip_enabled = yes tooltip = "pmcqfav_action_change_societal_values_desc"
  enabled = "[And(And(Not(GetVariableSystem.Exists('pmcqcs_request')), Not(Or3(GetVariableSystem.HasValue('pmcqia', 'advance'), GetVariableSystem.HasValue('pmcqia', 'select'), Or3(GetVariableSystem.HasValue('pmcqia', 'opening'), GetVariableSystem.HasValue('pmcqia', 'loading'), GetVariableSystem.HasValue('pmcqia', 'picker'))))), And(GetScriptedGui('pmcqfav_available_change_societal_values').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('actor', GetPlayer.MakeScope).End), Not(And(Cabinet.IsActive, EqualTo_string(Cabinet.GetAction.GetNameWithNoTooltip, ShowCabinetActionNameWithNoTooltip('change_societal_values'))))))]"
  
  onclick = "[GetVariableSystem.Clear('pmcqcs_close_government')]"
  onclick = "[GetVariableSystem.Clear('pmcqcs_close_phase')]"
  onclick = "[GetVariableSystem.Set('pmcqcs_slot_index', ToString_int32(Cabinet.GetIndex))]"
  onclick = "[GetScriptedGui('pmcqcs_prepare').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqcs_slot', Cabinet.MakeScope).AddScope('pmcqcs_action_id', MakeScopeValue('(CFixedPoint)1')).End)]"
  onclick = "[GetVariableSystem.Set('pmcqcs_request', 'change_societal_values')]"
  onclick = "[SelectCabinetAction(Cabinet.Self, '(bool)no')]"
 }
 icon = {
  size = { 21 21 } position = { 1 1 }
  alwaystransparent = yes
  texture = "gfx/interface/icons/cabinet_actions/change_societal_values.dds"
  
  glow = { name = "pmcqcs_selected_glow" visible = "[And(Cabinet.IsActive, EqualTo_string(Cabinet.GetAction.GetNameWithNoTooltip, ShowCabinetActionNameWithNoTooltip('change_societal_values')))]" glow_radius = 5 color = { 1.0 0.85 0.2 1.0 } alpha = 1 }
 }
 widget = {
  name = "pmcqcs_selected_border"
  size = { 24 24 } alwaystransparent = yes visible = "[And(Cabinet.IsActive, EqualTo_string(Cabinet.GetAction.GetNameWithNoTooltip, ShowCabinetActionNameWithNoTooltip('change_societal_values')))]"
  icon = { size = { 24 2 } position = { 0 0 } using = color_yellow_texture alwaystransparent = yes }
  icon = { size = { 24 2 } position = { 0 22 } using = color_yellow_texture alwaystransparent = yes }
  icon = { size = { 2 24 } position = { 0 0 } using = color_yellow_texture alwaystransparent = yes }
  icon = { size = { 2 24 } position = { 22 0 } using = color_yellow_texture alwaystransparent = yes }
 }
}

