## IMPROVING OPINION
#########################################

OutlinerEntryBase = {
	name = "improve_opinion_diplomatic_entry"

 widget = {
  name = "pmcqr_outliner_cap"
  size = { 1 1 }
  datacontext = "[OutlinerDiplomacyEntry.GetTemporaryRelationCountry]"
  visible_at_creation = no
  visible = "[And(GetPlayer.MakeScope.GetVariable('pmcqr_scan').IsSet, GreaterThanOrEqualTo_float(OngoingRelationCountry.GetOpinionImprovementProgress, '(float)99.99'))]"
  state = {
   name = _show alpha = 1 duration = 0.01
   on_start = "[GetScriptedGui('pmcqr_observe_capped').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqr_target', OutlinerDiplomacyEntry.GetTargetCountry.MakeScope).End)]"
  }
 }
 widget = {
  name = "pmcqr_native_recall"
  size = { 1 1 }
  visible_at_creation = no
  visible = "[And3(Not(IsShowingDialog), OutlinerDiplomacyEntry.CanRightClick, GetScriptedGui('pmcqr_recall_requested').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqr_target', OutlinerDiplomacyEntry.GetTargetCountry.MakeScope).End))]"
  state = {
   name = _show
   alpha = 1
   on_start = "[GetScriptedGui('pmcqr_arm_recall').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqr_target', OutlinerDiplomacyEntry.GetTargetCountry.MakeScope).End)]"
   duration = 0.05
   on_finish = "[OutlinerDiplomacyEntry.OnRightClick]"
  }
 }


	blockoverride "expanded_big_content" {
		using = diplomacy_expanded_big_content
	}

	blockoverride "expanded_small_content" {
		using = diplomacy_expanded_small_content
	}

	blockoverride "icon_content" {
		using = diplomacy_icon_content
	}

	blockoverride "button_setup" {
		datacontext = "[OutlinerDiplomacyEntry.GetTemporaryRelationCountry]"
		datacontext = "[OngoingRelationCountry.GetCountry]"
		tooltipwidget = {
			using = improve_opinion_tooltip
		}

		action_tooltip = {
			click_type = left
			click_mode = single
			title = "TAB_TOOLTIP_DIPLOMACY_LEFT_CLICK"
			on_action = "[OutlinerDiplomacyEntry.OnClick]"
		}

		action_tooltip = {
			click_type = right
			click_mode = single
			enabled = "[OutlinerDiplomacyEntry.CanRightClick]"
			title = "CANCEL_IMPROVE_RELATIONTITLE"
			on_action = "[OutlinerDiplomacyEntry.OnRightClick]"
		}
	}

	blockoverride "category_color" {
		using = color_diplomacy_texture
	}
}

