			click_type = right
			click_mode = single
			title = "OUTLINER_ITEM_GEOPOLITICS_PRIVATEERS_TOOLTIP"
			on_action = "[OpenLateralViewWithParams('maritime', 'low_tab = privateers')]"
		}
	}

	blockoverride "category_color" {
		using = color_geopolitics_texture
	}
}

