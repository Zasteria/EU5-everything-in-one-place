## CABINET ENTRY
# Available contexts
# "Cabinet"
# "CabinetItem"
# "Outliner"
###############################################################################

template pmcq_outliner_target_title {
 button = {
  name = "pmcq_manual_setup_button"
  size = { 45 20 }
  using = button_regular_texture
  text = "pmcq_manual_setup" fontsize = 10
  tooltip = "pmcq_manual_setup_desc"
  visible = "[GetScriptedGui('pmcq_manual_setup_visible').IsShown(GuiScope.SetRoot(Cabinet.MakeScope).End)]"
  onclick = "[GetVariableSystem.SetOrToggle('pmcq_manual_window', 'open')]"
 }

 OutlinerTextBase = {
  using = layoutpolicy_expanding
  visible = "[GetScriptedGui('pmcq_assimilation_waiting').IsShown(GuiScope.SetRoot(Cabinet.MakeScope).End)]"
  text = "[SelectLocalization(Cabinet.IsCharacterSet, 'pmcq_assimilation_waiting', 'pmcq_assimilation_no_member')]"
  align = left
  default_format = "#L"
  autoresize = no
  block "pmcq_target_title_width" { maximumsize = { 190 -1 } }
 }

 OutlinerTextBase = {
  using = layoutpolicy_expanding
  visible = "[Cabinet.MakeScope.GetVariable('pmcqi_slot_target').IsSet]"
  text = "pmcq_outliner_integrating_short"
  tooltip = "pmcq_outliner_integrating"
  align = left
  default_format = "#L"
  autoresize = no
  block "pmcq_target_title_width" { maximumsize = { 190 -1 } }
 }
 OutlinerTextBase = {
  using = layoutpolicy_expanding
  visible = "[Cabinet.MakeScope.GetVariable('pmcqa_slot_target').IsSet]"
  text = "pmcq_outliner_converting_short"
  tooltip = "pmcq_outliner_converting"
  align = left
  default_format = "#L"
  autoresize = no
  block "pmcq_target_title_width" { maximumsize = { 190 -1 } }
 }
 OutlinerTextBase = {
  using = layoutpolicy_expanding
  visible = "[Cabinet.MakeScope.GetVariable('pmcqie_area').IsSet]"
  text = "pmcq_outliner_integrating_area_short"
  tooltip = "pmcq_outliner_integrating_area"
  align = left
  default_format = "#L"
  autoresize = no
  block "pmcq_target_title_width" { maximumsize = { 190 -1 } }
 }
 OutlinerTextBase = {
  using = layoutpolicy_expanding
  visible = "[Cabinet.MakeScope.GetVariable('pmcqae_area').IsSet]"
  text = "pmcq_outliner_converting_area_short"
  tooltip = "pmcq_outliner_converting_area"
  align = left
  default_format = "#L"
  autoresize = no
  block "pmcq_target_title_width" { maximumsize = { 190 -1 } }
 }
}

template cabinet_entry_action_progress {
	hbox = {
		spacing = 4
		portrait_standard_head_button = {
			datacontext = "[Cabinet.GetCharacter]"
			visible = "[Cabinet.IsCharacterSet]"
			size = { 28 28 }
	
			action_tooltip = {
				click_type = right
				click_mode = single
	
				title = "CHANGE_CABINET"
				cost = "[Cabinet.GetPriceForAssigningCabinetMemberToSlot]"
				enabled = "[Cabinet.ArePossibleCabinetCharactersAvailable]"
				description = "[Cabinet.GetDescriptionForAssigningCabinetMemberToSlot]"
				on_action_with_params = "[Cabinet.AssigningCabinetMemberToSlot]"
			}
	
			# blockoverride "character_tooltip" { 
			# }
			blockoverride "character_contextmenu" {}
			blockoverride "button_setup" {
			}
			blockoverride "rightclick" {}
			# blockoverride "hover" {}
		}
		portrait_standard_head_button = {
			datacontext = "[Cabinet.GetCharacter]"
			visible = "[Not(Cabinet.IsCharacterSet)]"
			size = { 28 28 }
	
			action_tooltip = {
				click_type = left
				click_mode = single
	
				title = "SELECT_CABINET_CHARACTER"
				cost = "[Cabinet.GetPriceForAssigningCabinetMemberToSlot]"
				enabled = "[Cabinet.ArePossibleCabinetCharactersAvailable]"
				description = "[Cabinet.GetDescriptionForReplacingCabinetMemberToSlot]"
				on_action_with_params = "[Cabinet.AssigningCabinetMemberToSlot]"
			}
	
			blockoverride "character_tooltip" { 
				tooltipwidget = {
					BasicFunctionalTooltip = {}
				}
			}
			blockoverride "character_contextmenu" {}
			blockoverride "button_setup" {
			}
			blockoverride "rightclick" {}
			# blockoverride "hover" {}
		}
		cabinet_efficiency_icon = {
			blockoverride "icon_size" { size = { 20 20 } }
			tooltipwidget = {
				using = effective_skill_tooltip
			}
		}
	}
	block "cabinet_entry_title_text" {
		using = pmcq_outliner_target_title
        blockoverride "pmcq_target_title_width" { maximumsize = { 90 -1 } }
		OutlinerTextBase = {
			visible = "[And(Not(GetScriptedGui('pmcq_assimilation_waiting').IsShown(GuiScope.SetRoot(Cabinet.MakeScope).End)), Not(Or(Or(Cabinet.MakeScope.GetVariable('pmcqi_slot_target').IsSet, Cabinet.MakeScope.GetVariable('pmcqa_slot_target').IsSet), Or(Cabinet.MakeScope.GetVariable('pmcqie_area').IsSet, Cabinet.MakeScope.GetVariable('pmcqae_area').IsSet))))]"
			using = layoutpolicy_expanding
			text = "[Select_CString(EqualTo_string(Cabinet.GetAction.GetNameWithNoTooltip, ShowCabinetActionNameWithNoTooltip('pmcq2_control_action')), 'Control Q', Select_CString(EqualTo_string(Cabinet.GetAction.GetNameWithNoTooltip, ShowCabinetActionNameWithNoTooltip('pmcq2_nobles_action')), 'Nobles Q', Select_CString(EqualTo_string(Cabinet.GetAction.GetNameWithNoTooltip, ShowCabinetActionNameWithNoTooltip('pmcqi_action')), 'Auto Int.', Select_CString(EqualTo_string(Cabinet.GetAction.GetNameWithNoTooltip, ShowCabinetActionNameWithNoTooltip('pmcqa_action')), 'Auto Cul.', Select_CString(EqualTo_string(Cabinet.GetAction.GetNameWithNoTooltip, ShowCabinetActionNameWithNoTooltip('strengthen_government')), 'Gov. Power', Select_CString(EqualTo_string(Cabinet.GetAction.GetNameWithNoTooltip, ShowCabinetActionNameWithNoTooltip('stabilize_country')), 'Stability', Select_CString(EqualTo_string(Cabinet.GetAction.GetNameWithNoTooltip, ShowCabinetActionNameWithNoTooltip('change_societal_values')), 'Values', Cabinet.GetNameWithNoTooltip)))))))]"
            tooltip = "[Cabinet.GetNameWithNoTooltip]"
			align = left
			default_format = "#L"
			maximumsize = { 90 -1 }
		}
	}
	expand = {}

	block "cabinet_entry_progress_text" {
		OutlinerTextBase = {
			maximumsize = { 100 -1 }
			autoresize = yes
			text = "[Cabinet.GetActionProgress]"
		}
	}
	using = pmcq_cabinet_shortcuts
}

