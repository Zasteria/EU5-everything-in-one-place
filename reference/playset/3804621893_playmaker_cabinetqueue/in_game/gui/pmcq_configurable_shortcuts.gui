                        onclick = "[GetVariableSystem.Set('pmcq_shortcut_key', Select_CString(GetScriptedGui('pmcq_shortcut_allied').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', ForeignCountryView.GetCountry.MakeScope).End), 'break_alliance', 'alliance'))]"
                        onclick = "[GetVariableSystem.Set('pmcq_shortcut_category', Select_CString(GetScriptedGui('pmcq_shortcut_allied').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', ForeignCountryView.GetCountry.MakeScope).End), 'CATEGORY_HOSTILE_ACTIONS', 'CATEGORY_FRIENDLY_ACTIONS'))]"
                        onclick = "[GetVariableSystem.Set('pmcq_shortcut_pending', 'yes')]"
                        action_tooltip = {
                            click_type = right
                            click_mode = single
                            title = "pmcq_shortcut_check_acceptance"
                        on_action = "[GetVariableSystem.Set('pmcq_shortcut_target', ForeignCountryView.GetCountry.GetTag)]"
                        on_action = "[GetVariableSystem.Set('pmcq_shortcut_key', Select_CString(GetScriptedGui('pmcq_shortcut_allied').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', ForeignCountryView.GetCountry.MakeScope).End), 'break_alliance', 'alliance'))]"
                        on_action = "[GetVariableSystem.Set('pmcq_shortcut_category', Select_CString(GetScriptedGui('pmcq_shortcut_allied').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', ForeignCountryView.GetCountry.MakeScope).End), 'CATEGORY_HOSTILE_ACTIONS', 'CATEGORY_FRIENDLY_ACTIONS'))]"
                        on_action = "[GetVariableSystem.Set('pmcq_shortcut_pending', 'inspect')]"
                        }
                    }
                    blockoverride "pmcq_shortcut_text" { text = "[Select_CString(GetScriptedGui('pmcq_shortcut_allied').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', ForeignCountryView.GetCountry.MakeScope).End), Localize('pmcq_shortcut_break_alliance'), Localize('pmcq_shortcut_alliance'))]" }
                    blockoverride "pmcq_shortcut_visible" {
                        visible = "[Or(And(GetScriptedGui('pmcq_shortcut_allied').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', ForeignCountryView.GetCountry.MakeScope).End), Or(EqualTo_string(DiplomaticActionItem.GetTag, 'cancel_alliance'), EqualTo_string(DiplomaticActionItem.GetTitle, Localize('cancel_alliance')))), And(Not(GetScriptedGui('pmcq_shortcut_allied').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', ForeignCountryView.GetCountry.MakeScope).End)), Or(EqualTo_string(DiplomaticActionItem.GetTag, 'offer_alliance'), EqualTo_string(DiplomaticActionItem.GetTitle, Localize('offer_alliance')))))]"
                    }
                }
