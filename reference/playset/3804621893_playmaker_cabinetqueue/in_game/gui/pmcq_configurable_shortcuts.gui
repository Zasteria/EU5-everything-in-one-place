type pmcq_config_action_alliance = pmcq_diplo_shortcut_slot {
                    name = "pmcq_shortcut_alliance"
                    blockoverride "pmcq_shortcut_native_enabled" { enabled = "[Or(Not(GetScriptedGui('pmcq_shortcut_allied').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', ForeignCountryView.GetCountry.MakeScope).End)), DiplomaticActionItem.IsEnabled)]" }
                    blockoverride "pmcq_shortcut_action_enabled" { enabled = "[Or(Not(GetScriptedGui('pmcq_shortcut_allied').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', ForeignCountryView.GetCountry.MakeScope).End)), DiplomaticActionItem.IsEnabled)]" }
                    blockoverride "pmcq_shortcut_acceptance_frame" { frame = "[Select_int32(DiplomaticActionItem.IsEnabled, DiplomaticActionItem.GetAcceptanceFrame, '(int32)1')]" }
                    blockoverride "pmcq_shortcut_unknown_visible" { visible = "[Not(GetScriptedGui('pmcq_shortcut_allied').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', ForeignCountryView.GetCountry.MakeScope).End))]" }
                    blockoverride "pmcq_shortcut_acceptance_visible" { visible = "[Not(GetScriptedGui('pmcq_shortcut_allied').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', ForeignCountryView.GetCountry.MakeScope).End))]" }
                    blockoverride "pmcq_shortcut_launch" {
