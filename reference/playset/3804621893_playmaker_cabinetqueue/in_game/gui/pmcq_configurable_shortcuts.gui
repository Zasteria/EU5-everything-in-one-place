types pmcq_configurable_shortcuts {
type pmcq_config_action_gift = pmcq_diplo_shortcut_slot {
                    name = "pmcq_shortcut_gift"
                    blockoverride "pmcq_shortcut_launch_enabled" { enabled = "[Not(GetScriptedGui('pmcqsg_manual_cooldown').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqsg_target', ForeignCountryView.GetCountry.MakeScope).End))]" }
                    blockoverride "pmcq_shortcut_launch_tooltip" { tooltip = "[SelectLocalization(GetScriptedGui('pmcqsg_manual_cooldown').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqsg_target', ForeignCountryView.GetCountry.MakeScope).End), 'pmcqsg_manual_cooldown_tip', 'pmcq_shortcut_initialize_tip')]" }
                    blockoverride "pmcq_shortcut_launch" {
                        onclick = "[GetVariableSystem.Set('pmcq_shortcut_target', ForeignCountryView.GetCountry.GetTag)]"
                        onclick = "[GetVariableSystem.Set('pmcq_shortcut_key', 'gift')]"
                        onclick = "[GetVariableSystem.Set('pmcq_shortcut_category', 'CATEGORY_ECONOMY_ACTIONS')]"
                        onclick = "[GetVariableSystem.Set('pmcq_shortcut_pending', 'yes')]"
                        action_tooltip = {
                            click_type = right
                            click_mode = single
                            title = "pmcq_shortcut_check_acceptance"
                        on_action = "[GetVariableSystem.Set('pmcq_shortcut_target', ForeignCountryView.GetCountry.GetTag)]"
                        on_action = "[GetVariableSystem.Set('pmcq_shortcut_key', 'gift')]"
                        on_action = "[GetVariableSystem.Set('pmcq_shortcut_category', 'CATEGORY_ECONOMY_ACTIONS')]"
                        on_action = "[GetVariableSystem.Set('pmcq_shortcut_pending', 'inspect')]"
                        }
                    }
                    blockoverride "pmcq_shortcut_text" { text = "pmcq_shortcut_gift" }
                    blockoverride "pmcq_shortcut_visible" {
                        visible = "[Or(DiplomaticActionItem.IsType('giftaction'), EqualTo_string(DiplomaticActionItem.GetTitle, Localize('SENDGIFTTITLE')))]"
                    }
                }
type pmcq_config_action_access = pmcq_diplo_shortcut_slot {
                    name = "pmcq_shortcut_access"
                    blockoverride "pmcq_shortcut_launch_enabled" { enabled = "[Not(And(GetScriptedGui('pmcq_shortcut_has_military_access').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', ForeignCountryView.GetCountry.MakeScope).End), GetScriptedGui('pmcq_shortcut_allied').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', ForeignCountryView.GetCountry.MakeScope).End)))]" }
                    blockoverride "pmcq_shortcut_native_enabled" { enabled = "[And(Not(And(GetScriptedGui('pmcq_shortcut_has_military_access').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', ForeignCountryView.GetCountry.MakeScope).End), GetScriptedGui('pmcq_shortcut_allied').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', ForeignCountryView.GetCountry.MakeScope).End))), DiplomaticActionItem.IsEnabled)]" }
                    blockoverride "pmcq_shortcut_unknown_visible" { visible = "[Not(GetScriptedGui('pmcq_shortcut_has_military_access').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', ForeignCountryView.GetCountry.MakeScope).End))]" }
                    blockoverride "pmcq_shortcut_acceptance_visible" { visible = "[And(Not(GetScriptedGui('pmcq_shortcut_has_military_access').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', ForeignCountryView.GetCountry.MakeScope).End)), DiplomaticActionItem.RequiresAcceptance)]" }
                    blockoverride "pmcq_shortcut_launch" {
                        onclick = "[GetVariableSystem.Set('pmcq_shortcut_target', ForeignCountryView.GetCountry.GetTag)]"
                        onclick = "[GetVariableSystem.Set('pmcq_shortcut_key', Select_CString(GetScriptedGui('pmcq_shortcut_has_military_access').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', ForeignCountryView.GetCountry.MakeScope).End), 'end_access', 'access'))]"
                        onclick = "[GetVariableSystem.Set('pmcq_shortcut_category', 'CATEGORY_ACCESS_ACTIONS')]"
                        onclick = "[GetVariableSystem.Set('pmcq_shortcut_pending', 'yes')]"
                        action_tooltip = {
                            click_type = right
                            click_mode = single
                            title = "pmcq_shortcut_check_acceptance"
                        on_action = "[GetVariableSystem.Set('pmcq_shortcut_target', ForeignCountryView.GetCountry.GetTag)]"
                        on_action = "[GetVariableSystem.Set('pmcq_shortcut_key', Select_CString(GetScriptedGui('pmcq_shortcut_has_military_access').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', ForeignCountryView.GetCountry.MakeScope).End), 'end_access', 'access'))]"
                        on_action = "[GetVariableSystem.Set('pmcq_shortcut_category', 'CATEGORY_ACCESS_ACTIONS')]"
                        on_action = "[GetVariableSystem.Set('pmcq_shortcut_pending', 'inspect')]"
                        }
                    }
                    blockoverride "pmcq_shortcut_text" { text = "[Select_CString(GetScriptedGui('pmcq_shortcut_has_military_access').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', ForeignCountryView.GetCountry.MakeScope).End), Localize('pmcq_shortcut_end_access'), Localize('pmcq_shortcut_access'))]" }
                    blockoverride "pmcq_shortcut_visible" {
                        visible = "[Or(And(GetScriptedGui('pmcq_shortcut_has_military_access').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', ForeignCountryView.GetCountry.MakeScope).End), Or(EqualTo_string(DiplomaticActionItem.GetTag, 'break_military_access'), EqualTo_string(DiplomaticActionItem.GetTitle, Localize('break_military_access')))), And(Not(GetScriptedGui('pmcq_shortcut_has_military_access').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', ForeignCountryView.GetCountry.MakeScope).End)), Or(EqualTo_string(DiplomaticActionItem.GetTag, 'buy_request_military_access'), EqualTo_string(DiplomaticActionItem.GetTitle, Localize('buy_request_military_access')))))]"
                    }
                }
