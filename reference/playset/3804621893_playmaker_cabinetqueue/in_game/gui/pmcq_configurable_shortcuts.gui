type pmcq_config_action_insult = pmcq_diplo_shortcut_slot {
 name = "pmcq_shortcut_insult"
 blockoverride "pmcq_shortcut_text" { text = "pmcq_shortcut_insult" }
 blockoverride "pmcq_shortcut_visible" { visible = "[DiplomaticActionItem.IsType('insultaction')]" }
 blockoverride "pmcq_shortcut_launch" {
 onclick = "[GetVariableSystem.Set('pmcq_shortcut_target', ForeignCountryView.GetCountry.GetTag)]"
 onclick = "[GetVariableSystem.Set('pmcq_shortcut_key', 'insult')]"
 onclick = "[GetVariableSystem.Set('pmcq_shortcut_category', 'CATEGORY_HOSTILE_ACTIONS')]"
 onclick = "[GetVariableSystem.Set('pmcq_shortcut_pending', 'yes')]"
 action_tooltip = { click_type = right click_mode = single title = "pmcq_shortcut_check_acceptance"
 on_action = "[GetVariableSystem.Set('pmcq_shortcut_target', ForeignCountryView.GetCountry.GetTag)]"
 on_action = "[GetVariableSystem.Set('pmcq_shortcut_key', 'insult')]"
 on_action = "[GetVariableSystem.Set('pmcq_shortcut_category', 'CATEGORY_HOSTILE_ACTIONS')]"
 on_action = "[GetVariableSystem.Set('pmcq_shortcut_pending', 'inspect')]"
 }
 }
 blockoverride "pmcq_shortcut_launch_enabled" { enabled = "[GetScriptedGui('pmcq_shortcut_has_diplomat').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
 blockoverride "pmcq_shortcut_unknown_visible" { visible = no }
}
