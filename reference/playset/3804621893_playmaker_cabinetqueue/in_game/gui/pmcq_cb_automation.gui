template pmcqcb_tools {
 widget = {
  name = "pmcqcb_window" layer = top
  parentanchor = center widgetanchor = center size = { 555 420 }
  using = bg_main_inner_alt
  visible = "[GetVariableSystem.HasValue('pmcqcb_window', 'open')]"
  text_single = { position = { 12 8 } size = { 480 26 } text = "pmcqcb_title" fontsize = 18 }
  button = { position = { 520 6 } size = { 25 25 } using = button_regular_texture raw_text = "X" onclick = "[GetVariableSystem.Clear('pmcqcb_window')]" }
  text_multi = { position = { 12 40 } size = { 530 40 } text = "pmcqcb_help" fontsize = 12 }
  text_multi = { position = { 12 82 } size = { 405 28 } text = "[SelectLocalization(GetScriptedGui('pmcqcb_draft_active').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), 'pmcqcb_active', 'pmcqcb_idle')]" fontsize = 12 }
  button = { position = { 430 80 } size = { 100 25 } using = button_regular_texture text = "pmcqcb_cancel"
   visible = "[GetScriptedGui('pmcqcb_draft_active').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
   enabled = "[GetScriptedGui('pmcqcb_cancel').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
   onclick = "[GetScriptedGui('pmcqcb_cancel').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
  }
  text_multi = { position = { 12 112 } size = { 530 30 } text = "[SelectLocalization(GetScriptedGui('pmcqcb_draft_failed').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), 'pmcqcb_failed', 'pmcqcb_progress_help')]" fontsize = 12 }
  scrollarea = { position = { 12 150 } size = { 531 255 } scrollbarpolicy_horizontal = always_off scrollbarpolicy_vertical = as_needed
   scrollbar_vertical = { using = Scrollbar_Vertical }
   scrollwidget = { vbox = { layoutpolicy_horizontal = expanding layoutpolicy_vertical = fixed parentanchor = top spacing = 3 ignoreinvisible = yes
    datamodel = "[GetPlayer.MakeScope.GetList('pmcqcb_draft')]"
    item = { vbox = { layoutpolicy_horizontal = expanding layoutpolicy_vertical = fixed parentanchor = top spacing = 3 ignoreinvisible = yes datacontext = "[Scope.GetCountry]"
     text_single = { size = { 505 30 } text = "[Country.GetName]" fontsize = 16 }
     button = { size = { 505 30 } using = button_regular_texture text = "[ShowCasusBelliNameWithNoTooltip('cb_anti_piracy')]" fontsize = 13
      visible = "[GetScriptedGui('pmcqcb_option_1').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Country.MakeScope).End)]"
      enabled = "[GetScriptedGui('pmcqcb_option_1').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Country.MakeScope).End)]"
      onclick = "[GetScriptedGui('pmcqcb_option_1').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Country.MakeScope).End)]"
      onclick = "[GetVariableSystem.Clear('pmcqcb_window')]"
     }
     button = { size = { 505 30 } using = button_regular_texture text = "[ShowCasusBelliNameWithNoTooltip('attack_threat')]" fontsize = 13
