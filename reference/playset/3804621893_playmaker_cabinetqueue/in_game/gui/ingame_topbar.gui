widget = {
	size = { 100% 100% }
	name = "ingame_topbar"
 using = pmcqcb_tools

 # Keep assignment cleanup alive outside the panels being opened/closed.
 widget = { name = "pmcqcs_close_coordinator" size = { 1 1 } alwaystransparent = yes
  dynamicgridbox = {
   datamodel = "[DataModelRepeatedItem(Select_int32(And(And(GetVariableSystem.HasValue('pmcqcs_close_government', 'yes'), Not(GetVariableSystem.Exists('pmcqcs_close_phase'))), And(Not(GetVariableSystem.Exists('pmcqcs_request')), GetScriptedGui('pmcqcs_assignment_complete').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))), '(int32)1', '(int32)0'))]"
   item = { widget = { size = { 1 1 }
    state = { name = pmcqcs_wait_for_native_return trigger_on_create = yes alpha = 0.99 duration = 0.35
     on_finish = "[GetVariableSystem.Set('pmcqcs_close_phase', 'ready')]"
    }
   } }
  }
  dynamicgridbox = {
   datamodel = "[DataModelRepeatedItem(Select_int32(GetVariableSystem.HasValue('pmcqcs_close_phase', 'ready'), '(int32)1', '(int32)0'))]"
   item = { widget = { size = { 1 1 }
    state = { name = pmcqcs_finish_close_window trigger_on_create = yes alpha = 0.99 duration = 1.25
     on_finish = "[GetVariableSystem.Clear('pmcqcs_close_government')]"
     on_finish = "[GetVariableSystem.Clear('pmcqcs_close_phase')]"
    }
   } }
  }
 }


 

# No graphics. This stays active when the visible panel is minimized.
widget = {
 name = "pmcqr_monitor"
 size = { 1 1 }
 visible = "[GetPlayer.Exists]"
 datacontext = "[GetQuickTemporaryCountryRelations(Player.Self)]"
 dynamicgridbox = {
  size = { 1 1 }
  datamodel = "[GetPlayer.MakeScope.GetList('pmcqx_subjects')]"
  item = {
   widget = {
    size = { 1 1 }
    datacontext = "[Scope.GetCountry]"
    widget = {
 size = { 1 1 }
 visible_at_creation = no
 visible = "[And(GetPlayer.MakeScope.GetVariable('pmcqr_scan').IsSet, HasDiplomaticPendingWithCountry(Country.Self))]"
 state = { name = _show alpha = 1 duration = 0.01 on_start = "[GetScriptedGui('pmcqx_observe_pending').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqx_target', Country.MakeScope).End)]" }
}
    widget = {
     size = { 1 1 }
     datacontext = "[Country.GetQuickDiplomaticActions]"
     widget = {
      size = { 1 1 }
      visible = "[QuickDiplomaticActions.HasSpecificAction('annexationaction')]"
      datacontext = "[QuickDiplomaticActions.GetSpecificAction('annexationaction')]"
      widget = {
 size = { 1 1 }
 visible_at_creation = no
 visible = "[And3(GetPlayer.MakeScope.GetVariable('pmcqr_scan').IsSet, DiplomaticActionItem.IsEnabled, EqualTo_string(DiplomaticActionItem.GetTitle, Localize('ANNEXTITLE')))]"
 state = { name = _show alpha = 1 duration = 0.01 on_start = "[GetScriptedGui('pmcqx_observe_ready').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqx_target', Country.MakeScope).End)]" }
}
     }
    }
    widget = {
     size = { 1 1 }
     datacontext = "[Country.GetDynamicQuickDiplomaticActions]"
     dynamicgridbox = {
      size = { 1 1 }
      datamodel = "[QuickDiplomaticActions.GetDynamicList]"
      item = {
       widget = {
        size = { 1 1 }
        visible = "[DiplomaticActionItem.IsType('annexationaction')]"
        widget = {
 size = { 1 1 }
 visible_at_creation = no
 visible = "[And3(GetPlayer.MakeScope.GetVariable('pmcqr_scan').IsSet, DiplomaticActionItem.IsEnabled, EqualTo_string(DiplomaticActionItem.GetTitle, Localize('ANNEXTITLE')))]"
 state = { name = _show alpha = 1 duration = 0.01 on_start = "[GetScriptedGui('pmcqx_observe_ready').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqx_target', Country.MakeScope).End)]" }
}
        
widget = {
 size = { 1 1 }
 visible_at_creation = no
 visible = "[And4(Not(IsShowingDialog), DiplomaticActionItem.IsEnabled, EqualTo_string(DiplomaticActionItem.GetTitle, Localize('ANNEXTITLE')), GetScriptedGui('pmcqx_start_requested').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqx_target', Country.MakeScope).End))]"
 state = {
  name = _show alpha = 1 duration = 0.01
  on_start = "[GetScriptedGui('pmcqx_arm_start').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqx_target', Country.MakeScope).End)]"
  on_finish = "[DiplomaticActionItem.OnClick]"
 }
}

       }
      }
     }
    }
   }
  }
 }
 dynamicgridbox = {
  size = { 1 1 }
  datamodel = "[GetPlayer.MakeScope.GetList('pmcqr_queue')]"
  item = {
   widget = {
    size = { 1 1 }
    datacontext = "[Scope.GetCountry]"
    widget = {
 size = { 1 1 }
 visible_at_creation = no
 visible = "[GetPlayer.MakeScope.GetVariable('pmcqr_scan').IsSet]"
 state = { name = _show alpha = 1 duration = 0.01 on_start = "[GetScriptedGui('pmcqr_observe_sampled').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqr_target', Country.MakeScope).End)]" }
}
    widget = {
 size = { 1 1 }
 visible_at_creation = no
 visible = "[And(GetPlayer.MakeScope.GetVariable('pmcqr_scan').IsSet, HasDiplomaticPendingWithCountry(Country.Self))]"
 state = { name = _show alpha = 1 duration = 0.01 on_start = "[GetScriptedGui('pmcqr_observe_pending').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqr_target', Country.MakeScope).End)]" }
}
    widget = {
     size = { 1 1 }
     visible = "[QuickTemporaryCountryRelations.HasTemporaryRelation(Country.Self)]"
     datacontext = "[QuickTemporaryCountryRelations.GetTemporaryRelation(Country.Self)]"
     widget = {
 size = { 1 1 }
 visible_at_creation = no
 visible = "[And(GetPlayer.MakeScope.GetVariable('pmcqr_scan').IsSet, OngoingRelationCountry.IsImprovingOpinion)]"
 state = { name = _show alpha = 1 duration = 0.01 on_start = "[GetScriptedGui('pmcqr_observe_seen').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqr_target', Country.MakeScope).End)]" }
}
     widget = {
 size = { 1 1 }
 visible_at_creation = no
 visible = "[And(GetPlayer.MakeScope.GetVariable('pmcqr_scan').IsSet, GreaterThanOrEqualTo_float(OngoingRelationCountry.GetOpinionImprovementProgress, '(float)99.99'))]"
 state = { name = _show alpha = 1 duration = 0.01 on_start = "[GetScriptedGui('pmcqr_observe_capped').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqr_target', Country.MakeScope).End)]" }
}
    }
    widget = {
     size = { 1 1 }
     datacontext = "[Country.GetQuickDiplomaticActions]"
     widget = {
      size = { 1 1 }
      visible = "[QuickDiplomaticActions.HasSpecificAction('improve_relation')]"
      datacontext = "[QuickDiplomaticActions.GetSpecificAction('improve_relation')]"
      widget = {
 size = { 1 1 }
 visible_at_creation = no
 visible = "[And(GetPlayer.MakeScope.GetVariable('pmcqr_scan').IsSet, DiplomaticActionItem.IsEnabled)]"
 state = { name = _show alpha = 1 duration = 0.01 on_start = "[GetScriptedGui('pmcqr_observe_ready').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqr_target', Country.MakeScope).End)]" }
}
     }
    }
   }
  }
 }
 widget = {
  size = { 1 1 }
  visible_at_creation = no
  visible = "[Or(GetPlayer.MakeScope.GetVariable('pmcqr_auto_subjects').IsSet, Or3(GetPlayer.MakeScope.GetVariable('pmcqb_running').IsSet, GetPlayer.MakeScope.GetVariable('pmcqx_running').IsSet, Or3(GetPlayer.MakeScope.GetVariable('pmcqr_running').IsSet, GetPlayer.MakeScope.GetVariable('pmcqr_refresh').IsSet, Not(IsDataModelEmpty(GetPlayer.MakeScope.GetList('pmcqr_owned'))))))]"
  state = { name = _show alpha = 0.99 duration = 0.2 next = pmcqr_prepare }
  state = { name = pmcqr_prepare alpha = 1 on_start = "[PdxGuiTriggerAllAnimations('pmcqr_begin_if_clear')]" duration = 0.5 next = pmcqr_process_scan }
  state = { name = pmcqr_process_scan alpha = 0.99 on_start = "[GetScriptedGui('pmcqr_finish_scan').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" duration = 0.2 next = pmcqr_dispatch_recall }
  state = { name = pmcqr_dispatch_recall alpha = 1 duration = 0.5 next = pmcqr_cleanup }
  state = { name = pmcqr_cleanup alpha = 0.99 on_start = "[GetScriptedGui('pmcqr_clear_recall').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" duration = 0.5 next = pmcqr_prepare }
  widget = {
   size = { 1 1 }
   visible = "[Not(IsShowingDialog)]"
   state = { name = pmcqr_begin_if_clear alpha = 1 duration = 0.01 on_start = "[GetScriptedGui('pmcqr_prepare_scan').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
  }
 }
}






# Compact queue controls: local UI state only; collapsing does not pause.











widget = { name = "pmcqrm_reopen_picker" size = { 1 1 } alwaystransparent = yes
 datacontext = "[GetGenericAction('pmcqr_add')]"
 visible = "[GetPlayer.MakeScope.GetVariable('pmcqrm_reopen').IsSet]"
 state = { name = _show duration = 0.5
  on_finish = "[PerformGenericAction(GenericAction.Self)]"
  on_finish = "[GetScriptedGui('pmcqrm_reopen_consumed').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 }
}
widget = { name = "pmcqpm_reopen_picker" size = { 1 1 } alwaystransparent = yes
 datacontext = "[GetGenericAction('pmcq_add')]"
 visible = "[GetPlayer.MakeScope.GetVariable('pmcqpm_reopen').IsSet]"
 state = { name = _show duration = 0.5
  on_finish = "[PerformGenericAction(GenericAction.Self)]"
  on_finish = "[GetScriptedGui('pmcqpm_reopen_consumed').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 }
}
widget = { name = "pmcqcm_initialize" size = { 1 1 } ignore_layout = yes alwaystransparent = yes
 visible = "[Not(GetPlayer.MakeScope.GetVariable('pmcqcm_generation').IsSet)]"
 state = { name = _show alpha = 0.99 duration = 0.5
  on_finish = "[GetScriptedGui('pmcqcm_initialize').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 }
}

 


widget = {
 name = "pmcqcs_timeout" size = { 1 1 } alwaystransparent = yes visible_at_creation = no
 visible = "[Or(GetVariableSystem.Exists('pmcqcs_request'), GetVariableSystem.Exists('pmcqcs_cleanup'))]"
 state = { name = _show alpha = 0.99 duration = 5
  on_finish = "[GetVariableSystem.Clear('pmcqcs_request')]"
  on_finish = "[GetVariableSystem.Clear('pmcqcs_cleanup')]"
 }
}
widget = {
 name = "pmcqvalues_reopen_estates" size = { 1 1 } alwaystransparent = yes
 dynamicgridbox = {
  datamodel = "[DataModelRepeatedItem(Select_int32(And(GetVariableSystem.HasValue('pmcqvalues_refresh', 'reopening'), Not(IsLateralViewOpened('government'))), '(int32)1', '(int32)0'))]"
  item = { widget = { size = { 1 1 } alwaystransparent = yes
   state = { name = pmcqvalues_rebuild_estates trigger_on_create = yes alpha = 0.99 duration = 0.15
    on_finish = "[GetVariableSystem.Clear('pmcqvalues_refresh')]"
    on_finish = "[OpenLateralViewWithParams('government', 'tabcontent = estates')]"
   }
  } }
 }
}
