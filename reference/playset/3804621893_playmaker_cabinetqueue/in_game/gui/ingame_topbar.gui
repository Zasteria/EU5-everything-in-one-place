widget = { name = "pmcqia_workers" size = { 1 1 } alwaystransparent = yes
# Outliner stop requests are observed here so timer cancellation stays in this GUI root.
widget = { name = "pmcqia_stop_requested" size = { 1 1 } alwaystransparent = yes
 visible_at_creation = no
 visible = "[GetVariableSystem.HasValue('pmcqia', 'stopped')]"
 state = { name = _show alpha = 1 duration = 0.01
  on_start = "[PdxGuiTriggerAllAnimations('pmcqia_cancel_advance_timer')]"
  on_start = "[PdxGuiTriggerAllAnimations('pmcqia_cancel_open_timer')]"
  on_start = "[PdxGuiTriggerAllAnimations('pmcqia_cancel_arm_timer')]"
  on_start = "[PdxGuiTriggerAllAnimations('pmcqia_cancel_deadline')]"
 }
}

# Outliner requests cross GUI roots through VariableSystem, not animation dispatch.
# Every entry into advance starts the local worker, including skip/success/failure.
widget = { name = "pmcqia_advance_timer" size = { 1 1 } alwaystransparent = yes
 state = { name = pmcqia_cancel_advance_timer alpha = 1 duration = 0.01 }
 visible_at_creation = no
 visible = "[GetVariableSystem.HasValue('pmcqia', 'advance')]"
 state = { name = _show alpha = 0.99 duration = 0.4
 on_finish = "[GetVariableSystem.Set('pmcqia', 'select')]"
 }
}
widget = { name = "pmcqia_open_timer" size = { 1 1 } alwaystransparent = yes
 state = { name = pmcqia_cancel_open_timer alpha = 1 duration = 0.01 }
 state = { name = pmcqia_open_timer alpha = 0.99 duration = 0.4
 on_finish = "[GetVariableSystem.Set('pmcqia', 'opening')]"

 }
}
widget = { name = "pmcqia_arm_timer" size = { 1 1 } alwaystransparent = yes
 state = { name = pmcqia_cancel_arm_timer alpha = 1 duration = 0.01 }
 state = { name = pmcqia_arm_timer alpha = 0.99 duration = 0.8
 on_finish = "[GetVariableSystem.Set('pmcqia', 'picker')]"

 }
}
widget = { name = "pmcqia_deadline" size = { 1 1 } alwaystransparent = yes
 state = { name = pmcqia_cancel_deadline alpha = 1 duration = 0.01 }
 state = { name = pmcqia_deadline alpha = 0.99 duration = 20
 on_finish = "[GetVariableSystem.Set('pmcqia_expired', 'yes')]"

 }
}
