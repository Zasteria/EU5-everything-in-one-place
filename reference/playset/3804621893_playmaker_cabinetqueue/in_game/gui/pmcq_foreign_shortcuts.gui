# Use the exact native action items exposed by the country's diplomacy categories.
# Do not look them up via ForeignCountryView.GetDiplomaticAction: that returns
# empty items for these string arguments, even when the native menu is open.
types pmcq_foreign_shortcuts {
    type pmcq_diplo_shortcut_slot = widget {
        size = { -1 38 }
        layoutpolicy_horizontal = expanding
        button_regular = {
            size = { 100% 100% }
            fontsize = 12
            text_single = {
                size = { 100% 20 }
                position = { 0 3 }
                align = center
                fontsize = 12
                alwaystransparent = yes
                block "pmcq_shortcut_text" {}
            }
            block "pmcq_shortcut_launch" {}
            block "pmcq_shortcut_launch_enabled" { enabled = yes }
            text_single = {
                parentanchor = hcenter|bottom
                position = { 0 -2 }
                size = { 16 13 }
                fontsize = 11
                align = center
                raw_text = "?"
                block "pmcq_shortcut_unknown_visible" { visible = yes }
                alwaystransparent = yes
            }
            block "pmcq_shortcut_launch_tooltip" { tooltip = "pmcq_shortcut_initialize_tip" }
        }
        vbox = {
            size = { 100% 38 }
            layoutpolicy_horizontal = expanding
            ignoreinvisible = yes
            alwaystransparent = yes
            datamodel = "[ForeignCountryView.GetCategoryItems]"
            item = {
                vbox = {
                    layoutpolicy_horizontal = expanding
                    ignoreinvisible = yes
                    datamodel = "[DiplomaticActionCategory.GetActions]"
                    item = {
                        widget = {
                            size = { -1 38 }
                            layoutpolicy_horizontal = expanding
                            block "pmcq_shortcut_visible" { visible = no }
                            button_regular = {
                                size = { 100% 100% }
                                fontsize = 12
                                text_single = {
                size = { 100% 20 }
                position = { 0 3 }
                align = center
                fontsize = 12
                alwaystransparent = yes
                block "pmcq_shortcut_text" {}
            }
                                block "pmcq_shortcut_native_enabled" { enabled = "[And(DiplomaticActionItem.IsEnabled, Not(And3(DiplomaticActionItem.IsType('giftaction'), DiplomaticActionItem.HasTarget, GetScriptedGui('pmcqsg_manual_cooldown').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqsg_target', DiplomaticActionItem.GetRecipient.MakeScope).End))))]" }
                                # Native tooltip reads failed conditions from this action.
                                action_tooltip = {
                                    click_type = left
                                    click_mode = single
                                    title = "DIPLOMACY_MACROBUILDER_LATERAL_VIEW_SELECT_COUNTRY"
                                    on_action = "[DiplomaticActionItem.OnClick]"
                                    conditions = "[Concatenate(DiplomaticActionItem.GetTooltip, Select_CString(And3(DiplomaticActionItem.IsType('giftaction'), DiplomaticActionItem.HasTarget, GetScriptedGui('pmcqsg_manual_cooldown').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqsg_target', DiplomaticActionItem.GetRecipient.MakeScope).End)), Localize('pmcqsg_manual_cooldown_tip'), ''))]"
                                    block "pmcq_shortcut_action_enabled" { enabled = "[And(DiplomaticActionItem.IsEnabled, Not(And3(DiplomaticActionItem.IsType('giftaction'), DiplomaticActionItem.HasTarget, GetScriptedGui('pmcqsg_manual_cooldown').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqsg_target', DiplomaticActionItem.GetRecipient.MakeScope).End))))]" }
                                }
                                tooltipwidget = { using = diplomatic_action_tooltip }
                                icon = {
                                    parentanchor = hcenter|bottom
                                    position = { 0 -2 }
                                    size = { 13 13 }
                                    block "pmcq_shortcut_acceptance_visible" { visible = "[DiplomaticActionItem.RequiresAcceptance]" }
                                    texture = "gfx/interface/icons/diplomatic_status/ai_accept_decline_icon.dds"
                                    frame_grid = { 3 1 }
                                    block "pmcq_shortcut_acceptance_frame" { frame = "[DiplomaticActionItem.GetAcceptanceFrame]" }
                                    tooltipwidget = {
                                        SimpleContextualStringPairTooltipType = {
                                            lowpriotextcontext = "[DiplomaticActionItem.GetAcceptanceTooltip]"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        vbox = {
            size = { 100% 38 } layoutpolicy_horizontal = expanding ignoreinvisible = yes alwaystransparent = yes
            datamodel = "[ForeignCountryView.GetDefaultCategory.GetActions]"
            item = {
                        widget = {
                            size = { -1 38 }
                            layoutpolicy_horizontal = expanding
                            block "pmcq_shortcut_visible" { visible = no }
                            button_regular = {
                                size = { 100% 100% }
                                fontsize = 12
                                text_single = {
                size = { 100% 20 }
                position = { 0 3 }
                align = center
                fontsize = 12
                alwaystransparent = yes
                block "pmcq_shortcut_text" {}
            }
                                block "pmcq_shortcut_native_enabled" { enabled = "[And(DiplomaticActionItem.IsEnabled, Not(And3(DiplomaticActionItem.IsType('giftaction'), DiplomaticActionItem.HasTarget, GetScriptedGui('pmcqsg_manual_cooldown').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqsg_target', DiplomaticActionItem.GetRecipient.MakeScope).End))))]" }
                                # Native tooltip reads failed conditions from this action.
                                action_tooltip = {
                                    click_type = left
                                    click_mode = single
                                    title = "DIPLOMACY_MACROBUILDER_LATERAL_VIEW_SELECT_COUNTRY"
                                    on_action = "[DiplomaticActionItem.OnClick]"
                                    conditions = "[Concatenate(DiplomaticActionItem.GetTooltip, Select_CString(And3(DiplomaticActionItem.IsType('giftaction'), DiplomaticActionItem.HasTarget, GetScriptedGui('pmcqsg_manual_cooldown').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqsg_target', DiplomaticActionItem.GetRecipient.MakeScope).End)), Localize('pmcqsg_manual_cooldown_tip'), ''))]"
                                    block "pmcq_shortcut_action_enabled" { enabled = "[And(DiplomaticActionItem.IsEnabled, Not(And3(DiplomaticActionItem.IsType('giftaction'), DiplomaticActionItem.HasTarget, GetScriptedGui('pmcqsg_manual_cooldown').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqsg_target', DiplomaticActionItem.GetRecipient.MakeScope).End))))]" }
                                }
                                tooltipwidget = { using = diplomatic_action_tooltip }
                                icon = {
                                    parentanchor = hcenter|bottom
                                    position = { 0 -2 }
                                    size = { 13 13 }
                                    block "pmcq_shortcut_acceptance_visible" { visible = "[DiplomaticActionItem.RequiresAcceptance]" }
                                    texture = "gfx/interface/icons/diplomatic_status/ai_accept_decline_icon.dds"
                                    frame_grid = { 3 1 }
                                    block "pmcq_shortcut_acceptance_frame" { frame = "[DiplomaticActionItem.GetAcceptanceFrame]" }
                                    tooltipwidget = {
                                        SimpleContextualStringPairTooltipType = {
                                            lowpriotextcontext = "[DiplomaticActionItem.GetAcceptanceTooltip]"
                                        }
                                    }
                                }
                            }
                        }
            }
        }
    }
}
