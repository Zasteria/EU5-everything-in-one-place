# This controller is a sibling of the hidden visuals, so it keeps running.
# Only a matching option actually present in GetOptions can hide the event.
template pmcq_event_favorite_controller {
 widget = {
  size = { 1 1 } ignore_layout = yes alwaystransparent = yes
  state = { name = pmcqev_reset_fallback trigger_on_create = yes
   on_start = "[GetVariableSystem.Clear(Concatenate('pmcqev_fallback_', EventWindow.GetTitle))]"
  }
 }
 vbox = {
  name = "pmcqev_favorite_probe"
  size = { 1 1 } ignore_layout = yes alwaystransparent = yes
  datamodel = "[EventWindow.GetOptions]"
  item = { widget = {
   size = { 1 1 } alwaystransparent = yes
   visible = "[And(And3(And(GetPlayer.MakeScope.GetVariable('pmcq_favorites_system_enabled').IsSet, GetPlayer.MakeScope.GetVariable('pmcq_event_memory_enabled').IsSet), Not(EventWindow.IsOptionClicked), EqualTo_string(GetPlayer.MakeScope.GetVariableFromVariableMap('pmcq_event_choices', MakeScopeFlag(EventWindow.GetTitle)).GetFlagName, EventOption.GetText)), Not(GetVariableSystem.HasValue(Concatenate('pmcqev_fallback_', EventWindow.GetTitle), 'yes')))]"
   dynamicgridbox = {
    datamodel = "[DataModelRepeatedItem(Select_int32(And(And(And3(And(GetPlayer.MakeScope.GetVariable('pmcq_favorites_system_enabled').IsSet, GetPlayer.MakeScope.GetVariable('pmcq_event_memory_enabled').IsSet), Not(EventWindow.IsOptionClicked), EqualTo_string(GetPlayer.MakeScope.GetVariableFromVariableMap('pmcq_event_choices', MakeScopeFlag(EventWindow.GetTitle)).GetFlagName, EventOption.GetText)), Not(GetVariableSystem.HasValue(Concatenate('pmcqev_fallback_', EventWindow.GetTitle), 'yes'))), EventWindow.GetLockableInfo.IsUnlocked), '(int32)1', '(int32)0'))]"
    item = { widget = { size = { 1 1 } alwaystransparent = yes
     state = { name = pmcqev_select_remembered trigger_on_create = yes alpha = 0.99 duration = 0.1
      on_finish = "[EventOption.Select]"
     }
    } }
   }
   dynamicgridbox = {
    datamodel = "[DataModelRepeatedItem(Select_int32(And(And3(And(GetPlayer.MakeScope.GetVariable('pmcq_favorites_system_enabled').IsSet, GetPlayer.MakeScope.GetVariable('pmcq_event_memory_enabled').IsSet), Not(EventWindow.IsOptionClicked), EqualTo_string(GetPlayer.MakeScope.GetVariableFromVariableMap('pmcq_event_choices', MakeScopeFlag(EventWindow.GetTitle)).GetFlagName, EventOption.GetText)), Not(GetVariableSystem.HasValue(Concatenate('pmcqev_fallback_', EventWindow.GetTitle), 'yes'))), '(int32)1', '(int32)0'))]"
    item = { widget = { size = { 1 1 } alwaystransparent = yes
     state = { name = pmcqev_reveal_unresolved trigger_on_create = yes alpha = 0.99 duration = 2
      on_finish = "[GetVariableSystem.Set(Concatenate('pmcqev_fallback_', EventWindow.GetTitle), 'yes')]"
     }
    } }
   }
  } }
 }
}
