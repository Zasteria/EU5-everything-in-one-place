template flexible_interaction_target_entry_setup {
	set_parent_size_to_minimum = yes
	minimumsize = { 530 -1 }
	maximumsize = { 530 -1 }
}

template select_interaction_target_map_tooltip {
	container = {
		visible = "[IsSelectInteractionTargetValid]"
		ContextualTooltipType = {
			datacontext = "[GetLastSelectInteractionTargetGlue(Location.Self)]"
			blockoverride "title_text" { text = "[SelectInteractionTargetGlue.GetUIActionTitle]" }
			blockoverride "title_icon_texture" { texture = "[SelectInteractionTargetGlue.GetObject.GetGameConceptTexture]" }
			blockoverride "concept_link" { text = "[SelectInteractionTargetGlue.GetObject.GetGameConceptName|e]" }
			blockoverride "tooltip_content" { 
				TooltipContentSection = {
					visible = "[LastSelectInteractionTargetGlueWasTarget(Location.Self)]"
					using = action_tooltip_inner_content_select_interaction_target_map
				}
				TooltipContentSection = {
					visible = "[Not(LastSelectInteractionTargetGlueWasTarget(Location.Self))]"
					TooltipTextBlock = {
						blockoverride "text" { text = "INVALID_TARGET" }
					}
				}
			}

		}
	}
}

types SelectInteractionTargetTypes
{
	type interaction_target_table_entry = widget {



 


 button = { name = "pmcqrm_row" size = { 100% 100% } ignore_layout = yes
  visible = "[And(SelectInteractionTargetView.IsCountry, EqualTo_string(SelectInteractionTargetView.GetTitle, Localize('pmcqr_pick')))]"
  using = button_regular_texture
  down = "[GetScriptedGui('pmcqrm_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqrm_target', SelectInteractionTargetGlue.GetObject.GetCountry.MakeScope).End)]"
  enabled = "[Not(GetScriptedGui('pmcqrm_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqrm_target', SelectInteractionTargetGlue.GetObject.GetCountry.MakeScope).End))]"
  text_single = { size = { 90 24 } parentanchor = right|vcenter widgetanchor = right|vcenter position = { -8 0 } alwaystransparent = yes align = right
   visible = "[GetScriptedGui('pmcqrm_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqrm_target', SelectInteractionTargetGlue.GetObject.GetCountry.MakeScope).End)]" raw_text = "#G Selected#!" fontsize = 13
  }
  onclick = "[GetScriptedGui('pmcqrm_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqrm_target', SelectInteractionTargetGlue.GetObject.GetCountry.MakeScope).End)]"
 }
 button = { name = "pmcqpm_row" size = { 100% 100% } ignore_layout = yes
  visible = "[And(SelectInteractionTargetView.IsProvince, EqualTo_string(SelectInteractionTargetView.GetTitle, Localize('pmcqpm_pick')))]"
  using = button_regular_texture
  down = "[GetScriptedGui('pmcqpm_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqpm_target', SelectInteractionTargetGlue.GetObject.GetProvince.MakeScope).End)]"
  enabled = "[Not(GetScriptedGui('pmcqpm_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqpm_target', SelectInteractionTargetGlue.GetObject.GetProvince.MakeScope).End))]"
  text_single = { size = { 90 24 } parentanchor = right|vcenter widgetanchor = right|vcenter position = { -8 0 } alwaystransparent = yes align = right
   visible = "[GetScriptedGui('pmcqpm_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqpm_target', SelectInteractionTargetGlue.GetObject.GetProvince.MakeScope).End)]" raw_text = "#G Selected#!" fontsize = 13
  }
  onclick = "[GetScriptedGui('pmcqpm_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqpm_target', SelectInteractionTargetGlue.GetObject.GetProvince.MakeScope).End)]"
 }




