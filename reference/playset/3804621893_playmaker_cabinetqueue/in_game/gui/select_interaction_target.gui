widget = { name = "pmcqp_select_society_action" size = { 1 1 } alwaystransparent = yes
 visible = "[And(GetVariableSystem.HasValue('pmcqp_communal', 'action'), And(EqualTo_int32(SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('cabinet').GetCabinet.GetIndex, GetPlayer.MakeScope.GetVariable('pmcqp_communal_slot').GetCabinet.GetIndex), And(SelectInteractionTargetView.IsCabinetAction, And(SelectInteractionTargetGlue.GetObject.IsCabinetAction, And(SelectInteractionTargetGlue.IsLeftClickEnabled, EqualTo_string(SelectInteractionTargetGlue.GetObject.GetCabinetAction.GetNameWithNoTooltip, ShowCabinetActionNameWithNoTooltip('change_societal_values')))))))]"
 state = {
 on_start = "[GetScriptedGui('pmcqp_trace_pmcqp_select_society_action_entered').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 on_finish = "[GetScriptedGui('pmcqp_trace_pmcqp_select_society_action_finished').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" name = _show alpha = 0.99 duration = 0.1
 on_start = "[SelectInteractionTargetGlue.OnMouseEnter(PdxGuiWidget.AccessSelf, SelectInteractionTargetGlue.GetObject)]"
on_start = "[SelectInteractionTargetGlue.OnLeftClick]" }
}
		tooltipmeta = {
			texture = "[SelectInteractionTargetGlue.GetObject.GetGameConceptTexture]"
			game_concept = "[SelectInteractionTargetGlue.GetObject.GetGameConceptName|e]"
		}

		card_list_button = {
			ignore_layout = yes
			size = { 100% 100% }
			visible = "[And(And(Not(SelectInteractionTargetView.HasSelectTarget), Not(Or(And(SelectInteractionTargetView.IsCountry, EqualTo_string(SelectInteractionTargetView.GetTitle, Localize('pmcqr_pick'))), And(SelectInteractionTargetView.IsProvince, EqualTo_string(SelectInteractionTargetView.GetTitle, Localize('pmcqpm_pick')))))), Not(And(SelectInteractionTargetView.IsEstatePrivilege, GetScriptedGui('pmcqpriv_multi_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))))]"
			using = select_interaction_target_action_provider
			using = snd_UI_confirm

			onmousehierarchyenter = "[SelectInteractionTargetGlue.OnMouseEnter(PdxGuiWidget.AccessSelf, SelectInteractionTargetGlue.GetObject)]"
			onmousehierarchyleave = "[SelectInteractionTargetGlue.OnMouseLeave(PdxGuiWidget.AccessSelf)]"
			
			onpressed = "[SelectInteractionTargetGlue.OnMouseDown]"
			onreleased = "[SelectInteractionTargetGlue.OnMouseUp]"
			onrightpressed = "[SelectInteractionTargetGlue.OnMouseDown]"
			onrightreleased = "[SelectInteractionTargetGlue.OnMouseUp]"

			icon = {
				visible = "[And(SelectInteractionTargetGlue.IsHovered, Not(SelectInteractionTargetGlue.IsDown))]"
				size =  { 100% 100% }
				using = color_white_texture
				alpha = 0.1
			}

			icon = {
				visible = "[SelectInteractionTargetGlue.IsDown]"
				size =  { 100% 100% }
				using = color_black_texture
				alpha = 0.2
			}
			icon = {
				visible = "[Or(SelectInteractionTargetGlue.IsAlreadySelected,SelectInteractionTargetGlue.IsCurrentlySelected)]"
				size =  { 100% 100% }
				using = color_black_texture
				alpha = 0.5
			}
		}
	}
}

template select_interaction_target_header {
	window_header_alt = {
		using = bg_main_inner_alt
		blockoverride "window_header_alt_color_texture"{
			using = color_default_brown_texture
		}

		blockoverride "header_text" {
			maximumsize = { 500 -1 }
			autoresize = yes
			text = "[SelectInteractionTargetView.GetTitle]"
		}
	}
}

template select_interaction_target {
 widget = { name = "pmcqcs_close_completed_action_list" size = { 1 1 } ignore_layout = yes alwaystransparent = yes
  dynamicgridbox = {
   datamodel = "[DataModelRepeatedItem(Select_int32(And(SelectInteractionTargetView.IsCabinetAction, And(GetVariableSystem.HasValue('pmcqcs_cleanup', 'yes'), GetScriptedGui('pmcqcs_assignment_complete').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))), '(int32)1', '(int32)0'))]"
   item = { widget = { size = { 1 1 } alwaystransparent = yes
    state = { name = pmcqcs_close_assigned trigger_on_create = yes
     on_start = "[GetVariableSystem.Clear('pmcqcs_cleanup')]"
     on_start = "[SelectInteractionTargetView.Manager.Close]"
    }
   } }
  }
 }

	vbox = {
 vbox = { name = "pmcqpriv_controls" layoutpolicy_horizontal = expanding layoutpolicy_vertical = fixed spacing = 5
  visible = "[SelectInteractionTargetView.IsEstatePrivilege]"
  hbox = { spacing = 8
   button = { size = { 165 30 } using = button_regular_texture raw_text = "Multi-select"
    down = "[GetScriptedGui('pmcqpriv_multi_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    onclick = "[GetScriptedGui('pmcqpriv_multi_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
   }
   button = { size = { 145 30 } using = button_regular_texture raw_text = "Confirm"
    enabled = "[And(GetScriptedGui('pmcqpriv_multi_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetScriptedGui('pmcqpriv_has_selection').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
    onclick = "[GetScriptedGui('pmcqpriv_confirm').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
   }
   button = { size = { 145 30 } using = button_regular_texture raw_text = "Clear"
    enabled = "[GetScriptedGui('pmcqpriv_has_selection').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    onclick = "[GetScriptedGui('pmcqpriv_begin').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
   }
  }
  text_single = { visible = "[GetScriptedGui('pmcqpriv_multi_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" raw_text = "#G Multi-select ON#! — click privileges, then Confirm." fontsize = 14 }
  text_single = { visible = "[GetScriptedGui('pmcqpriv_multi_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" raw_text = "Selections carry between estates. Blocked grants stay selected." fontsize = 13 }
  hbox = {
   spacing = 6
   datamodel = "[GetPlayer.GetGovernment.GetEstates]"
   item = {
    button = {
     name = "pmcqpriv_estate_shortcut"
     size = { 40 40 }
     using = button_regular_texture
     visible = "[GetScriptedGui('pmcqpriv_estate_shortcut_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqpriv_current', SelectInteractionTargetView.GetCurrentParams.GetFirstObjectOfType('estate').GetEstate.MakeScope).AddScope('pmcqpriv_destination', Estate.MakeScope).End)]"
     tooltip = "[Estate.GetType.GetNameWithNoTooltip]"
     onclick = "[GetScriptedGui('pmcqpriv_request_navigation').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pmcqpriv_destination', Estate.MakeScope).End)]"
     onclick = "[GetVariableSystem.Set('pmcqpriv_navigation_click', Estate.GetType.GetNameWithNoTooltip)]"
     onclick = "[SelectInteractionTargetView.Manager.Close]"
     icon = {
      size = { 32 32 } parentanchor = center widgetanchor = center
      alwaystransparent = yes
      texture = "[GetEstateIcon(Estate.GetType)]"
     }
    }
   }
  }
 }


 vbox = { name = "pmcqrm_controls" layoutpolicy_horizontal = expanding layoutpolicy_vertical = fixed spacing = 5
  maximumsize = { 540 -1 } margin = { 10 5 }
  visible = "[And(SelectInteractionTargetView.IsCountry, EqualTo_string(SelectInteractionTargetView.GetTitle, Localize('pmcqr_pick')))]"
  state = { name = _show
   on_start = "[GetVariableSystem.Clear('pmcqr_window')]"
   on_start = "[GetScriptedGui('pmcqrm_begin').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
  }

 

  textbox = {
   size = { 100% 36 } maximumsize = { 520 36 }
   layoutpolicy_horizontal = expanding layoutpolicy_vertical = fixed
   multiline = yes autoresize = no align = left|vcenter fontsize = 12
   raw_text = "Select nations, then Confirm to add them and start.\nCancel discards this selection."
  }
  hbox = { spacing = 8
   button = { size = { 145 30 } using = button_regular_texture raw_text = "Confirm"
    enabled = "[GetScriptedGui('pmcqrm_has_selection').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    onclick = "[GetScriptedGui('pmcqrm_confirm').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    onclick = "[SelectInteractionTargetView.Manager.Close]"
   }
   button = { size = { 145 30 } using = button_regular_texture raw_text = "Cancel"
    onclick = "[GetScriptedGui('pmcqrm_begin').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    onclick = "[SelectInteractionTargetView.Manager.Close]"
   }
  }
 }
 vbox = { name = "pmcqpm_controls" layoutpolicy_horizontal = expanding layoutpolicy_vertical = fixed spacing = 5
  visible = "[And(SelectInteractionTargetView.IsProvince, EqualTo_string(SelectInteractionTargetView.GetTitle, Localize('pmcqpm_pick')))]"
  state = { name = _show on_start = "[GetScriptedGui('pmcqpm_begin').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }

 

  text_single = { raw_text = "Selected provinces are marked and locked. Confirm to add them and start the queue, or Cancel to start over." fontsize = 14 }
  hbox = { spacing = 8
   button = { size = { 145 30 } using = button_regular_texture raw_text = "Confirm"
    enabled = "[GetScriptedGui('pmcqpm_has_selection').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    onclick = "[GetScriptedGui('pmcqpm_confirm').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    onclick = "[SelectInteractionTargetView.Manager.Close]"
   }
   button = { size = { 145 30 } using = button_regular_texture raw_text = "Cancel"
    onclick = "[GetScriptedGui('pmcqpm_cancel').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    onclick = "[SelectInteractionTargetView.Manager.Close]"
   }
  }
 }




		using = layoutpolicy_expanding
		using = bg_secondary_inner_alt
		using = window_main_tabs_margin_alt
		allow_outside = yes

		subheader_A = {
			visible = "[SelectInteractionTargetView.IsTopVisible]"
			# Left Data
			blockoverride "left_1liner_text_visible" {
				visible = "[Not(SelectInteractionTargetView.IsLeftMultiline)]"
			}
			blockoverride "left_1liner_text" {
				text = "[SelectInteractionTargetView.GetTopLeftTitle]"
			}
			blockoverride "left_2liner_text_1_visible" {
				visible = "[SelectInteractionTargetView.IsLeftMultiline]"
			}
			blockoverride "left_2liner_text_1" {
				text = "[SelectInteractionTargetView.GetTopLeftTitle]"
			}
			blockoverride "left_2liner_text_2_visible" {
				visible = "[SelectInteractionTargetView.IsLeftMultiline]"
			}
			blockoverride "left_2liner_text_2" {
				text = "[SelectInteractionTargetView.GetTopLeftDesc]"
			}
			blockoverride "left_icon_visible" {
				visible = yes
			}
			blockoverride "left_icon_gfx" {
				texture = "[SelectInteractionTargetView.GetTopLeftTexture]"
				texture_density = 2

			}

			# Right Data
			blockoverride "right_icon_visible" {
				visible = yes
			}
			blockoverride "right_icon_gfx" {
				texture = "[SelectInteractionTargetView.GetTopRightTexture]"
				texture_density = 2

				glow = {
					name = "drop_shadow"
					glow_radius = 3
					color = {0.0 0.0 0.0 1.0}
					alpha = 0.3
				}
			}
			blockoverride "right_1liner_text_visible" {
				visible = "[Not(SelectInteractionTargetView.IsRightMultiline)]"
			}
			blockoverride "right_1liner_text" {
				text = "[SelectInteractionTargetView.GetTopRightTitle]"
			}
			blockoverride "right_2liner_text_1_visible" {
				visible = "[SelectInteractionTargetView.IsRightMultiline]"
			}
			blockoverride "right_2liner_text_1" {
				text = "[SelectInteractionTargetView.GetTopRightTitle]"
			}
			blockoverride "right_2liner_text_2_visible" {
				visible = "[SelectInteractionTargetView.IsRightMultiline]"
			}
			blockoverride "right_2liner_text_2" {
				text = "[SelectInteractionTargetView.GetTopRightDesc]"
			}
		}

		# top widget (specifyable in script with top_widget)
		vbox = {
			layoutpolicy_vertical = fixed
			layoutpolicy_horizontal = expanding
			name = "top_widget_container"
		}

		# select a number
		vbox = {
			layoutpolicy_vertical = expanding
			layoutpolicy_horizontal = expanding
			visible = "[SelectInteractionTargetView.IsValue]"

			select_value_widget = {
				datacontext = "[SelectInteractionTargetView.GetCurrentValueGlue]"
			}

			expand = {}
		}



		# select from a list
		filtered_sorted_list = {
			using = layoutpolicy_expanding
			allow_outside = yes

			visible = "[Not(SelectInteractionTargetView.IsValue)]"
			datacontext = "[SelectInteractionTargetView.GetTargetObjectSortSearch]"

			blockoverride "scroll_list_vbox" {
				using = layoutpolicy_expanding
				allow_outside = yes
				margin = { -10 0 }
				margin_bottom = 5
			}

			blockoverride "scroll_list_is_empty" {
				visible = "[Not(GreaterThan_int32(GetDataModelSize(SelectInteractionTargetView.GetTargetObjects), '(int32)0'))]"
			}

			blockoverride "scroll_list_is_empty_text" {
				text = "[SelectInteractionTargetView.GetNoneAvailableTextOnlyHeader]"
			}

			blockoverride "sort_buttons_filtered_list" {
				datamodel = "[FilteredSortedList.GetSortKeys]"
				item = {
					sort_by_key_button = {
						blockoverride "sort_by_key_button_datacontext" {}
						size = "[SortKey.GetSize]"
						visible = "[SortKey.IsVisible]"
					}
				}
			}

			blockoverride "scroll_list_layout" {
				table = {
					name = "selection_table"
					size = { 540 100% }
					margin = { 0 5 }
					margin_left = 10
					spacing = 7

					# data model is set from code
					even_row_widget = {
						interaction_target_table_entry = {
							size = { -1 30 }
						}
					}
					odd_row_widget = {
						interaction_target_table_entry = {
							size = { -1 30 }
						}
					}
				}
			}
		}

		# bottom widget (specifyable in script with bottom_widget)
		vbox = {
			layoutpolicy_vertical = fixed
			layoutpolicy_horizontal = expanding
			name = "bottom_widget_container"
		}
	}
}

lateralview = {
	name = "select_interaction_target_left"

 widget = { size = { 1 1 } ignore_layout = yes alwaystransparent = yes
  dynamicgridbox = { datamodel = "[DataModelRepeatedItem(Select_int32(And(GetVariableSystem.Exists('pmcqcb_close_completed'), Or(SelectInteractionTargetView.IsCasusBelli, SelectInteractionTargetView.IsProvince)), '(int32)1', '(int32)0'))]"
   item = { widget = { size = { 1 1 }
    state = { name = pmcqcb_close_started_cb trigger_on_create = yes
     on_start = "[SelectInteractionTargetView.Manager.Close]"
    }
   } }
  }
 }


	# SOUND - Select Interaction Target (Left Panel)
	blockoverride "snd_panel_identifier" { soundeffect = "UI_panelAux_selectInteractionTarget_show" }
	blockoverride "panel_header" {
		using = select_interaction_target_header
	}

	blockoverride "panel_content" {
		using = select_interaction_target
	}
}

lateralview = {
	name = "select_interaction_target_right"

 widget = { size = { 1 1 } ignore_layout = yes alwaystransparent = yes
  dynamicgridbox = { datamodel = "[DataModelRepeatedItem(Select_int32(And(GetVariableSystem.Exists('pmcqcb_close_completed'), Or(SelectInteractionTargetView.IsCasusBelli, SelectInteractionTargetView.IsProvince)), '(int32)1', '(int32)0'))]"
   item = { widget = { size = { 1 1 }
    state = { name = pmcqcb_close_started_cb trigger_on_create = yes
     on_start = "[SelectInteractionTargetView.Manager.Close]"
    }
   } }
  }
 }


	# SOUND - Select Interaction Target (Right Panel)
	blockoverride "snd_panel_identifier" { soundeffect = "UI_panelAux_selectInteractionTarget_show" }
	blockoverride "panel_header" {
		using = select_interaction_target_header
	}

	blockoverride "panel_content" {
		using = select_interaction_target
	}
}
