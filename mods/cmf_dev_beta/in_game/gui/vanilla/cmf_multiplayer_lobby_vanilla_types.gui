	type close_right_tabs = button_close_alt {
		blockoverride "close_properties" {
			parentanchor = vcenter|right
		}
		blockoverride "close_inputaction"{}
		blockoverride "close_title" {
			title = "CLOSE_TAB"
		}
	}

