# Свёрнутое окно зонда: плашка «Замер». Само окно — bag_perf_window.gui.

window = {
	name = "bag_perf_pill"
	allow_outside = yes
	alwaystransparent = no
	parentanchor = top|right
	widgetanchor = top|right
	position = { -260 90 }
	movable = yes
	size = { 110 44 }
	using = bg_window_default_alt
	visible = "[Not(GetVariableSystem.Exists('bag_perf_open'))]"

	button_regular = {
		parentanchor = center
		widgetanchor = center
		size = { 96 30 }
		tooltip = "bag_perf_pill_tt"
		onclick = "[GetVariableSystem.Set('bag_perf_open', 'yes')]"
		text_single = {
			parentanchor = center
			widgetanchor = center
			autoresize = yes
			text = "bag_perf_pill"
		}
	}
}
