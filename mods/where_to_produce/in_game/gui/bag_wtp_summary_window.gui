# Сводка по товарам: сколько домиков у каждого и почему он остановился.
#
# **Его просьба 2026-09-07, дословно:** «сам план как таковой довольно жирный,
# подробный — но вот какой-то сводки я не вижу по товарам… мне важно сравнивать.
# И тогда я смогу более наглядно делать тесты на разной земле, собирать так же
# более подробную диагностику для тебя и выдвигать свои предпочтения.»
#
# **Строки живут в `bag_wtp_sum_cells.gui`, выписанные по товару.** Строка
# датамодели несёт скоуп товара, а скоуп не достаёт до нумерованной глобалки, —
# и `_pn<n>`, `_pq<n>` и причина остановки рисуются только из выписанной строки.
# Ровно поэтому же так сделана и сетка редактора.
#
# **Форма окна взята у `bag_wtp_changes_window.gui`**, которое взяло её у
# `ai_settings_menu.gui`: `size` и `using = bg_window_default_alt` стоят на самом
# `window`, `vbox` лежит в нём напрямую, и между ними нет ничего. Лишний `widget`
# со своим размером держит ширину шапки — это стоило трёх сессий,
# `docs/pitfalls/windows.md`.

window = {
	name = "bag_wtp_summary_window"
	datacontext = "[GetPlayer]"
	allow_outside = yes
	alwaystransparent = no
	parentanchor = center
	widgetanchor = center
	position = { 40 40 }
	movable = yes
	size = { 1460 840 }
	using = bg_window_default_alt

	visible = "[GetPlayer.MakeScope.GetVariable('bag_wtp_sum_open').IsSet]"
	enabled = "[GetPlayer.MakeScope.GetVariable('bag_wtp_sum_open').IsSet]"

	widget = {
		parentanchor = right
		position = { -5 5 }
		size = { 40 40 }
		ui_direction_button_holder_right = {}
		button_close_alt = {
			blockoverride "close_on_action" {
				on_action = "[GetScriptedGui('bag_wtp_close_summary_window').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
		}
	}

	vbox = {
		using = window_margin_alt

		window_header_alt = {
			blockoverride "header_text" { text = "bag_wtp_sum_window_title" }
			blockoverride "window_header_alt_color_texture" { using = color_production_texture }
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			using = bg_secondary_inner_alt
			margin = { 12 12 }
			spacing = 6

			# **Две страницы, и переключатель между ними.** Его слово
			# 2026-09-12: «в общую сводку нужно добавить вторую страницу, в
			# которой будет списком показана статистика по городским правам в
			# области, аналогично сводке по товарам из плана».
			#
			# Страница — глобалка: её читают `visible` обеих половин, а
			# `visible` умеет только переменные и функции данных.
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 6

				button_regular = {
					size = { 220 26 }
					down = "[Not(GetGlobalVariable('bag_wtp_sum_page').IsSet)]"
					tooltip = "bag_wtp_sum_page_goods_tt"
					onclick = "[GetScriptedGui('bag_wtp_sum_page_goods').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					text_single = {
						parentanchor = center
						widgetanchor = center
						autoresize = yes
						fontsize = 14
						text = "bag_wtp_sum_page_goods"
					}
				}

				button_regular = {
					size = { 220 26 }
					down = "[GetGlobalVariable('bag_wtp_sum_page').IsSet]"
					tooltip = "bag_wtp_sum_page_rights_tt"
					onclick = "[GetScriptedGui('bag_wtp_sum_page_rights').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					text_single = {
						parentanchor = center
						widgetanchor = center
						autoresize = yes
						fontsize = 14
						text = "bag_wtp_sum_page_rights"
					}
				}

				expand = {}
			}

			# Числа плана целиком, чтобы строку товара было с чем сравнивать.
			text_single = {
				size = { 1298 24 }
				autoresize = no
				maximumsize = { 1298 24 }
				align = left|vcenter
				fontsize = 14
				elide = right
				text = "bag_wtp_sum_head"
				tooltip = "bag_wtp_sum_head_tt"
			}

			# **Ровность одной строкой, и это главный ответ окна.** «Мне важно
			# сравнивать» — разрыв между «меньше всех» и «больше всех» и есть то,
			# что сравнивают, а «без единого домика» больше нуля — отказ покрытия.
			text_single = {
				size = { 1298 22 }
				autoresize = no
				maximumsize = { 1298 22 }
				align = left|vcenter
				fontsize = 13
				elide = right
				text = "bag_wtp_sum_even"
				tooltip = "bag_wtp_sum_even_tt"
			}

			# Пометка режима: в специализации доли и потолки не применялись,
			# и столбец «доля» рядом с числами — это то, что дал бы обычный
			# план, а не то, что ограничивало этот.
			text_single = {
				size = { 1298 22 }
				autoresize = no
				maximumsize = { 1298 22 }
				align = left|vcenter
				fontsize = 13
				elide = right
				visible = "[GetGlobalVariable('bag_wtp_spec_ran').IsSet]"
				text = "bag_wtp_sum_mode_spec"
			}

			# Заголовки столбцов. Тип выписан генератором из `SUM_COLS`,
			# теми же ширинами, что и строки: разъехаться им не на чем.
			# **`visible` стоит на самом экземпляре типа, а не на обёртке.**
			# `widget` со своим размером под содержимое не растёт, и коробка
			# строк в нём схлопнулась бы в ноль — та же ошибка, что уже стоила
			# этому моду ряда ячеек (`docs/pitfalls/windows.md`).
			bag_wtp_sum_head_row = {
				visible = "[Not(GetGlobalVariable('bag_wtp_sum_page').IsSet)]"
			}

			# И заголовки второй страницы, своими ширинами.
			bag_wtp_sumr_head_row = {
				visible = "[GetGlobalVariable('bag_wtp_sum_page').IsSet]"
			}

			text_multi = {
				layoutpolicy_horizontal = expanding
				autoresize = yes
				maximumsize = { 1298 60 }
				align = center
				visible = "[Not(GetGlobalVariable('bag_wtp_sum_any').IsSet)]"
				text = "bag_wtp_sum_window_empty"
			}

			scrollbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				blockoverride "scrollbox_content" {
					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = preferred
						margin = { 10 8 }
						margin_right = 20
						ignoreinvisible = yes

						bag_wtp_sum_all = {
							visible = "[Not(GetGlobalVariable('bag_wtp_sum_page').IsSet)]"
						}

						bag_wtp_sumr_all = {
							visible = "[GetGlobalVariable('bag_wtp_sum_page').IsSet]"
						}
					}
				}
			}
		}
	}
}
