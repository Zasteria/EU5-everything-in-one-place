# The plan editor: a window, and its own window, because he would not use it
# anywhere else.
#
# The owner, 2026-09-03, after the first build put the picker and the buttons on
# the mod's settings page: «Сейчас окно настроек мода - стало засраным и
# неудобным. Более того это именно что окно настроек и основных функций, я не
# хочу делать подобные вещи там. … Редактор - должен быть полностью отдельно
# открывающимся окном. Я открываю окно и загружаю сохранённый план. План
# загружается примерно в том же виде, в каком он показывается в окне "где
# производить - общий план".»
#
# So: three slots along the top, the goods this ground can make as icons, a row
# per good he picks with «−1», its icon and «+1», and the plan itself in the
# rows the plan window draws -- `bag_wtp_plan_entry`, reused rather than copied,
# so the two windows can never drift apart.
#
# **Nothing in here re-plans.** `bag_wtp_plan_run` is the only thing that does,
# and every button here changes the plan on the map one building at a time:
# «Мод не пересобирает весь план с 0, он просто точечно выбирает какой товар X
# менее болезненно удалить для наилучшей установки туда товара Y».
#
# **Every widget in this file is one this mod or vanilla already draws.** Types
# derive from `widget` or `hbox` and hold a `button_regular` inside, the way
# `bag_wtp_plan_goods_entry` holds a `text_single`. The picker wraps on a
# `fixedgridbox`, which is what the game itself uses for a wrapping grid of a
# datamodel -- and **not** on a `flowcontainer`, which killed four builds in a
# row before the run history said so. See the picker below.

# **The picker's type lives in `bag_wtp_edit_cells.gui` now**, written out a
# good at a time, because only a written cell can print `_pn<n>` beside the
# good. The datamodel entry that stood here is gone with the scope bridge it
# reached its effect through -- one press, one path.

window = {
	name = "bag_wtp_edit_window"
	datacontext = "[GetPlayer]"
	allow_outside = yes
	alwaystransparent = no
	parentanchor = center
	widgetanchor = center
	position = { 0 0 }
	movable = yes
	size = { 1500 880 }
	using = bg_window_default_alt

	visible = "[GetPlayer.MakeScope.GetVariable('bag_wtp_edit_open').IsSet]"
	enabled = "[GetPlayer.MakeScope.GetVariable('bag_wtp_edit_open').IsSet]"

	# **Форма окна взята у самой игры, а не придумана.** `ai_settings_menu.gui` —
	# свободное окно ровно этого вида: `size` и `using = bg_window_default_alt`
	# стоят **на самом `window`**, а `vbox` лежит в нём напрямую. У нас между ними
	# был лишний `widget` со своим размером, и шапка, оказавшись внутри него,
	# держала ширину своего типа, что бы ни делало окно. «Злоебучая шапка окна
	# снова не расширилась вместе с окном» — 2026-09-06, и это третий раз.
	#
	# **Тип `window_header_alt` не объявлен нигде в `reference/`**, так что читать,
	# что держит его ширину, отсюда нечем. Поэтому здесь не догадка о шапке, а
	# копия структуры окна, которое в игре работает.

	widget = {
		parentanchor = right
		position = { -5 5 }
		size = { 40 40 }
		ui_direction_button_holder_right = {}
		button_close_alt = {
			blockoverride "close_on_action" {
				on_action = "[GetScriptedGui('bag_wtp_close_edit_window').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
		}
	}

	vbox = {
		using = window_margin_alt

		# **`layoutpolicy_horizontal = expanding` on the header, and every window
		# of this mod was missing it.** «Злоебучая шапка окна снова не
		# расширилась вместе с окном» — 2026-09-06, and the third time he has
		# said it. The game's own windows all carry this line on their
		# `window_header_alt` (`multiplayer_lobby.gui`,
		# `automation_lateralview.gui`); without it the header keeps the type's
		# own width whatever the window does.
		window_header_alt = {
			blockoverride "header_text" { text = "bag_wtp_edit_window_title" }
			blockoverride "window_header_alt_color_texture" { using = color_production_texture }
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			using = bg_secondary_inner_alt
			margin = { 12 12 }
			spacing = 6


			# The slots. Three of them, and the reason is his: «я проебу свой
			# сохранённый план, если захочу посмотреть какой-то план на другой
			# земле… Слотов для планов должно быть минимум 3.»
			#
			# Each shows what it holds, so «загрузить» is never a guess. The label
			# is a `customizable_localization` of the mod's own because a plain key
			# can read a number but cannot choose between two sentences, and an
			# empty slot must not read «0 зданий в 0 локациях».
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 8

				text_single = {
					size = { 90 34 }
					autoresize = no
					align = left|vcenter
					fontsize = 14
					text = "bag_wtp_edit_slots_head"
				}

				widget = {
					size = { 300 40 }
					using = bg_number_container_bckg

					hbox = {
						parentanchor = left|vcenter
						widgetanchor = left|vcenter
						spacing = 4

						text_single = {
							size = { 130 32 }
							autoresize = no
							maximumsize = { 130 32 }
							align = left|vcenter
							fontsize = 13
							elide = right
							text = "[GetPlayer.Custom('bag_wtp_edit_slot1_label')]"
							tooltip = "bag_wtp_edit_slot_tt"
						}

						button_regular = {
							size = { 78 32 }
							tooltip = "bag_wtp_edit_store_tt"
							text_single = {
								size = { 70 24 }
								parentanchor = center
								widgetanchor = center
								autoresize = no
								maximumsize = { 70 24 }
								fontsize = 12
								fontsize_min = 9
								align = center|nobaseline
								elide = right
								text = "bag_wtp_edit_store"
							}
							onclick = "[GetScriptedGui('bag_wtp_edit_slot_save_1').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}

						button_regular = {
							size = { 78 32 }
							tooltip = "bag_wtp_edit_recall_tt"
							text_single = {
								size = { 70 24 }
								parentanchor = center
								widgetanchor = center
								autoresize = no
								maximumsize = { 70 24 }
								fontsize = 12
								fontsize_min = 9
								align = center|nobaseline
								elide = right
								text = "bag_wtp_edit_recall"
							}
							onclick = "[GetScriptedGui('bag_wtp_edit_slot_load_1').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
					}
				}

				widget = {
					size = { 300 40 }
					using = bg_number_container_bckg

					hbox = {
						parentanchor = left|vcenter
						widgetanchor = left|vcenter
						spacing = 4

						text_single = {
							size = { 130 32 }
							autoresize = no
							maximumsize = { 130 32 }
							align = left|vcenter
							fontsize = 13
							elide = right
							text = "[GetPlayer.Custom('bag_wtp_edit_slot2_label')]"
							tooltip = "bag_wtp_edit_slot_tt"
						}

						button_regular = {
							size = { 78 32 }
							tooltip = "bag_wtp_edit_store_tt"
							text_single = {
								size = { 70 24 }
								parentanchor = center
								widgetanchor = center
								autoresize = no
								maximumsize = { 70 24 }
								fontsize = 12
								fontsize_min = 9
								align = center|nobaseline
								elide = right
								text = "bag_wtp_edit_store"
							}
							onclick = "[GetScriptedGui('bag_wtp_edit_slot_save_2').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}

						button_regular = {
							size = { 78 32 }
							tooltip = "bag_wtp_edit_recall_tt"
							text_single = {
								size = { 70 24 }
								parentanchor = center
								widgetanchor = center
								autoresize = no
								maximumsize = { 70 24 }
								fontsize = 12
								fontsize_min = 9
								align = center|nobaseline
								elide = right
								text = "bag_wtp_edit_recall"
							}
							onclick = "[GetScriptedGui('bag_wtp_edit_slot_load_2').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
					}
				}

				widget = {
					size = { 300 40 }
					using = bg_number_container_bckg

					hbox = {
						parentanchor = left|vcenter
						widgetanchor = left|vcenter
						spacing = 4

						text_single = {
							size = { 130 32 }
							autoresize = no
							maximumsize = { 130 32 }
							align = left|vcenter
							fontsize = 13
							elide = right
							text = "[GetPlayer.Custom('bag_wtp_edit_slot3_label')]"
							tooltip = "bag_wtp_edit_slot_tt"
						}

						button_regular = {
							size = { 78 32 }
							tooltip = "bag_wtp_edit_store_tt"
							text_single = {
								size = { 70 24 }
								parentanchor = center
								widgetanchor = center
								autoresize = no
								maximumsize = { 70 24 }
								fontsize = 12
								fontsize_min = 9
								align = center|nobaseline
								elide = right
								text = "bag_wtp_edit_store"
							}
							onclick = "[GetScriptedGui('bag_wtp_edit_slot_save_3').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}

						button_regular = {
							size = { 78 32 }
							tooltip = "bag_wtp_edit_recall_tt"
							text_single = {
								size = { 70 24 }
								parentanchor = center
								widgetanchor = center
								autoresize = no
								maximumsize = { 70 24 }
								fontsize = 12
								fontsize_min = 9
								align = center|nobaseline
								elide = right
								text = "bag_wtp_edit_recall"
							}
							onclick = "[GetScriptedGui('bag_wtp_edit_slot_load_3').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
					}
				}

				widget = { layoutpolicy_horizontal = expanding size = { -1 40 } }

				# **The way out of the pins.** Every «+1» and «−1» pins the
				# good it was pressed on, and without this the only release
				# was «Пересчитать» on the mod's page, which throws the
				# edited plan away with them. This leaves the plan alone.
				button_regular = {
					size = { 190 34 }
					tooltip = "bag_wtp_edit_unpin_tt"
					text_single = {
						size = { 176 26 }
						parentanchor = center
						widgetanchor = center
						autoresize = no
						maximumsize = { 176 26 }
						fontsize = 13
						fontsize_min = 10
						align = center|nobaseline
						elide = right
						text = "bag_wtp_edit_unpin"
					}
					onclick = "[GetScriptedGui('bag_wtp_edit_unpin').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}

				widget = { size = { 8 24 } }

				button_regular = {
					size = { 210 34 }
					tooltip = "bag_wtp_edit_changes_tt"
					text_single = {
						size = { 196 26 }
						parentanchor = center
						widgetanchor = center
						autoresize = no
						maximumsize = { 196 26 }
						fontsize = 13
						fontsize_min = 10
						align = center|nobaseline
						elide = right
						text = "bag_wtp_edit_changes"
					}
					onclick = "[GetScriptedGui('bag_wtp_open_changes_window').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
			}

			# **Земля — и здесь, а не только в окне плана.** Шаг 6: доливка
			# новой земли к плану, который уже стоит. Чтобы «план, который у
			# меня есть» и «вот новая земля» существовали одновременно, второго
			# понятия не нужно — земля и так набирается по клику, а новое есть
			# то, что выбрано сейчас, минус то, на чём план уже стоит. Кнопки
			# те же четыре, что в окне плана, и действие у них то же самое.
			#
			# **Кнопка стоит здесь, а не рядом с «Пересчитать».** «Пересчитать»
			# — функция 3: она сносит каждое закрепление и считает с нуля.
			# Доливка — функция 4: она эти закрепления читает и снимает только
			# то, которое переросла новая доля. Две соседние кнопки, из которых
			# одна стирает закрепления, а другая на них держится, — ровно то
			# смешение, на котором этот мод уже обжигался.
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 8

				text_single = {
					size = { 90 34 }
					autoresize = no
					align = left|vcenter
					fontsize = 14
					text = "bag_wtp_edit_ground_head"
				}

				action_button_regular = {
					size = { 128 34 }
					title = "bag_wtp_map_pick_area"
					description = "bag_wtp_map_pick_area_desc"
					actor = "[Player]"
					left_action = { action_name = "bag_wtp_select_area" }
					tooltip = "bag_wtp_map_pick_area_desc"
					text_single = {
						size = { 120 30 }
						parentanchor = center
						autoresize = no
						maximumsize = { 120 30 }
						fontsize = 14
						fontsize_min = 10
						align = center|nobaseline
						elide = right
						text = "bag_wtp_map_pick_area"
					}
				}

				action_button_regular = {
					size = { 128 34 }
					title = "bag_wtp_map_pick_province"
					description = "bag_wtp_map_pick_province_desc"
					actor = "[Player]"
					left_action = { action_name = "bag_wtp_select_province" }
					tooltip = "bag_wtp_map_pick_province_desc"
					text_single = {
						size = { 120 30 }
						parentanchor = center
						autoresize = no
						maximumsize = { 120 30 }
						fontsize = 14
						fontsize_min = 10
						align = center|nobaseline
						elide = right
						text = "bag_wtp_map_pick_province"
					}
				}

				action_button_regular = {
					size = { 128 34 }
					title = "bag_wtp_map_pick_location"
					description = "bag_wtp_map_pick_location_desc"
					actor = "[Player]"
					left_action = { action_name = "bag_wtp_select_location" }
					tooltip = "bag_wtp_map_pick_location_desc"
					text_single = {
						size = { 120 30 }
						parentanchor = center
						autoresize = no
						maximumsize = { 120 30 }
						fontsize = 14
						fontsize_min = 10
						align = center|nobaseline
						elide = right
						text = "bag_wtp_map_pick_location"
					}
				}

				action_button_regular = {
					size = { 128 34 }
					title = "bag_wtp_map_pick_market"
					description = "bag_wtp_map_pick_market_desc"
					actor = "[Player]"
					left_action = { action_name = "bag_wtp_select_market" }
					tooltip = "bag_wtp_map_pick_market_desc"
					text_single = {
						size = { 120 30 }
						parentanchor = center
						autoresize = no
						maximumsize = { 120 30 }
						fontsize = 14
						fontsize_min = 10
						align = center|nobaseline
						elide = right
						text = "bag_wtp_map_pick_market"
					}
				}

				widget = { layoutpolicy_horizontal = expanding size = { -1 34 } }

				text_single = {
					size = { 190 34 }
					autoresize = no
					maximumsize = { 190 34 }
					align = right|vcenter
					fontsize = 12
					fontsize_min = 9
					elide = right
					text = "bag_wtp_select_summary"
					tooltip = "bag_wtp_edit_extend_tt"
				}

				# **«Перетасовать» стоит в редакторе, а не в окне плана.** Она
				# меняет места, а не количества, и смотреть на её работу идут в
				# «Показать изменения» — в это же окно. Его слова, 2026-09-09:
				# «кнопка „перетасовать“ в общем плане, а кнопка показать
				# изменений — в редакторе. Тогда уж лучше переместить».
				button_regular = {
					size = { 180 34 }
					tooltip = "bag_wtp_plan_reshuffle_tt"
					text_single = {
						size = { 166 26 }
						parentanchor = center
						widgetanchor = center
						autoresize = no
						maximumsize = { 166 26 }
						fontsize = 13
						fontsize_min = 10
						align = center|nobaseline
						elide = right
						text = "bag_wtp_plan_reshuffle"
					}
					onclick = "[GetScriptedGui('bag_wtp_plan_reshuffle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}

				button_regular = {
					size = { 190 34 }
					tooltip = "bag_wtp_edit_extend_tt"
					text_single = {
						size = { 176 26 }
						parentanchor = center
						widgetanchor = center
						autoresize = no
						maximumsize = { 176 26 }
						fontsize = 13
						fontsize_min = 10
						align = center|nobaseline
						elide = right
						text = "bag_wtp_edit_extend"
					}
					onclick = "[GetScriptedGui('bag_wtp_edit_extend').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
			}

			# **Шесть чисел доливки, и это проба, а не отчёт.** «Доливка не
			# сработала», «новой земли не оказалось» и «доливка полезла на
			# старую землю» на карте выглядят одинаково — ничего не изменилось
			# либо изменилось не там, — а здесь это три разных числа.
			# Последнее из них обязано быть нулём.
			text_single = {
				layoutpolicy_horizontal = expanding
				size = { -1 24 }
				autoresize = no
				align = left|vcenter
				fontsize = 13
				elide = right
				text = "[GetPlayer.Custom('bag_wtp_edit_ext_label')]"
				tooltip = "bag_wtp_edit_ext_tt"
			}

			# The picker, and the whole of the editing: every good this ground
			# can make, one row each, «−1» and «+1» in place. A scrolling `vbox`
			# over a datamodel is the shape this mod has drawn since its first
			# window, and 47 rows of it need no wrapping widget.
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 8

				# **The head carries the count.** A picker that was never filled and
				# one that was filled and does not draw look identical, and the goods
				# vanished once already. A number here says which without a log.
				text_single = {
					size = { 420 24 }
					autoresize = no
					align = left|vcenter
					fontsize = 13
					elide = right
					text = "bag_wtp_edit_pool_head"
					tooltip = "bag_wtp_edit_pool_tt"
				}

				# **What the last press did, and whether it arrived at all.** An
				# effect that merely does nothing logs nothing, and a button that
				# never reaches its effect looks exactly like a rule refusing.
				# **It takes the whole rest of the row, and that is why the two
				# buttons moved up beside the slots.** The line names two goods, a
				# location and sometimes two charters, and at 470 it was cut off
				# mid-sentence — «текст не показывается полностью», 2026-09-06.
				# The slots row had that width standing empty.
				text_single = {
					layoutpolicy_horizontal = expanding
					size = { -1 24 }
					autoresize = no
					align = left|vcenter
					fontsize = 13
					elide = right
					text = "[GetPlayer.Custom('bag_wtp_edit_last_label')]"
					tooltip = "bag_wtp_edit_last_tt"
				}
			}

			text_multi = {
				layoutpolicy_horizontal = expanding
				autoresize = yes
				maximumsize = { 1450 30 }
				align = center
				visible = "[Not(DataModelHasItems(GetGlobalList('bag_wtp_edit_pool')))]"
				text = "bag_wtp_edit_pool_empty"
			}

			# **The picker: five rows of ten cells, and every cell is written
			# out** in `bag_wtp_edit_cells.gui`. A cell is «−1», the good's icon
			# with how many buildings of it the plan holds, and «+1».
			#
			# **The number is why the cells are not a datamodel.** `_pn<n>` is
			# numbered and a datamodel row carries a goods scope; nothing gets
			# from one to the other. He asked for the count three times.
			#
			# **And nothing wraps.** `flowcontainer` with a datamodel crashed the
			# game four builds running; `fixedgridbox` drew the cells on top of
			# each other. These are static children of a plain `hbox`, which is as
			# simple as this interface gets. `docs/pitfalls/interface.md`.
			vbox = {
				layoutpolicy_horizontal = expanding
				spacing = 2

				bag_wtp_edit_row1 = {}
				bag_wtp_edit_row2 = {}
				bag_wtp_edit_row3 = {}
				bag_wtp_edit_row4 = {}
				bag_wtp_edit_row5 = {}
			}

			# **The charters, and he asked for them here by name**, 2026-09-06:
			# «можно сделать аналогично, удобно и добавить в том числе туда
			# редактирование по городским правам». Same cell as a good — «−1»,
			# the count, «+1» — with the charter's name instead of an icon,
			# because thirteen charters share their icons with the goods they
			# favour.
			#
			# **Two columns, and the trailing spacer is not decoration.** An
			# `hbox` with room to spare divides it between its children, so
			# without a child that takes the slack the two columns drift apart
			# across the window. `docs/pitfalls/interface.md`.
			# **Заголовок и галочка режима в одном ряду.** Галочка -- его
			# просьба 2026-09-14: «Можно добавить галочку режима на этот счёт.
			# Менять по одному праву или по провинциям сразу». Стоит по
			# умолчанию, значение ей ставит `bag_wtp_register`.
			#
			# **Растягивающаяся пустышка в конце ряда обязательна**: `hbox` с
			# запасом делит его между детьми, и без неё заголовок с галочкой
			# разъезжаются по ширине окна (`docs/pitfalls/interface.md`).
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 8

				text_single = {
					size = { 700 22 }
					autoresize = no
					align = left|vcenter
					fontsize = 13
					elide = right
					text = "bag_wtp_edit_rights_head"
					tooltip = "bag_wtp_edit_rights_head_tt"
				}

				checkbutton_round_alt = {
					size = { 22 22 }
					down = "[GetGlobalVariable('bag_wtp_edit_rprov').IsSet]"
					tooltip = "bag_wtp_edit_rprov_tt"
					onclick = "[GetScriptedGui('bag_wtp_edit_rprov_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}

				text_single = {
					size = { 330 22 }
					maximumsize = { 330 22 }
					autoresize = no
					align = left|vcenter
					fontsize = 13
					elide = right
					text = "bag_wtp_edit_rprov"
					tooltip = "bag_wtp_edit_rprov_tt"
				}

				expand = {}
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				spacing = 2
				ignoreinvisible = yes

				bag_wtp_edit_right_row1 = {}
				bag_wtp_edit_right_row2 = {}
				bag_wtp_edit_right_row3 = {}
			}

			# The plan as it stands, in the plan window's own rows.
			text_single = {
				size = { 1130 22 }
				autoresize = no
				align = left|vcenter
				fontsize = 13
				elide = right
				text = "bag_wtp_plan_pass_summary"
				tooltip = "bag_wtp_plan_pass_tt"
			}

			# The same fold switch as the plan window, on the same variable, so
			# the two windows are never in different states.
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 8

				checkbutton_round_alt = {
					size = { 24 24 }
					down = "[GetPlayer.MakeScope.GetVariable('bag_wtp_plan_folded').IsSet]"
					tooltip = "bag_wtp_plan_fold_tt"
					onclick = "[GetScriptedGui('bag_wtp_plan_fold_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}

				text_single = {
					size = { 140 24 }
					maximumsize = { 140 24 }
					autoresize = no
					align = left|vcenter
					fontsize = 13
					elide = right
					text = "bag_wtp_plan_fold"
					tooltip = "bag_wtp_plan_fold_tt"
				}

				text_single = {
					size = { 300 24 }
					maximumsize = { 300 24 }
					autoresize = no
					align = left|vcenter
					fontsize = 13
					elide = right
					visible = "[GetPlayer.MakeScope.GetVariable('bag_wtp_plan_folded').IsSet]"
					text = "bag_wtp_plan_provs_head"
					tooltip = "bag_wtp_plan_fold_tt"
				}

				widget = { layoutpolicy_horizontal = expanding size = { -1 24 } }
			}

			text_multi = {
				layoutpolicy_horizontal = expanding
				autoresize = yes
				maximumsize = { 1450 40 }
				align = center
				visible = "[And(Not(DataModelHasItems(GetGlobalList('bag_wtp_plan_results'))), Not(DataModelHasItems(GetGlobalList('bag_wtp_plan_provs'))))]"
				text = "bag_wtp_edit_no_plan"
			}

			scrollbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				blockoverride "scrollbox_content" {
					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = preferred
						margin = { 10 8 }
						margin_right = 20
						spacing = 3
						ignoreinvisible = yes

						# **The same switch as the plan window, and the same two
						# lists.** Step 4 asked for the fold «в двух окнах
						# плана», and the row types are shared, so the editor
						# gets it by drawing the same pair.
						vbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = preferred
							spacing = 3
							visible = "[Not(GetPlayer.MakeScope.GetVariable('bag_wtp_plan_folded').IsSet)]"
							datamodel = "[GetGlobalList('bag_wtp_plan_results')]"
							item = {
								bag_wtp_plan_entry = {
									datacontext = "[Scope.GetLocation]"
								}
							}
						}

						vbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = preferred
							spacing = 3
							visible = "[GetPlayer.MakeScope.GetVariable('bag_wtp_plan_folded').IsSet]"
							datamodel = "[GetGlobalList('bag_wtp_plan_provs')]"
							item = {
								bag_wtp_plan_prov_entry = {
									datacontext = "[Scope.GetLocation]"
								}
							}
						}
					}
				}
			}
		}
	}
}
