# The whole-map plan: one row per location the plan put anything in, the most
# crowded first.
#
# **A row is a location here and a province in the other window**, and that is
# the whole difference between the two. The ranking answers «which province is
# best at this good», which is a question about a province because the bonus is
# counted over one. A plan answers «what do I build here», and «here» is a
# location: the cap is a location's, and one province holds four of them.
#
# Everything a row prints is on the location itself -- `bag_wtp_load` and the
# `bag_wtp_plan_goods` list, both written by `bag_wtp_generated_plan.txt` -- and
# `bag_wtp_plan_results` is those locations in rank order. The idiom is the
# results window's throughout: every column a fixed width, none expanding, and a
# column that hugs its content is a `widget` with an anchored child rather than a
# sized hbox (`docs/pitfalls/interface.md`).

types BagWtpPlanTypes {

	# **Домик и товар — две ячейки одной ширины, одна над другой.**
	# Ширина здесь и ширина у `bag_wtp_plan_good_entry` обязаны совпадать: обе
	# строки — датамодели двух списков, которые пишутся одним шагом и потому
	# идут индекс в индекс, а в столбик их ставит только равная ячейка. Разойдись
	# ширины — и товар встанет над чужим домиком, молча.
	#
	# **Размер держит `widget`, а не текст.** Значок-текст берёт размер шрифта, и
	# в прошлый раз именно он вылез из своих 20 и наехал на соседнюю строку:
	# «иконка домика и иконка товара встали друг на друга», 2026-09-06. Теперь
	# коробка фиксирована, а текст висит по центру внутри неё.
	type bag_wtp_plan_building_entry = widget {
		size = { 34 20 }
		text_single = {
			parentanchor = center
			autoresize = yes
			fontsize = 14
			raw_text = "[BuildingType.GetIcon]"
			tooltip = "[BuildingType.GetName]"
		}
	}

	type bag_wtp_plan_good_entry = widget {
		size = { 34 20 }
		text_single = {
			parentanchor = center
			autoresize = yes
			fontsize = 14
			raw_text = "[Goods.GetIcon]"
			tooltip = "[Goods.GetName]"
		}
	}

	# **A province, and its own locations folded under it.** Step 4: «провинции
	# сворачиваются в двух окнах плана», and the search window has drawn exactly
	# this since it was built.
	#
	# The row stands on the province's representative location — the one
	# `bag_wtp_plan_provs` holds — so `_plan_prov_locn`, `_plan_prov_load` and
	# `_plan_prank` are all read straight off it, and the open/closed state has
	# somewhere of its own to live (`_plan_pexp`), which a datamodel row does not.
	#
	# **The inner rows are the flat list's own row type**, gated on
	# `_plan_rank`: `GetLocations` gives every location of the province and the
	# plan uses only some. Nothing is duplicated, and a column that moves moves in
	# both views at once.
	type bag_wtp_plan_prov_entry = vbox {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = preferred
		spacing = 2

		widget = {
			layoutpolicy_horizontal = expanding
			size = { -1 40 }
			using = bg_paper_card

			hbox = {
				layoutpolicy_horizontal = expanding
				size = { -1 40 }
				spacing = 0

				onmousehierarchyenter = "[PdxGuiWidget.SetHighlightLocation(Location.Self)]"

				widget = {
					size = { 38 40 }
					button_square_plus = {
						size = { 26 26 }
						parentanchor = center
						widgetanchor = center
						visible = "[Not(Location.MakeScope.GetVariable('bag_wtp_plan_pexp').IsSet)]"
						tooltip = "bag_wtp_plan_prov_expand_tt"
						onclick = "[GetScriptedGui('bag_wtp_plan_prov_expand').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_location', Location.MakeScope).End)]"
					}
					button_square_minus = {
						size = { 26 26 }
						parentanchor = center
						widgetanchor = center
						visible = "[Location.MakeScope.GetVariable('bag_wtp_plan_pexp').IsSet]"
						tooltip = "bag_wtp_plan_prov_collapse_tt"
						onclick = "[GetScriptedGui('bag_wtp_plan_prov_collapse').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_location', Location.MakeScope).End)]"
					}
				}

				text_single = {
					size = { 40 40 }
					autoresize = no
					maximumsize = { 40 40 }
					align = left|vcenter
					fontsize = 13
					text = "bag_wtp_plan_prov_rank_value"
					tooltip = "bag_wtp_plan_prov_rank_tt"
				}

				text_single = {
					size = { 200 40 }
					autoresize = no
					maximumsize = { 200 40 }
					align = left|vcenter
					elide = right
					fontsize = 14
					text = "[Location.GetProvinceDefinition.GetName]"
					tooltip = "bag_wtp_plan_province_tt"
				}

				widget = { size = { 8 40 } }

				text_single = {
					size = { 120 40 }
					autoresize = no
					maximumsize = { 120 40 }
					align = left|vcenter
					elide = right
					fontsize = 13
					text = "[Location.GetArea.GetNameWithNoTooltip]"
				}

				widget = { size = { 8 40 } }

				text_single = {
					size = { 260 40 }
					autoresize = no
					maximumsize = { 260 40 }
					align = left|vcenter
					elide = right
					fontsize = 13
					text = "bag_wtp_plan_prov_sum"
					tooltip = "bag_wtp_plan_prov_sum_tt"
				}

				# **Шаг 8: отмашка на всю провинцию.** Одно нажатие переключает
				# галочки автостроя CM у домиков плана во всех её локациях —
				# и больше ничего: дальше решает CM.
				button_regular = {
					size = { 40 40 }
					tooltip = "bag_wtp_cm_prov_tt"
					visible = "[GetScriptedGui('bag_wtp_cm_present').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					icon = {
						size = { 26 26 }
						parentanchor = center
						widgetanchor = center
						texture = "gfx/interface/icons/flat_icons/mass_upgrade.dds"
						alpha = 0.35
						visible = "[Not(Location.MakeScope.GetVariable('bag_wtp_cm_lit_prov').IsSet)]"
					}
					icon = {
						size = { 26 26 }
						parentanchor = center
						widgetanchor = center
						texture = "gfx/interface/icons/flat_icons/mass_upgrade.dds"
						visible = "[Location.MakeScope.GetVariable('bag_wtp_cm_lit_prov').IsSet]"
					}
					onclick = "[GetScriptedGui('bag_wtp_cm_press_prov').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_location', Location.MakeScope).End)]"
				}

				# **Снос лишнего в этой провинции.**
				button_regular = {
					size = { 40 40 }
					tooltip = "bag_wtp_raze_prov_tt"
					icon = {
						size = { 24 24 }
						parentanchor = center
						widgetanchor = center
						texture = "gfx/interface/icons/flat_icons/disable_icon.dds"
					}
					onclick = "[GetScriptedGui('bag_wtp_raze_press_prov').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_location', Location.MakeScope).End)]"
				}

				widget = { layoutpolicy_horizontal = expanding size = { -1 40 } }
			}
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = preferred
			spacing = 3
			ignoreinvisible = yes
			visible = "[Location.MakeScope.GetVariable('bag_wtp_plan_pexp').IsSet]"
			datamodel = "[Location.GetProvinceDefinition.GetLocations]"
			item = {
				bag_wtp_plan_entry = {
					visible = "[Location.MakeScope.GetVariable('bag_wtp_plan_rank').IsSet]"
				}
			}
		}
	}

	type bag_wtp_plan_entry = hbox {
		layoutpolicy_horizontal = expanding
		size = { -1 42 }
		spacing = 0
		using = bg_number_container_bckg

		# The map answers the row. `SetHighlightLocation` is on the generic widget
		# rather than on any view, so this is the game's own highlight in a mod's
		# own window, and the engine clears it when the mouse leaves.
		onmousehierarchyenter = "[PdxGuiWidget.SetHighlightLocation(Location.Self)]"

		text_single = {
			size = { 38 42 }
			autoresize = no
			align = center|vcenter
			fontsize = 13
			text = "bag_wtp_plan_rank_value"
			tooltip = "bag_wtp_plan_rank_tt"
		}

		# The rank cell is a button and the button is the override. The game's
		# rank is only what is true today; a village he means to raise is still a
		# village to `location_rank`, and the mod cannot guess which. Clicking
		# cycles auto -> town -> village -> auto.
		#
		# **One word and no icon.** The first build drew the game's rank icon in
		# the button, which of course never changed however the override was set,
		# and coloured the word with `§Y...§!`, which prints literally -- **not a
		# quirk of this widget, which is how this note read until 2026-09-05:**
		# `§` is the previous engine's markup and this game uses `#Y ...#!`
		# everywhere. Left here as a comment, the rule was re-broken 100 times
		# over; it is `check_script.py` -> `localization_markup` now.
		# The location's own rank icon is beside its name instead,
		# where it says what the game thinks rather than what the plan does.
		widget = {
			size = { 92 42 }
			button_regular = {
				size = { 88 26 }
				parentanchor = center
				widgetanchor = center
				tooltip = "bag_wtp_plan_rank_button_tt"
				onclick = "[GetScriptedGui('bag_wtp_plan_mark_town').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_location', Location.MakeScope).End)]"
				text_single = {
					parentanchor = center
					widgetanchor = center
					autoresize = yes
					fontsize = 12
					visible = "[And(Not(Location.MakeScope.GetVariable('bag_wtp_force_town').IsSet), Not(Location.MakeScope.GetVariable('bag_wtp_force_rural').IsSet))]"
					text = "bag_wtp_plan_rank_auto"
				}
				text_single = {
					parentanchor = center
					widgetanchor = center
					autoresize = yes
					fontsize = 12
					visible = "[Location.MakeScope.GetVariable('bag_wtp_force_town').IsSet]"
					text = "bag_wtp_plan_forced_town"
				}
				text_single = {
					parentanchor = center
					widgetanchor = center
					autoresize = yes
					fontsize = 12
					visible = "[Location.MakeScope.GetVariable('bag_wtp_force_rural').IsSet]"
					text = "bag_wtp_plan_forced_rural"
				}
			}
		}

		# What the game itself calls this location, which the button above does
		# not change.
		widget = {
			size = { 26 42 }
			icon = {
				size = { 18 18 }
				parentanchor = center
				widgetanchor = center
				texture = "[Location.GetRankIcon]"
				tooltipwidget = { using = location_simple_tooltip }
			}
		}

		text_single = {
			size = { 154 42 }
			autoresize = no
			maximumsize = { 154 42 }
			align = left|vcenter
			elide = right
			text = "[Location.GetName]"
		}

		widget = { size = { 6 42 } }

		text_single = {
			size = { 130 42 }
			autoresize = no
			maximumsize = { 130 42 }
			align = left|vcenter
			elide = right
			fontsize = 13
			text = "[Location.GetProvinceDefinition.GetName]"
			tooltip = "bag_wtp_plan_province_tt"
		}

		widget = { size = { 6 42 } }

		text_single = {
			size = { 100 42 }
			autoresize = no
			maximumsize = { 100 42 }
			align = left|vcenter
			elide = right
			fontsize = 13
			text = "[Location.GetArea.GetNameWithNoTooltip]"
		}

		widget = { size = { 6 42 } }

		text_single = {
			size = { 56 42 }
			autoresize = no
			align = center|vcenter
			fontsize = 14
			text = "bag_wtp_plan_load_value"
			tooltip = "bag_wtp_plan_load_tt"
		}

		widget = { size = { 6 42 } }

		# What the ground already digs up here, which is the other half of the
		# answer: a location with salt in it is why the plan put no salt works in
		# the province, and the icon says so without a column of its own.
		widget = {
			size = { 30 42 }
			visible = "[Location.HasRawMaterial]"
			icon = {
				size = { 22 22 }
				parentanchor = center
				widgetanchor = center
				texture = "[GetGoodsIcon(Location.GetRawMaterial)]"
				tooltip = "[Location.GetRawMaterial.GetName]"
			}
		}

		widget = { size = { 6 42 } }

		# Which urban right the province was given, if the switch is on. A
		# `customizable_localization` of this mod's own turns the number the pass
		# parks on the location into the right's own name and icon.
		text_single = {
			size = { 150 42 }
			autoresize = no
			maximumsize = { 150 42 }
			align = left|vcenter
			fontsize = 13
			elide = right
			# A village row carries its province's right variable too, because
			# everything is mirrored across the province -- and printing it there
			# said a right applies to a village, which it never does.
			visible = "[Location.MakeScope.GetVariable('bag_wtp_plan_town_row').IsSet]"
			text = "[Location.Custom('bag_wtp_plan_right_label')]"
			tooltip = "bag_wtp_plan_right_tt"
		}

		widget = { size = { 6 42 } }

		# **Только домики, без иконок товаров над ними.** Его слова, 2026-09-06:
		# «иконка домика и иконка товара встали друг на друга… пусть там будет
		# именно только иконка домика, без иконки товара. По домику и так ясно, что
		# это за товар.» Две строки по 20 в ячейке 42 не пересекались по числам, а
		# `autoresize = yes` внутри них — пересекались на экране.
		#
		# **Это окно и редактор, а не поиск по одному товару.** Там строка отвечает
		# на другой вопрос и остаётся как была.
		#
		# **`_row_builds` и не `_plan_builds`.** Списки самого плана лежат в том
		# порядке, в каком проход их поставил, и этот порядок невоспроизводим:
		# слот, загруженный обратно, кладёт те же четыре товара в нумерации самих
		# товаров. Ничего не двигалось, а строка читалась иначе.
		#
		# **`hbox` без своей ширины жмётся к содержимому**, поэтому он лежит в
		# простом `widget` с якорем: `vbox` брал все 260 и центрировал строку
		# внутри себя — «иконки товаров немного не в столбике», 2026-09-06.
		widget = {
			size = { 300 42 }
			alwaystransparent = no
			tooltip = "bag_wtp_plan_goods_tt"

			# **Товар над своим домиком, столбик в столбик.** Его слова
			# 2026-09-06: «я не понял, что именно производят в плане эти
			# деревни… иконки производимого товара к домикам нужно вернуть».
			# Причина настоящая: торговая деревня делает пиво, посуду и
			# инструменты, так что по домику товар больше не читается —
			# `market_village` и есть тот домик, из-за которого 25 пивоварен
			# выглядели как ошибка.
			#
			# **Два списка, а не один, потому что строка датамодели видит один
			# скоуп** — правило из `SETTLED.md`, и обойти его нечем. `_row_goods`
			# и `_row_builds` пишутся одним шагом в `row_entry`, по одному
			# домику на товар, поэтому идут индекс в индекс; равная ширина
			# ячеек — всё, что превращает это в пары на экране.
			#
			# **Что расходится молча, то посчитано:** `WTP ROWPAIR` в
			# диагностике считает локации, где длины двух списков разошлись.
			# Не ноль — значит столбики врут, и это видно числом, а не глазом.
			vbox = {
				parentanchor = left|vcenter
				widgetanchor = left|vcenter
				spacing = 2

				hbox = {
					parentanchor = left
					widgetanchor = left
					spacing = 2
					datamodel = "[Location.MakeScope.GetList('bag_wtp_row_goods')]"
					item = {
						bag_wtp_plan_good_entry = {
							datacontext = "[Scope.GetGoods]"
						}
					}
				}

				hbox = {
					parentanchor = left
					widgetanchor = left
					spacing = 2
					datamodel = "[Location.MakeScope.GetList('bag_wtp_row_builds')]"
					item = {
						bag_wtp_plan_building_entry = {
							datacontext = "[Scope.GetBuildingType]"
						}
					}
				}

				# **Домики житницы — свой список, и не случайно.** Своего товара
				# у них нет, а `_row_goods` и `_row_builds` обязаны идти индекс
				# в индекс: пара «сырьё локации — домик» ломала это, как только
				# житница ставила больше одного домика (`ROWPAIR mismatched=7`,
				# прогон 2026-09-13). Третий список ничего не обещает попарно.
				hbox = {
					parentanchor = left
					widgetanchor = left
					spacing = 2
					datamodel = "[Location.MakeScope.GetList('bag_wtp_row_gran')]"
					item = {
						bag_wtp_plan_building_entry = {
							datacontext = "[Scope.GetBuildingType]"
						}
					}
				}
			}
		}

		# **Продовольственный потенциал локации** — формула режима карты
		# Construction Manager, переписанная под себя на сборке. Ячейка пуста
		# там, где сырьё не продовольственное: `_food_pot` там просто не стоит.
		widget = {
			size = { 56 42 }
			alwaystransparent = no
			tooltip = "bag_wtp_food_pot_tt"
			visible = "[Location.MakeScope.GetVariable('bag_wtp_food_pot').IsSet]"
			text_single = {
				parentanchor = center
				widgetanchor = center
				autoresize = no
				size = { 52 26 }
				align = center|nobaseline
				fontsize = 13
				text = "bag_wtp_food_pot_value"
			}
		}

		# **Шаг 8: отмашка на эту локацию.**
		button_regular = {
			size = { 40 42 }
			tooltip = "bag_wtp_cm_loc_tt"
			visible = "[GetScriptedGui('bag_wtp_cm_present').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			icon = {
				size = { 26 26 }
				parentanchor = center
				widgetanchor = center
				texture = "gfx/interface/icons/flat_icons/mass_upgrade.dds"
				alpha = 0.35
				visible = "[Not(Location.MakeScope.GetVariable('bag_wtp_cm_lit').IsSet)]"
			}
			icon = {
				size = { 26 26 }
				parentanchor = center
				widgetanchor = center
				texture = "gfx/interface/icons/flat_icons/mass_upgrade.dds"
				visible = "[Location.MakeScope.GetVariable('bag_wtp_cm_lit').IsSet]"
			}
			onclick = "[GetScriptedGui('bag_wtp_cm_press_loc').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_location', Location.MakeScope).End)]"
		}

		# **Снос лишнего в этой локации.**
		button_regular = {
			size = { 40 42 }
			tooltip = "bag_wtp_raze_loc_tt"
			icon = {
				size = { 24 24 }
				parentanchor = center
				widgetanchor = center
				texture = "gfx/interface/icons/flat_icons/disable_icon.dds"
			}
			onclick = "[GetScriptedGui('bag_wtp_raze_press_loc').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_location', Location.MakeScope).End)]"
		}

		# **Режим житницы CM**, и только там, где CM его предлагает.
		button_regular = {
			size = { 40 42 }
			tooltip = "bag_wtp_food_loc_tt"
			visible = "[GetScriptedGui('bag_wtp_food_here').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_location', Location.MakeScope).End)]"
			icon = {
				size = { 24 24 }
				parentanchor = center
				widgetanchor = center
				texture = "gfx/interface/icons/unit_view/food.dds"
				alpha = 0.35
				visible = "[Not(Location.MakeScope.GetVariable('cm_auto_food_location_enabled').IsSet)]"
			}
			icon = {
				size = { 24 24 }
				parentanchor = center
				widgetanchor = center
				texture = "gfx/interface/icons/unit_view/food.dds"
				visible = "[Location.MakeScope.GetVariable('cm_auto_food_location_enabled').IsSet]"
			}
			onclick = "[GetScriptedGui('bag_wtp_food_press_loc').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_location', Location.MakeScope).End)]"
		}

		# **Замена домика в этой локации.** Его шестой пункт, 2026-09-13: «в
		# каждой локации в окне редактора должна быть добавлена кнопочка
		# замены». Ряд общий на оба окна, поэтому кнопка спрашивает, открыт ли
		# редактор, — и не показывается на житнице, которую заполняет свой круг.
		button_regular = {
			size = { 40 42 }
			tooltip = "bag_wtp_swap_open_tt"
			visible = "[GetScriptedGui('bag_wtp_swap_here').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_location', Location.MakeScope).End)]"
			icon = {
				size = { 24 24 }
				parentanchor = center
				widgetanchor = center
				# `arrow_double_h` -- значок, который игра правда рисует: он назван в
				# её же `.gui`. Придуманное имя текстуры даёт пустую кнопку и
				# молчит, как и всё остальное в этом интерфейсе.
				texture = "gfx/interface/icons/flat_icons/arrow_double_h.dds"
			}
			onclick = "[GetScriptedGui('bag_wtp_swap_open').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_location', Location.MakeScope).End)]"
		}

		widget = { layoutpolicy_horizontal = expanding size = { -1 30 } }
	}
}

window = {
	name = "bag_wtp_plan_window"
	datacontext = "[GetPlayer]"
	allow_outside = yes
	alwaystransparent = no
	parentanchor = center
	widgetanchor = center
	position = { 0 0 }
	movable = yes
	size = { 1700 760 }
	using = bg_window_default_alt

	visible = "[GetPlayer.MakeScope.GetVariable('bag_wtp_plan_open').IsSet]"
	enabled = "[GetPlayer.MakeScope.GetVariable('bag_wtp_plan_open').IsSet]"

	# **Форма окна взята у самой игры, а не придумана.** `ai_settings_menu.gui` —
	# свободное окно ровно этого вида: `size` и `using = bg_window_default_alt`
	# стоят **на самом `window`**, а `vbox` лежит в нём напрямую. У нас между ними
	# был лишний `widget` со своим размером, и шапка, оказавшись внутри него,
	# держала ширину своего типа, что бы ни делало окно. «Злоебучая шапка окна
	# снова не расширилась вместе с окном» — 2026-09-06, и это третий раз.
	#
	# **Тип `window_header_alt` не объявлен нигде в `reference/`**, так что читать,
	# что держит его ширину, отсюда нечем. Поэтому здесь не догадка о шапке, а
	# копия структуры окна, которое в игре работает.

	widget = {
		parentanchor = right
		position = { -5 5 }
		size = { 40 40 }
		ui_direction_button_holder_right = {}
		button_close_alt = {
			blockoverride "close_on_action" {
				on_action = "[GetScriptedGui('bag_wtp_close_plan_window').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
		}
	}

	vbox = {
		using = window_margin_alt

		# **`layoutpolicy_horizontal = expanding` on the header, and every window
		# of this mod was missing it.** «Злоебучая шапка окна снова не
		# расширилась вместе с окном» — 2026-09-06, and the third time he has
		# said it. The game's own windows all carry this line on their
		# `window_header_alt` (`multiplayer_lobby.gui`,
		# `automation_lateralview.gui`); without it the header keeps the type's
		# own width whatever the window does.
		window_header_alt = {
			blockoverride "header_text" { text = "bag_wtp_plan_window_title" }
			blockoverride "window_header_alt_color_texture" { using = color_production_texture }
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			using = bg_secondary_inner_alt
			margin = { 12 12 }
			spacing = 6


			# ---- the plan's own settings, which were the mod page's ----
			#
			# **Five settings moved here on 2026-09-06**: «План» and «На конец»
			# were two buttons on the page and are one switch and «Пересчитать»
			# now, and the caps, the urban-rights tick and the town/village
			# reset came with them. His rule: у функции на странице мода одна
			# кнопка «открыть», всё остальное внутри её окна.
			#
			# **Nothing here re-plans.** The pass costs about fifty times a
			# ranking's and he may flip a hundred town markers before he wants
			# an answer, so «Пересчитать» above is the moment and it is his.
			# That is why the switch behaves differently from its twin in the
			# ranking window, where a press does re-rank.
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 8

				widget = {
					size = { 28 34 }
					checkbutton_round_alt = {
						size = { 24 24 }
						parentanchor = center
						widgetanchor = center
						down = "[GetGlobalVariable('bag_wtp_plan_by_end').IsSet]"
						tooltip = "bag_wtp_plan_by_end_tt"
						onclick = "[GetScriptedGui('bag_wtp_toggle_plan_end').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					}
				}

				text_single = {
					size = { 210 34 }
					autoresize = no
					maximumsize = { 210 34 }
					align = left|vcenter
					fontsize = 13
					fontsize_min = 10
					elide = right
					text = "bag_wtp_plan_by_end"
					tooltip = "bag_wtp_plan_by_end_tt"
				}

				widget = {
					size = { 28 34 }
					checkbutton_round_alt = {
						size = { 24 24 }
						parentanchor = center
						widgetanchor = center
						down = "[GetGlobalVariable('bag_wtp_plan_rights').IsSet]"
						tooltip = "bag_wtp_plan_rights_tt"
						onclick = "[GetScriptedGui('bag_wtp_toggle_plan_rights').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					}
				}

				text_single = {
					size = { 210 34 }
					autoresize = no
					maximumsize = { 210 34 }
					align = left|vcenter
					fontsize = 13
					fontsize_min = 10
					elide = right
					text = "bag_wtp_plan_rights"
					tooltip = "bag_wtp_plan_rights_tt"
				}

				# «Специализация» — третий тумблер того же «Пересчитать».
				#
				# **Была кнопкой на странице мода и перестала ею быть**,
				# 2026-09-12: «если я захочу в этом же окне нажать
				# "пересчитать" — он просто сделает базовый общий план, а не
				# специализацию… нужно просто добавить галочку "специализация"
				# в общий план». Развилка — в `bag_wtp_plan_refresh`.
				widget = {
					size = { 28 34 }
					checkbutton_round_alt = {
						size = { 24 24 }
						parentanchor = center
						widgetanchor = center
						down = "[GetGlobalVariable('bag_wtp_plan_spec').IsSet]"
						tooltip = "bag_wtp_plan_spec_tt"
						onclick = "[GetScriptedGui('bag_wtp_toggle_plan_spec').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					}
				}

				text_single = {
					size = { 210 34 }
					autoresize = no
					maximumsize = { 210 34 }
					align = left|vcenter
					fontsize = 13
					fontsize_min = 10
					elide = right
					text = "bag_wtp_plan_spec"
					tooltip = "bag_wtp_plan_spec_tt"
				}


				text_single = {
					size = { 150 34 }
					autoresize = no
					maximumsize = { 150 34 }
					align = left|vcenter
					fontsize = 13
					fontsize_min = 10
					elide = right
					text = "bag_wtp_cap_urban"
					tooltip = "bag_wtp_cap_urban_tt"
				}

				button_regular = {
					size = { 28 30 }
					tooltip = "bag_wtp_cap_urban_tt"
					text_single = {
						parentanchor = center
						widgetanchor = center
						autoresize = yes
						fontsize = 14
						text = "bag_wtp_edit_minus"
					}
					onclick = "[GetScriptedGui('bag_wtp_cap_urban_down').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}

				text_single = {
					size = { 30 34 }
					autoresize = no
					maximumsize = { 30 34 }
					align = center|vcenter
					fontsize = 15
					text = "bag_wtp_cap_urban_value"
					tooltip = "bag_wtp_cap_urban_tt"
				}

				button_regular = {
					size = { 28 30 }
					tooltip = "bag_wtp_cap_urban_tt"
					text_single = {
						parentanchor = center
						widgetanchor = center
						autoresize = yes
						fontsize = 14
						text = "bag_wtp_edit_plus"
					}
					onclick = "[GetScriptedGui('bag_wtp_cap_urban_up').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}


				text_single = {
					size = { 150 34 }
					autoresize = no
					maximumsize = { 150 34 }
					align = left|vcenter
					fontsize = 13
					fontsize_min = 10
					elide = right
					text = "bag_wtp_cap_rural"
					tooltip = "bag_wtp_cap_rural_tt"
				}

				button_regular = {
					size = { 28 30 }
					tooltip = "bag_wtp_cap_rural_tt"
					text_single = {
						parentanchor = center
						widgetanchor = center
						autoresize = yes
						fontsize = 14
						text = "bag_wtp_edit_minus"
					}
					onclick = "[GetScriptedGui('bag_wtp_cap_rural_down').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}

				text_single = {
					size = { 30 34 }
					autoresize = no
					maximumsize = { 30 34 }
					align = center|vcenter
					fontsize = 15
					text = "bag_wtp_cap_rural_value"
					tooltip = "bag_wtp_cap_rural_tt"
				}

				button_regular = {
					size = { 28 30 }
					tooltip = "bag_wtp_cap_rural_tt"
					text_single = {
						parentanchor = center
						widgetanchor = center
						autoresize = yes
						fontsize = 14
						text = "bag_wtp_edit_plus"
					}
					onclick = "[GetScriptedGui('bag_wtp_cap_rural_up').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}

				widget = { layoutpolicy_horizontal = expanding size = { -1 34 } }

				# **The tick is a location variable and it outlives a save**,
				# so clearing the rows on screen is not clearing them: on
				# 2026-09-02 he cleared the fourteen he could see, widened the
				# ground, and fourteen others came into the plan looking
				# exactly like a revert. One button, the whole world.
				button_regular = {
					size = { 260 34 }
					tooltip = "bag_wtp_plan_ticks_tt"
					text_single = {
						size = { 246 26 }
						parentanchor = center
						widgetanchor = center
						autoresize = no
						maximumsize = { 246 26 }
						fontsize = 13
						fontsize_min = 10
						align = center|nobaseline
						elide = right
						text = "bag_wtp_plan_ticks"
					}
					onclick = "[GetScriptedGui('bag_wtp_plan_clear_ticks').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
			}

			# The borders, the same four buttons the ranking window carries.
			# They were only there before, and choosing the ground for a plan
			# meant opening the other window to do it and coming back.
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 8

				action_button_regular = {
					size = { 116 34 }
					title = "bag_wtp_map_pick_area"
					description = "bag_wtp_map_pick_area_desc"
					actor = "[Player]"
					left_action = { action_name = "bag_wtp_select_area" }
					tooltip = "bag_wtp_map_pick_area_desc"
					text_single = {
						size = { 108 30 }
						parentanchor = center
						autoresize = no
						maximumsize = { 108 30 }
						fontsize = 14
						fontsize_min = 10
						align = center|nobaseline
						elide = right
						text = "bag_wtp_map_pick_area"
					}
				}

				action_button_regular = {
					size = { 116 34 }
					title = "bag_wtp_map_pick_province"
					description = "bag_wtp_map_pick_province_desc"
					actor = "[Player]"
					left_action = { action_name = "bag_wtp_select_province" }
					tooltip = "bag_wtp_map_pick_province_desc"
					text_single = {
						size = { 108 30 }
						parentanchor = center
						autoresize = no
						maximumsize = { 108 30 }
						fontsize = 14
						fontsize_min = 10
						align = center|nobaseline
						elide = right
						text = "bag_wtp_map_pick_province"
					}
				}

				action_button_regular = {
					size = { 116 34 }
					title = "bag_wtp_map_pick_location"
					description = "bag_wtp_map_pick_location_desc"
					actor = "[Player]"
					left_action = { action_name = "bag_wtp_select_location" }
					tooltip = "bag_wtp_map_pick_location_desc"
					text_single = {
						size = { 108 30 }
						parentanchor = center
						autoresize = no
						maximumsize = { 108 30 }
						fontsize = 14
						fontsize_min = 10
						align = center|nobaseline
						elide = right
						text = "bag_wtp_map_pick_location"
					}
				}

				action_button_regular = {
					size = { 116 34 }
					title = "bag_wtp_map_pick_market"
					description = "bag_wtp_map_pick_market_desc"
					actor = "[Player]"
					left_action = { action_name = "bag_wtp_select_market" }
					tooltip = "bag_wtp_map_pick_market_desc"
					text_single = {
						size = { 108 30 }
						parentanchor = center
						autoresize = no
						maximumsize = { 108 30 }
						fontsize = 14
						fontsize_min = 10
						align = center|nobaseline
						elide = right
						text = "bag_wtp_map_pick_market"
					}
				}

				# **«Выбрать мою землю» — his ask, 2026-09-06**, in the place of
				# the «только там, где здание может стоять» tick, which named
				# one thing and did another. This one says what it does: every
				# location the country owns, added to the selection. It is a
				# plain button and not a map action, because there is nothing
				# to click on the map — the answer is already known.
				button_regular = {
					size = { 116 34 }
					tooltip = "bag_wtp_pick_my_land_tt"
					text_single = {
						size = { 108 30 }
						parentanchor = center
						widgetanchor = center
						autoresize = no
						maximumsize = { 108 30 }
						fontsize = 14
						fontsize_min = 10
						align = center|nobaseline
						elide = right
						text = "bag_wtp_pick_my_land"
					}
					onclick = "[GetScriptedGui('bag_wtp_pick_my_land').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}

				widget = { layoutpolicy_horizontal = expanding size = { -1 34 } }

				# Choosing on the map does not re-plan: the pass is fifty times
				# a ranking's, and a plan that redrew itself on every click
				# would make the picker unusable. Press «План» again.
				text_single = {
					size = { 120 34 }
					autoresize = no
					maximumsize = { 120 34 }
					align = right|vcenter
					fontsize = 12
					fontsize_min = 9
					elide = right
					text = "bag_wtp_select_summary"
					tooltip = "bag_wtp_plan_reselect_tt"
				}

				# The plan is remade only when he says so, which is the whole
				# point of the button: he may flip a hundred town markers
				# before he wants an answer.
				# **Шаг 8: отмашка на весь план.**
				button_regular = {
					size = { 44 42 }
					tooltip = "bag_wtp_cm_all_tt"
					visible = "[GetScriptedGui('bag_wtp_cm_present').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					icon = {
						size = { 30 30 }
						parentanchor = center
						widgetanchor = center
						texture = "gfx/interface/icons/flat_icons/mass_upgrade.dds"
						alpha = 0.35
						visible = "[Not(GetGlobalVariable('bag_wtp_cm_lit_all').IsSet)]"
					}
					icon = {
						size = { 30 30 }
						parentanchor = center
						widgetanchor = center
						texture = "gfx/interface/icons/flat_icons/mass_upgrade.dds"
						visible = "[GetGlobalVariable('bag_wtp_cm_lit_all').IsSet]"
					}
					onclick = "[GetScriptedGui('bag_wtp_cm_press_all').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}

				# **Снос лишнего по всему плану.**
				button_regular = {
					size = { 44 42 }
					tooltip = "bag_wtp_raze_all_tt"
					icon = {
						size = { 26 26 }
						parentanchor = center
						widgetanchor = center
						texture = "gfx/interface/icons/flat_icons/disable_icon.dds"
					}
					onclick = "[GetScriptedGui('bag_wtp_raze_press_all').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}

				button_regular = {
					size = { 150 42 }
					tooltip = "bag_wtp_plan_refresh_tt"
					text_single = {
						size = { 116 26 }
						parentanchor = center
						widgetanchor = center
						autoresize = no
						maximumsize = { 116 26 }
						fontsize = 13
						fontsize_min = 10
						align = center|nobaseline
						elide = right
						text = "bag_wtp_plan_refresh"
					}
					onclick = "[GetScriptedGui('bag_wtp_plan_refresh').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}

				# **«Сохранить план», here and not only in the editor**, because
				# this is the window a finished plan is looked at in and he
				# asked for it here by name: «Сделай кнопку "сохранить план" в
				# окне результата планов "на сейчас" и "На конец".» One button
				# per slot, three of them, because a single slot meant that
				# planning other ground threw the kept plan away -- «я проебу
				# свой сохранённый план, если захочу посмотреть какой-то план
				# на другой земле».
				#
				# The mode is not a second window: «на сейчас» and «на конец»
				# are one switch on the settings page and one plan on the map,
				# so a slot holds whichever of the two was last run and the
				# label on it says how many buildings that was.
				widget = {
					size = { 300 42 }
					alwaystransparent = no
					tooltip = "bag_wtp_edit_store_tt"

					hbox = {
						parentanchor = left|vcenter
						widgetanchor = left|vcenter
						spacing = 3

						text_single = {
							size = { 74 34 }
							autoresize = no
							maximumsize = { 74 34 }
							align = right|vcenter
							fontsize = 12
							elide = right
							text = "bag_wtp_plan_save_head"
						}

						button_regular = {
							size = { 70 34 }
							tooltip = "[GetPlayer.Custom('bag_wtp_edit_slot1_label')]"
							text_single = {
								size = { 62 26 }
								parentanchor = center
								widgetanchor = center
								autoresize = no
								maximumsize = { 62 26 }
								fontsize = 13
								fontsize_min = 10
								align = center|nobaseline
								elide = right
								text = "bag_wtp_plan_save_slot1"
							}
							onclick = "[GetScriptedGui('bag_wtp_edit_slot_save_1').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}

						button_regular = {
							size = { 70 34 }
							tooltip = "[GetPlayer.Custom('bag_wtp_edit_slot2_label')]"
							text_single = {
								size = { 62 26 }
								parentanchor = center
								widgetanchor = center
								autoresize = no
								maximumsize = { 62 26 }
								fontsize = 13
								fontsize_min = 10
								align = center|nobaseline
								elide = right
								text = "bag_wtp_plan_save_slot2"
							}
							onclick = "[GetScriptedGui('bag_wtp_edit_slot_save_2').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}

						button_regular = {
							size = { 70 34 }
							tooltip = "[GetPlayer.Custom('bag_wtp_edit_slot3_label')]"
							text_single = {
								size = { 62 26 }
								parentanchor = center
								widgetanchor = center
								autoresize = no
								maximumsize = { 62 26 }
								fontsize = 13
								fontsize_min = 10
								align = center|nobaseline
								elide = right
								text = "bag_wtp_plan_save_slot3"
							}
							onclick = "[GetScriptedGui('bag_wtp_edit_slot_save_3').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						
						# **The slack goes here, not between the children.** A box given
						# more room than its children need spreads the difference across
						# them: the count and the icons drifted apart until the icon sat
						# between two columns — «куда-то между столбцами воткнулась иконка
						# товара», 2026-09-06. An expanding child takes it all instead.
						widget = { layoutpolicy_horizontal = expanding size = { -1 42 } }
					}
				}

				# And the door to the editor, from the window the plan is in.
				button_regular = {
					size = { 150 42 }
					tooltip = "bag_wtp_edit_open_tt"
					text_single = {
						size = { 116 26 }
						parentanchor = center
						widgetanchor = center
						autoresize = no
						maximumsize = { 116 26 }
						fontsize = 13
						fontsize_min = 10
						align = center|nobaseline
						elide = right
						text = "bag_wtp_edit_open_button"
					}
					onclick = "[GetScriptedGui('bag_wtp_open_edit_window').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}

				button_regular = {
					size = { 150 42 }
					tooltip = "bag_wtp_clear_all_tt"
					text_single = {
						size = { 116 26 }
						parentanchor = center
						widgetanchor = center
						autoresize = no
						maximumsize = { 116 26 }
						fontsize = 13
						fontsize_min = 10
						align = center|nobaseline
						elide = right
						text = "bag_wtp_clear_all"
					}
					onclick = "[GetScriptedGui('bag_wtp_clear_all').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
			}

			# The pass, in numbers. Every one of them is counted by the pass
			# itself, and the first zero among them is the diagnosis: an effect
			# that merely does nothing logs nothing at all, and this is the one
			# place a failure is visible without asking for a log.
			# A fixed width and not an expanding one: an expanding child inside a
			# parent that has a size of its own comes out at zero and elides to
			# nothing, which reads exactly like a variable that failed to print
			# (`docs/pitfalls/interface.md`).
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 8

				text_single = {
					size = { 900 22 }
					maximumsize = { 900 22 }
					autoresize = no
					align = left|vcenter
					fontsize = 13
					elide = right
					text = "bag_wtp_plan_pass_summary"
					tooltip = "bag_wtp_plan_pass_tt"
				}

				# **Каким режимом посчитано то, что на экране.** Два режима
				# плана рисуют одни и те же строки, и без этой пометки
				# «специализация» и «Пересчитать» на одной земле различались бы
				# только числами, которые надо помнить.
				text_single = {
					size = { 210 22 }
					maximumsize = { 210 22 }
					autoresize = no
					align = left|vcenter
					fontsize = 13
					elide = right
					visible = "[GetGlobalVariable('bag_wtp_spec_ran').IsSet]"
					text = "bag_wtp_plan_mode_spec"
					tooltip = "bag_wtp_plan_mode_spec_tt"
				}

				# **How many provinces the plan touched, beside the switch that
				# folds them.** Drawn only while folded, because a count of
				# provinces above a list of locations answers nothing.
				text_single = {
					size = { 300 22 }
					maximumsize = { 300 22 }
					autoresize = no
					align = left|vcenter
					fontsize = 13
					elide = right
					visible = "[GetPlayer.MakeScope.GetVariable('bag_wtp_plan_folded').IsSet]"
					text = "bag_wtp_plan_provs_head"
					tooltip = "bag_wtp_plan_fold_tt"
				}

				widget = { layoutpolicy_horizontal = expanding size = { -1 22 } }

				# **Сводка по товарам — иконкой, рядом с числами прохода.** Его
				# просьба 2026-09-07: «добавь мне в окно плана какую-нить
				# небольшую иконку, которая будет мне открывать окно с подробной
				# информацией». Она стоит здесь, а не среди кнопок выше, потому
				# что читает ровно то, о чём говорит эта строка, — что прошлый
				# расчёт положил.
				#
				# **`@production_panel!` — texticon самой игры**, а не выдуманный
				# глиф: он стоит в её собственной локализации 24 раза. Глиф,
				# которого нет в шрифте, рисуется квадратом, и это уже стоило
				# этому моду ста ключей (`docs/pitfalls/localization.md`).
				button_regular = {
					size = { 34 26 }
					tooltip = "bag_wtp_sum_open_tt"
					text_single = {
						parentanchor = center
						widgetanchor = center
						autoresize = yes
						fontsize = 16
						text = "bag_wtp_sum_open"
					}
					onclick = "[GetScriptedGui('bag_wtp_open_summary_window').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}

				checkbutton_round_alt = {
					size = { 24 24 }
					down = "[GetPlayer.MakeScope.GetVariable('bag_wtp_plan_folded').IsSet]"
					tooltip = "bag_wtp_plan_fold_tt"
					onclick = "[GetScriptedGui('bag_wtp_plan_fold_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}

				text_single = {
					size = { 140 22 }
					maximumsize = { 140 22 }
					autoresize = no
					align = left|vcenter
					fontsize = 13
					elide = right
					text = "bag_wtp_plan_fold"
					tooltip = "bag_wtp_plan_fold_tt"
				}
			}

			text_multi = {
				layoutpolicy_horizontal = expanding
				autoresize = yes
				maximumsize = { 1590 60 }
				align = center
				visible = "[And(Not(DataModelHasItems(GetGlobalList('bag_wtp_plan_results'))), Not(DataModelHasItems(GetGlobalList('bag_wtp_plan_provs'))))]"
				text = "bag_wtp_plan_window_empty"
			}

			# The page bar. The window's datamodel is what a scripted widget
			# costs, so it holds one page of 150 rows -- but the plan builds
			# over the whole ground, and cutting the answer at the window's
			# capacity is what made «показано всего 150 локаций» read as the
			# plan stopping short. The rows are all ranked; these two buttons
			# choose which of them the datamodel gets, and re-plan nothing.
			#
			# **The buttons carry words and not arrow glyphs.** Of ◄ ► ← ‹ ›
			# the game's own localization uses none — only → appears in it at
			# all — so nothing says the font carries them, and a glyph it does
			# not carry is a box on a button.
			#
			# **Drawn only where there is more than one page**, and the test is
			# a country variable rather than a number: `bag_wtp_plan_paged` is
			# set by `bag_wtp_plan_show` and `.IsSet` is the one question a
			# `visible` can ask without a data function of its own.
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 8
				visible = "[And(GetPlayer.MakeScope.GetVariable('bag_wtp_plan_paged').IsSet, Not(GetPlayer.MakeScope.GetVariable('bag_wtp_plan_folded').IsSet))]"

				button_regular = {
					size = { 96 28 }
					tooltip = "bag_wtp_plan_page_prev_tt"
					text_single = {
						size = { 84 22 }
						parentanchor = center
						widgetanchor = center
						autoresize = no
						maximumsize = { 84 22 }
						fontsize = 13
						fontsize_min = 10
						align = center|nobaseline
						elide = right
						text = "bag_wtp_plan_page_prev"
					}
					onclick = "[GetScriptedGui('bag_wtp_plan_page_prev').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}

				# A fixed width and not an expanding one: an expanding child
				# inside a parent that has a size of its own comes out at zero
				# and elides to nothing (`docs/pitfalls/interface.md`).
				text_single = {
					size = { 380 28 }
					maximumsize = { 380 28 }
					autoresize = no
					align = left|vcenter
					fontsize = 13
					elide = right
					text = "bag_wtp_plan_page_label"
					tooltip = "bag_wtp_plan_page_tt"
				}

				button_regular = {
					size = { 96 28 }
					tooltip = "bag_wtp_plan_page_next_tt"
					text_single = {
						size = { 84 22 }
						parentanchor = center
						widgetanchor = center
						autoresize = no
						maximumsize = { 84 22 }
						fontsize = 13
						fontsize_min = 10
						align = center|nobaseline
						elide = right
						text = "bag_wtp_plan_page_next"
					}
					onclick = "[GetScriptedGui('bag_wtp_plan_page_next').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				margin_left = 10
				spacing = 0
				visible = "[DataModelHasItems(GetGlobalList('bag_wtp_plan_results'))]"

				text_single = {
					size = { 38 24 }
					autoresize = no
					align = center|vcenter
					fontsize = 13
					text = "bag_wtp_plan_head_rank"
				}
				text_single = {
					size = { 92 24 }
					autoresize = no
					align = center|vcenter
					fontsize = 13
					text = "bag_wtp_plan_head_rank_kind"
					tooltip = "bag_wtp_plan_rank_button_tt"
				}
				widget = { size = { 26 24 } }
				text_single = {
					size = { 154 24 }
					autoresize = no
					align = left|vcenter
					fontsize = 13
					text = "bag_wtp_plan_head_location"
				}
				widget = { size = { 6 24 } }
				text_single = {
					size = { 130 24 }
					autoresize = no
					align = left|vcenter
					fontsize = 13
					text = "bag_wtp_plan_head_province"
				}
				widget = { size = { 6 24 } }
				text_single = {
					size = { 100 24 }
					autoresize = no
					align = left|vcenter
					fontsize = 13
					text = "bag_wtp_plan_head_area"
				}
				widget = { size = { 6 24 } }
				text_single = {
					size = { 56 24 }
					autoresize = no
					align = center|vcenter
					fontsize = 13
					text = "bag_wtp_plan_head_load"
					tooltip = "bag_wtp_plan_load_tt"
				}
				widget = { size = { 6 24 } }
				text_single = {
					size = { 30 24 }
					autoresize = no
					align = left|vcenter
					fontsize = 13
					text = "bag_wtp_plan_head_rgo"
				}
				widget = { size = { 6 24 } }
				text_single = {
					size = { 150 24 }
					autoresize = no
					align = left|vcenter
					fontsize = 13
					text = "bag_wtp_plan_head_right"
					tooltip = "bag_wtp_plan_right_tt"
				}
				widget = { size = { 6 24 } }
				text_single = {
					size = { 260 24 }
					autoresize = no
					maximumsize = { 260 24 }
					align = left|vcenter
					fontsize = 13
					text = "bag_wtp_plan_head_goods"
				}
				widget = { layoutpolicy_horizontal = expanding size = { -1 24 } }
			}

			scrollbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				blockoverride "scrollbox_content" {
					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = preferred
						margin = { 10 8 }
						margin_right = 20
						spacing = 3
						ignoreinvisible = yes

						# **Two lists, one drawn.** A datamodel item sees one
						# scope, so a province row and a location row cannot be
						# the same row. The flat list is untouched — it is what
						# he has read since the plan existed — and the fold is a
						# switch beside it.
						vbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = preferred
							spacing = 3
							visible = "[Not(GetPlayer.MakeScope.GetVariable('bag_wtp_plan_folded').IsSet)]"
							datamodel = "[GetGlobalList('bag_wtp_plan_results')]"
							item = {
								bag_wtp_plan_entry = {
									datacontext = "[Scope.GetLocation]"
								}
							}
						}

						vbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = preferred
							spacing = 3
							visible = "[GetPlayer.MakeScope.GetVariable('bag_wtp_plan_folded').IsSet]"
							datamodel = "[GetGlobalList('bag_wtp_plan_provs')]"
							item = {
								bag_wtp_plan_prov_entry = {
									datacontext = "[Scope.GetLocation]"
								}
							}
						}
					}
				}
			}
		}
	}
}
