# The rights window: the same ranked provinces, answering for a whole urban
# right instead of for one good.
#
# It is a second window rather than a third line on the first, because it is a
# different question with a different unit. A row here is the bundle -- two or
# three goods, each with its own best method and its own bonus -- and the number
# it is ranked on is what one level of all of them would earn, market prices
# included. `docs/investigations/town_rights.md` is why that has to be a price
# and not a count of things made.
#
# What it shares with `bag_wtp_result_window.gui` it does not redeclare: the
# picker footer, the goods text icon and the expanded location row are types in
# that file and types are global. The two windows also share the ranked list,
# the map pickers and the live re-rank; only one is ever open, because only one
# of a good and a right can be ticked.

types BagWtpRightTypes {

	# One good of the right's bundle: which good, its best method here, the bonus
	# that method earns, and the raw materials the bonus is made of. Three of
	# these make a province row and each hides itself when its slot is empty --
	# a right favours one, two or three goods and the widest in the game is three.
	#
	# Written out three times rather than once with a parameter: no `.gui` in the
	# game or in CMF contains a `$` at all, so a type takes no arguments here.
	type bag_wtp_right_slot_1 = hbox {
		layoutpolicy_horizontal = expanding
		size = { -1 28 }
		spacing = 0
		visible = "[Location.MakeScope.GetVariable('bag_wtp_r_bt_1').IsSet]"

		text_single = {
			size = { 118 28 }
			autoresize = no
			maximumsize = { 118 28 }
			align = left|vcenter
			elide = right
			fontsize = 13
			text = "bag_wtp_right_good_1"
		}

		text_single = {
			size = { 70 28 }
			autoresize = no
			maximumsize = { 70 28 }
			align = left|vcenter
			text = "bag_wtp_right_bonus_1"
			tooltip = "bag_wtp_result_bonus_tt"
		}

		widget = { size = { 10 28 } }

		# Fixed, so the columns after it sit in the same place as their headers
		# -- an expanding column is as wide as what is left, and a row inside a
		# scrollbox has less left than the header does.
		text_single = {
			size = { 470 28 }
			maximumsize = { 470 28 }
			autoresize = no
			align = left|vcenter
			elide = right
			text = "bag_wtp_right_method_1"
			tooltip = "bag_wtp_result_method_tt"
		}

		# «Из чего», pinned to the left edge of its column.
		#
		# **A plain `widget`, not an hbox.** An hbox given a width spreads its
		# children across it: the count and the icons drifted apart, and the pair
		# of them sat centred in a column whose header is left-aligned. A `widget`
		# places its children where their anchor says, and the hbox inside it has
		# no width of its own, so it hugs what it holds.
		widget = {
			size = { 44 28 }
			alwaystransparent = no
			tooltip = "bag_wtp_result_goods_tt"

			text_single = {
				size = { 40 28 }
				parentanchor = left|vcenter
				widgetanchor = left|vcenter
				autoresize = no
				maximumsize = { 40 28 }
				align = left|vcenter
				fontsize = 13
				text = "bag_wtp_right_goods_count_1"
			}
		}

		widget = { size = { 4 28 } }

		widget = {
			size = { 62 28 }
			alwaystransparent = no
			tooltip = "bag_wtp_result_goods_tt"

			hbox = {
				parentanchor = left|vcenter
				widgetanchor = left|vcenter
				spacing = 1
				datamodel = "[Location.MakeScope.GetList('bag_wtp_r_goods_1')]"
				item = {
				bag_wtp_result_goods_entry = {
				datacontext = "[Scope.GetGoods]"
				}
				}
			}
		}

		widget = { size = { 12 28 } }
		widget = { layoutpolicy_horizontal = expanding size = { -1 28 } }
	}

	# One good of the right's bundle: which good, its best method here, the bonus
	# that method earns, and the raw materials the bonus is made of. Three of
	# these make a province row and each hides itself when its slot is empty --
	# a right favours one, two or three goods and the widest in the game is three.
	#
	# Written out three times rather than once with a parameter: no `.gui` in the
	# game or in CMF contains a `$` at all, so a type takes no arguments here.
	type bag_wtp_right_slot_2 = hbox {
		layoutpolicy_horizontal = expanding
		size = { -1 28 }
		spacing = 0
		visible = "[Location.MakeScope.GetVariable('bag_wtp_r_bt_2').IsSet]"

		text_single = {
			size = { 118 28 }
			autoresize = no
			maximumsize = { 118 28 }
			align = left|vcenter
			elide = right
			fontsize = 13
			text = "bag_wtp_right_good_2"
		}

		text_single = {
			size = { 70 28 }
			autoresize = no
			maximumsize = { 70 28 }
			align = left|vcenter
			text = "bag_wtp_right_bonus_2"
			tooltip = "bag_wtp_result_bonus_tt"
		}

		widget = { size = { 10 28 } }

		# Fixed, so the columns after it sit in the same place as their headers
		# -- an expanding column is as wide as what is left, and a row inside a
		# scrollbox has less left than the header does.
		text_single = {
			size = { 470 28 }
			maximumsize = { 470 28 }
			autoresize = no
			align = left|vcenter
			elide = right
			text = "bag_wtp_right_method_2"
			tooltip = "bag_wtp_result_method_tt"
		}

		# «Из чего», pinned to the left edge of its column.
		#
		# **A plain `widget`, not an hbox.** An hbox given a width spreads its
		# children across it: the count and the icons drifted apart, and the pair
		# of them sat centred in a column whose header is left-aligned. A `widget`
		# places its children where their anchor says, and the hbox inside it has
		# no width of its own, so it hugs what it holds.
		widget = {
			size = { 44 28 }
			alwaystransparent = no
			tooltip = "bag_wtp_result_goods_tt"

			text_single = {
				size = { 40 28 }
				parentanchor = left|vcenter
				widgetanchor = left|vcenter
				autoresize = no
				maximumsize = { 40 28 }
				align = left|vcenter
				fontsize = 13
				text = "bag_wtp_right_goods_count_2"
			}
		}

		widget = { size = { 4 28 } }

		widget = {
			size = { 62 28 }
			alwaystransparent = no
			tooltip = "bag_wtp_result_goods_tt"

			hbox = {
				parentanchor = left|vcenter
				widgetanchor = left|vcenter
				spacing = 1
				datamodel = "[Location.MakeScope.GetList('bag_wtp_r_goods_2')]"
				item = {
				bag_wtp_result_goods_entry = {
				datacontext = "[Scope.GetGoods]"
				}
				}
			}
		}

		widget = { size = { 12 28 } }
		widget = { layoutpolicy_horizontal = expanding size = { -1 28 } }
	}

	# One good of the right's bundle: which good, its best method here, the bonus
	# that method earns, and the raw materials the bonus is made of. Three of
	# these make a province row and each hides itself when its slot is empty --
	# a right favours one, two or three goods and the widest in the game is three.
	#
	# Written out three times rather than once with a parameter: no `.gui` in the
	# game or in CMF contains a `$` at all, so a type takes no arguments here.
	type bag_wtp_right_slot_3 = hbox {
		layoutpolicy_horizontal = expanding
		size = { -1 28 }
		spacing = 0
		visible = "[Location.MakeScope.GetVariable('bag_wtp_r_bt_3').IsSet]"

		text_single = {
			size = { 118 28 }
			autoresize = no
			maximumsize = { 118 28 }
			align = left|vcenter
			elide = right
			fontsize = 13
			text = "bag_wtp_right_good_3"
		}

		text_single = {
			size = { 70 28 }
			autoresize = no
			maximumsize = { 70 28 }
			align = left|vcenter
			text = "bag_wtp_right_bonus_3"
			tooltip = "bag_wtp_result_bonus_tt"
		}

		widget = { size = { 10 28 } }

		# Fixed, so the columns after it sit in the same place as their headers
		# -- an expanding column is as wide as what is left, and a row inside a
		# scrollbox has less left than the header does.
		text_single = {
			size = { 470 28 }
			maximumsize = { 470 28 }
			autoresize = no
			align = left|vcenter
			elide = right
			text = "bag_wtp_right_method_3"
			tooltip = "bag_wtp_result_method_tt"
		}

		# «Из чего», pinned to the left edge of its column.
		#
		# **A plain `widget`, not an hbox.** An hbox given a width spreads its
		# children across it: the count and the icons drifted apart, and the pair
		# of them sat centred in a column whose header is left-aligned. A `widget`
		# places its children where their anchor says, and the hbox inside it has
		# no width of its own, so it hugs what it holds.
		widget = {
			size = { 44 28 }
			alwaystransparent = no
			tooltip = "bag_wtp_result_goods_tt"

			text_single = {
				size = { 40 28 }
				parentanchor = left|vcenter
				widgetanchor = left|vcenter
				autoresize = no
				maximumsize = { 40 28 }
				align = left|vcenter
				fontsize = 13
				text = "bag_wtp_right_goods_count_3"
			}
		}

		widget = { size = { 4 28 } }

		widget = {
			size = { 62 28 }
			alwaystransparent = no
			tooltip = "bag_wtp_result_goods_tt"

			hbox = {
				parentanchor = left|vcenter
				widgetanchor = left|vcenter
				spacing = 1
				datamodel = "[Location.MakeScope.GetList('bag_wtp_r_goods_3')]"
				item = {
				bag_wtp_result_goods_entry = {
				datacontext = "[Scope.GetGoods]"
				}
				}
			}
		}

		widget = { size = { 12 28 } }
		widget = { layoutpolicy_horizontal = expanding size = { -1 28 } }
	}

	# One province: the bundle, one line per good, and its locations under it once
	# expanded. 116 tall so three lines at 28 fit -- a `widget` does not size
	# itself to its child, which is what collapsed the first window's rows into
	# each other on the tenth run, so every height here is a number.
	type bag_wtp_right_province_entry = vbox {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = preferred
		spacing = 2

		widget = {
			layoutpolicy_horizontal = expanding
			size = { -1 116 }
			using = bg_paper_card

			hbox = {
				layoutpolicy_horizontal = expanding
				size = { -1 116 }
				spacing = 0

				widget = {
					size = { 38 116 }
					button_square_plus = {
						size = { 26 26 }
						parentanchor = center
						widgetanchor = center
						visible = "[Not(Location.MakeScope.GetVariable('bag_wtp_res_expanded').IsSet)]"
						tooltip = "bag_wtp_result_expand_tt"
						onclick = "[GetScriptedGui('bag_wtp_result_expand').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_location', Location.MakeScope).End)]"
					}
					button_square_minus = {
						size = { 26 26 }
						parentanchor = center
						widgetanchor = center
						visible = "[Location.MakeScope.GetVariable('bag_wtp_res_expanded').IsSet]"
						tooltip = "bag_wtp_result_collapse_tt"
						onclick = "[GetScriptedGui('bag_wtp_result_collapse').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_location', Location.MakeScope).End)]"
					}
				}

				text_single = {
					size = { 34 116 }
					autoresize = no
					maximumsize = { 34 116 }
					align = left|vcenter
					fontsize = 13
					text = "bag_wtp_result_rank_value"
					tooltip = "bag_wtp_result_rank_tt"
				}

				text_single = {
					size = { 160 116 }
					autoresize = no
					maximumsize = { 160 116 }
					align = left|vcenter
					elide = right
					text = "[Location.GetProvinceDefinition.GetName]"
					tooltip = "bag_wtp_result_province_tt"
				}

				text_single = {
					size = { 110 116 }
					autoresize = no
					maximumsize = { 110 116 }
					align = left|vcenter
					elide = right
					fontsize = 13
					text = "[Location.GetArea.GetNameWithNoTooltip]"
				}

				# **Пригодность земли под эту грамоту -- тем же числом, что и на
				# карте.** Это `_rq<k>`, среднее покрытий связки; строка и карта
				# обязаны сходиться, и он этим их сверяет.
				text_single = {
					size = { 78 116 }
					autoresize = no
					maximumsize = { 78 116 }
					align = left|vcenter
					text = "bag_wtp_right_fit_value"
					tooltip = "bag_wtp_right_fit_tt"
				}

				# What the whole bundle would earn a level here, which is what the
				# rows are ranked on.
				text_single = {
					size = { 78 116 }
					autoresize = no
					maximumsize = { 78 116 }
					align = left|vcenter
					text = "bag_wtp_right_total_value"
					tooltip = "bag_wtp_right_total_tt"
				}

				widget = { size = { 10 116 } }

				vbox = {
					layoutpolicy_horizontal = expanding
					size = { -1 116 }
					spacing = 2
					ignoreinvisible = yes

					bag_wtp_right_slot_1 = {}
					bag_wtp_right_slot_2 = {}
					bag_wtp_right_slot_3 = {}
				}
			}
		}

		vbox = {
			visible = "[Location.MakeScope.GetVariable('bag_wtp_res_expanded').IsSet]"
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = preferred
			ignoreinvisible = yes
			margin_left = 20
			datamodel = "[Location.GetProvinceDefinition.GetLocations]"
			item = { bag_wtp_result_location_entry = {} }
		}
	}
}

window = {
	name = "bag_wtp_right_window"
	datacontext = "[GetPlayer]"
	allow_outside = yes
	alwaystransparent = no
	parentanchor = center
	widgetanchor = center
	position = { 0 0 }
	movable = yes
	size = { 1380 900 }
	using = bg_window_default_alt

	visible = "[GetPlayer.MakeScope.GetVariable('bag_wtp_right_open').IsSet]"
	enabled = "[GetPlayer.MakeScope.GetVariable('bag_wtp_right_open').IsSet]"

	# **Форма окна взята у самой игры, а не придумана.** `ai_settings_menu.gui` —
	# свободное окно ровно этого вида: `size` и `using = bg_window_default_alt`
	# стоят **на самом `window`**, а `vbox` лежит в нём напрямую. У нас между ними
	# был лишний `widget` со своим размером, и шапка, оказавшись внутри него,
	# держала ширину своего типа, что бы ни делало окно. «Злоебучая шапка окна
	# снова не расширилась вместе с окном» — 2026-09-06, и это третий раз.
	#
	# **Тип `window_header_alt` не объявлен нигде в `reference/`**, так что читать,
	# что держит его ширину, отсюда нечем. Поэтому здесь не догадка о шапке, а
	# копия структуры окна, которое в игре работает.

	widget = {
		parentanchor = right
		position = { -5 5 }
		size = { 40 40 }
		ui_direction_button_holder_right = {}
		button_close_alt = {
			blockoverride "close_on_action" {
				on_action = "[GetScriptedGui('bag_wtp_close_result_window').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
		}
	}

	vbox = {
		using = window_margin_alt

		# **`layoutpolicy_horizontal = expanding` on the header, and every window
		# of this mod was missing it.** «Злоебучая шапка окна снова не
		# расширилась вместе с окном» — 2026-09-06, and the third time he has
		# said it. The game's own windows all carry this line on their
		# `window_header_alt` (`multiplayer_lobby.gui`,
		# `automation_lateralview.gui`); without it the header keeps the type's
		# own width whatever the window does.
		window_header_alt = {
			blockoverride "header_text" { text = "bag_wtp_right_window_title" }
			blockoverride "window_header_alt_color_texture" { using = color_production_texture }
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			using = bg_secondary_inner_alt
			margin = { 12 12 }
			spacing = 6


			# The borders, picked here rather than in a window of their own. Each
			# button hands the game one of this mod's generic actions and the
			# game answers with its own target panel: a searchable list, the map
			# highlighted, and a click on the map picking the same thing a row
			# does. The actions toggle, so clicking is cumulative -- and every
			# pick re-ranks, so the table under these buttons is the answer for
			# the borders as they stand.
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 8

				action_button_regular = {
					size = { 138 34 }
					title = "bag_wtp_map_pick_area"
					description = "bag_wtp_map_pick_area_desc"
					actor = "[Player]"
					left_action = { action_name = "bag_wtp_select_area" }
					tooltip = "bag_wtp_map_pick_area_desc"
					text_single = {
						size = { 130 30 }
						parentanchor = center
						autoresize = no
						maximumsize = { 130 30 }
						fontsize = 14
						fontsize_min = 10
						align = center|nobaseline
						elide = right
						text = "bag_wtp_map_pick_area"
					}
				}

				action_button_regular = {
					size = { 138 34 }
					title = "bag_wtp_map_pick_province"
					description = "bag_wtp_map_pick_province_desc"
					actor = "[Player]"
					left_action = { action_name = "bag_wtp_select_province" }
					tooltip = "bag_wtp_map_pick_province_desc"
					text_single = {
						size = { 130 30 }
						parentanchor = center
						autoresize = no
						maximumsize = { 130 30 }
						fontsize = 14
						fontsize_min = 10
						align = center|nobaseline
						elide = right
						text = "bag_wtp_map_pick_province"
					}
				}

				action_button_regular = {
					size = { 138 34 }
					title = "bag_wtp_map_pick_location"
					description = "bag_wtp_map_pick_location_desc"
					actor = "[Player]"
					left_action = { action_name = "bag_wtp_select_location" }
					tooltip = "bag_wtp_map_pick_location_desc"
					text_single = {
						size = { 130 30 }
						parentanchor = center
						autoresize = no
						maximumsize = { 130 30 }
						fontsize = 14
						fontsize_min = 10
						align = center|nobaseline
						elide = right
						text = "bag_wtp_map_pick_location"
					}
				}

				action_button_regular = {
					size = { 138 34 }
					title = "bag_wtp_map_pick_market"
					description = "bag_wtp_map_pick_market_desc"
					actor = "[Player]"
					left_action = { action_name = "bag_wtp_select_market" }
					tooltip = "bag_wtp_map_pick_market_desc"
					text_single = {
						size = { 130 30 }
						parentanchor = center
						autoresize = no
						maximumsize = { 130 30 }
						fontsize = 14
						fontsize_min = 10
						align = center|nobaseline
						elide = right
						text = "bag_wtp_map_pick_market"
					}
				}

				# **«Выбрать мою землю» — his ask, 2026-09-06**, in the place of
				# the «только там, где здание может стоять» tick, which named
				# one thing and did another. This one says what it does: every
				# location the country owns, added to the selection. It is a
				# plain button and not a map action, because there is nothing
				# to click on the map — the answer is already known.
				button_regular = {
					size = { 138 34 }
					tooltip = "bag_wtp_pick_my_land_tt"
					text_single = {
						size = { 130 30 }
						parentanchor = center
						widgetanchor = center
						autoresize = no
						maximumsize = { 130 30 }
						fontsize = 14
						fontsize_min = 10
						align = center|nobaseline
						elide = right
						text = "bag_wtp_pick_my_land"
					}
					onclick = "[GetScriptedGui('bag_wtp_pick_my_land').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}

				widget = { layoutpolicy_horizontal = expanding size = { -1 34 } }

				# Two lines, and the lower one is a diagnostic on purpose: it
				# says how many locations the last pass walked, how many rows it
				# found, and how many times a pick has re-ranked since the game
				# loaded. A pick that does not move the third number never
				# reached the country's scope at all -- which is a failure that
				# writes nothing anywhere else.
				# 260, which is what the one line it replaces was: the three
				# buttons, this and «Очистить» already fill the row, and a
				# widget wider than the row it is in pushes the rest out of the
				# window rather than wrapping.
				vbox = {
					size = { 260 34 }
					spacing = 0

					text_single = {
						size = { 260 17 }
						autoresize = no
						maximumsize = { 260 17 }
						align = right|vcenter
						fontsize = 13
						fontsize_min = 10
						elide = right
						text = "bag_wtp_select_summary"
					}

					text_single = {
						size = { 260 17 }
						autoresize = no
						maximumsize = { 260 17 }
						align = right|vcenter
						fontsize = 12
						fontsize_min = 9
						elide = right
						text = "bag_wtp_result_pass_summary"
						tooltip = "bag_wtp_result_pass_tt"
					}
				}

				button_regular = {
					size = { 150 30 }
					tooltip = "bag_wtp_clear_all_tt"
					text_single = {
						size = { 142 26 }
						parentanchor = center
						widgetanchor = center
						autoresize = no
						maximumsize = { 142 26 }
						fontsize = 13
						fontsize_min = 10
						align = center|nobaseline
						elide = right
						text = "bag_wtp_clear_all"
					}
					onclick = "[GetScriptedGui('bag_wtp_clear_all').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
			}

			# ---- what to rank: one good, or one urban right ------------
			#
			# **This was the «Товар» tab of the mod's own settings page until
			# 2026-09-06**, four CMM lists of it: «просто добавишь в окно
			# расчёта иконки товаров и прав как ты это сделал в редакторе и
			# поставишь каждому кружочек для активации нужного, далее кнопку
			# искать локации, всё».
			#
			# **Both ranking windows draw the same rows**, declared once in
			# `bag_wtp_pick_cells.gui`, so the two can never come to offer
			# different goods -- and a press in either lands in the other,
			# because choosing a right is choosing the other window.
			#
			# **Each block is a `vbox` pinned to the top of a plain `widget`.**
			# An hbox centres its children on one another, so the shorter
			# block's heading sat above the taller one's and the two titles
			# were on different lines — he reported exactly that, 2026-09-06.
			# A fixed box with a top anchor holds both headings on one line
			# whatever the blocks weigh.
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 8

				widget = {
					size = { 746 236 }

					vbox = {
						parentanchor = top|left
						widgetanchor = top|left
						spacing = 2

						text_single = {
							size = { 746 20 }
							autoresize = no
							maximumsize = { 746 20 }
							align = left|vcenter
							fontsize = 13
							elide = right
							text = "bag_wtp_pick_goods_head"
							tooltip = "bag_wtp_pick_goods_tt"
						}

						bag_wtp_pick_row1 = {}
						bag_wtp_pick_row2 = {}
						bag_wtp_pick_row3 = {}
						bag_wtp_pick_row4 = {}
						bag_wtp_pick_row5 = {}

						# The slack goes here, not between the rows.
						widget = { layoutpolicy_vertical = expanding size = { 746 -1 } }
					}
				}

				widget = {
					size = { 504 236 }

					vbox = {
						parentanchor = top|left
						widgetanchor = top|left
						spacing = 2

						text_single = {
							size = { 504 20 }
							autoresize = no
							maximumsize = { 504 20 }
							align = left|vcenter
							fontsize = 13
							elide = right
							text = "bag_wtp_pick_rights_head"
							tooltip = "bag_wtp_pick_rights_tt"
						}

						# **Two columns, each packing upward and each pinned to
						# the top.** An `hbox` centres its children on one
						# another, so a column of three sat a row and a half
						# below a column of six — «во втором столбце прав
						# пропуск в 1 строке, вместо например 2 пропусков в
						# конце», 2026-09-06. A plain `widget` of a fixed
						# height with the column anchored top is what puts
						# every gap at the bottom, where he wants them.
						hbox = {
							spacing = 4

							widget = {
								size = { 250 210 }
								bag_wtp_pick_right_col1 = {
									parentanchor = top|left
									widgetanchor = top|left
								}
							}

							widget = {
								size = { 250 210 }
								bag_wtp_pick_right_col2 = {
									parentanchor = top|left
									widgetanchor = top|left
								}
							}
						}

						# The slack goes here, not between the blocks.
						widget = { layoutpolicy_vertical = expanding size = { 504 -1 } }
					}
				}

				widget = { layoutpolicy_horizontal = expanding size = { -1 20 } }
			}

			# ---- how to rank it, and the press that does ----------------
			#
			# **The switch does not re-rank by itself.** It did for one
			# build, and his verdict was that it should not: «снимаю галочку
			# — жму пересчитать — получаю результат… я считаю так и должно
			# быть». So this only decides what the next «Искать локации»
			# answers, exactly like the plan window's twin.
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 8

				widget = {
					size = { 28 34 }
					checkbutton_round_alt = {
						size = { 24 24 }
						parentanchor = center
						widgetanchor = center
						down = "[GetGlobalVariable('bag_wtp_rank_by_end').IsSet]"
						tooltip = "bag_wtp_search_by_end_tt"
						onclick = "[GetScriptedGui('bag_wtp_toggle_by_end').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					}
				}

				text_single = {
					size = { 210 34 }
					autoresize = no
					maximumsize = { 210 34 }
					align = left|vcenter
					fontsize = 13
					fontsize_min = 10
					elide = right
					text = "bag_wtp_search_by_end"
					tooltip = "bag_wtp_search_by_end_tt"
				}

				widget = { layoutpolicy_horizontal = expanding size = { -1 34 } }

				# The pass itself. It opens the answer as well, because the
				# answer may belong to the other window: a good and a right
				# draw different rows.
				button_regular = {
					size = { 220 38 }
					tooltip = "bag_wtp_search_run_tt"
					text_single = {
						size = { 206 28 }
						parentanchor = center
						widgetanchor = center
						autoresize = no
						maximumsize = { 206 28 }
						fontsize = 14
						fontsize_min = 10
						align = center|nobaseline
						elide = right
						text = "bag_wtp_search_run"
					}
					onclick = "[GetScriptedGui('bag_wtp_search_run').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
			}

			# Nothing computed yet, or nothing survived the filters. Without this
			# the window is an empty box and says nothing about why.
			text_multi = {
				layoutpolicy_horizontal = expanding
				autoresize = yes
				maximumsize = { 1270 60 }
				align = center
				visible = "[Not(DataModelHasItems(GetGlobalList('bag_wtp_right_results')))]"
				text = "bag_wtp_right_window_empty"
			}

			# 48, not 38: the rows below sit inside a scrollbox whose content
			# carries a 10px margin, and the header does not.
			hbox = {
				layoutpolicy_horizontal = expanding
				margin_left = 10
				spacing = 0
				visible = "[DataModelHasItems(GetGlobalList('bag_wtp_right_results'))]"

				# The column the +/- buttons live in. It had no heading and the
				# empty corner read as a column out of line rather than as a
				# column without a name. `margin_left` drops from 48 to 10 --
				# the scrollbox's own content margin -- and this 38 makes the
				# difference back up, so «№» has not moved a pixel.
				text_single = {
					size = { 38 24 }
					autoresize = no
					align = center|vcenter
					fontsize = 13
					text = "bag_wtp_result_head_expand"
				}
				text_single = {
					size = { 34 24 }
					autoresize = no
					align = left|vcenter
					fontsize = 13
					text = "bag_wtp_result_head_rank"
				}
				text_single = {
					size = { 160 24 }
					autoresize = no
					align = left|vcenter
					fontsize = 13
					text = "bag_wtp_result_head_province"
				}
				text_single = {
					size = { 110 24 }
					autoresize = no
					align = left|vcenter
					fontsize = 13
					text = "bag_wtp_result_head_area"
				}
				text_single = {
					size = { 78 24 }
					autoresize = no
					align = left|vcenter
					fontsize = 13
					text = "bag_wtp_right_head_fit"
				}

				text_single = {
					size = { 78 22 }
					autoresize = no
					maximumsize = { 78 22 }
					align = left|vcenter
					text = "bag_wtp_right_head_total"
				}
				widget = { size = { 10 24 } }
				text_single = {
					size = { 118 24 }
					autoresize = no
					align = left|vcenter
					fontsize = 13
					text = "bag_wtp_right_head_good"
				}
				text_single = {
					size = { 70 24 }
					autoresize = no
					align = left|vcenter
					fontsize = 13
					text = "bag_wtp_result_head_bonus"
				}
				widget = { size = { 10 24 } }
				text_single = {
					size = { 470 24 }
					autoresize = no
					maximumsize = { 470 24 }
					align = left|vcenter
					fontsize = 13
					text = "bag_wtp_result_head_method"
				}
				# **The count has a column of its own, and that was his fix**,
				# 2026-09-06: «просто символам 1/2 нужен свой столбик и тогда
				# проблем не возникнет». Two things sharing one column is what
				# let the icon wander into the gap between columns.
				text_single = {
					size = { 44 24 }
					autoresize = no
					maximumsize = { 44 24 }
					align = left|vcenter
					fontsize = 13
					fontsize_min = 10
					elide = right
					text = "bag_wtp_result_head_supply"
					tooltip = "bag_wtp_result_goods_tt"
				}
				widget = { size = { 4 24 } }
				text_single = {
					size = { 62 24 }
					autoresize = no
					maximumsize = { 62 24 }
					align = left|vcenter
					fontsize = 13
					fontsize_min = 10
					elide = right
					text = "bag_wtp_result_head_goods"
					tooltip = "bag_wtp_result_goods_tt"
				}
				widget = { size = { 12 24 } }
				widget = { layoutpolicy_horizontal = expanding size = { -1 28 } }
			}

			scrollbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				blockoverride "scrollbox_content" {
					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = preferred
						margin = { 10 8 }
						margin_right = 20
						spacing = 3
						ignoreinvisible = yes
						datamodel = "[GetGlobalList('bag_wtp_right_results')]"
						item = {
							bag_wtp_right_province_entry = {
								datacontext = "[Scope.GetLocation]"
							}
						}
					}
				}
			}
		}
	}
}
