# Окно замены домика в одной локации.
#
# **Шестой пункт его списка, 2026-09-13.** «В каждой локации в окне редактора
# должна быть добавлена кнопочка замены. Жму кнопку и открывается окно
# конкретной локации. В нём показаны те домики, которые там стоят. Я могу
# нажать удалить на любой из них. На другой части окна мне показывается список
# домиков, которые я могу туда поставить.»
#
# **Оба списка -- списки зданий, и это не деталь.** Строка датамодели, которой
# дан тип здания, рисует значок и имя сама; товар пришлось бы переводить в
# здание картой переменных на локации. Слева -- `bag_wtp_row_builds`, тот самый
# список, которым рисуется строка плана; справа -- `bag_wtp_swap_can`, собранный
# `bag_wtp_swap_rebuild` по убыванию выгоды от РГО.
#
# **Ни одной своей кнопки сохранения.** «×» и «+» меняют план сразу же, теми же
# эффектами, что «−1» и «+1» редактора; «Готово» только закрывает. Так же, как
# и вся остальная правка в этом моде: отменять нечего, потому что каждое
# нажатие видно в строке плана в тот же миг.

types BagWtpSwapTypes {

	# Один домик, который тут стоит: значок, имя и «−».
	#
	# **Тип -- `widget` с размером, а не `hbox` с размером.** Размер на `hbox`
	# не держится: он подгоняется под детей, и ряд схлопывается вместе с ними
	# (`pitfalls/windows.md`). Первый заход написал оба ряда коробкой с
	# размером, и списки не нарисовались при верных числах в заголовках.
	type bag_wtp_swap_here_entry = widget {
		size = { 380 30 }
		using = bg_number_container_bckg

		hbox = {
			parentanchor = left|vcenter
			widgetanchor = left|vcenter
			spacing = 4

			widget = {
				size = { 30 30 }
				text_single = {
					parentanchor = center
					autoresize = yes
					fontsize = 16
					raw_text = "[BuildingType.GetIcon]"
					tooltip = "[BuildingType.GetName]"
				}
			}

			widget = {
				size = { 300 30 }
				text_single = {
					parentanchor = left|vcenter
					widgetanchor = left|vcenter
					size = { 300 30 }
					autoresize = no
					maximumsize = { 300 30 }
					align = left|vcenter
					fontsize = 13
					fontsize_min = 10
					elide = right
					raw_text = "[BuildingType.GetName]"
				}
			}

			widget = {
				size = { 34 30 }
				button_regular = {
					size = { 26 26 }
					parentanchor = center
					widgetanchor = center
					tooltip = "bag_wtp_swap_drop_tt"
					onclick = "[GetScriptedGui('bag_wtp_swap_drop').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_bt', BuildingType.MakeScope).End)]"
					text_single = {
						parentanchor = center
						widgetanchor = center
						autoresize = yes
						fontsize = 14
						text = "bag_wtp_edit_minus"
					}
				}
			}
		}
	}

	# Один домик, который сюда можно поставить: значок, имя и «+».
	type bag_wtp_swap_can_entry = widget {
		size = { 380 30 }
		using = bg_number_container_bckg

		hbox = {
			parentanchor = left|vcenter
			widgetanchor = left|vcenter
			spacing = 4

			widget = {
				size = { 30 30 }
				text_single = {
					parentanchor = center
					autoresize = yes
					fontsize = 16
					raw_text = "[BuildingType.GetIcon]"
					tooltip = "[BuildingType.GetName]"
				}
			}

			widget = {
				size = { 300 30 }
				text_single = {
					parentanchor = left|vcenter
					widgetanchor = left|vcenter
					size = { 300 30 }
					autoresize = no
					maximumsize = { 300 30 }
					align = left|vcenter
					fontsize = 13
					fontsize_min = 10
					elide = right
					raw_text = "[BuildingType.GetName]"
				}
			}

			widget = {
				size = { 34 30 }
				button_regular = {
					size = { 26 26 }
					parentanchor = center
					widgetanchor = center
					tooltip = "bag_wtp_swap_put_tt"
					onclick = "[GetScriptedGui('bag_wtp_swap_put').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_bt', BuildingType.MakeScope).End)]"
					text_single = {
						parentanchor = center
						widgetanchor = center
						autoresize = yes
						fontsize = 14
						text = "bag_wtp_edit_plus"
					}
				}
			}
		}
	}
}

window = {
	name = "bag_wtp_swap_window"
	datacontext = "[GetPlayer]"
	allow_outside = yes
	alwaystransparent = no
	parentanchor = center
	widgetanchor = center
	position = { 120 40 }
	movable = yes
	size = { 860 620 }
	using = bg_window_default_alt

	visible = "[GetPlayer.MakeScope.GetVariable('bag_wtp_swap_open').IsSet]"
	enabled = "[GetPlayer.MakeScope.GetVariable('bag_wtp_swap_open').IsSet]"

	widget = {
		parentanchor = right
		position = { -5 5 }
		size = { 40 40 }
		ui_direction_button_holder_right = {}
		button_close_alt = {
			blockoverride "close_on_action" {
				on_action = "[GetScriptedGui('bag_wtp_swap_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
		}
	}

	vbox = {
		using = window_margin_alt

		window_header_alt = {
			blockoverride "header_text" { text = "bag_wtp_swap_window_title" }
			blockoverride "window_header_alt_color_texture" { using = color_production_texture }
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			using = bg_secondary_inner_alt
			margin = { 12 12 }
			spacing = 6

			# **Скоуп нужен здесь только имени локации.** Оба списка окно
			# читает из глобальных (`GetGlobalList`), потому что три захода
			# подряд ряды не рисовались при верных числах в заголовках: число
			# стоит в этой коробке, рядом с `datacontext`, а `datamodel` — внутри
			# `blockoverride` у `scrollbox`, и что `datacontext` туда доходит,
			# в этом дереве ничем не доказано. Единственная работающая
			# датамодель в `scrollbox` — строки плана — читает глобальный список.
			datacontext = "[GetGlobalVariable('bag_wtp_swap_loc').GetLocation]"

			# Какая локация правится. Имя, а не номер: окно открывается из
			# строки плана, и перепутать строку легко.
			text_single = {
				size = { 800 24 }
				autoresize = no
				maximumsize = { 800 24 }
				align = left|vcenter
				fontsize = 14
				elide = right
				raw_text = "[Location.GetName]"
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				spacing = 10

				# ---- что стоит здесь -----------------------------------
				vbox = {
					layoutpolicy_vertical = expanding
					spacing = 4

					# **Число рядом с заголовком -- зонд, а не украшение.** Пустой
					# список и оборванная цепочка данных выглядят на экране
					# одинаково; это число разделяет их одним взглядом.
					text_single = {
						size = { 380 22 }
						autoresize = no
						maximumsize = { 380 22 }
						align = left|vcenter
						fontsize = 13
						elide = right
						text = "bag_wtp_swap_head_here"
						tooltip = "bag_wtp_swap_head_here_tt"
					}

					# **Форма ровно та, которой строка плана рисует эти же
					# списки.** Размер держит `widget` снаружи, `scrollbox`
					# внутри тянется политикой, а `datamodel` висит на **вложенной**
					# коробке, не на той, которую подставляет `scrollbox_content`.
					# Первый заход дал `scrollbox` свой размер и повесил датамодель
					# прямо на его коробку: `layoutpolicy = expanding` у ребёнка
					# коробки со своим размером даёт нулевую ширину
					# (`pitfalls/windows.md`), и ряды рисовались в ничто -- при
					# верных числах в заголовке.
					widget = {
						size = { 396 460 }
						scrollbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							blockoverride "scrollbox_content" {
								vbox = {
									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = preferred
									margin = { 6 4 }
									margin_right = 16
									spacing = 3

									vbox = {
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = preferred
										spacing = 3
										datamodel = "[GetGlobalList('bag_wtp_swap_here')]"
										item = {
											bag_wtp_swap_here_entry = {
												datacontext = "[Scope.GetBuildingType]"
											}
										}
									}
								}
							}
						}
					}
				}

				# ---- что сюда можно поставить --------------------------
				vbox = {
					layoutpolicy_vertical = expanding
					spacing = 4

					hbox = {
						spacing = 6

						text_single = {
							size = { 260 22 }
							autoresize = no
							maximumsize = { 260 22 }
							align = left|vcenter
							fontsize = 13
							elide = right
							text = "bag_wtp_swap_head_can"
							tooltip = "bag_wtp_swap_head_can_tt"
						}

						button_regular = {
							size = { 114 24 }
							down = "[GetGlobalVariable('bag_wtp_swap_sift').IsSet]"
							tooltip = "bag_wtp_swap_sift_tt"
							onclick = "[GetScriptedGui('bag_wtp_swap_sift').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							text_single = {
								parentanchor = center
								widgetanchor = center
								autoresize = yes
								fontsize = 13
								text = "bag_wtp_swap_sift"
							}
						}
					}

					# **Форма ровно та, которой строка плана рисует эти же
					# списки.** Размер держит `widget` снаружи, `scrollbox`
					# внутри тянется политикой, а `datamodel` висит на **вложенной**
					# коробке, не на той, которую подставляет `scrollbox_content`.
					# Первый заход дал `scrollbox` свой размер и повесил датамодель
					# прямо на его коробку: `layoutpolicy = expanding` у ребёнка
					# коробки со своим размером даёт нулевую ширину
					# (`pitfalls/windows.md`), и ряды рисовались в ничто -- при
					# верных числах в заголовке.
					widget = {
						size = { 396 460 }
						scrollbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							blockoverride "scrollbox_content" {
								vbox = {
									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = preferred
									margin = { 6 4 }
									margin_right = 16
									spacing = 3

									vbox = {
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = preferred
										spacing = 3
										datamodel = "[GetGlobalList('bag_wtp_swap_list')]"
										item = {
											bag_wtp_swap_can_entry = {
												datacontext = "[Scope.GetBuildingType]"
											}
										}
									}
								}
							}
						}
					}
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 8

				expand = {}

				button_regular = {
					size = { 150 30 }
					tooltip = "bag_wtp_swap_done_tt"
					onclick = "[GetScriptedGui('bag_wtp_swap_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					text_single = {
						parentanchor = center
						widgetanchor = center
						autoresize = yes
						fontsize = 13
						text = "bag_wtp_swap_done"
					}
				}
			}
		}
	}
}
