# Окно замены домика в одной локации.
#
# **Шестой пункт его списка, 2026-09-13.** «В каждой локации в окне редактора
# должна быть добавлена кнопочка замены. Жму кнопку и открывается окно
# конкретной локации. В нём показаны те домики, которые там стоят. Я могу
# нажать удалить на любой из них. На другой части окна мне показывается список
# домиков, которые я могу туда поставить.»
#
# **Оба списка -- списки зданий, и это не деталь.** Строка датамодели, которой
# дан тип здания, рисует значок и имя сама; товар пришлось бы переводить в
# здание картой переменных на локации. Слева -- `bag_wtp_row_builds`, тот самый
# список, которым рисуется строка плана; справа -- `bag_wtp_swap_can`, собранный
# `bag_wtp_swap_rebuild` по убыванию выгоды от РГО.
#
# **Ни одной своей кнопки сохранения.** «×» и «+» меняют план сразу же, теми же
# эффектами, что «−1» и «+1» редактора; «Готово» только закрывает. Так же, как
# и вся остальная правка в этом моде: отменять нечего, потому что каждое
# нажатие видно в строке плана в тот же миг.

types BagWtpSwapTypes {

	# Один домик, который тут стоит: значок, имя и «−».
	#
	# **Форма ряда -- та же, что у `bag_wtp_chg_entry`, который рисуется.**
	# `hbox` с политикой и `size = { -1 h }`: `-1` значит «ширину решает
	# политика», а дети -- `widget`-ы со своими размерами. Правило
	# «размер на `hbox` не держится» -- про `hbox` с настоящим числом и без
	# политики; здесь я применил его не к тому случаю и написал ряд
	# `widget`-ом, чего в этом моде не рисует никто.
	type bag_wtp_swap_here_entry = hbox {
		# **Политика плюс `-1`, а дети со своими размерами** -- ровно
		# `bag_wtp_chg_entry`. Твёрдое число на `hbox` не держится (он
		# подгоняется под детей), а растягивающийся ребёнок съедает соседей:
		# сперва так пропали имена, потом так пропала кнопка «−».
		layoutpolicy_horizontal = expanding
		size = { -1 30 }
		spacing = 4
		using = bg_number_container_bckg

		widget = {
			size = { 30 30 }
			text_single = {
				parentanchor = center
				autoresize = yes
				fontsize = 16
				raw_text = "[BuildingType.GetIcon]"
				tooltip = "[BuildingType.GetName]"
			}
		}

		# **Имя печаталось «...»**, и это тот же ноль ширины, что и у списка,
		# только этажом ниже: `autoresize = no` без настоящего размера -- нечего
		# обрезать, кроме как в многоточие. У рисующегося ряда
		# (`bag_wtp_chg_entry`) каждая ячейка -- `widget` со своим размером, и
		# текст внутри повторяет его же числом и `maximumsize`.
		widget = {
			size = { 300 30 }
			text_single = {
				parentanchor = left|vcenter
				widgetanchor = left|vcenter
				size = { 300 30 }
				autoresize = no
				maximumsize = { 300 30 }
				align = left|vcenter
				fontsize = 13
				fontsize_min = 10
				elide = right
				raw_text = "[BuildingType.GetName]"
			}
		}

		widget = {
			size = { 34 30 }
			button_regular = {
				size = { 26 26 }
				parentanchor = center
				widgetanchor = center
				tooltip = "bag_wtp_swap_drop_tt"
				onclick = "[GetScriptedGui('bag_wtp_swap_drop').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_bt', BuildingType.MakeScope).End)]"
				text_single = {
					parentanchor = center
					widgetanchor = center
					autoresize = yes
					fontsize = 14
					text = "bag_wtp_edit_minus"
				}
			}
		}
	}

	# Один домик, который сюда можно поставить: значок, имя, выгода и «+».
	#
	# **Строка читает себя по флагу**, как строка списка модов у CMF:
	# `Scope.GetFlagName` даёт `bag_wtp_swapslotN`, а `Concatenate` достраивает
	# имя переменной на державе. Так строка знает не только здание, но и
	# процент, который без этого достать было нечем.
	type bag_wtp_swap_can_entry = hbox {
		layoutpolicy_horizontal = expanding
		size = { -1 30 }
		spacing = 4
		using = bg_number_container_bckg

		widget = {
			size = { 30 30 }
			text_single = {
				parentanchor = center
				autoresize = yes
				fontsize = 16
				raw_text = "[GetPlayer.MakeScope.GetVariable(Concatenate(Scope.GetFlagName, '_bt')).GetBuildingType.GetIcon]"
				tooltip = "[GetPlayer.MakeScope.GetVariable(Concatenate(Scope.GetFlagName, '_bt')).GetBuildingType.GetName]"
			}
		}

		widget = {
			size = { 250 30 }
			text_single = {
				parentanchor = left|vcenter
				widgetanchor = left|vcenter
				size = { 250 30 }
				autoresize = no
				maximumsize = { 250 30 }
				align = left|vcenter
				fontsize = 13
				fontsize_min = 10
				elide = right
				raw_text = "[GetPlayer.MakeScope.GetVariable(Concatenate(Scope.GetFlagName, '_bt')).GetBuildingType.GetName]"
			}
		}

		# Что провинция платит этому зданию здесь -- доля от потолка его
		# рецепта, в тех же десятых процента, что и всюду в моде.
		widget = {
			size = { 56 30 }
			tooltip = "bag_wtp_swap_gain_tt"
			text_single = {
				parentanchor = right|vcenter
				widgetanchor = right|vcenter
				size = { 56 30 }
				autoresize = no
				maximumsize = { 56 30 }
				align = right|vcenter
				fontsize = 13
				fontsize_min = 10
				elide = right
				raw_text = "[GetPlayer.MakeScope.GetVariable(Concatenate(Scope.GetFlagName, '_gain')).GetValue|1]%"
			}
		}

		widget = {
			size = { 34 30 }
			button_regular = {
				size = { 26 26 }
				parentanchor = center
				widgetanchor = center
				tooltip = "bag_wtp_swap_put_tt"
				onclick = "[GetScriptedGui('bag_wtp_swap_put').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_bt', GetPlayer.MakeScope.GetVariable(Concatenate(Scope.GetFlagName, '_bt')).GetBuildingType.MakeScope).End)]"
				text_single = {
					parentanchor = center
					widgetanchor = center
					autoresize = yes
					fontsize = 14
					text = "bag_wtp_edit_plus"
				}
			}
		}
	}
}

window = {
	name = "bag_wtp_swap_window"
	datacontext = "[GetPlayer]"
	allow_outside = yes
	alwaystransparent = no
	parentanchor = center
	widgetanchor = center
	position = { 120 40 }
	movable = yes
	size = { 860 620 }
	using = bg_window_default_alt

	visible = "[GetPlayer.MakeScope.GetVariable('bag_wtp_swap_open').IsSet]"
	enabled = "[GetPlayer.MakeScope.GetVariable('bag_wtp_swap_open').IsSet]"

	widget = {
		parentanchor = right
		position = { -5 5 }
		size = { 40 40 }
		ui_direction_button_holder_right = {}
		button_close_alt = {
			blockoverride "close_on_action" {
				on_action = "[GetScriptedGui('bag_wtp_swap_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
		}
	}

	vbox = {
		using = window_margin_alt

		window_header_alt = {
			blockoverride "header_text" { text = "bag_wtp_swap_window_title" }
			blockoverride "window_header_alt_color_texture" { using = color_production_texture }
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			using = bg_secondary_inner_alt
			margin = { 12 12 }
			spacing = 6

			# **Скоуп нужен здесь только имени локации.** Оба списка окно
			# читает из глобальных (`GetGlobalList`), потому что три захода
			# подряд ряды не рисовались при верных числах в заголовках: число
			# стоит в этой коробке, рядом с `datacontext`, а `datamodel` — внутри
			# `blockoverride` у `scrollbox`, и что `datacontext` туда доходит,
			# в этом дереве ничем не доказано. Единственная работающая
			# датамодель в `scrollbox` — строки плана — читает глобальный список.
			datacontext = "[GetGlobalVariable('bag_wtp_swap_loc').GetLocation]"

			# Какая локация правится. Имя, а не номер: окно открывается из
			# строки плана, и перепутать строку легко.
			text_single = {
				size = { 800 24 }
				autoresize = no
				maximumsize = { 800 24 }
				align = left|vcenter
				fontsize = 14
				elide = right
				raw_text = "[Location.GetName]"
			}

			# **Цепочка коробок -- буква в букву та, которой рисуют себя окно
			# плана и окно изменений**, и это не стиль, а причина. Пятый заход на
			# пустые списки: у обоих работающих окон `scrollbox` -- прямой
			# ребёнок коробки содержимого, и **ни на одном звене цепочки нет
			# своего размера**, только политики. Здесь стояло
			# `hbox > vbox > widget{size} > scrollbox{expanding}` -- то самое
			# «`layoutpolicy = expanding` у ребёнка коробки со своим размером
			# даёт нулевую ширину» из `pitfalls/windows.md`, только размер я
			# переставил на обёртку, а не убрал.
			#
			# Ширину колонок делит `hbox`: две растягивающиеся коробки берут
			# по половине. Ни одного числа.
			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				spacing = 10

				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					spacing = 4

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6

						text_single = {
							layoutpolicy_horizontal = expanding
							autoresize = no
							align = left|vcenter
							fontsize = 13
							elide = right
							text = "bag_wtp_swap_head_here"
						}
					}

					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						blockoverride "scrollbox_content" {
							vbox = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = preferred
								margin = { 10 8 }
								margin_right = 20
								spacing = 3
								ignoreinvisible = yes
								datamodel = "[GetGlobalList('bag_wtp_swap_here')]"
								item = {
									bag_wtp_swap_here_entry = {
										datacontext = "[Scope.GetBuildingType]"
									}
								}
							}
						}
					}
				}

				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					spacing = 4

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6

						text_single = {
							layoutpolicy_horizontal = expanding
							autoresize = no
							align = left|vcenter
							fontsize = 13
							elide = right
							text = "bag_wtp_swap_head_can"
						}

						button_regular = {
							size = { 114 24 }
							down = "[GetGlobalVariable('bag_wtp_swap_sift').IsSet]"
							tooltip = "bag_wtp_swap_sift_tt"
							onclick = "[GetScriptedGui('bag_wtp_swap_sift').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							text_single = {
								parentanchor = center
								widgetanchor = center
								autoresize = yes
								fontsize = 13
								text = "bag_wtp_swap_sift"
							}
						}
					}

					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						blockoverride "scrollbox_content" {
							vbox = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = preferred
								margin = { 10 8 }
								margin_right = 20
								spacing = 3
								ignoreinvisible = yes
								datamodel = "[GetGlobalList('bag_wtp_swap_slots')]"
								item = {
									bag_wtp_swap_can_entry = {}
								}
							}
						}
					}
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 8

				expand = {}

				button_regular = {
					size = { 150 30 }
					tooltip = "bag_wtp_swap_done_tt"
					onclick = "[GetScriptedGui('bag_wtp_swap_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					text_single = {
						parentanchor = center
						widgetanchor = center
						autoresize = yes
						fontsize = 13
						text = "bag_wtp_swap_done"
					}
				}
			}
		}
	}
}
