# Полоса значков карт над баннером режима карты — перенесена из CM dev целиком.
#
# Его слово, 2026-09-14: «почему ты не сделал так, как оно было в CM DEV? Там
# буквально появлялись иконки на экране снизу над панелью карт, если включена
# карта рекомендуемых прав.» Так и есть, и это его файл
# `cm_town_rights_search_panel.gui`: полоса видна, только пока включён один из
# режимов семейства, наведение показывает карту предпросмотром, нажатие ставит
# её, а «×» возвращает режим по умолчанию. Значок карты в сводке остался -- он
# открывает семейство, а дальше ходить по нему этой полосой.
#
# Переименованы только имена. Ни одна координата, ни одно условие не тронуты.

# Urban right search panel: shown while the recommended urban rights mapmode
# family is active, overlaying the vanilla current-mapmode banner
# (mapmode_current_button). The best-rights button plus one search button per
# royal right and a close button; hovering previews the mode, clicking sets it.

# Strip offsets from screen bottom-center, one pair per mapmodes bar state,
# aligning the strip over the banner's two placements.
@bag_wtp_trmm_collapsed_x = 0
@bag_wtp_trmm_collapsed_y = -43
@bag_wtp_trmm_expanded_x = 0
@bag_wtp_trmm_expanded_y = -88

types bag_wtp_trmm_search_panel_types {
	type bag_wtp_trmm_search_strip = hbox {
		spacing = 4
		margin = { 8 4 }

		mapmode_tooltip_button = {
			datacontext = "[GetMapMode('bag_wtp_best_town_right')]"
			onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('bag_wtp_best_town_right')]"
		}

		mapmode_tooltip_button = {
			datacontext = "[GetMapMode('bag_wtp_trmm_search_tooling')]"
			onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('bag_wtp_trmm_search_tooling')]"
		}

		mapmode_tooltip_button = {
			datacontext = "[GetMapMode('bag_wtp_trmm_search_jewelry')]"
			onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('bag_wtp_trmm_search_jewelry')]"
		}

		mapmode_tooltip_button = {
			datacontext = "[GetMapMode('bag_wtp_trmm_search_naval')]"
			onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('bag_wtp_trmm_search_naval')]"
		}

		mapmode_tooltip_button = {
			datacontext = "[GetMapMode('bag_wtp_trmm_search_textile')]"
			onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('bag_wtp_trmm_search_textile')]"
		}

		mapmode_tooltip_button = {
			datacontext = "[GetMapMode('bag_wtp_trmm_search_weaponry')]"
			onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('bag_wtp_trmm_search_weaponry')]"
		}

		mapmode_tooltip_button = {
			datacontext = "[GetMapMode('bag_wtp_trmm_search_book')]"
			onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('bag_wtp_trmm_search_book')]"
		}

		mapmode_tooltip_button = {
			datacontext = "[GetMapMode('bag_wtp_trmm_search_artisan')]"
			onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('bag_wtp_trmm_search_artisan')]"
		}

		mapmode_tooltip_button = {
			datacontext = "[GetMapMode('bag_wtp_trmm_search_brewing')]"
			onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('bag_wtp_trmm_search_brewing')]"
		}

		mapmode_tooltip_button = {
			datacontext = "[GetMapMode('bag_wtp_trmm_search_masonry')]"
			onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('bag_wtp_trmm_search_masonry')]"
		}

		# Same close action as right-clicking the vanilla banner.
		button_close = {
			blockoverride "close_properties" {}
			blockoverride "close_on_action" {
				on_action = "[SetDefaultMapMode]"
			}
			tooltip = "MAPMODE_SELECT_DEFAULT"
		}
	}
}

widget = {
	name = "bag_wtp_trmm_search_panel"
	size = { 100% 100% }
	alwaystransparent = yes
	# Keeps the descendant visibility gates re-evaluating each frame.
	visible = "[EqualTo_CFixedPoint('(CFixedPoint)0', '(CFixedPoint)0')]"
	layer = top

	# Collapsed mapmodes bar placement.
	widget = {
		parentanchor = hcenter|bottom
		widgetanchor = hcenter|bottom
		position = { @bag_wtp_trmm_collapsed_x @bag_wtp_trmm_collapsed_y }
		# 10 buttons at 40 wide plus the close button, spacing, and margins.
		size = { 480 48 }
		alwaystransparent = no
		using = bg_paper_card
		visible = "[And3(GetPlayer.Exists, Or(Or(Or5(GetMapMode('bag_wtp_best_town_right').IsActive, GetMapMode('bag_wtp_trmm_search_tooling').IsActive, GetMapMode('bag_wtp_trmm_search_jewelry').IsActive, GetMapMode('bag_wtp_trmm_search_naval').IsActive, GetMapMode('bag_wtp_trmm_search_textile').IsActive), Or5(GetMapMode('bag_wtp_trmm_search_weaponry').IsActive, GetMapMode('bag_wtp_trmm_search_book').IsActive, GetMapMode('bag_wtp_trmm_search_artisan').IsActive, GetMapMode('bag_wtp_trmm_search_brewing').IsActive, GetMapMode('bag_wtp_trmm_search_masonry').IsActive)), Or(Or5(GetMapMode('bag_wtp_best_town_right_refresh').IsActive, GetMapMode('bag_wtp_trmm_search_tooling_refresh').IsActive, GetMapMode('bag_wtp_trmm_search_jewelry_refresh').IsActive, GetMapMode('bag_wtp_trmm_search_naval_refresh').IsActive, GetMapMode('bag_wtp_trmm_search_textile_refresh').IsActive), Or5(GetMapMode('bag_wtp_trmm_search_weaponry_refresh').IsActive, GetMapMode('bag_wtp_trmm_search_book_refresh').IsActive, GetMapMode('bag_wtp_trmm_search_artisan_refresh').IsActive, GetMapMode('bag_wtp_trmm_search_brewing_refresh').IsActive, GetMapMode('bag_wtp_trmm_search_masonry_refresh').IsActive))), Not(Or3(MapModeSelectorVars.Exists('hover'), MapModeSelectorVars.Exists('action'), IsMapModeMenuPinned)))]"

		bag_wtp_trmm_search_strip = {}
	}

	# Expanded mapmodes bar placement: the banner rides above the selector
	# window, hidden while its tab picker is open.
	widget = {
		parentanchor = hcenter|bottom
		widgetanchor = hcenter|bottom
		position = { @bag_wtp_trmm_expanded_x @bag_wtp_trmm_expanded_y }
		size = { 480 48 }
		alwaystransparent = no
		using = bg_paper_card
		visible = "[And4(GetPlayer.Exists, Or(Or(Or5(GetMapMode('bag_wtp_best_town_right').IsActive, GetMapMode('bag_wtp_trmm_search_tooling').IsActive, GetMapMode('bag_wtp_trmm_search_jewelry').IsActive, GetMapMode('bag_wtp_trmm_search_naval').IsActive, GetMapMode('bag_wtp_trmm_search_textile').IsActive), Or5(GetMapMode('bag_wtp_trmm_search_weaponry').IsActive, GetMapMode('bag_wtp_trmm_search_book').IsActive, GetMapMode('bag_wtp_trmm_search_artisan').IsActive, GetMapMode('bag_wtp_trmm_search_brewing').IsActive, GetMapMode('bag_wtp_trmm_search_masonry').IsActive)), Or(Or5(GetMapMode('bag_wtp_best_town_right_refresh').IsActive, GetMapMode('bag_wtp_trmm_search_tooling_refresh').IsActive, GetMapMode('bag_wtp_trmm_search_jewelry_refresh').IsActive, GetMapMode('bag_wtp_trmm_search_naval_refresh').IsActive, GetMapMode('bag_wtp_trmm_search_textile_refresh').IsActive), Or5(GetMapMode('bag_wtp_trmm_search_weaponry_refresh').IsActive, GetMapMode('bag_wtp_trmm_search_book_refresh').IsActive, GetMapMode('bag_wtp_trmm_search_artisan_refresh').IsActive, GetMapMode('bag_wtp_trmm_search_brewing_refresh').IsActive, GetMapMode('bag_wtp_trmm_search_masonry_refresh').IsActive))), Or3(MapModeSelectorVars.Exists('hover'), MapModeSelectorVars.Exists('action'), IsMapModeMenuPinned), Not(MapModeSelectorVars.Exists('tab')))]"

		bag_wtp_trmm_search_strip = {}
	}

	# Selection memory: bag_wtp_trmm_sel holds the last set family mode, and an
	# outside open of bag_wtp_best_town_right swaps once to it. bag_wtp_trmm_in marks
	# being inside the family, which keeps strip picks of best-rights from
	# re-triggering the swap. IsSet ignores the hover-preview overrides.

	# Open-swap drivers, one per search.
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And3(GetMapMode('bag_wtp_best_town_right').IsSet, GetVariableSystem.HasValue('bag_wtp_trmm_sel', 'bag_wtp_trmm_search_tooling'), Not(GetVariableSystem.Exists('bag_wtp_trmm_in')))]"
		state = {
			name = _show
			on_start = "[GetMapMode('bag_wtp_trmm_search_tooling').SetMapMode]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And3(GetMapMode('bag_wtp_best_town_right').IsSet, GetVariableSystem.HasValue('bag_wtp_trmm_sel', 'bag_wtp_trmm_search_jewelry'), Not(GetVariableSystem.Exists('bag_wtp_trmm_in')))]"
		state = {
			name = _show
			on_start = "[GetMapMode('bag_wtp_trmm_search_jewelry').SetMapMode]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And3(GetMapMode('bag_wtp_best_town_right').IsSet, GetVariableSystem.HasValue('bag_wtp_trmm_sel', 'bag_wtp_trmm_search_naval'), Not(GetVariableSystem.Exists('bag_wtp_trmm_in')))]"
		state = {
			name = _show
			on_start = "[GetMapMode('bag_wtp_trmm_search_naval').SetMapMode]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And3(GetMapMode('bag_wtp_best_town_right').IsSet, GetVariableSystem.HasValue('bag_wtp_trmm_sel', 'bag_wtp_trmm_search_textile'), Not(GetVariableSystem.Exists('bag_wtp_trmm_in')))]"
		state = {
			name = _show
			on_start = "[GetMapMode('bag_wtp_trmm_search_textile').SetMapMode]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And3(GetMapMode('bag_wtp_best_town_right').IsSet, GetVariableSystem.HasValue('bag_wtp_trmm_sel', 'bag_wtp_trmm_search_weaponry'), Not(GetVariableSystem.Exists('bag_wtp_trmm_in')))]"
		state = {
			name = _show
			on_start = "[GetMapMode('bag_wtp_trmm_search_weaponry').SetMapMode]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And3(GetMapMode('bag_wtp_best_town_right').IsSet, GetVariableSystem.HasValue('bag_wtp_trmm_sel', 'bag_wtp_trmm_search_book'), Not(GetVariableSystem.Exists('bag_wtp_trmm_in')))]"
		state = {
			name = _show
			on_start = "[GetMapMode('bag_wtp_trmm_search_book').SetMapMode]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And3(GetMapMode('bag_wtp_best_town_right').IsSet, GetVariableSystem.HasValue('bag_wtp_trmm_sel', 'bag_wtp_trmm_search_artisan'), Not(GetVariableSystem.Exists('bag_wtp_trmm_in')))]"
		state = {
			name = _show
			on_start = "[GetMapMode('bag_wtp_trmm_search_artisan').SetMapMode]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And3(GetMapMode('bag_wtp_best_town_right').IsSet, GetVariableSystem.HasValue('bag_wtp_trmm_sel', 'bag_wtp_trmm_search_brewing'), Not(GetVariableSystem.Exists('bag_wtp_trmm_in')))]"
		state = {
			name = _show
			on_start = "[GetMapMode('bag_wtp_trmm_search_brewing').SetMapMode]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And3(GetMapMode('bag_wtp_best_town_right').IsSet, GetVariableSystem.HasValue('bag_wtp_trmm_sel', 'bag_wtp_trmm_search_masonry'), Not(GetVariableSystem.Exists('bag_wtp_trmm_in')))]"
		state = {
			name = _show
			on_start = "[GetMapMode('bag_wtp_trmm_search_masonry').SetMapMode]"
		}
	}

	# Selection recorders.
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[GetMapMode('bag_wtp_trmm_search_tooling').IsSet]"
		state = {
			name = _show
			# Delayed so the entry frame's swap check still sees the mark absent.
			duration = 0.2
			on_start = "[GetVariableSystem.Set('bag_wtp_trmm_sel', 'bag_wtp_trmm_search_tooling')]"
			on_finish = "[GetVariableSystem.Set('bag_wtp_trmm_in', 'on')]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[GetMapMode('bag_wtp_trmm_search_jewelry').IsSet]"
		state = {
			name = _show
			duration = 0.2
			on_start = "[GetVariableSystem.Set('bag_wtp_trmm_sel', 'bag_wtp_trmm_search_jewelry')]"
			on_finish = "[GetVariableSystem.Set('bag_wtp_trmm_in', 'on')]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[GetMapMode('bag_wtp_trmm_search_naval').IsSet]"
		state = {
			name = _show
			duration = 0.2
			on_start = "[GetVariableSystem.Set('bag_wtp_trmm_sel', 'bag_wtp_trmm_search_naval')]"
			on_finish = "[GetVariableSystem.Set('bag_wtp_trmm_in', 'on')]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[GetMapMode('bag_wtp_trmm_search_textile').IsSet]"
		state = {
			name = _show
			duration = 0.2
			on_start = "[GetVariableSystem.Set('bag_wtp_trmm_sel', 'bag_wtp_trmm_search_textile')]"
			on_finish = "[GetVariableSystem.Set('bag_wtp_trmm_in', 'on')]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[GetMapMode('bag_wtp_trmm_search_weaponry').IsSet]"
		state = {
			name = _show
			duration = 0.2
			on_start = "[GetVariableSystem.Set('bag_wtp_trmm_sel', 'bag_wtp_trmm_search_weaponry')]"
			on_finish = "[GetVariableSystem.Set('bag_wtp_trmm_in', 'on')]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[GetMapMode('bag_wtp_trmm_search_book').IsSet]"
		state = {
			name = _show
			duration = 0.2
			on_start = "[GetVariableSystem.Set('bag_wtp_trmm_sel', 'bag_wtp_trmm_search_book')]"
			on_finish = "[GetVariableSystem.Set('bag_wtp_trmm_in', 'on')]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[GetMapMode('bag_wtp_trmm_search_artisan').IsSet]"
		state = {
			name = _show
			duration = 0.2
			on_start = "[GetVariableSystem.Set('bag_wtp_trmm_sel', 'bag_wtp_trmm_search_artisan')]"
			on_finish = "[GetVariableSystem.Set('bag_wtp_trmm_in', 'on')]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[GetMapMode('bag_wtp_trmm_search_brewing').IsSet]"
		state = {
			name = _show
			duration = 0.2
			on_start = "[GetVariableSystem.Set('bag_wtp_trmm_sel', 'bag_wtp_trmm_search_brewing')]"
			on_finish = "[GetVariableSystem.Set('bag_wtp_trmm_in', 'on')]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[GetMapMode('bag_wtp_trmm_search_masonry').IsSet]"
		state = {
			name = _show
			duration = 0.2
			on_start = "[GetVariableSystem.Set('bag_wtp_trmm_sel', 'bag_wtp_trmm_search_masonry')]"
			on_finish = "[GetVariableSystem.Set('bag_wtp_trmm_in', 'on')]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And(GetMapMode('bag_wtp_best_town_right').IsSet, GetVariableSystem.Exists('bag_wtp_trmm_in'))]"
		state = {
			name = _show
			on_start = "[GetVariableSystem.Set('bag_wtp_trmm_sel', 'bag_wtp_best_town_right')]"
		}
	}

	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[Not(Or(Or(Or5(GetMapMode('bag_wtp_best_town_right').IsSet, GetMapMode('bag_wtp_trmm_search_tooling').IsSet, GetMapMode('bag_wtp_trmm_search_jewelry').IsSet, GetMapMode('bag_wtp_trmm_search_naval').IsSet, GetMapMode('bag_wtp_trmm_search_textile').IsSet), Or5(GetMapMode('bag_wtp_trmm_search_weaponry').IsSet, GetMapMode('bag_wtp_trmm_search_book').IsSet, GetMapMode('bag_wtp_trmm_search_artisan').IsSet, GetMapMode('bag_wtp_trmm_search_brewing').IsSet, GetMapMode('bag_wtp_trmm_search_masonry').IsSet)), Or(Or5(GetMapMode('bag_wtp_best_town_right_refresh').IsSet, GetMapMode('bag_wtp_trmm_search_tooling_refresh').IsSet, GetMapMode('bag_wtp_trmm_search_jewelry_refresh').IsSet, GetMapMode('bag_wtp_trmm_search_naval_refresh').IsSet, GetMapMode('bag_wtp_trmm_search_textile_refresh').IsSet), Or5(GetMapMode('bag_wtp_trmm_search_weaponry_refresh').IsSet, GetMapMode('bag_wtp_trmm_search_book_refresh').IsSet, GetMapMode('bag_wtp_trmm_search_artisan_refresh').IsSet, GetMapMode('bag_wtp_trmm_search_brewing_refresh').IsSet, GetMapMode('bag_wtp_trmm_search_masonry_refresh').IsSet))))]"
		state = {
			name = _show
			on_start = "[GetVariableSystem.Clear('bag_wtp_trmm_in')]"
		}
	}

	# Stripe-refresh drivers, one out/back pair per mode. A tooltip grant sets
	# bag_wtp_trmm_refresh_armed; the out-driver swaps to the mode's hidden _refresh
	# twin and the back-driver returns 0.1s later and clears the arming.
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And(GetMapMode('bag_wtp_best_town_right').IsSet, GetScriptedGui('bag_wtp_trmm_refresh_pending').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
		state = {
			name = _show
			on_start = "[GetMapMode('bag_wtp_best_town_right_refresh').SetMapMode]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[GetMapMode('bag_wtp_best_town_right_refresh').IsSet]"
		state = {
			name = _show
			duration = 0.1
			on_finish = "[GetMapMode('bag_wtp_best_town_right').SetMapMode]"
			on_finish = "[GetScriptedGui('bag_wtp_trmm_ack_refresh').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And(GetMapMode('bag_wtp_trmm_search_tooling').IsSet, GetScriptedGui('bag_wtp_trmm_refresh_pending').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
		state = {
			name = _show
			on_start = "[GetMapMode('bag_wtp_trmm_search_tooling_refresh').SetMapMode]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[GetMapMode('bag_wtp_trmm_search_tooling_refresh').IsSet]"
		state = {
			name = _show
			duration = 0.1
			on_finish = "[GetMapMode('bag_wtp_trmm_search_tooling').SetMapMode]"
			on_finish = "[GetScriptedGui('bag_wtp_trmm_ack_refresh').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And(GetMapMode('bag_wtp_trmm_search_jewelry').IsSet, GetScriptedGui('bag_wtp_trmm_refresh_pending').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
		state = {
			name = _show
			on_start = "[GetMapMode('bag_wtp_trmm_search_jewelry_refresh').SetMapMode]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[GetMapMode('bag_wtp_trmm_search_jewelry_refresh').IsSet]"
		state = {
			name = _show
			duration = 0.1
			on_finish = "[GetMapMode('bag_wtp_trmm_search_jewelry').SetMapMode]"
			on_finish = "[GetScriptedGui('bag_wtp_trmm_ack_refresh').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And(GetMapMode('bag_wtp_trmm_search_naval').IsSet, GetScriptedGui('bag_wtp_trmm_refresh_pending').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
		state = {
			name = _show
			on_start = "[GetMapMode('bag_wtp_trmm_search_naval_refresh').SetMapMode]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[GetMapMode('bag_wtp_trmm_search_naval_refresh').IsSet]"
		state = {
			name = _show
			duration = 0.1
			on_finish = "[GetMapMode('bag_wtp_trmm_search_naval').SetMapMode]"
			on_finish = "[GetScriptedGui('bag_wtp_trmm_ack_refresh').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And(GetMapMode('bag_wtp_trmm_search_textile').IsSet, GetScriptedGui('bag_wtp_trmm_refresh_pending').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
		state = {
			name = _show
			on_start = "[GetMapMode('bag_wtp_trmm_search_textile_refresh').SetMapMode]"
		}
	}
