# Лаборатория ползунков, версия вторая. Прогон 2026-09-16 снял три вопроса и
# оставил один — этот файл спрашивает оставшийся.
#
# **Что сказал первый прогон (его слова и логи, `docs/TESTLOG.md`):**
# 1. Вызов функции интерфейса из нашего окна до игры доходит — ванильная
#    галочка авто-чеканки переключается кнопкой мода.
# 2. `onclick = "[GetEconomyView.PostTaxes]"` не привязался вовсе:
#    `gui.log` — «failed reading callback, at gui/bag_wsl_lab_window.gui:150»
#    и `:162`, то есть кнопки «А» и «Б» были без обработчика и нажимались
#    вхолостую. **Глобальный promote в колбэке игра не берёт** — ванилла зовёт
#    эти функции только через `datacontext`, и здесь теперь так же.
# 3. `datamodel = "[GetEconomyView.GetMaintenanceSettings]"` на `vbox` отвергнут:
#    «Property 'datamodel'(1002) not handled». Та же причина; ванильная форма —
#    `datacontext` на коробке, `EconomyView.` в самой датамодели.
# 4. Наш ползунок с упорами 0/0 родился в нуле и не двигался ни мышью, ни
#    кнопками «+»/«−» — упоры держали его намертво. **Значит, опыт не состоялся
#    вовсе**: значение ни разу не менялось, и обработчику нечего было ловить.
#
# **Оставшийся вопрос, и он весь тут.** Ползунок, живущий в нашем окне и
# привязанный к панели экономики, — доходит ли его движение до игры? Опыт 1
# отвечает рукой (тащить мышью), опыт 2 — модом (кнопка пишет число, ползунок
# едет за числом). Если работает опыт 2 — мод готов: остальное складывается из
# того, что в этом репозитории уже работает.
window = {
	name = "bag_wsl_lab_window"
	datacontext = "[GetPlayer]"
	allow_outside = yes
	alwaystransparent = no
	parentanchor = top|left
	widgetanchor = top|left
	position = { 780 100 }
	movable = yes
	size = { 620 540 }
	using = bg_window_default_alt

	visible = "[Or(IsLateralViewOpened('economy'), GetVariableSystem.Exists('bag_wsl_pin'))]"

	vbox = {
		using = window_margin_alt

		window_header_alt = {
			blockoverride "header_text" { text = "bag_wsl_lab_title" }
			blockoverride "window_header_alt_color_texture" { using = color_economy_texture }
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			using = bg_secondary_inner_alt
			margin = { 12 12 }
			spacing = 4

			# ---- показания. Эти три строки в прогоне читались верно ------------
			text_multi = {
				layoutpolicy_horizontal = expanding
				autoresize = yes
				maximumsize = { 580 -1 }
				text = "bag_wsl_row_minting"
			}

			text_multi = {
				layoutpolicy_horizontal = expanding
				autoresize = yes
				maximumsize = { 580 -1 }
				text = "bag_wsl_row_auto"
			}

			# ---- опыт 1: тащить рукой -----------------------------------------
			text_single = {
				layoutpolicy_horizontal = expanding
				autoresize = no
				align = left|nobaseline
				text = "bag_wsl_h1"
			}

			widget = {
				size = { 580 24 }
				datacontext = "[GetEconomyView]"

				economy_slider = {
					parentanchor = left|vcenter
					size = { 560 10 }
					min = 0
					max = 1
					value = "[EconomyView.GetDefaultCoinMinting]"
					onvaluechanged = "[EconomyView.OnChangedCoinMinting]"
					onchangefinish = "[EconomyView.PostTaxes]"
				}
			}

			# ---- опыт 2: число пишет мод --------------------------------------
			text_single = {
				layoutpolicy_horizontal = expanding
				autoresize = no
				align = left|nobaseline
				text = "bag_wsl_h2"
			}

			widget = {
				size = { 580 24 }
				datacontext = "[GetEconomyView]"

				economy_slider = {
					parentanchor = left|vcenter
					size = { 560 10 }
					min = 0
					max = 1
					# Ванильная форма чтения скриптового числа интерфейсом —
					# `decline_of_majapahit.gui:196` делает ей ровно так же.
					value = "[FixedPointToFloat(GetPlayer.MakeScope.GetVariable('bag_wsl_target').GetValue)]"
					onvaluechanged = "[EconomyView.OnChangedCoinMinting]"
					onchangefinish = "[EconomyView.PostTaxes]"
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 4

				button_regular = {
					size = { 140 26 }
					tooltip = "bag_wsl_btn_t0_tt"
					onclick = "[GetScriptedGui('bag_wsl_target_0').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					text_single = {
						parentanchor = center
						widgetanchor = center
						autoresize = yes
						text = "bag_wsl_btn_t0"
					}
				}

				button_regular = {
					size = { 140 26 }
					tooltip = "bag_wsl_btn_t0_tt"
					onclick = "[GetScriptedGui('bag_wsl_target_25').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					text_single = {
						parentanchor = center
						widgetanchor = center
						autoresize = yes
						text = "bag_wsl_btn_t25"
					}
				}

				button_regular = {
					size = { 140 26 }
					tooltip = "bag_wsl_btn_t0_tt"
					onclick = "[GetScriptedGui('bag_wsl_target_50').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					text_single = {
						parentanchor = center
						widgetanchor = center
						autoresize = yes
						text = "bag_wsl_btn_t50"
					}
				}

				button_regular = {
					size = { 140 26 }
					tooltip = "bag_wsl_btn_t0_tt"
					onclick = "[GetScriptedGui('bag_wsl_target_100').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					text_single = {
						parentanchor = center
						widgetanchor = center
						autoresize = yes
						text = "bag_wsl_btn_t100"
					}
				}
			}

			# ---- отправка и ванильная автоматика -------------------------------
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 4

				# `datacontext` на самой кнопке: в прошлый раз именно его тут и
				# не хватало, и колбэк не привязался.
				button_regular = {
					size = { 285 26 }
					datacontext = "[GetEconomyView]"
					tooltip = "bag_wsl_btn_post_tt"
					onclick = "[EconomyView.PostTaxes]"
					text_single = {
						parentanchor = center
						widgetanchor = center
						autoresize = yes
						text = "bag_wsl_btn_post"
					}
				}

				button_regular = {
					size = { 285 26 }
					tooltip = "bag_wsl_btn_g_tt"
					onclick = "[ToggleAutoMinting]"
					text_single = {
						parentanchor = center
						widgetanchor = center
						autoresize = yes
						text = "bag_wsl_btn_g"
					}
				}
			}

			# ---- содержание: та же пара опытов на списке движка -----------------
			text_single = {
				layoutpolicy_horizontal = expanding
				autoresize = no
				align = left|nobaseline
				text = "bag_wsl_h3"
			}

			# Над датамоделью не бывает ничего, кроме политик раскладки: политика
			# под коробкой со своим размером схлопывается в нулевую ширину, и
			# ряды рисуются в ничто (`tools/check_script.py` это ловит). Поэтому
			# скоуп панели берётся коробкой, у которой нет размера.
			vbox = {
				layoutpolicy_horizontal = expanding
				datacontext = "[GetEconomyView]"

				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 2
					ignoreinvisible = yes

					datamodel = "[EconomyView.GetMaintenanceSettings]"
					item = {
						widget = {
							size = { 580 26 }
							visible = "[Or3(MaintenanceSetting.IsArmy, MaintenanceSetting.IsNavy, MaintenanceSetting.IsFort)]"

							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4

								text_single = {
									size = { 250 22 }
									autoresize = no
									align = left|nobaseline
									text = "bag_wsl_row_maint"
								}

								widget = {
									size = { 230 22 }

									economy_slider = {
										parentanchor = left|vcenter
										size = { 220 10 }
										min = 0
										max = 1
										value = "[MaintenanceSetting.GetDefault]"
										onvaluechanged = "[MaintenanceSetting.OnChanged]"
										onchangefinish = "[MaintenanceSetting.Post]"
									}
								}

								button_regular = {
									size = { 90 22 }
									tooltip = "bag_wsl_btn_post_maint_tt"
									onclick = "[MaintenanceSetting.Post]"
									text_single = {
										parentanchor = center
										widgetanchor = center
										autoresize = yes
										text = "bag_wsl_btn_post_maint"
									}
								}
							}
						}
					}
				}
			}

			text_multi = {
				layoutpolicy_horizontal = expanding
				autoresize = yes
				maximumsize = { 580 -1 }
				text = "bag_wsl_lab_hint"
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 4

				button_regular = {
					size = { 285 26 }
					tooltip = "bag_wsl_btn_h_tt"
					onclick = "[GetVariableSystem.Toggle('bag_wsl_pin')]"
					text_single = {
						parentanchor = center
						widgetanchor = center
						autoresize = yes
						text = "bag_wsl_btn_h"
					}
				}

				widget = { size = { 285 26 } }
			}

			# Пустышка последним ребёнком: коробка с запасом места делит его
			# между детьми, а не прижимает их к верху.
			widget = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
			}
		}
	}
}
