# Runs the placement finder when a finder mapmode is opened: a prep driver primes the search,
# a gated tick driver scores candidate batches until done, and the repaint driver swaps through
# the mode's hidden duplicate to show the finished scores.
widget = {
	name = "bcm_pf_map_mode_window"
	# Keeps the descendant visibility gates re-evaluating each frame.
	visible = "[EqualTo_CFixedPoint('(CFixedPoint)0', '(CFixedPoint)0')]"
	position = { -10000 1 }

	# Governor finder prep driver.
	widget = {
		size = { 0 0 }
		# Pinned so a save made with the mode active still fires _show on load.
		visible_at_creation = no
		# The hidden duplicate keeps the gate up through the repaint swap.
		visible = "[And(GetPlayer.Exists, Or(GetMapMode('bcm_governor_finder').IsActive, GetMapMode('bcm_governor_finder_hidden').IsActive))]"
		state = {
			name = _show
			duration = 0.1
			on_finish = "[GetScriptedGui('bcm_pf_prep_gov').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		}
	}

	# Governor finder tick driver. The bcm_pf_batch_ready term is what ends the loop: each Execute is
	# a broadcast scripted_gui_command, and a finished run would otherwise keep paying one per tick
	# for the length of time the mode stays open. Priming re-arms it, so the refresh button works.
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And3(GetPlayer.Exists, Or(GetMapMode('bcm_governor_finder').IsActive, GetMapMode('bcm_governor_finder_hidden').IsActive), GetScriptedGui('bcm_pf_batch_ready').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
		state = {
			name = _show
			duration = 0.1
			next = bcm_pf_gf_tick_a
			on_finish = "[GetScriptedGui('bcm_pf_run_batch').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		}
		state = {
			name = bcm_pf_gf_tick_a
			duration = 0.1
			next = bcm_pf_gf_tick_b
			on_finish = "[GetScriptedGui('bcm_pf_run_batch').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		}
		state = {
			name = bcm_pf_gf_tick_b
			duration = 0.1
			next = bcm_pf_gf_tick_a
			on_finish = "[GetScriptedGui('bcm_pf_run_batch').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		}
	}

	# Governor finder repaint driver: fires once per finished run while the mode is viewed.
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And3(GetPlayer.Exists, GetMapMode('bcm_governor_finder').IsActive, GetScriptedGui('bcm_pf_repaint_ready').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
		state = {
			name = _show
			duration = 0.1
			next = bcm_pf_gf_restore
			on_finish = "[GetMapMode('bcm_governor_finder_hidden').SetMapMode]"
			on_finish = "[GetScriptedGui('bcm_pf_repaint_ready').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		}
		state = {
			name = bcm_pf_gf_restore
			duration = 0.1
			on_finish = "[GetMapMode('bcm_governor_finder').SetMapMode]"
		}
	}

	# Clears bcm_pf_mode_open when the last finder mode closes, hiding the action bar refresh button.
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And3(GetPlayer.Exists, Not(Or(GetMapMode('bcm_governor_finder').IsActive, GetMapMode('bcm_governor_finder_hidden').IsActive)), GetScriptedGui('bcm_pf_refresh').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
		state = {
			name = _show
			duration = 0.1
			on_finish = "[GetScriptedGui('bcm_pf_clear_mode_open').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		}
	}
	# Setup driver. Runs the urban-rights pass, the food-potential pass and the
	# river harvest's enumeration the first time any of the three is out of date,
	# which is a new game, a save made before this mod, or a version bump. Each
	# pass is stamped, so this costs nothing on a load that owes none of them.
	#
	# The gate stays true through the river harvest that follows, and that is
	# fine: _show fires on the hidden->shown edge, not every frame it is shown.
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And(GetPlayer.Exists, GetScriptedGui('bcm_setup_pending').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
		state = {
			name = _show
			duration = 0.1
			on_finish = "[GetScriptedGui('bcm_run_setup').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		}
	}

	# River-adjacency harvest, lifted out of CM's own hidden window. The
	# placement finder reads the neighbour lists it writes, and
	# Location.GetRiverProximityLocations is readable only from GUI, which is
	# why this is a window and not a scripted effect.
	widget = {
		# River-adjacency precompute for the placement finder. Location.GetRiverProximityLocations
		# reads only in GUI, so record each river location's genuinely river-connected neighbors into
		# the per-location bcm_pf_river_neighbors list the path search reads.
		# visible_at_creation = no pins it hidden at creation so a loaded save still gets a
		# hidden->shown first-show that fires _show. The tick loop records one small batch of source
		# locations per fire so scripted_gui_command volume stays under the flood threshold; each fill rebinds
		# this datamodel to the next batch, and bcm_pf_river_fill_batch tears down and stamps once done.
		widget = {
			size = { 0 0 }
			visible_at_creation = no
			visible = "[And(GetPlayer.Exists, GetScriptedGui('bcm_pf_river_should_process').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
			state = {
				name = _show
				duration = 0.1
				next = bcm_pf_river_fire
				on_finish = "[GetScriptedGui('bcm_pf_river_fill_batch').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
			state = {
				name = bcm_pf_river_fire
				duration = 0.3
				next = bcm_pf_river_next
				on_finish = "[PdxGuiTriggerAllAnimations('bcm_pf_river_record_state')]"
			}
			state = {
				name = bcm_pf_river_next
				duration = 0.1
				next = bcm_pf_river_fire
				on_finish = "[GetScriptedGui('bcm_pf_river_fill_batch').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
		}

		# Statically visible so each freshly-filled batch's nested neighbor datamodels instantiate before the fire state.
		widget = {
			datamodel = "[GetGlobalList('bcm_pf_river_batch')]"
			item = {
				widget = {
					datacontext = "[Scope.GetLocation]"
					widget = {
						datamodel = "[Location.GetRiverProximityLocations]"
						item = {
							widget = {
								size = { 0 0 }
								state = {
									name = bcm_pf_river_record_state
									on_finish = "[GetScriptedGui('bcm_pf_river_record').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('bcm_pf_river_src', Scope.GetLocation.MakeScope).AddScope('bcm_pf_river_nb', Location.MakeScope).End)]"
								}
							}
						}
					}
				}
			}
		}
	}

}
