# quiet_alerts: the game's `type alert_banner` (alertmanager.gui), copied whole,
# plus the child that plays the red/orange sound while the CMF checkbox is on.
# Rebuilt from the game by mods/quiet_alerts/tools/generate.py.

types QuietAlerts {
	type alert_banner = button {
		ontextcontextchanged = "[SetAlertPriorityFromTextContext(PdxGuiWidget.AccessSelf)]"

		using = alert_banner_setup
		using = alert_banner_anim

		blockoverride "alert_banner_priority" {
			using = automatic_priority_alert
		}

		onmousehierarchyenter = "[AlertEntry.SetAsOld]"

		# block "action_tooltip_left" {
			action_tooltip = {
				click_type = left
				click_mode = single
				visible = "[AlertEntry.GetAlertAction.IsVisible]"
				enabled = "[AlertEntry.GetAlertAction.IsEnabled]"
				title = "[AlertEntry.GetAlertAction.GetName]"
				cost = "[AlertEntry.GetAlertAction.GetCost]"
				description = "[AlertEntry.GetAlertAction.GetDescription]"
				conditions = "[AlertEntry.GetAlertAction.GetConditions]"
				on_action_with_params = "[AlertEntry.GetAlertAction.PerformAction]"
			}
		# }

		action_tooltip = {
			click_type = left
			click_modifier = shift
			click_modifier_description = "OPEN_HINT_TEXT"
			title = "ALERT_HINT"
			visible = "[AlertEntry.GetDescription.HasHint]"
			on_action_with_params = "[AlertEntry.GetAlertAction.PerformAction]"
			on_action = "[OpenLateralViewWithParams('hints', LinkParam('selected_hint', AlertEntry.GetDescription.GetHint))]"
		}

		# block "action_tooltip_right" {
			action_tooltip = {
				click_type = right
				title = "ALERT_HIDE"
				clicksound = "UI_alert_discard"
				on_action = "[AlertEntry.Hide]"
			}

			action_tooltip = {
				click_type = right
				click_modifier = shift
				title = "ALERT_HIDE_AND_MUTE"
				clicksound = "UI_alert_discard"
				on_action = "[AlertEntry.Hide]"
				on_action = "[AlertEntry.SetMuted]"
			}
		# }

		# using = alert_tooltip
		using = snd_UI_alert_hide

		modify_texture = {
			visible = "[AlertEntry.IsNew]"
			alpha = "[GetHighlightAnim('4.0, 0.1, 0.25')]"
		}

		tagtooltip_enabled = yes
		tooltip = "[AlertEntry.GetDescription.GetTitleWithTooltip]"

		# quiet_alerts: born hidden, so a banner that is red or orange when it
		# appears still goes hidden -> shown and fires _show (the CM pattern,
		# cm_hidden_window.gui). The engine's own sound for these is "" in defines.
		widget = {
			name = "quiet_alerts_sound"
			size = { 0 0 }
			visible_at_creation = no
			visible = "[And(Or(AlertEntry.GetDescription.IsPriority('red'), AlertEntry.GetDescription.IsPriority('orange')), CMMIsSettingEnabled('bag_qal__red_orange_sound'))]"
			state = {
				name = _show
				start_sound = { soundeffect = "UI_alert_appear_yellow" }
			}
		}
	}
}
