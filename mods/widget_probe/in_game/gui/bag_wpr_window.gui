# Пробник виджетов. Мод отладочный: ставится на один прогон и снимается.
#
# Он отвечает на один вопрос — можно ли модом освободить виджеты, которые игра
# копит за сессию (`../../docs/investigations/widget_leak.md`). Рычаги, и
# каждый нажимается отдельно, потому что неизвестно, работает ли хоть один:
#
#   * `PdxGuiDestroyWidget` — единственная в дампах функция, уничтожающая
#     виджет. Глобальная, поэтому прошлый поиск по методам типов её не нашёл.
#     Здесь она бьёт по своей же жертве `bag_wpr_victim`, рядом счётчик детей
#     той же коробки: 3 до нажатия, 2 после — значит вызов работает.
#   * `gui.clearwidgets` — консольная команда, которой игра гасит свою же
#     библиотеку интерфейса (`ui_library.gui:18261`).
#   * `CloseAllTooltips` — то, чем игра закрывает подсказки сама.
#
# **Перепись корня — главное, что тут есть.** Прогон 2026-09-19 показал, что
# вверх по дереву цепочка кончается быстро: окно > `windows_layer` (32 ребёнка)
# > `_root_` (23 ребёнка). Значит утечка сидит не наверху, а в одной из веток
# корня, и её надо назвать. `AccessChild` берёт номер или имя — неизвестно, в
# игровых файлах он не встречается ни разу; если номер, строки ниже назовут
# ветку с десятками тысяч детей. Все `ERROR` — значит берёт имя, и эта дорога
# закрыта.
#
# Панель висит на флаге `bag_wpr_open`, который переключает отдельное окно
# `bag_wpr_button.gui`: играть с открытым зондом неудобно, и это его слова.
window = {
	name = "bag_wpr_window"
	datacontext = "[GetPlayer]"
	allow_outside = yes
	alwaystransparent = no
	parentanchor = top|left
	widgetanchor = top|left
	position = { 20 200 }
	movable = yes
	size = { 620 700 }
	using = bg_window_default_alt

	visible = "[GetVariableSystem.Exists('bag_wpr_open')]"

	vbox = {
		using = window_margin_alt

		window_header_alt = {
			blockoverride "header_text" { text = "bag_wpr_title" }
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			using = bg_secondary_inner_alt
			margin = { 12 12 }
			spacing = 2

			text_multi = {
				layoutpolicy_horizontal = expanding
				autoresize = yes
				maximumsize = { 580 -1 }
				text = "bag_wpr_frame"
			}

			text_multi = {
				layoutpolicy_horizontal = expanding
				autoresize = yes
				maximumsize = { 580 -1 }
				text = "bag_wpr_lvl3"
			}

			text_multi = {
				layoutpolicy_horizontal = expanding
				autoresize = yes
				maximumsize = { 580 -1 }
				text = "bag_wpr_lvl4"
			}

			text_multi = {
				layoutpolicy_horizontal = expanding
				autoresize = yes
				maximumsize = { 580 -1 }
				text = "bag_wpr_lvl5"
			}

			text_multi = {
				layoutpolicy_horizontal = expanding
				autoresize = yes
				maximumsize = { 580 -1 }
				text = "bag_wpr_root_head"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				size = { 580 17 }
				autoresize = no
				align = left|nobaseline
				text = "bag_wpr_root00"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				size = { 580 17 }
				autoresize = no
				align = left|nobaseline
				text = "bag_wpr_root01"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				size = { 580 17 }
				autoresize = no
				align = left|nobaseline
				text = "bag_wpr_root02"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				size = { 580 17 }
				autoresize = no
				align = left|nobaseline
				text = "bag_wpr_root03"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				size = { 580 17 }
				autoresize = no
				align = left|nobaseline
				text = "bag_wpr_root04"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				size = { 580 17 }
				autoresize = no
				align = left|nobaseline
				text = "bag_wpr_root05"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				size = { 580 17 }
				autoresize = no
				align = left|nobaseline
				text = "bag_wpr_root06"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				size = { 580 17 }
				autoresize = no
				align = left|nobaseline
				text = "bag_wpr_root07"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				size = { 580 17 }
				autoresize = no
				align = left|nobaseline
				text = "bag_wpr_root08"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				size = { 580 17 }
				autoresize = no
				align = left|nobaseline
				text = "bag_wpr_root09"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				size = { 580 17 }
				autoresize = no
				align = left|nobaseline
				text = "bag_wpr_root10"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				size = { 580 17 }
				autoresize = no
				align = left|nobaseline
				text = "bag_wpr_root11"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				size = { 580 17 }
				autoresize = no
				align = left|nobaseline
				text = "bag_wpr_root12"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				size = { 580 17 }
				autoresize = no
				align = left|nobaseline
				text = "bag_wpr_root13"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				size = { 580 17 }
				autoresize = no
				align = left|nobaseline
				text = "bag_wpr_root14"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				size = { 580 17 }
				autoresize = no
				align = left|nobaseline
				text = "bag_wpr_root15"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				size = { 580 17 }
				autoresize = no
				align = left|nobaseline
				text = "bag_wpr_root16"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				size = { 580 17 }
				autoresize = no
				align = left|nobaseline
				text = "bag_wpr_root17"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				size = { 580 17 }
				autoresize = no
				align = left|nobaseline
				text = "bag_wpr_root18"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				size = { 580 17 }
				autoresize = no
				align = left|nobaseline
				text = "bag_wpr_root19"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				size = { 580 17 }
				autoresize = no
				align = left|nobaseline
				text = "bag_wpr_root20"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				size = { 580 17 }
				autoresize = no
				align = left|nobaseline
				text = "bag_wpr_root21"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				size = { 580 17 }
				autoresize = no
				align = left|nobaseline
				text = "bag_wpr_root22"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				size = { 580 17 }
				autoresize = no
				align = left|nobaseline
				text = "bag_wpr_root23"
			}

			# Скамья для `PdxGuiDestroyWidget`. Жертва — первый ребёнок ряда,
			# счётчик читает число детей этого же ряда, кнопка бьёт по имени.
			hbox = {
				layoutpolicy_horizontal = expanding
				size = { -1 28 }
				spacing = 4

				widget = {
					name = "bag_wpr_victim"
					size = { 150 24 }

					text_single = {
						parentanchor = vcenter
						autoresize = yes
						text = "bag_wpr_victim_text"
					}
				}

				text_single = {
					layoutpolicy_horizontal = expanding
					size = { 190 24 }
					autoresize = no
					align = left|nobaseline
					text = "bag_wpr_row_count"
				}

				button_regular = {
					size = { 210 26 }
					tooltip = "bag_wpr_btn_kill_tt"
					onclick = "[PdxGuiDestroyWidget(PdxGuiWidget.AccessParent.FindChild('bag_wpr_victim'))]"
					text_single = {
						parentanchor = center
						widgetanchor = center
						autoresize = yes
						text = "bag_wpr_btn_kill"
					}
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				size = { -1 30 }
				spacing = 4

				button_regular = {
					size = { 190 26 }
					tooltip = "bag_wpr_btn_clear_tt"
					onclick = "[ExecuteConsoleCommand('gui.clearwidgets')]"
					text_single = {
						parentanchor = center
						widgetanchor = center
						autoresize = yes
						text = "bag_wpr_btn_clear"
					}
				}

				button_regular = {
					size = { 190 26 }
					tooltip = "bag_wpr_btn_tips_tt"
					onclick = "[CloseAllTooltips]"
					text_single = {
						parentanchor = center
						widgetanchor = center
						autoresize = yes
						text = "bag_wpr_btn_tips"
					}
				}

				button_regular = {
					size = { 190 26 }
					tooltip = "bag_wpr_btn_close_tt"
					onclick = "[GetVariableSystem.Toggle('bag_wpr_open')]"
					text_single = {
						parentanchor = center
						widgetanchor = center
						autoresize = yes
						text = "bag_wpr_btn_close"
					}
				}
			}

			widget = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
			}
		}
	}
}
