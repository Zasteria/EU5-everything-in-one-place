# Открывалка зонда. Отдельное окно, потому что рамку рисует `using` на самом
# `window`, и спрятать панель, оставив кнопку, одним окном нельзя.
#
# Всегда на экране, двигается мышью. Панель висит на том же флаге и по
# умолчанию закрыта — зонд не мешает играть, пока его не позвали.
window = {
	name = "bag_wpr_button"
	datacontext = "[GetPlayer]"
	allow_outside = yes
	alwaystransparent = no
	parentanchor = top|left
	widgetanchor = top|left
	position = { 20 140 }
	movable = yes
	size = { 140 44 }
	using = bg_window_default_alt

	visible = "[GetPlayer.Exists]"

	vbox = {
		using = window_margin_alt

		button_regular = {
			size = { 110 26 }
			tooltip = "bag_wpr_btn_open_tt"
			onclick = "[GetVariableSystem.Toggle('bag_wpr_open')]"
			text_single = {
				parentanchor = center
				widgetanchor = center
				autoresize = yes
				text = "bag_wpr_btn_open"
			}
		}
	}
}
