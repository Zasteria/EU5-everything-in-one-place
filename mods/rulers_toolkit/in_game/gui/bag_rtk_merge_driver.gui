# Объединение нерегулярных полков после боя (его просьба 10-20). Своего эффекта
# слияния у скрипта нет; есть пункт контекстного меню отряда (ПКМ) «Объединить
# иррегулярные полки» — `UnitActionItem` из `Unit.GetQuickUnitActions`, как в
# `context_menu.gui`. Бой ставит игроку `bag_rtk_merge_due` (`on_battle_won`,
# `on_battle_lost`); пока флаг стоит, привод проходит по армиям игрока
# (`AccessPlayerUnits`, как `single_unit_window.gui`) и жмёт этот пункт там, где
# он доступен. Через секунду флаг снимается.
#
# Пункт узнаётся по ключу (`non_regular`, `irregular`) или по куску имени
# («ррегуляр», «rregular»); ключа в файлах игры нет — он в exe. 0.9.13 искал
# имя целиком — не слил ни разу (10-21); 0.9.14 шире и с зондом.
widget = {
	name = "bag_rtk_merge_driver"
	# ВЫКЛЮЧЕН (10-21): 0.9.15 в его игре наплодил сотни пустых армий — нажималось
	# не то или по кругу. Не включать, пока зонд не назовёт ключ пункта.
	visible = "[EqualTo_CFixedPoint('(CFixedPoint)0', '(CFixedPoint)1')]"
	position = { -10000 1 }

	state = {
		name = bag_rtk_merge_arm
		trigger_when = "[GetPlayer.MakeScope.GetVariable('bag_rtk_merge_due').IsSet]"
		on_start = "[PdxGuiTriggerAllAnimations('bag_rtk_merge_wait')]"
	}

	state = {
		name = bag_rtk_merge_wait
		duration = 1
		on_finish = "[GetScriptedGui('bag_rtk_merge_done').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	}

	# Размеры не нулевые: в контейнере нулевого размера игра строк не строит
	# (шаблон мира 0.9.7, 10-20); форма — как у `bag_rtk_rep_driver.gui`.
	widget = {
		size = { 200 200 }
		visible = "[GetPlayer.MakeScope.GetVariable('bag_rtk_merge_due').IsSet]"

		vbox = {
			layoutpolicy_horizontal = expanding
			datamodel = "[AccessPlayerUnits]"
			item = {
				widget = {
					size = { 160 20 }
					visible = "[Unit.IsArmy]"
					datacontext = "[Unit.GetQuickUnitActions]"

					vbox = {
						datamodel = "[QuickUnitActions.AccessList]"
						item = {
							# 0.13.5: one widget per item -- 1.4.5 logs «Too many widget entries» for two
							# (run 10-30), so the presser and its probe share one holder.
							widget = {
								size = { 10 10 }
								widget = {
									size = { 10 10 }
									visible_at_creation = no
									visible = "[And3(GetPlayer.MakeScope.GetVariable('bag_rtk_merge_due').IsSet, Or4(StringContains(UnitActionItem.GetKey, 'non_regular'), StringContains(UnitActionItem.GetKey, 'irregular'), StringContains(UnitActionItem.GetName, 'ррегуляр'), StringContains(UnitActionItem.GetName, 'rregular')), And(UnitActionItem.HasSingleLeftAction, UnitActionItem.CanSingleLeftClick))]"
									state = {
										name = _show
										duration = 0.05
										on_finish = "[UnitActionItem.SingleLeftClick]"
									}
								}
								# Зонд под галочкой журнала: ключ, имя и доступность каждого пункта меню
								# каждой армии — в debug.log (`bag_rtk: merge item`). 0.9.13 не слил ни разу (10-21).
								widget = {
									size = { 10 10 }
									visible_at_creation = no
									visible = "[And(GetPlayer.MakeScope.GetVariable('bag_rtk_merge_due').IsSet, GetGlobalVariable('bag_rtk_log').IsSet)]"
									state = {
										name = _show
										duration = 0.05
										on_finish = "[GetVariableSystem.Set('bag_rtk_mk', Concatenate(UnitActionItem.GetKey, Concatenate(' / ', Concatenate(UnitActionItem.GetName, Select_CString(And(UnitActionItem.HasSingleLeftAction, UnitActionItem.CanSingleLeftClick), ' / can', ' / cannot')))))]"
										on_finish = "[GetScriptedGui('bag_rtk_merge_probe').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
