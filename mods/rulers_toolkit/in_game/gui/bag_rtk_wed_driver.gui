# Настоящий династический брак (`bag_rtk_wed_native_fire`), 0.13.1.
# 0.13.0 жал ванильный `royal_marriage` скрытой кнопкой `scripted_action_tooltip`,
# нажатой `UIAction.OnLeftClick`: «нажата», но игра такое не исполняет — ни брак,
# ни для сравнения наша продажа (прогоны 10-27, hands-off и от лица игрока).
# Теперь путь окнами игры, как вручную: окно персонажа «Супруг»
# (`ShowConsortSelection(жених)`) → «Найти пару» (жмёт копия
# `select_consort_interaction.gui`) → ванильный список стран и невест, строки жмёт
# копия `select_interaction_target.gui`. Этап — в `GetVariableSystem`
# `bag_rtk_wed_stage` (consort → picker); через 12 с привод всё снимает.
widget = {
	name = "bag_rtk_wed_driver"
	visible = "[EqualTo_CFixedPoint('(CFixedPoint)0', '(CFixedPoint)0')]"
	position = { -10000 1 }
	size = { 20 20 }

	dynamicgridbox = {
		datamodel = "[DataModelRepeatedItem(Select_int32(GetGlobalVariable('bag_rtk_wed_go').IsSet, '(int32)1', '(int32)0'))]"
		item = {
			widget = {
				size = { 10 10 }
				state = {
					name = bag_rtk_wed_open
					trigger_on_create = yes
					duration = 0.3
					next = bag_rtk_wed_timeout
					on_finish = "[GetVariableSystem.Set('bag_rtk_wed_stage', 'consort')]"
					on_finish = "[ShowConsortSelection(GetGlobalVariable('bag_rtk_wed_groom').GetCharacter)]"
					on_finish = "[GetVariableSystem.Set('bag_rtk_wk', Select_CString(IsPlayerValid, 'consort window asked, player valid', 'consort window asked, NO player'))]"
					on_finish = "[GetScriptedGui('bag_rtk_wed_probe').Execute(GuiScope.SetRoot(GetGlobalVariable('bag_rtk_wed_from').GetCountry.MakeScope).End)]"
				}
				state = {
					name = bag_rtk_wed_timeout
					duration = 12
					on_finish = "[GetVariableSystem.Set('bag_rtk_wk', Concatenate('done, last stage ', GetVariableSystem.Get('bag_rtk_wed_stage')))]"
					on_finish = "[GetVariableSystem.Clear('bag_rtk_wed_stage')]"
					on_finish = "[GetScriptedGui('bag_rtk_wed_clicked').Execute(GuiScope.SetRoot(GetGlobalVariable('bag_rtk_wed_from').GetCountry.MakeScope).End)]"
				}
			}
		}
	}
}
