# Проба 0.10.x (его мысль 10-26): продать творение ванильным действием, как
# вручную, не открывая панель страны. Список действий берётся прямо у
# покупателя (`Country.GetQuickDiplomaticActions`, так строит меню ПКМ по стране
# `context_menu.gui`), пункт жмётся `DiplomaticActionItem.OnClick` — без
# параметров, как в том меню. Дальше открывается ванильный список выбора; его
# строки жмёт копия `select_interaction_target.gui` (пока стоит `bag_rtk_art_pick`).
#
# Порядок: скрипт ставит `bag_rtk_art_native_due` и переменные `bag_rtk_art_nb`
# (покупатель), `bag_rtk_art_na` (творение) → взвод → пункт «Продать творение»
# у покупателя нажат один раз (`bag_rtk_art_sent`) → через 4 с
# `bag_rtk_art_native_done` проверяет владельца и снимает всё.
#
# 0.10.2 (его прогон 10-26 23:34): в `GetList` шесть пунктов, продажи по ключу и
# имени нет; зонд писал последний пункт шесть раз — строка `debug_log` читает
# `GetVariableSystem` в конце кадра. 0.10.3: пункт берётся по ключу,
# `GetSpecificAction('sell_work_of_art')`, как окно макросборщика берёт
# `GetSpecificAction('improve_relation')`; списки копятся в одну строку и пишутся
# одной строкой через секунду.
widget = {
	name = "bag_rtk_art_driver"
	visible = "[EqualTo_CFixedPoint('(CFixedPoint)0', '(CFixedPoint)0')]"
	position = { -10000 1 }

	state = {
		name = bag_rtk_art_arm
		trigger_when = "[And(GetPlayer.MakeScope.GetVariable('bag_rtk_art_native_due').IsSet, Not(GetVariableSystem.Exists('bag_rtk_art_armed')))]"
		on_start = "[GetVariableSystem.Clear('bag_rtk_al')]"
		on_start = "[GetVariableSystem.Clear('bag_rtk_adl')]"
		on_start = "[GetVariableSystem.Set('bag_rtk_ah', 'unknown')]"
		on_start = "[GetVariableSystem.Set('bag_rtk_art_armed', '1')]"
		on_start = "[PdxGuiTriggerAllAnimations('bag_rtk_art_wait')]"
		on_start = "[PdxGuiTriggerAllAnimations('bag_rtk_art_dump')]"
	}

	state = {
		name = bag_rtk_art_wait
		duration = 4
		on_finish = "[GetScriptedGui('bag_rtk_art_native_done').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		on_finish = "[GetVariableSystem.Clear('bag_rtk_art_pick')]"
		on_finish = "[GetVariableSystem.Clear('bag_rtk_art_sent')]"
		on_finish = "[GetVariableSystem.Clear('bag_rtk_art_armed')]"
	}

	# Зонд под галочкой журнала: что дали списки, есть ли пункт по ключу.
	state = {
		name = bag_rtk_art_dump
		duration = 1
		next = bag_rtk_art_dump2
		on_finish = "[GetVariableSystem.Set('bag_rtk_ak', Concatenate('sell by key: ', Concatenate(GetVariableSystem.Get('bag_rtk_ah'), Concatenate('; list: ', GetVariableSystem.Get('bag_rtk_al')))))]"
		on_finish = "[GetScriptedGui('bag_rtk_art_probe').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	}

	state = {
		name = bag_rtk_art_dump2
		duration = 0.2
		on_finish = "[GetVariableSystem.Set('bag_rtk_ak', Concatenate('dynamic list: ', GetVariableSystem.Get('bag_rtk_adl')))]"
		on_finish = "[GetScriptedGui('bag_rtk_art_probe').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	}

	# Размеры не нулевые: в контейнере нулевого размера игра строк не строит
	# (шаблон мира 0.9.7, 10-20); форма — как у `bag_rtk_merge_driver.gui`.
	widget = {
		size = { 200 200 }
		visible = "[And(GetVariableSystem.Exists('bag_rtk_art_armed'), GetPlayer.MakeScope.GetVariable('bag_rtk_art_nb').IsSet)]"
		datacontext = "[GetPlayer.MakeScope.GetVariable('bag_rtk_art_nb').GetCountry]"

		vbox = {
			layoutpolicy_horizontal = expanding
			datacontext = "[Country.GetQuickDiplomaticActions]"

			# Есть ли у покупателя пункт продажи по ключу — для зонда.
			widget = {
				size = { 10 10 }
				visible_at_creation = no
				visible = "[GetVariableSystem.Exists('bag_rtk_art_armed')]"
				state = {
					name = _show
					duration = 0.1
					on_finish = "[GetVariableSystem.Set('bag_rtk_ah', Select_CString(QuickDiplomaticActions.HasSpecificAction('sell_work_of_art'), 'yes', 'no'))]"
				}
			}

			# Нажать «Продать творение» по ключу — один раз за взвод.
			widget = {
				size = { 10 10 }
				visible_at_creation = no
				visible = "[And3(GetVariableSystem.Exists('bag_rtk_art_armed'), Not(GetVariableSystem.Exists('bag_rtk_art_sent')), QuickDiplomaticActions.HasSpecificAction('sell_work_of_art'))]"
				datacontext = "[QuickDiplomaticActions.GetSpecificAction('sell_work_of_art')]"
				state = {
					name = _show
					duration = 0.3
					on_finish = "[GetVariableSystem.Set('bag_rtk_art_sent', '1')]"
					on_finish = "[GetVariableSystem.Set('bag_rtk_art_pick', '1')]"
					on_finish = "[GetVariableSystem.Set('bag_rtk_ak', Concatenate('clicked by key ', Concatenate(DiplomaticActionItem.GetTag, Select_CString(DiplomaticActionItem.IsEnabled, ' / enabled', ' / DISABLED'))))]"
					on_finish = "[GetScriptedGui('bag_rtk_art_probe').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					on_finish = "[DiplomaticActionItem.OnClick]"
				}
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				datamodel = "[QuickDiplomaticActions.GetList]"
				item = {
					widget = {
						size = { 160 20 }

						# Запасной путь: пункт в списке по ключу или имени (позже пути по ключу).
						widget = {
							size = { 10 10 }
							visible_at_creation = no
							visible = "[And3(GetVariableSystem.Exists('bag_rtk_art_armed'), Not(GetVariableSystem.Exists('bag_rtk_art_sent')), And(DiplomaticActionItem.IsEnabled, Or4(StringContains(DiplomaticActionItem.GetTag, 'sell_work_of_art'), StringContains(DiplomaticActionItem.GetTag, 'SELL_WORK_OF_ART'), StringContains(DiplomaticActionItem.GetTitle, 'Продать творение'), StringContains(DiplomaticActionItem.GetTitle, 'Sell Work of Art'))))]"
							state = {
								name = _show
								duration = 0.6
								on_finish = "[GetVariableSystem.Set('bag_rtk_art_sent', '1')]"
								on_finish = "[GetVariableSystem.Set('bag_rtk_art_pick', '1')]"
								on_finish = "[GetVariableSystem.Set('bag_rtk_ak', Concatenate('clicked in list ', DiplomaticActionItem.GetTag))]"
								on_finish = "[GetScriptedGui('bag_rtk_art_probe').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								on_finish = "[DiplomaticActionItem.OnClick]"
							}
						}

						# Зонд: пункт дописывается в строку `bag_rtk_al`.
						widget = {
							size = { 10 10 }
							visible_at_creation = no
							visible = "[GetVariableSystem.Exists('bag_rtk_art_armed')]"
							state = {
								name = _show
								duration = 0.1
								on_finish = "[GetVariableSystem.Set('bag_rtk_al', Concatenate(GetVariableSystem.Get('bag_rtk_al'), Concatenate(DiplomaticActionItem.GetTag, Select_CString(DiplomaticActionItem.IsEnabled, ' | ', ' (off) | '))))]"
							}
						}
					}
				}
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				datamodel = "[QuickDiplomaticActions.GetDynamicList]"
				item = {
					widget = {
						size = { 10 10 }
						visible_at_creation = no
						visible = "[GetVariableSystem.Exists('bag_rtk_art_armed')]"
						state = {
							name = _show
							duration = 0.15
							on_finish = "[GetVariableSystem.Set('bag_rtk_adl', Concatenate(GetVariableSystem.Get('bag_rtk_adl'), Concatenate(DiplomaticActionItem.GetTag, ' | ')))]"
						}
					}
				}
			}
		}
	}
}
