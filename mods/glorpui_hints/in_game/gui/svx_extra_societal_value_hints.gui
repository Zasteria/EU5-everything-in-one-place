template SocietalValueCountryRight_tooltip {
	using = SocietalValueRight_tooltip
	blockoverride "societal_value_right_tooltip_extra" {

		# Either switch on: the game's own two lists.

		TooltipScrolledStringPairList = {
			visible = "[Or(Player.MakeScope.GetVariable('showUnavailableSocietalValueSuggestions').IsSet, And(CMMSettingIsRegistered('svx__show_all'),CMMValueEqualsOne(CMMSettingValue('svx__show_all'))))]"
			blockoverride "block_scrollarea" {
				maximumsize = { -1 160 }
			}

			blockoverride "block_title" {
				text = "TO_MOVE_FURTHER_TO_RIGHT"
				default_format = "#help"
			}

			textcontext = "[SocietalValue.GetRightHint(Player.Self)]"
		}

		TooltipScrolledStringPairList = {
			visible = "[And(Or(Player.MakeScope.GetVariable('showUnavailableSocietalValueSuggestions').IsSet, And(CMMSettingIsRegistered('svx__show_all'),CMMValueEqualsOne(CMMSettingValue('svx__show_all')))), SocietalValue.ShowRightLockedHint(Player.Self))]"
			blockoverride "block_scrollarea" {
				maximumsize = { -1 160 }
			}

