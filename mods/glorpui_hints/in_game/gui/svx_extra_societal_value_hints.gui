template SocietalValueCountryRight_tooltip {
	using = SocietalValueRight_tooltip
	blockoverride "societal_value_right_tooltip_extra" {

		# The game's whole list, while the switch is on.
		TooltipScrolledStringPairList = {
			visible = "[And(CMMSettingIsRegistered('svx__show_all'),CMMValueEqualsOne(CMMSettingValue('svx__show_all')))]"
			blockoverride "block_scrollarea" {
				maximumsize = { -1 160 }
			}

			blockoverride "block_title" {
				text = "TO_MOVE_FURTHER_TO_RIGHT"
				default_format = "#help"
			}

			textcontext = "[SocietalValue.GetRightHint(Player.Self)]"
		}

		# The takeable-only lists, forked from Glorp UI, while it is off.

		TooltipScrolledStringPairList = {
			visible = "[And(GreaterThan_CFixedPoint(GuiScope.AddScope('svx_sv', SocietalValue.MakeScope).AddScope('svx_country', Player.MakeScope).ScriptValue('svx_svh_visible_decentralization'), '(CFixedPoint)0'), Not(And(CMMSettingIsRegistered('svx__show_all'),CMMValueEqualsOne(CMMSettingValue('svx__show_all')))))]"
			blockoverride "block_scrollarea" {
				maximumsize = { -1 160 }
			}

			blockoverride "block_title" {
				text = "TO_MOVE_FURTHER_TO_RIGHT"
				default_format = "#help"
			}

			textcontext = "[Localize('SVX_SVH_BODY_DECENTRALIZATION')]"
